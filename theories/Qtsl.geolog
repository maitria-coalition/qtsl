import std.{B, Nat, Q, Shape, Str, nat_lt, q_le, q_lt};

// Engine-decided judgements (oracle = the qtsl certification plugin
// at the engine's ground seam): bounded computations discharged by
// evaluation, never derivation-defined. Everything declared and not
// imported below is ordinary (the default). This header replaces the
// retired .registry classification sidecar.
import qtsl.{farkasPairValid, lirpaPremHiForm, lirpaPremLoForm,
             lirpaSandwichForm, qcred_contains, qtsl_asel_attach,
             qtsl_asel_closed, qtsl_asel_cover, qtsl_asel_enabled,
             qtsl_asel_ratecap, qtsl_asel_reach, qtsl_asel_relay,
             qtsl_bag_canon, qtsl_bag_wf, qtsl_base_exact, qtsl_cb_attach,
             qtsl_cb_drift, qtsl_cb_nonneg, qtsl_cb_seam, qtsl_cb_wf,
             qtsl_cell_cover, qtsl_cert_claim_wf, qtsl_certfam_wf,
             qtsl_contract_cell, qtsl_contract_param, qtsl_couple_drift,
             qtsl_dbar_closure, qtsl_deadline_table, qtsl_dist_transport,
             qtsl_dwell_gate, qtsl_firebound_fold, qtsl_firecount_roster,
             qtsl_fixball, qtsl_flatten, qtsl_form_grounded, qtsl_gap_a,
             qtsl_gate_scalar, qtsl_gen_form, qtsl_hole_count,
             qtsl_hplate_coverage, qtsl_hplate_coverage_lb, qtsl_hplate_flow,
             qtsl_hplate_flow_lb, qtsl_hplate_footprint, qtsl_hplate_lowbound,
             qtsl_hplate_param_cert, qtsl_hplate_param_wire, qtsl_hybtime,
             qtsl_init_bridge, qtsl_init_member, qtsl_intbound_sw,
             qtsl_kcite_wf, qtsl_ksupport, qtsl_lirpa_arith,
             qtsl_lowbound_boxes, qtsl_massone, qtsl_miranda_battery,
             qtsl_mode_wf, qtsl_morse_readout, qtsl_nd_roster,
             qtsl_palways_fold, qtsl_palwayst_fold, qtsl_palwayst_lineage,
             qtsl_poly_canonical, qtsl_problog_blocks,
             qtsl_problog_bonferroni, qtsl_problog_compiled,
             qtsl_problog_derives, qtsl_problog_exact, qtsl_problog_lower,
             qtsl_problog_upper, qtsl_problog_wf, qtsl_rate_clock,
             qtsl_rate_clocks, qtsl_rate_lb, qtsl_rate_ub, qtsl_role_support,
             qtsl_sm_index, qtsl_sm_rowstoch, qtsl_sm_shape, qtsl_spec_wf,
             qtsl_stochwire_shape, qtsl_support_canonical, qtsl_sys_causal,
             qtsl_sys_w3, qtsl_tc_firstservice, qtsl_tc_fssplit,
             qtsl_tc_invrel, qtsl_tr_content, qtsl_tr_endo, qtsl_tr_grain,
             qtsl_tr_meter, qtsl_tr_ratecap, qtsl_unit_lineage,
             qtsl_verdict_compile, qtsl_warrant_member, qtsl_wire_causality,
             qtsl_wire_markflow, qtsl_wiring_shapes, reluOutDominatesForm,
             reluOutEqInputForm, reluOutNonnegForm, reluOutZeroForm,
             reluPremNonnegForm, reluPremNonposForm, saCellOneHotForm,
             saCellOutWitnessForm, saCellOutZeroForm,
             saCellStrictInteriorForm, saEmptyCellForm, tsCellOneHotForm,
             tsCellOutWitnessForm, tsCellOutZeroForm,
             tsCellStrictInteriorForm, vcCellMemberForm, vcScopeBridgeForm,
             verifiedCoverSplitValid};

// Qtsl.geolog
//
// The QTSL specification language and its System stratum, as one
// geolog theory. A revision loading this theory can state what a
// dynamical system IS (mechanisms, interfaces, wirings, composites,
// transitions, clocks), what a specification CLAIMS about it (state
// and path formulas, Streett conditions, return functionals, level
// probes), and the derived surfaces a certificate checker consumes
// (the compiled generator map). Since the omnibus fold (the
// theory-unification enactment) this ONE theory carries every
// stratum: the subject and specification strata first, then the
// flavored cell schemas (the certificate's disjunction source), the
// certificate sections (judgments, proof nodes, batteries, the
// verdict form), and the certificate-shape stratum (branch-indexed
// families over declared nondeterminism axes).
//
// The theory extends BernsteinLogic (the polynomial proof calculus
// whose tower runs from ground dtypes through hypernets, formulas,
// and judgments to the Bernstein-Logic proof species). QTSL inherits
// that tower's node types and adds the specification and System
// vocabulary above them.
//
// HOW TO READ THIS FILE. Declarations come in three idioms, each
// carrying its own identity semantics:
//
//   * VALUE-LIKE sorts get constructor functions with record
//     domains. The chase hash-conses them: structurally equal terms
//     denote one element, so a formula, an interval, or a wiring is
//     identified by its content. Two spellings of the same content
//     are one value.
//   * ENTITY-LIKE sorts (mechanisms, modes, specifications,
//     transitions, stochastic matrices) are named and owned; their
//     content hangs off them as attribute functions and relation
//     rows. Two entities of equal content remain distinct — which is
//     load-bearing wherever multiplicity is physical (two identical
//     transitions attached to one system race, and their rates add).
//   * RELATIONS carry zero-or-more content. A field family that a
//     subject may populate zero times, once, or many times is a
//     relation row, never a partial function: geolog functions carry
//     totality obligations (existence and uniqueness are implicit in
//     the sort), so optionality spelled as a partial function would
//     smuggle a counting constraint into sort structure. Where the
//     semantics demands at most one row, that demand is admission
//     conformance (a named check at load), never a chased equality —
//     the engine refuses to unify ground values, and a uniqueness
//     axiom over ground content would ask it to.
//
// Every axiom carries an explicit mode:
//
//   * `chase`  — derivation is the intent: the axiom fires and
//     creates rows (interface determination, list walks, refinement
//     generation, and the demand rows that side-condition oracles
//     discharge).
//   * `report` — the axiom states a constraint; a violation is a
//     loud judgment on the commit, never a refusal and never a
//     minted row. Arithmetic well-formedness lives here: range and
//     ordering checks should not gate admission on arithmetic the
//     oracle stratum owns. So does every cross-commit agreement
//     check, whose blame spans more than one record.
//   * `refuse` — a violation is a malformed subject that must gate
//     admission: constructor confusion, length mismatch, two content
//     languages on one subject. Blame is local to the record being
//     admitted.
//
// Side-condition relations (declared with the classification roster
// that accompanies this file) are discharged by bounded evaluation
// at the engine's ground seam, never by chase derivation. An axiom
// concluding a side-condition atom is a demand JUDGMENT, authored in
// judging mode (the modal scoping rule: a side-condition's extension
// is decided by its evaluator, never asserted by a fired head): it
// renders as a pending judgment until the evaluator discharges or
// loudly defers it. Checking
// is engine-internal end to end; no external tool is trusted for any
// obligation this file states.
//
// Conformance families named C-* in the section comments are the
// admission checks that are not geometrically expressible (whole-list
// and whole-fibre arithmetic, canonical-form disciplines). Each is
// realized as a side-condition demand in this file, so the family's
// existence and scope are theory content, and only its arithmetic
// lives at the evaluator.

theory Qtsl extends BernsteinLogic {

  // ==========================================================
  // Polynomials
  // ==========================================================
  //
  // A polynomial is its own canonical term list: pZero is the zero
  // polynomial; pTerm prepends one monomial, whose exponent tuple
  // rides the ground Shape sort (a finite sequence of naturals, read
  // positionally) and whose coefficient is an exact rational.
  // Canonical form — nonzero coefficients, exponent tuples of
  // uniform width, strictly increasing in the fixed monomial order —
  // is a bounded computation, demanded of every polynomial. Stored
  // zeros are unrepresentable in canonical form: sparsity is the
  // representation.

  Poly : Set;

  pZero : Poly;
  pTerm : {expts: Shape, coeff: Q, tail: Poly} -> Poly;

  qtsl_poly_canonical : {p: Poly} -> Prop;   // side-condition

  report ax/wf/poly_canonical : forall p : Poly.
    |- {p: p} qtsl_poly_canonical;

  // ==========================================================
  // Intervals, boxes, vectors
  // ==========================================================

  Interval : Set;   // closed rational interval [lo, hi]
  Box      : Set;   // list of intervals: chart domains, slabs,
                    // landing enclosures
  PolyVec  : Set;   // list of polynomials: drift vectors, resets
  StrList  : Set;   // variable-name vectors (order is the index)

  mkInterval : {hi: Q, lo: Q} -> Interval;

  report ax/wf/interval_order : forall lo : Q, hi : Q, i : Interval.
    i = {hi: hi, lo: lo} mkInterval
    |- {l: lo, r: hi} q_le;

  boxNil  : Box;
  boxCons : {head: Interval, tail: Box} -> Box;

  pvNil  : PolyVec;
  pvCons : {head: Poly, tail: PolyVec} -> PolyVec;

  strNil  : StrList;
  strCons : {head: Str, tail: StrList} -> StrList;

  // ==========================================================
  // Hypernet references
  // ==========================================================
  //
  // Hypernets are the one genus of computational and dynamical
  // content. Polynomial fields in this file are VIEWS: surface
  // syntax whose meaning is a definitional elaboration into hypernet
  // applications, with the elaboration digest derived and never
  // stored. A HypernetRef names hypernet content by the digest of
  // its canonical serialization — one digest scheme for every
  // citation in the theory. Where a view and a native reference are
  // both present, their agreement is a recompute obligation, never a
  // trusted row.

  HypernetRef : Set;
  hnDigest : {sha256hex: Str} -> HypernetRef;

  // ==========================================================
  // The formation grid (state/path x observable/pred, capped)
  // ==========================================================
  //
  // Seven judgment sorts carry the specification grammar (the grid
  // re-sort revision): four arrange as a two-by-two grid — the
  // temporal axis (State: atemporal; Path: trajectory) crossed with
  // the shape axis (Observable: Q-valued; Pred: Boolean) — capped by
  // the two polarity sorts and consumed by the Spec record. An
  // eighth, small sort carries the attitude blends (design scores).
  //
  // THE STRATIFICATION LAW. The State row admits no trajectory
  // quantification and no credal quantification; the Path row lifts
  // State-row material along trajectories; ALL quantification over
  // the credal body happens at the cap, and the cap is where
  // polarity lives. A ForallSpec component reads its bound against
  // every admitted law (the safety face — compiles to a forall-face
  // demand: wall domination, the closed containment face); an ExistsSpec
  // component asserts some admitted law attains (a liveness mark —
  // compiles to a dip: the open escape face). Polarity is thereby a
  // SORT, not an annotation: a specification cannot be written
  // without declaring the face of every component, a mis-faced
  // premise is a formation error, and rule statements carry face
  // restrictions as sort premises instead of prose side conditions.
  // The judgment layer is untouched — one turnstile, no subscripts.
  //
  // Renames at this revision: StatePred was StateF, PathPred was
  // PathF, PathObservable was Return; StateObservable names the
  // atemporal quantitative stratum that was previously anonymous
  // (bare Poly arguments, channel indices, gate citations). What the
  // earlier polarity comment defended — no polarity fork of shared
  // subterms — survives BELOW the cap: the grid rows stay
  // polarity-free, shared values; only the cap declares a face, and
  // a cap component is consumed by the record, never shared into
  // formula trees.
  //
  // Comparison atoms come in two closed orientations and no strict
  // ones: the surface grammar is nonstrict by construction, and
  // strict literals are compiler artifacts with no representation
  // here.

  StateObservable : Set;   // atemporal Q-valued observables
  StatePred       : Set;   // atemporal predicates (regions)
  PathObservable  : Set;   // run functionals
  PathPred        : Set;   // trajectory events
  ForallSpec      : Set;   // safety-face components (the cap)
  ExistsSpec      : Set;   // liveness-mark components (the cap)
  AttitudeSpec    : Set;   // attitude blends: design scores, never
                           // guarantees (the record's score slot)
  StreettPair     : Set;   // one (request, response) pair
  StatePredList   : Set;
  StreettPairList : Set;

  // ==========================================================
  // Observables (the State row's Q-valued cell)
  // ==========================================================
  //
  // Four injections. A CHANNEL cites a positional output wire of
  // the paired subject's interface (resolved at the pairing, as
  // before — channel-within-arity has no row here by design). A
  // GATE cites a scalar-codomain hypernet on the state carrier by
  // digest. A POLY is the polynomial view over the paired carrier's
  // positional variables. An INDICATOR embeds a predicate as its
  // characteristic observable (the State row's Pred -> Observable
  // arrow). Reward provenance, previously fused into the
  // run-functional constructors, is exactly this stratum: an
  // accumulator below consumes ONE observable, whatever its
  // provenance.

  oChan : {chan: Nat} -> StateObservable;
  oGate : {gate: HypernetRef} -> StateObservable;
  oPoly : {poly: Poly} -> StateObservable;
  oInd  : {arg: StatePred} -> StateObservable;

  // Every gate citation resolves to a scalar-codomain hypernet on
  // the (possibly augmented) state carrier. Checked at admission,
  // where the cited content is reachable; the demand is minted once
  // per gate injection — the single locus every gate-bearing
  // consumer now routes through.
  qtsl_gate_scalar : {gate: HypernetRef} -> Prop;   // side-condition

  report ax/wf/gate_scalar : forall g : HypernetRef, o : StateObservable.
    o = {gate: g} oGate
    |- {gate: g} qtsl_gate_scalar;

  // Representative constructor-disjointness fixtures (the full
  // pairwise family is mechanical and rides the admission
  // checklist).
  refuse ax/qtsl/obs_chan_gate_disjoint : forall k : Nat,
      g : HypernetRef, o : StateObservable.
    o = {chan: k} oChan, o = {gate: g} oGate
    |- false;

  refuse ax/qtsl/obs_poly_ind_disjoint : forall p : Poly,
      a : StatePred, o : StateObservable.
    o = {poly: p} oPoly, o = {arg: a} oInd
    |- false;

  // ==========================================================
  // State predicates (the State row's Boolean cell)
  // ==========================================================

  STrue  : StatePred;
  SFalse : StatePred;
  SAtomLE : {c: Q, o: StateObservable} -> StatePred;   // o <= c
  SAtomGE : {c: Q, o: StateObservable} -> StatePred;   // o >= c
  SAnd : StatePredList -> StatePred;
  SOr  : StatePredList -> StatePred;
  SNot : StatePred -> StatePred;

  slNil  : StatePredList;
  slCons : {head: StatePred, tail: StatePredList} -> StatePredList;

  // ==========================================================
  // Path formulas
  // ==========================================================

  PAlways : StatePred -> PathPred;                          // G phi
  PDeadline : {T: Q, arg: StatePred, producerT: B} -> PathPred;
                       // F_{<=T} phi; producerT marks a
                       // producer-chosen horizon standing in for an
                       // unbounded eventually (a sound
                       // under-approximation)
  PAlwaysT : {T: Q, arg: StatePred} -> PathPred;            // G_{<=T} phi:
                       // the enclosure and tube claim shape
  PUntil : {T: Q, safe: StatePred, target: StatePred} -> PathPred;
                       // safe U_{<=T} target

  // Streett acceptance, split by METERING SPECIES (the former split
  // revision — the record lens proves the two species incomparable
  // on con-coupled points, so a mode flag would leave every
  // consuming rule case-splitting on data the type system never
  // sees; two formers make the meter part of the event's identity):
  //   * PDwellStreett — occupation metering: unbounded request
  //     OCCUPATION forces unbounded response occupation (counting
  //     measure at tick strata, duration at clocked strata). Today's
  //     step-metered batteries, the K5 engine, and the GF/FG aliases
  //     are this former's unit-tick instance BY IDENTITY — nothing
  //     existing migrates to the cross species.
  //   * PCrossStreett — entry-event counting: unboundedly many
  //     request CROSSINGS (fresh contact after absence — the
  //     countable, payable unit of touching) force unboundedly many
  //     response crossings. Enter-and-stay separates the species
  //     even at unit ticks (occupation diverges, the entry counter
  //     stops at one), so no existing content migrates here; its
  //     consuming rule composes with the crossing-budget family,
  //     whose non-accumulation evidence is the DEFINEDNESS of the
  //     infinitary reading at continuum strata, not merely its
  //     price. Metering is the event's identity; the FACE of a
  //     Streett claim stays at the cap that consumes the event —
  //     2 meterings x 2 faces, all spelled compositionally.
  // Both share the pair kit verbatim: the pair vocabulary (request,
  // response, consumption parity) is metering-independent.
  PDwellStreett : StreettPairList -> PathPred;
  PCrossStreett : StreettPairList -> PathPred;

  PNotPath : PathPred -> PathPred;   // surface-only negation, resolved by
                               // the dualities in negation normal
                               // form; negated Streett refuses with
                               // its Rabin address under EITHER
                               // metering — the refusal is
                               // metering-parametric

  // The two meterings at one pair list are distinct events — a
  // certificate priced per crossing is not one priced per unit of
  // occupation.
  refuse ax/qtsl/streett_meter_disjoint : forall l : StreettPairList,
      x : PathPred.
    x = l PDwellStreett, x = l PCrossStreett
    |- false;

  plNil  : StreettPairList;
  plCons : {head: StreettPair, tail: StreettPairList} -> StreettPairList;

  // A Streett request is consumed in one of two modes, and the mode
  // is the pair's constructor: base-exact consumption demands a
  // base-stratum request; complement consumption reads the request
  // through its syntactic complement, an over-approximation.
  PairBase : {req: StatePred, resp: StatePred} -> StreettPair;
  PairCmpl : {req: StatePred, resp: StatePred} -> StreettPair;

  // Deadlines are strictly positive, in both deadline-carrying
  // forms and the bounded always.
  report ax/wf/deadline_pos : forall T : Q, a : StatePred, b : B, x : PathPred.
    x = {T: T, arg: a, producerT: b} PDeadline
    |- {l: 0, r: T} q_lt;

  report ax/wf/until_pos : forall T : Q, s : StatePred, tg : StatePred, x : PathPred.
    x = {T: T, safe: s, target: tg} PUntil
    |- {l: 0, r: T} q_lt;

  report ax/wf/alwayst_pos : forall T : Q, a : StatePred, x : PathPred.
    x = {T: T, arg: a} PAlwaysT
    |- {l: 0, r: T} q_lt;

  // Path-row thresholds (Observable -> Pred at the Path row; the
  // grid's admitted arrow): pathwise accumulated-cost EVENTS — the
  // inner clause of P_{>=p}[sum r <= B] — a claim species distinct
  // from any expectation bound (SReturnLE bounds the prevision;
  // PAtomLE names the event that the accumulated value lands under
  // the threshold, and the cap then declares the face). The
  // run-functional argument is declared below with its own cell;
  // sorts are pre-declared, so the arrow reads naturally here.
  PAtomLE : {c: Q, ret: PathObservable} -> PathPred;   // ret <= c
  PAtomGE : {c: Q, ret: PathObservable} -> PathPred;   // ret >= c

  refuse ax/qtsl/patom_le_ge_disjoint : forall c : Q,
      r : PathObservable, x : PathPred.
    x = {c: c, ret: r} PAtomLE, x = {c: c, ret: r} PAtomGE
    |- false;

  // ==========================================================
  // The base-stratum refinement
  // ==========================================================
  //
  // The base stratum consists of nonstrict POLYNOMIAL atoms,
  // conjunction, disjunction, and the constants. Its complement is
  // derivable in the monotone direction: negation generates
  // nonbase-ness, so does any atom whose observable is not a
  // polynomial view (a channel, gate, or indicator atom is not a
  // polynomial atom — Theta_0 is the polynomial stratum, which is
  // what the base-exact consumers arithmetically need), and
  // nonbase-ness propagates up through the list formers. The credal
  // formers, which generated most of the old nonbase family, no
  // longer inhabit this sort at all — their nonbase rows retired
  // with their re-homing to the cap, where mis-faced consumption is
  // a formation error rather than a refinement query. Base-ness is
  // a property of the value, not of any occurrence, so a stored
  // refinement is sound here where a stored polarity would not be.

  StatePred/nonbase : StatePred -> Prop;
  StatePredList/has_nonbase : StatePredList -> Prop;

  chase ax/nonbase_not : forall a : StatePred, f : StatePred.
    f = a SNot
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_chan_le : forall c : Q, k : Nat,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomLE, o = {chan: k} oChan
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_chan_ge : forall c : Q, k : Nat,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomGE, o = {chan: k} oChan
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_gate_le : forall c : Q, g : HypernetRef,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomLE, o = {gate: g} oGate
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_gate_ge : forall c : Q, g : HypernetRef,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomGE, o = {gate: g} oGate
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_ind_le : forall c : Q, a : StatePred,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomLE, o = {arg: a} oInd
    |- f StatePred/nonbase;

  chase ax/nonbase_atom_ind_ge : forall c : Q, a : StatePred,
      o : StateObservable, f : StatePred.
    f = {c: c, o: o} SAtomGE, o = {arg: a} oInd
    |- f StatePred/nonbase;

  chase ax/has_nonbase_head : forall h : StatePred, t : StatePredList, l : StatePredList.
    l = {head: h, tail: t} slCons, h StatePred/nonbase
    |- l StatePredList/has_nonbase;

  chase ax/has_nonbase_tail : forall h : StatePred, t : StatePredList, l : StatePredList.
    l = {head: h, tail: t} slCons, t StatePredList/has_nonbase
    |- l StatePredList/has_nonbase;

  chase ax/nonbase_and : forall l : StatePredList, f : StatePred.
    f = l SAnd, l StatePredList/has_nonbase
    |- f StatePred/nonbase;

  chase ax/nonbase_or : forall l : StatePredList, f : StatePred.
    f = l SOr, l StatePredList/has_nonbase
    |- f StatePred/nonbase;

  // A base-exact request that is provably nonbase is a malformed
  // pair: the constructor's whole meaning is base-exact consumption.
  refuse ax/wf/request_base_exact : forall r : StatePred, b : StatePred, pr : StreettPair.
    pr = {req: r, resp: b} PairBase, r StatePred/nonbase
    |- false;

  // The POSITIVE half (the F-2 review repair): the nonbase refusal
  // catches what the refinement can prove, but base membership is a
  // positive property — constants, atoms over ACTUAL polynomial
  // views, and/or closure — and an open-sort observable outside the
  // four injections is not provably nonbase yet is not base either.
  // So every base-consumed position ALSO demands the fail-closed
  // positive check at the ground seam: the evaluator admits exactly
  // the Theta_0 grammar and refuses-or-defers everything else,
  // unknown extension constructors included.
  qtsl_base_exact : {f: StatePred} -> Prop;   // side-condition

  report ax/wf/request_base_demand : forall r : StatePred,
      b : StatePred, pr : StreettPair.
    pr = {req: r, resp: b} PairBase
    |- {f: r} qtsl_base_exact;

  // Representative constructor-disjointness fixtures. The full
  // pairwise family is mechanical and rides the admission
  // checklist; these are stated so the schema's own rejection
  // machinery has instances, and the third is the polarity-relevant
  // one — a pair consumed base-exact is never the same element as
  // one consumed through the complement, because the two
  // consumption directions differ.

  refuse ax/qtsl/true_atom_disjoint : forall c : Q, o : StateObservable,
      f : StatePred.
    f = STrue, f = {c: c, o: o} SAtomLE
    |- false;

  refuse ax/qtsl/and_or_disjoint : forall l : StatePredList, f : StatePred.
    f = l SAnd, f = l SOr
    |- false;

  refuse ax/qtsl/pair_mode_disjoint : forall r : StatePred, b : StatePred,
      pr : StreettPair.
    pr = {req: r, resp: b} PairBase, pr = {req: r, resp: b} PairCmpl
    |- false;

  // ==========================================================
  // Parity-dependent typing
  // ==========================================================
  //
  // Some typing rules depend on occurrence parity across a whole
  // formula tree (a doubly negated Streett condition is lawful while
  // a singly negated one is not), so no local geometric rule can
  // carry them. What the old whole-tree oracle ALSO carried —
  // negated probability at even parity, attitude atoms below the
  // root — is now unrepresentable at formation (no credal former
  // inhabits StatePred, so SNot cannot reach one; the attitude sort
  // is consumed only by the record), the fence-to-type upgrade this
  // grid revision exists for. The residual parity walk is demanded
  // per SPECIFICATION over its components (qtsl_spec_wf, with
  // the record below), discharged by the typing evaluator at the
  // ground seam.

  // ==========================================================
  // Extended nonnegative rationals (formation data)
  // ==========================================================
  //
  // A two-constructor value sort for bounds that may be infinite:
  // transition majorants, level-probe thresholds. This is formation
  // syntax, deliberately distinct from the ground dtype that carries
  // extended-rational wire VALUES: every consumer of this sort
  // case-splits on finiteness, and the case split is the load-bearing
  // discriminator (finite bounds are generator-plane content;
  // infinite bounds mark the instant-fire stratum), so the sum
  // spelling keeps the discriminator syntactic. The sort admits
  // zero; consumers that exclude it do so at their own rows.

  EnnRat : Set;
  enFin : {q: Q} -> EnnRat;   // finite bound
  enInf : EnnRat;             // positive infinity

  report ax/wf/ennrat_nonneg : forall q : Q, e : EnnRat.
    e = {q: q} enFin
    |- {l: 0, r: q} q_le;

  refuse ax/qtsl/ennrat_fin_inf_disjoint : forall q : Q, e : EnnRat.
    e = {q: q} enFin, e = enInf
    |- false;

  // Constructor coverage: every EnnRat element is one of the two
  // wings. Without this row a fresh element would evade every
  // consumer's finiteness case split — a majorant outside both the
  // generator and instant strata, a dwell floor outside both the
  // positivity report and the dead-point refusal.
  report ax/wf/ennrat_total : forall e : EnnRat.
    |- exists q : Q. e = {q: q} enFin or e = enInf;

  // ==========================================================
  // Run functionals (the Path row's Observable cell)
  // ==========================================================
  //
  // A run functional packages what a run is worth. At this revision
  // the reward's PROVENANCE (channel, gate, polynomial view,
  // indicator) is StateObservable formation above, and ACCUMULATION
  // is four formers over one observable — the provenance-fused
  // constructor roster of the earlier edition (retChanSum through
  // retAvg) is re-founded as injections + accumulators, at
  // unchanged denotations. Accumulation modes: per-tick sums to a
  // tick horizon, time integrals to a rational horizon, exponential
  // discounting at a positive rate, the long-run average, and the
  // pathwise running supremum. Horizon integrality is carried by
  // the constructor split — tick horizons are naturals, time
  // horizons are rationals — so an integrality side condition has
  // nothing left to check.
  //
  // The path former retPath cites a path event as a reward source:
  // the indicator of the event, or its compiled reward where the
  // Streett route needs one. Its elaboration into gate-and-
  // accumulation rows is computed where consumed, never trusted.
  // (retPath and oInd are the two indicator arrows of the grid —
  // one per row; probability is expectation of an indicator BY THE
  // DIAGRAM, and the alias ties stay denotation lemmas at the
  // mechanized stratum, never chase equations.)
  //
  // poSup — the running-sup accumulator (the E[sup] former): the
  // pathwise supremum of the observable along the run, horizon-free,
  // read in the extended-real scale where an infinite sup makes an
  // upper-bound claim FALSE, never ill-formed (the firing-count
  // functional below shares the extended reading on its nonnegative
  // fragment). The
  // maximal-function shape: SReturnLE {hi: B, ret: {o: m} poSup}
  // bounds E[sup_t m(x_t)] over every admitted law — Doob's maximal
  // inequality is its natural certificate engine, the
  // supermartingale row kit its natural feed (rule rows ride a later
  // event, per the certificate-stratum ruling). Deliberately NOT
  // minted: a sup-outside-expectation former (sup_t E[...] is a
  // forall-t family of marginal-law judgments, not a run
  // functional); E[sup] >= sup_t E always, so the per-instant-
  // uniform reading arrives as a free corollary of the expressible,
  // stronger form.

  poSum  : {horizon: Nat, o: StateObservable} -> PathObservable;
  poInt  : {horizon: Q, o: StateObservable} -> PathObservable;
  poDisc : {o: StateObservable, rate: Q} -> PathObservable;
  poAvg  : {o: StateObservable} -> PathObservable;
  poSup  : {o: StateObservable} -> PathObservable;
  retPath : PathPred -> PathObservable;

  report ax/wf/po_int_horizon_pos : forall o : StateObservable, T : Q,
      r : PathObservable.
    r = {horizon: T, o: o} poInt
    |- {l: 0, r: T} q_lt;

  report ax/wf/po_disc_rate_pos : forall o : StateObservable, th : Q,
      r : PathObservable.
    r = {o: o, rate: th} poDisc
    |- {l: 0, r: th} q_lt;

  // A zero-tick sum is the empty sum — a constant claim wearing an
  // accumulator's clothes — so canonical form demands at least one
  // tick. The natural-number order atom carries the check.
  report ax/wf/po_sum_horizon_pos : forall o : StateObservable, h : Nat,
      r : PathObservable.
    r = {horizon: h, o: o} poSum
    |- {l: 0, r: h} nat_lt;

  // Channel-within-arity is checked at the pairing, where the paired
  // interface is in hand; it has no row here by design. Gate
  // scalar-codomain conformance rides the oGate injection above —
  // one locus, every accumulator inherits it.

  // A finite-horizon integral is never a discounted return, even at
  // equal data; the average and the running sup are distinct
  // readings of one observable. Representative disjointness
  // fixtures; the full pairwise family is mechanical and rides the
  // admission checklist.
  refuse ax/qtsl/po_int_disc_disjoint : forall o : StateObservable,
      x : Q, r : PathObservable.
    r = {horizon: x, o: o} poInt,
    r = {o: o, rate: x} poDisc
    |- false;

  refuse ax/qtsl/po_avg_sup_disjoint : forall o : StateObservable,
      r : PathObservable.
    r = {o: o} poAvg, r = {o: o} poSup
    |- false;

  // ==========================================================
  // The soft former: prevision floors and marks at a PathObservable
  // ==========================================================
  //
  // ("Floor" and "mark" here are the prevision-bound senses — the
  // two cap faces; at the verdict stratum the same polarity is
  // spelled forall_face/exists_face.)
  // Denotations read the paired system's credal body. A FLOOR bounds
  // the whole body (lower prevision at least lo; upper prevision at
  // most hi) — the safety face, concluded ForallSpec. A MARK asserts
  // that some admitted law attains the bound — the liveness face,
  // concluded ExistsSpec. A two-sided claim is a two-entry record
  // (one component per face); no interval sort exists. Bounds are
  // unconstrained rationals: returns are not probabilities. A floor
  // and a mark at equal data are distinct claims in distinct SORTS —
  // the old floor/mark disjointness fixture retired as a type-level
  // fact (a variable cannot match both faces), the fence-to-type
  // upgrade in miniature.

  SReturnGE      : {lo: Q, ret: PathObservable} -> ForallSpec;
  SReturnLE      : {hi: Q, ret: PathObservable} -> ForallSpec;
  SReturnMayBeGE : {lo: Q, ret: PathObservable} -> ExistsSpec;
  SReturnMayBeLE : {hi: Q, ret: PathObservable} -> ExistsSpec;

  refuse ax/qtsl/return_ge_le_disjoint : forall b : Q, r : PathObservable,
      f : ForallSpec.
    f = {lo: b, ret: r} SReturnGE,
    f = {hi: b, ret: r} SReturnLE
    |- false;

  refuse ax/qtsl/return_maybe_ge_le_disjoint : forall b : Q,
      r : PathObservable, e : ExistsSpec.
    e = {lo: b, ret: r} SReturnMayBeGE,
    e = {hi: b, ret: r} SReturnMayBeLE
    |- false;

  // ==========================================================
  // The attitude former: Hurwicz blends of the two faces
  // ==========================================================
  //
  // Certification is pessimism; design exploration wants the other
  // end too, and occasionally a weighted blend — the Hurwicz
  // optimism-pessimism criterion, transposed. The former blends the
  // two envelope readings of the paired system's credal body at a
  // PathObservable: alpha = 0 is the pure worst case (SReturnGE's floor
  // face, exactly), alpha = 1 the pure best case (SReturnMayBeGE's
  // witness face, exactly); interior alpha mixes them once, in
  // checker-recomputed rational arithmetic, and a verdict there
  // renders as a design score, never as a guarantee.
  //
  // ROOT-ONLY, NOW BY TYPE — the fence-to-type upgrade: the pair
  // concludes its own small cap sort, AttitudeSpec, whose ONLY
  // consumer is the record's score slot (spec_score below) — no
  // connective, path former, or attitude atom takes an AttitudeSpec
  // argument, so occurrence below a root is unrepresentable rather
  // than oracle-rejected, and the old whole-tree typing clause for
  // this former retires. The restriction was always theorem-backed,
  // not caution: an interior blend mixes a quantity that shrinks
  // under new admitted laws with one that grows, so it is not
  // monotone in the refinement order and fails both the
  // marginal-extension tower property and equivalence with any
  // single envelope bound (exact-rational countermodels are
  // kernel-checked, both faces). The pair fits NEITHER cap face —
  // alpha = 0 is the floor face exactly, alpha = 1 the witness face
  // exactly, and an interior alpha reads both envelopes — which is
  // why it has its own sort instead of a mis-declared face. Nothing
  // is lost: at the endpoints a nested blend has its canonical
  // spelling in the sibling formers. No rule concludes the atom —
  // evaluation decomposes into the two extreme passes (one floor
  // certificate, one witness certificate) mixed once at the root,
  // and a verdict renders as a design score, never a guarantee.

  SHurwiczGE : {alpha: Q, lo: Q, ret: PathObservable} -> AttitudeSpec;
  SHurwiczLE : {alpha: Q, hi: Q, ret: PathObservable} -> AttitudeSpec;

  refuse ax/qtsl/hurwicz_ge_le_disjoint : forall a : Q, b : Q,
      r : PathObservable, f : AttitudeSpec.
    f = {alpha: a, lo: b, ret: r} SHurwiczGE,
    f = {alpha: a, hi: b, ret: r} SHurwiczLE
    |- false;

  // The attitude weight is a genuine mixture weight: both extreme
  // passes enter the blend with nonnegative coefficient, which is
  // what the derived discharge leans on. Non-strict at both ends —
  // the endpoints are the degenerate-consistency cases.
  report ax/wf/hurwicz_ge_alpha_range : forall h : AttitudeSpec, a : Q,
      b : Q, r : PathObservable.
    h = {alpha: a, lo: b, ret: r} SHurwiczGE
    |- {l: 0, r: a} q_le, {l: a, r: 1} q_le;

  report ax/wf/hurwicz_le_alpha_range : forall h : AttitudeSpec, a : Q,
      b : Q, r : PathObservable.
    h = {alpha: a, hi: b, ret: r} SHurwiczLE
    |- {l: 0, r: a} q_le, {l: a, r: 1} q_le;

  // ==========================================================
  // The hard former: level probes
  // ==========================================================
  //
  // A level probe bounds the expectation of a PathObservable over every
  // admitted law whose penalty is finite and at most the threshold.
  // The threshold is an extended rational: at a finite threshold the
  // finiteness clause is redundant; at infinity the quantifier
  // ranges over the whole support, and that instance is the
  // possibilistic face of the satisfaction judgment. Every rung of
  // the threshold ladder is a lawful probe, so the threshold carries
  // no positivity premise beyond the sort's own.

  SLevelGE : {lo: Q, ret: PathObservable, thr: EnnRat} -> ForallSpec;
  SLevelLE : {hi: Q, ret: PathObservable, thr: EnnRat} -> ForallSpec;

  refuse ax/qtsl/level_ge_le_disjoint : forall b : Q, r : PathObservable,
      t : EnnRat, f : ForallSpec.
    f = {lo: b, ret: r, thr: t} SLevelGE,
    f = {hi: b, ret: r, thr: t} SLevelLE
    |- false;

  // The level marks (the grid-completion pair): SOME full-mass
  // admitted law within the penalty threshold attains the stated
  // side of the bound — the level stratum's possibility marks, read
  // exactly as the Prob/Return marks. At thr = infinity the
  // quantifier ranges over the support, so the mark asserts
  // attainment by some not-fully-refused behaviour law. With these
  // two the mark roster is polarity-total: each threshold family
  // (Prob, Return, Level) presents both faces.

  SLevelMayBeGE : {lo: Q, ret: PathObservable, thr: EnnRat} -> ExistsSpec;
  SLevelMayBeLE : {hi: Q, ret: PathObservable, thr: EnnRat} -> ExistsSpec;

  refuse ax/qtsl/level_maybe_ge_le_disjoint : forall b : Q,
      r : PathObservable, t : EnnRat, e : ExistsSpec.
    e = {lo: b, ret: r, thr: t} SLevelMayBeGE,
    e = {hi: b, ret: r, thr: t} SLevelMayBeLE
    |- false;

  // ==========================================================
  // The probability family, harmonized
  // ==========================================================
  //
  // Four orientations of one species. Each is an alias of the
  // corresponding return former at the path indicator — an event
  // probability is the expectation of an indicator gamble — and the
  // alias ties are denotation lemmas at the mechanized stratum,
  // never chase equations: hash-consed constructor images stay
  // disjoint, and the elaboration is computed where consumed. Under
  // the grid the alias is a commuting triangle through retPath, and
  // both sides of each tie carry the same face, so the ties survive
  // the re-homing untouched.
  //
  // Threshold canonicity per orientation: (0, 1] on the GE faces,
  // [0, 1) on the LE faces. The excluded end of each re-spells a
  // structural atom (the unit atom, or the properness mark itself).

  SProbGE      : {p: Q, path: PathPred} -> ForallSpec;
  SProbLE      : {q: Q, path: PathPred} -> ForallSpec;
  SProbMayBeGE : {p: Q, path: PathPred} -> ExistsSpec;
  SProbMayBeLE : {q: Q, path: PathPred} -> ExistsSpec;

  report ax/wf/prob_range : forall p : Q, ps : PathPred, f : ForallSpec.
    f = {p: p, path: ps} SProbGE
    |- {l: 0, r: p} q_lt, {l: p, r: 1} q_le;

  report ax/wf/prob_le_range : forall q : Q, ps : PathPred, f : ForallSpec.
    f = {q: q, path: ps} SProbLE
    |- {l: 0, r: q} q_le, {l: q, r: 1} q_lt;

  report ax/wf/prob_maybe_ge_range : forall p : Q, ps : PathPred, f : ExistsSpec.
    f = {p: p, path: ps} SProbMayBeGE
    |- {l: 0, r: p} q_lt, {l: p, r: 1} q_le;

  report ax/wf/prob_maybe_le_range : forall q : Q, ps : PathPred, f : ExistsSpec.
    f = {q: q, path: ps} SProbMayBeLE
    |- {l: 0, r: q} q_le, {l: q, r: 1} q_lt;

  refuse ax/qtsl/prob_ge_le_disjoint : forall t : Q, ps : PathPred,
      f : ForallSpec.
    f = {p: t, path: ps} SProbGE,
    f = {q: t, path: ps} SProbLE
    |- false;

  // ==========================================================
  // The initial-state injection
  // ==========================================================
  //
  // The honest name for what the earlier edition attached silently
  // to a bare region at spec root: SInit(phi) reads "every admitted
  // initial state satisfies phi" — the forall-face reading, one
  // visible former. The bare feasibility spec is a record holding
  // SInit(STrue) alone, its properness mark carried by the judgment.
  // The ExistsSpec twin the earlier edition left as a visibly open
  // cell is CLAIMED at revision event 6: SProper below.

  SInit : {arg: StatePred} -> ForallSpec;

  refuse ax/qtsl/sinit_prob_disjoint : forall a : StatePred, p : Q,
      ps : PathPred, f : ForallSpec.
    f = {arg: a} SInit, f = {p: p, path: ps} SProbGE
    |- false;

  // The properness twin (revision event 6): "some admitted initial
  // state" — anchored at x, some admitted law from x at FINITE
  // penalty: the support face's nonemptiness, never the zero face
  // (a subject whose laws all carry positive finite penalty is
  // live, not bricked). Minted so every verdict entry is a
  // (component, region) citation and the credal comparison
  // morphism has zero exceptional arms; minting now is free while
  // the verdict stratum is corpus-free — upgrading later is a
  // migration. Consumable by authored specs (harmless,
  // forward-compatible); emitted by the record compile
  // unconditionally (the compile re-aims from the structural mark
  // to the (SProper, region) entry — the verdict form below).
  // Either way the finite-penalty-mass WITNESS stays a
  // grounded-walk obligation: the twin improves uniformity, it
  // does not supply evidence.

  SProper : ExistsSpec;

  refuse ax/qtsl/sproper_return_maybe_disjoint : forall b : Q,
      r : PathObservable, e : ExistsSpec.
    e = SProper, e = {lo: b, ret: r} SReturnMayBeGE
    |- false;

  // The credal formers' old nonbase family (probability, return,
  // level, attitude memberships) retired whole with the re-homing:
  // none of those formers inhabits StatePred, so the refinement has
  // nothing to say about them — mis-faced consumption is a
  // formation error now, not a derived-membership query.

  // ==========================================================
  // Transcendental drift terms
  // ==========================================================
  //
  // One term contributes coeff(x) * func(x_arg) to one drift
  // component. The leaf argument is a bare variable index: the
  // enclosure certifier's interval discipline reads exactly that
  // shape, and a composed argument would be a different former.

  TranscFunc : Set;   // enumeration: exp | sin | cos
  TranscTerm : Set;
  TranscList : Set;

  tfExp : TranscFunc;
  tfSin : TranscFunc;
  tfCos : TranscFunc;

  mkTranscTerm : {arg: Nat, coeff: Poly, component: Nat, func: TranscFunc}
    -> TranscTerm;

  tlNil  : TranscList;
  tlCons : {head: TranscTerm, tail: TranscList} -> TranscList;

  // ==========================================================
  // Multi-driver noise
  // ==========================================================
  //
  // One Noise value per independent Brownian driver; its field is
  // the driver's sigma COLUMN, exact-rational, entries polynomial
  // (state-dependent sigma is representable as written). The
  // diffusion matrix a = sum of sigma sigma-transposed over drivers
  // is derived where consumed, never stored. Driver order and
  // multiplicity are load-bearing — two drivers with equal columns
  // are physically distinct sources whose contributions add — so the
  // driver roster is a list, and the compiled generator map keys
  // driver slots by position in it.

  Noise : Set;
  NoiseList : Set;

  mkNoise : {col: PolyVec} -> Noise;

  nlNil  : NoiseList;
  nlCons : {head: Noise, tail: NoiseList} -> NoiseList;

  // ==========================================================
  // Noise spectra (the jet stratum's stochastic complement)
  // ==========================================================
  //
  // Driver shapes are finite exact-rational combinations of the
  // declared domain's ORTHONORMAL Fourier basis. Orthonormality is
  // load-bearing for exactness: raw cosine norms would carry pi,
  // while in orthonormal coordinates the derived identities and
  // Parseval on trigonometric polynomials hold exactly over the
  // rationals. The covariance is derived, never stored. The sine at
  // mode zero names the zero function (representable, massless); the
  // cosine at mode zero is the mean mode, whose admissibility is the
  // checker's business, not the manifest's.

  FourierKind : Set;
  fkSin : FourierKind;
  fkCos : FourierKind;

  FourierTerm     : Set;
  FourierTermList : Set;

  mkFourierTerm : {coeff: Q, kind: FourierKind, mode: Nat}
    -> FourierTerm;

  ftNil  : FourierTermList;
  ftCons : {head: FourierTerm, tail: FourierTermList}
    -> FourierTermList;

  // A driver pairs a spatial shape with an amplitude. The amplitude
  // is typed as a polynomial over the jet space so that
  // multiplicative noise is a fence lift rather than a schema
  // change; the additive-noise restriction (constant amplitude) is
  // preset business, never a schema axiom, because polynomials are
  // opaque constructor data here.

  Driver     : Set;
  DriverList : Set;

  mkDriver : {amp: Poly, shape: FourierTermList} -> Driver;

  drNil  : DriverList;
  drCons : {head: Driver, tail: DriverList} -> DriverList;

  // The tail form says what lies beyond the explicit drivers, in
  // exactly one of three shapes. There is deliberately no fourth
  // "absent" shape and no default: a missing tail reading as "tail
  // is zero" would silently convert a trace-class or cylindrical
  // declaration into a finite-rank one and understate the floor.
  // Finite rank is SAID, by tailZero, never implied by silence. A
  // consumer needing a plain trace refuses the divergent form; the
  // mode-resolved reading is the only road through it.

  TailForm : Set;

  tailZero      : TailForm;
  tailBracket   : {hi: Q, lo: Q} -> TailForm;   // rational tail-trace
                                                // enclosure [lo, hi]
  tailDivergent : TailForm;

  report ax/wf/tail_bracket_order : forall lo : Q, hi : Q, t : TailForm.
    t = {hi: hi, lo: lo} tailBracket
    |- {l: lo, r: hi} q_le;

  refuse ax/jet/tail_zero_bracket_disjoint : forall lo : Q, hi : Q,
      t : TailForm.
    t = tailZero, t = {hi: hi, lo: lo} tailBracket
    |- false;

  // A spectrum without a declared tail is unrepresentable at the
  // sort level: the tail field is constructor-required, so no
  // presence check exists to forget.
  NoiseSpectrum : Set;

  mkNoiseSpectrum : {drivers: DriverList, tail: TailForm}
    -> NoiseSpectrum;

  // ==========================================================
  // Jet variables (partial-differential mechanisms as data)
  // ==========================================================
  //
  // A jet variable ties one position of a mode's polynomial index
  // space to a base field variable and a spatial multi-index (the
  // ground Shape sort; higher spatial dimension is representable
  // data). A jet-bearing mode's drift vector is the differential-
  // polynomial mechanism: one drift polynomial per field component,
  // read over the extended index space, state components at
  // derivative order zero first, declared jets after, both
  // positional. Order in the jet roster is therefore load-bearing,
  // and the roster is a list.

  JetVar     : Set;
  JetVarList : Set;

  mkJetVar : {base: Nat, deriv: Shape} -> JetVar;

  jvNil  : JetVarList;
  jvCons : {head: JetVar, tail: JetVarList} -> JetVarList;

  refuse ax/jet/jv_nil_cons_disjoint : forall h : JetVar, t : JetVarList,
      l : JetVarList.
    l = jvNil, l = {head: h, tail: t} jvCons
    |- false;

  // ==========================================================
  // Step outcomes and kernel citations
  // ==========================================================
  //
  // The tagged one-step alphabet: a kernel application lands on
  // `next` (with a reset map and its landing enclosure), `stay` (the
  // lazy self-loop — generator-invisible, grading-visible, so mass
  // names itself), or `cemetery` (trajectory death as an explicit
  // outcome). Sub-stochastic deficit is unrepresentable: all mass is
  // explicitly named, and a pure-kill step is a weight-one cemetery
  // branch.
  //
  // A tier-two kernel citation names a kernel-flavor hypernet by
  // digest together with its wire roles: the noise roster (input
  // positions typed as fresh uniform draws — a strictly ascending
  // Shape, the canonical set representative), the three one-hot tag
  // OUTPUT positions (role-ordered, hence three natural-number
  // fields and deliberately not a Shape, whose wire connotes
  // sortedness), the payload as the remaining outputs in order, and
  // the payload's landing enclosure, consumed by reachable-set
  // closure and the demonic face.
  //
  // Conformance family C-JD-KCITE — noise roster strictly ascending
  // within the digest's input arity; tag positions within the output
  // arity; tag wires one-hot Boolean-typed; payload positional —
  // is the citation's admission side-condition below, checked where
  // the cited content is reachable.

  StepRes        : Set;
  StepBranchList : Set;
  KernelCite     : Set;

  srNext : {image: Box, reset: PolyVec} -> StepRes;
  srStay : StepRes;
  srCemetery : StepRes;

  sbNil  : StepBranchList;
  sbCons : {step: StepRes, tail: StepBranchList, weight: Q}
    -> StepBranchList;

  mkKernelCite : {cemetery: Nat, hypernet: HypernetRef, image: Box,
                  next: Nat, noise: Shape, stay: Nat} -> KernelCite;

  // Branch weights are strictly positive convex coefficients: a
  // zero-weight branch is a non-row (drop it; the generator's
  // linearity gives the same denotation), and admitting one would
  // smuggle its mandatory image into the reachable-set closure.
  report ax/wf/branch_weight_range : forall s : StepRes, bt : StepBranchList,
      w : Q, bl : StepBranchList.
    bl = {step: s, tail: bt, weight: w} sbCons
    |- {l: 0, r: w} q_lt, {l: w, r: 1} q_le;

  // Tag channels are pairwise distinct. Binding one variable to two
  // fields premises their equality, so each axiom names one
  // coincidence and refuses it.
  refuse ax/wf/kc_tags_next_stay : forall c : Nat, h : HypernetRef, b : Box,
      n : Nat, no : Shape, k : KernelCite.
    k = {cemetery: c, hypernet: h, image: b, next: n, noise: no,
         stay: n} mkKernelCite
    |- false;

  refuse ax/wf/kc_tags_next_cemetery : forall h : HypernetRef, b : Box,
      n : Nat, no : Shape, st : Nat, k : KernelCite.
    k = {cemetery: n, hypernet: h, image: b, next: n, noise: no,
         stay: st} mkKernelCite
    |- false;

  refuse ax/wf/kc_tags_stay_cemetery : forall h : HypernetRef, b : Box,
      nx : Nat, no : Shape, n : Nat, k : KernelCite.
    k = {cemetery: n, hypernet: h, image: b, next: nx, noise: no,
         stay: n} mkKernelCite
    |- false;

  // The citation's roster and arity discipline (C-JD-KCITE), as an
  // admission demand per citation.
  qtsl_kcite_wf : {k: KernelCite} -> Prop;   // side-condition

  report ax/wf/kcite_wf : forall k : KernelCite.
    |- {k: k} qtsl_kcite_wf;

  refuse ax/qtsl/stay_cemetery_disjoint : forall p : StepRes.
    p = srStay, p = srCemetery
    |- false;

  refuse ax/qtsl/sb_nil_cons_disjoint : forall s : StepRes,
      bt : StepBranchList, w : Q, bl : StepBranchList.
    bl = sbNil, bl = {step: s, tail: bt, weight: w} sbCons
    |- false;

  // ==========================================================
  // The stochastic-matrix generator
  // ==========================================================
  //
  // Honestly tabular kernel content: a tensor of transition
  // probabilities over factored finite input and output wire
  // blocks. The extent tuples are data (the positional reading of
  // the ground Shape sort), so the general many-in, many-out form
  // is representable without dependent record arities; per-position
  // typing of the wires demotes to admission conformance. Entity-
  // like, deliberately: a matrix's identity is its entries, which
  // are rows about it — a constructor keyed on the shape pair alone
  // would identify all equal-shaped matrices.
  //
  // Zero entries are absent (sparsity is the representation). Mass
  // discipline is exactly-one per input point over the full output
  // block; a sub-stochastic matrix is not a row-deficient one but
  // an explicit cemetery column in the output alphabet. Genuinely
  // large or continuous kernels do not belong here — they ride the
  // kernel citation above.
  //
  // Conformance families, realized as the admission demand below:
  //   C-SM-SHAPE    — both extent attributes present, every extent
  //                   strictly positive.
  //   C-SM-INDEX    — per entry: index widths match the extents,
  //                   every index position strictly below its
  //                   extent.
  //   C-SM-ROWSTOCH — for every input point, the stored entries
  //                   total exactly one over the output block;
  //                   an input point with no rows is mass zero,
  //                   refused, so the row count is at least the
  //                   input product — the honest size of tabular
  //                   content.

  StochMat : Set;   // entity-like: identity is the entries

  StochMat/inputs  : StochMat -> Shape;  // input extents
  StochMat/outputs : StochMat -> Shape;  // output extents

  smProb : {inIdx: Shape, mat: StochMat, outIdx: Shape} -> Q;

  report ax/wf/sm_entry_range : forall i : Shape, m : StochMat, o : Shape,
      v : Q.
    v = {inIdx: i, mat: m, outIdx: o} smProb
    |- {l: 0, r: v} q_lt, {l: v, r: 1} q_le;

  qtsl_sm_shape    : {mat: StochMat} -> Prop;   // side-condition
  qtsl_sm_index    : {mat: StochMat} -> Prop;   // side-condition
  qtsl_sm_rowstoch : {mat: StochMat} -> Prop;   // side-condition

  report ax/wf/sm_shape : forall m : StochMat.
    |- {mat: m} qtsl_sm_shape;

  report ax/wf/sm_index : forall m : StochMat.
    |- {mat: m} qtsl_sm_index;

  report ax/wf/sm_rowstoch : forall m : StochMat.
    |- {mat: m} qtsl_sm_rowstoch;

  // ==========================================================
  // Modes and manifests (the hybrid/continuous content language)
  // ==========================================================
  //
  // A manifest is a mode lattice over named variables. Its mode
  // roster is an ordered list — order is load-bearing, because a
  // mode's position is its variant index wherever a composite or a
  // transition names one variant of the lattice — and its variable
  // names are positional against every polynomial index space.
  //
  // A mode's attributes split by totality. Every mode is named,
  // carries a chart domain, and carries a drift vector (a driftless
  // mode declares the zero vector, which is representable); those
  // three stay functions. Everything else is profile content a mode
  // may lawfully lack — stochastic form, transcendental terms, jet
  // roster, native hypernet references — and rides relation rows.
  // A mode declares its stochastic content in at most ONE of three
  // forms (a single diffusion column, a multi-driver roster, or a
  // spectral declaration at jet grain): declaring two would state
  // the same physics twice, and the pairwise refusals below gate it.
  //
  // What no longer lives here: jump content and switch structure.
  // Both were mode-attached in an earlier staging of this
  // vocabulary; they are one abstraction — the Transition former
  // below — attached at the System stratum, with the mode's variant
  // index as the transition's grain. The mode stratum keeps the
  // continuous families only.
  //
  // Conformance family C-MODE (admission, per mode): at most one
  // row per mode in each of the profile families below.

  Mode     : Set;   // entity: one mode of a lattice
  ModeList : Set;
  Manifest : Set;   // entity: one declared model manifest

  Mode/name   : Mode -> Str;
  Mode/domain : Mode -> Box;
  Mode/drift  : Mode -> PolyVec;

  mode_diffusion : {mode: Mode, col: PolyVec} -> Prop;
      // the single-driver form: one sigma column
  mode_noise : {mode: Mode, drivers: NoiseList} -> Prop;
      // the multi-driver form: the ordered driver roster
  mode_noise_spectrum : {mode: Mode, spectrum: NoiseSpectrum} -> Prop;
      // the jet-grain spectral form
  mode_drift_transc : {mode: Mode, terms: TranscList} -> Prop;
      // transcendental drift terms (a list: term multiplicity
      // contributes additively)
  mode_jet_vars : {mode: Mode, vars: JetVarList} -> Prop;
      // present = the mode's polynomial index space extends its
      // variables by the declared jets, positionally
  mode_drift_hypernet : {mode: Mode, ref: HypernetRef} -> Prop;
      // native hypernet drift; where a polynomial view is also
      // present, agreement is a recompute obligation
  mode_diffusion_hypernet : {mode: Mode, ref: HypernetRef} -> Prop;

  refuse ax/wf/noise_excl_diff_multi : forall m : Mode, d : PolyVec,
      nl : NoiseList.
    {mode: m, col: d} mode_diffusion, {mode: m, drivers: nl} mode_noise
    |- false;

  refuse ax/wf/noise_excl_diff_spectrum : forall m : Mode, d : PolyVec,
      ns : NoiseSpectrum.
    {mode: m, col: d} mode_diffusion,
    {mode: m, spectrum: ns} mode_noise_spectrum
    |- false;

  refuse ax/wf/noise_excl_multi_spectrum : forall m : Mode, nl : NoiseList,
      ns : NoiseSpectrum.
    {mode: m, drivers: nl} mode_noise,
    {mode: m, spectrum: ns} mode_noise_spectrum
    |- false;

  qtsl_mode_wf : {mode: Mode} -> Prop;   // side-condition (C-MODE)

  report ax/wf/mode_wf : forall m : Mode.
    |- {mode: m} qtsl_mode_wf;

  mlNil  : ModeList;
  mlCons : {head: Mode, tail: ModeList} -> ModeList;

  Manifest/name     : Manifest -> Str;
  Manifest/varnames : Manifest -> StrList;
  Manifest/modes    : Manifest -> ModeList;   // ordered: position is
                                              // the variant index

  // ==========================================================
  // Transitions: one abstraction for switch edges, jump kernels,
  // and marked-population events
  // ==========================================================
  //
  // A transition attached to a System specifies a kernel over the
  // system's state: state wires and noise wires in; one-hot
  // next/stay/cemetery tags, successor payload, and a landing
  // enclosure out. WHEN the kernel is consulted is the transition's
  // CLOCK — on the race wing, race an exponential clock at the
  // majorant rate; when it rings at a state, sample the kernel: on
  // next, jump to the payload; on stay, do nothing (the ring was
  // thinned away); on cemetery, die. On the demonic wing there is
  // no timing LAW: whether, when, and (at tuple grains) on which
  // selected tuple the kernel is consulted belongs to the demonic
  // scheduler — under one timing FLOOR, the declared minimum
  // contiguous dwell within the guard before each fire. On the
  // forced wing the timing is a deterministic delay: the kernel is
  // consulted at exactly the declared dwell of contiguous in-guard
  // time. On the carved-window wing (revision event 5) the kernel
  // is consulted at a scheduler-chosen contiguous in-guard dwell
  // inside [floor, ceil] (and inside the gate's sign-fiber where a
  // gate row is present); at a FINITE ceiling reached in-guard the
  // consultation is forced — the forced wing's own law at the
  // window's top.
  //
  //   * ENABLING IS DERIVED — there is no guard field. The active
  //     region is the kernel's non-stay support; a separate guard
  //     could disagree with it, and that disagreement was the
  //     half-bakedness this former replaces.
  //   * INSTANT IS A LIMIT, not a species: an infinite majorant
  //     fires instantly on the active region, and the GSHS
  //     forced-crossing trigger is the infinite-majorant transition
  //     whose gate is domain exit. (The FORCED wing below is a
  //     different object — deterministic delay, never instant: its
  //     dwell is strictly positive.)
  //   * RATES ARE THINNING: the effective jump rate is the majorant
  //     times the non-stay mass, state dependence living inside the
  //     kernel where the landed jump vocabulary always kept it.
  //   * THE CLOCK is the plane discriminator, one constructor split,
  //     five-valued (revision event 5 added the window wing):
  //     tkRace at a finite majorant contributes a
  //     generator term; tkRace at the infinite majorant contributes
  //     none and rides the boundary plane; tkDemonic contributes NO
  //     generator term and NO boundary cascade — its content enters
  //     judgments only through the step relation (inductive and
  //     seam obligations) and its image through the reachable-set
  //     closure; tkForced likewise contributes no generator term
  //     and no instant cascade — a deterministic timer (the GSHS
  //     encoding: a unit-drift meter hitting its threshold), its
  //     firings structurally capped by the strict dwell floor;
  //     tkCarved contributes no generator term and no instant
  //     cascade either — a window-scheduled timer (the demonic seat
  //     resolves WHICH in-window dwell, the forced law fires it at a
  //     finite ceiling), its firings structurally capped by the
  //     strict window floor. The
  //     discriminator is syntactic, never an oracle call.
  //
  // The former is entity-like: a transition's identity is the
  // element, never its content. Two content-equal transitions
  // attached to one system race, and their rates add; a value
  // spelling would merge them and silently halve rates.
  //
  // The GRAIN names which wire presentation of the system's state
  // the kernel consumes: the whole coordinate block, one variant's
  // payload, a selected tuple with its declared features (the
  // marked-population case — a count is the constant-one feature
  // aggregated by sum, an ordinary member of the declared feature
  // dictionary), or a nested path of selections.
  //
  // Kernel content comes in two exclusive presentations, one per
  // transition: a native kernel citation, or the polynomial scale
  // view (a rate observable and a mass-one tagged mixture of
  // polynomial resets) that elaborates definitionally into the
  // thinning normal form. The elaboration digest is derived, never
  // stored.
  //
  // Conformance families (admission demands below):
  //   C-TR-CONTENT — exactly one content presentation per
  //                  transition (the pairwise refusal gates
  //                  co-presence; presence is the counting half).
  //   C-TR-GRAIN   — the kernel's input block matches the grain's
  //                  wire list against the attached system's state
  //                  type; noise roster per the citation
  //                  discipline.
  //   C-TR-ENDO    — the next payload is typed at the attached
  //                  system's state (variant-crossing jumps are
  //                  ordinary next outcomes at the sigma-typed
  //                  grains).
  //   C-JD-MASSONE — per scale view, the branch weights total
  //                  exactly one (whole-list arithmetic stays at
  //                  the evaluator; deficit has no representation,
  //                  and the pure-kill spelling is a weight-one
  //                  cemetery branch).
  //
  // A monotone-enabledness family on marked-population attachments
  // (the inhibitor question) is deliberately NOT declared yet: the
  // design decision is pending, and the slot is named here so its
  // arrival is an addition, not a redesign.

  SelSpec     : Set;   // one per-place tuple pre-selection
  SelSpecList : Set;   // ordered: positions index the selected tuple

  selMk : {consume: Nat, place: Nat, read: Nat} -> SelSpec;

  sslNil  : SelSpecList;
  sslCons : {head: SelSpec, tail: SelSpecList} -> SelSpecList;

  refuse ax/qtsl/ssl_nil_cons_disjoint : forall h : SelSpec,
      t : SelSpecList, l : SelSpecList.
    l = sslNil, l = {head: h, tail: t} sslCons
    |- false;

  TrGrain : Set;

  grWhole   : TrGrain;                        // the coordinate block
  grVariant : {ix: Nat} -> TrGrain;           // one variant's payload
  grTuple   : {pre: SelSpecList} -> TrGrain;  // selected tuple with
                                              // declared features
  grPath    : {inner: TrGrain, outer: TrGrain} -> TrGrain;
                                              // nested selection

  refuse ax/qtsl/gr_whole_variant_disjoint : forall i : Nat, g : TrGrain.
    g = grWhole, g = {ix: i} grVariant
    |- false;

  // The transition clock (the hybrid-time seam, four wings), and
  // the wing split carries the whole plane discipline (the header
  // bullet above). STATUS of the semantics clauses in this block:
  // they are the DECLARED evaluator/Lean semantics — this revision
  // mints their data, floors, and conformance demands; the meter
  // discharge, the counting bounds, and the glue lemmas are the
  // proof tier's, owed and tracked, not established by these rows.
  //
  //   * tkRace {majorant} — the racing stratum, status quo verbatim:
  //     finite majorants are generator-plane content via the
  //     thinning identity; the infinite majorant is the instant-fire
  //     boundary stratum.
  //   * tkDemonic {dwellMin} — the demonic scheduler's seat. Same
  //     element roster as the instant guard transition (grain,
  //     kernel content, attachment, conformance all unchanged); no
  //     timing LAW, but a timing FLOOR carried in the System
  //     definition: the scheduler may fire the row only after
  //     dwellMin of CONTIGUOUS dwell within its guard range (the
  //     active region). The meter resets on guard exit —
  //     exit-and-reenter starts over — and at the transition's OWN
  //     firing, so a self-looping in-guard row re-buys its dwellMin
  //     at every fire. dwellMin is strictly positive (the report
  //     row below), which makes the wing Zeno-incapable by
  //     construction: for a finite conforming roster, under the
  //     declared meter semantics, a row with floor d fires at most
  //     T/d + 1 times by horizon T, under EVERY resolution —
  //     arithmetic once the meter discharge lands, not a
  //     certificate. Ordinary place/transition Petri nets are
  //     the all-demonic, Dirac-kernel, unit-colour case at uniform
  //     dwellMin = 1: the discrete-time unfolding of the net,
  //     embedded in the continuous-time frame with unit dwell —
  //     faithful for ordering-and-counting properties, deliberately
  //     not for metric-time properties an untimed net never had.
  //   * tkForced {dwell} — the deterministic-delay wing: the row
  //     fires at EXACTLY dwell d of contiguous in-guard dwell, by
  //     itself, on both faces (quantifier-free: no scheduler seat,
  //     no rate — every judgment sees the same firing; for the
  //     angelic family below, a forced row supplies the non-Zeno
  //     timing leg of a selection, with cover, attachment,
  //     enabledness, and closure still owed as its rows demand).
  //     Same meter law as dwellMin: guard exit resets the
  //     clock, and so does the row's own firing. Preemption is
  //     guard-reset: whatever fires first wins, and a firing that
  //     resets the guard resets the forced clock with it.
  //     Same-instant forced-vs-forced ties resolve through the
  //     demonic seat — the scheduler seat inherits measure-zero
  //     coincidences, so determinism holds up to scheduler exactly
  //     where classical deterministic-net treatments need an ad-hoc
  //     tie-breaking convention. This wing completes the DSPN
  //     triple — exponential (tkRace at a finite majorant),
  //     immediate (tkRace at the infinite majorant), deterministic
  //     delay (tkForced) — so deterministic and stochastic Petri
  //     nets land whole: watchdogs, timeouts, and protocol timers
  //     are native rows.
  //
  // Zeno accounting, whole-former: with every dwell/window floor
  // strictly positive (demonic, forced, and carved-window wings
  // alike), the syntactically visible Zeno engine in this
  // vocabulary — for a finite CONFORMING roster (the totality and
  // closure rows below are what "conforming" costs), under the
  // declared meter semantics — is exactly ONE: unbounded instant
  // chains (tkRace at the infinite majorant), priced by the
  // crossing budgets below. Non-Zeno everywhere else is mechanism
  // inspection, and a certificate is owed only where the syntax
  // shows the engine.
  //
  // The scheduler is a nondeterminism source with a structurally
  // forced binding time (step-bound), anchored at the per-former
  // transcription legs like the jitter clock's per-tick draw — so
  // certificate families cannot split over it (the axis_step
  // refusal below), which is the forall-scheduler uniformity of
  // every in-scope judgment, enforced by the existing refusal
  // rather than by a new connective. A demonic envelope stays a
  // consuming rule's cellwise reading of the scheduler seat, never
  // an interface object — deliberate idling is a member of the
  // seat, which is the family-level liveness refusal.
  //
  // Deliberately absent, each absence load-bearing:
  //   * no fairness, priority, or weight fields on tkDemonic —
  //     liveness vocabulary; the seat's idling member is the honest
  //     current semantics;
  //   * no capped-demonic wing (a scheduler under an intensity
  //     bound): imprecise-rate transitions are real mathematics
  //     with no settled semantics here; they arrive, if ever, as an
  //     additive constructor, never by reinterpreting tkDemonic;
  //   * no zero and no infinite floors: dwellMin = 0 (a chattering
  //     scheduler) and dwell = 0 (a second, unpriced instant
  //     species) are excluded by the strict report rows below, and
  //     dwellMin at the infinite majorant is the demonic wing's
  //     dead point — a row that can never fire, refused below for
  //     the same reason the race wing reports away rate zero;
  //   * no non-Zeno gate on the demonic, forced, or carved-window
  //     wings: safety-class judgments never consume one, all three
  //     are structurally rate-capped by their strict floors, and
  //     crossing budgets (below) price the instant stratum — a
  //     budget slot on these strata would be a type error.

  TrClock : Set;

  tkRace    : {majorant: EnnRat} -> TrClock;
  tkDemonic : {dwellMin: EnnRat} -> TrClock;
  tkForced  : {dwell: Q} -> TrClock;

  // The carved-window wing (revision event 5): the
  // row may fire at any CONTIGUOUS in-guard dwell t with floor <= t
  // and t <= ceil where ceil is finite, and t inside the declared
  // gate's sign-fiber where a gate row is present (the gate REFINES
  // the window; it never widens it). WHICH t belongs to the demonic
  // scheduler, per firing, at composite-event granularity; when the
  // meter reaches a FINITE ceil within the guard, the row fires by
  // itself — the forced wing's own law at the window's top, so a
  // finite ceil is a deadline (watchdog windows; maintenance windows
  // via union-of-intervals gates). ceil = enInf keeps the
  // scheduler's idling member — deferral past every horizon is
  // lawful, exactly as on the demonic wing. Same meter law as the
  // sibling wings: guard exit resets, the row's own firing resets;
  // preemption is guard-reset; same-instant ties resolve through the
  // demonic seat. Degeneracies are Lean-tier theorems, never
  // rewrites (the r5 singleton-subsumption pattern): tkCarved{d,
  // enInf} gateless has tkDemonic{d}'s semantics; tkCarved{d,
  // enFin d} has tkForced{d}'s. The sibling wings are NOT retired —
  // this wing is additive, and the common cases keep their
  // one-field spellings. Zeno accounting: the floor is strictly
  // positive (report row below), so the wing is Zeno-incapable by
  // the demonic wing's arithmetic (at most T/floor + 1 fires per
  // horizon under every resolution); the syntactically visible Zeno
  // engine roster is unchanged, and a budget slot here would be the
  // same type error the sibling wings refuse. Certificates: a
  // window row owes the demonic seam obligation and nothing else on
  // the safety face; a FINITE-ceil row additionally supplies a free
  // non-Zeno timing leg to the angelic selection family (dwell
  // bounded by ceil), consumed through the existing witness rows.
  // A finite-ceil row's image is MANDATORY in the reachable-set
  // closure (within its window it CAN fire — and at the ceiling it
  // MUST): dropping it would be unsound exactly as the rate-zero
  // comment names; the dead-row hygiene reports above are about
  // rows that can NEVER fire, and an inverted window (below) is
  // this wing's member of that family.
  tkCarved  : {floor: Q, ceil: EnnRat} -> TrClock;

  refuse ax/qtsl/trclock_wing_disjoint : forall e : EnnRat,
      d : EnnRat, k : TrClock.
    k = {majorant: e} tkRace, k = {dwellMin: d} tkDemonic
    |- false;

  refuse ax/qtsl/trclock_race_forced_disjoint : forall e : EnnRat,
      d : Q, k : TrClock.
    k = {majorant: e} tkRace, k = {dwell: d} tkForced
    |- false;

  refuse ax/qtsl/trclock_demonic_forced_disjoint : forall e : EnnRat,
      d : Q, k : TrClock.
    k = {dwellMin: e} tkDemonic, k = {dwell: d} tkForced
    |- false;

  refuse ax/qtsl/trclock_race_carved_disjoint : forall e : EnnRat,
      fl : Q, ce : EnnRat, k : TrClock.
    k = {majorant: e} tkRace, k = {floor: fl, ceil: ce} tkCarved
    |- false;

  refuse ax/qtsl/trclock_demonic_carved_disjoint : forall d : EnnRat,
      fl : Q, ce : EnnRat, k : TrClock.
    k = {dwellMin: d} tkDemonic, k = {floor: fl, ceil: ce} tkCarved
    |- false;

  refuse ax/qtsl/trclock_forced_carved_disjoint : forall d : Q,
      fl : Q, ce : EnnRat, k : TrClock.
    k = {dwell: d} tkForced, k = {floor: fl, ceil: ce} tkCarved
    |- false;

  // Constructor coverage: every clock is one of the four wings —
  // the pairwise denials above give at-most-one; this row is the
  // presence half. Without it a fresh TrClock element would carry
  // no timing law at all: outside every positivity report, the
  // dead-point refusal, and the crossing-budget seam demand.
  // (The existentials are named apart deliberately, per disjunct: the seal
  // emitter's row encoding scopes evars per disjunct, and same-named
  // evars across disjuncts trip its conformance self-check — minimal
  // repro banked with the event-3 receipts.)
  report ax/wf/trclock_total : forall k : TrClock.
    |- exists er : EnnRat. k = {majorant: er} tkRace
       or exists ed : EnnRat. k = {dwellMin: ed} tkDemonic
       or exists df : Q. k = {dwell: df} tkForced
       or exists cf : Q, cc : EnnRat.
          k = {floor: cf, ceil: cc} tkCarved;

  Transition : Set;   // entity: identity is the element

  // Exactly-one attributes: every consumer — generator readout,
  // boundary rows, crossing budgets — reads both; a transition
  // missing either denotes nothing.
  Transition/grain : Transition -> TrGrain;
  Transition/clock : Transition -> TrClock;

  // The two content presentations.
  ScaleView : Set;

  mkScaleView : {mix: StepBranchList, rate: Poly} -> ScaleView;

  tr_kernel : {tr: Transition, kernel: KernelCite} -> Prop;
  tr_scale  : {tr: Transition, scale: ScaleView} -> Prop;

  refuse ax/wf/tr_content_excl : forall t : Transition, k : KernelCite,
      v : ScaleView.
    {tr: t, kernel: k} tr_kernel, {tr: t, scale: v} tr_scale
    |- false;

  // Attachment is a relation: a system carries zero or more
  // transitions, and one transition may lawfully attach to several
  // systems (its conformance re-checks per attachment).
  sys_transition : {sys: System, tr: Transition} -> Prop;

  // Dead-row hygiene, carried on the race wing verbatim: a rate-zero
  // finite transition is a dead row whose mandatory image would
  // still inflate the reachable-set closure; drop it, same
  // denotation. (A demonic row's image is NOT dead — it can fire;
  // dropping it from the closure would be unsound in exactly the
  // way this row exists to prevent for rate zero.)
  report ax/wf/tr_majorant_pos : forall t : Transition, q : Q,
      e : EnnRat, k : TrClock.
    t Transition/clock = k, k = {majorant: e} tkRace, e = {q: q} enFin
    |- {l: 0, r: q} q_lt;

  // The demonic dwell floor is strictly positive: a zero floor
  // would let the scheduler chatter, and the positive floor IS the
  // wing's Zeno-incapability (the whole-seat counting bound in the
  // former header). Strict by design — never nonstrict.
  report ax/wf/tr_dwellmin_pos : forall t : Transition, q : Q,
      e : EnnRat, k : TrClock.
    t Transition/clock = k, k = {dwellMin: e} tkDemonic,
    e = {q: q} enFin
    |- {l: 0, r: q} q_lt;

  // The demonic wing's dead point: an infinite dwell floor is a row
  // that can never fire (no finite record accumulates an infinite
  // contiguous dwell), yet its mandatory image would still inflate
  // the reachable-set closure — the rate-zero disease one wing
  // over, refused rather than reported because no arithmetic
  // evidence can rescue it. Drop the row; same denotation.
  refuse ax/qtsl/tr_dwellmin_finite : forall t : Transition,
      k : TrClock.
    t Transition/clock = k, k = {dwellMin: enInf} tkDemonic
    |- false;

  // The forced dwell is strictly positive: dwell = 0 would be a
  // second instant species — immediate firing is the instant
  // stratum's job (tkRace at the infinite majorant), and an
  // unpriced deterministic twin would open a Zeno door the
  // crossing-budget seam demand does not reach.
  report ax/wf/tr_forced_dwell_pos : forall t : Transition, d : Q,
      k : TrClock.
    t Transition/clock = k, k = {dwell: d} tkForced
    |- {l: 0, r: d} q_lt;

  // The window floor is strictly positive: a zero floor would let
  // the scheduler chatter — the demonic wing's report row, carried
  // onto the window verbatim.
  report ax/wf/tr_carved_floor_pos : forall t : Transition, fl : Q,
      ce : EnnRat, k : TrClock.
    t Transition/clock = k, k = {floor: fl, ceil: ce} tkCarved
    |- {l: 0, r: fl} q_lt;

  // A finite ceiling sits at or above the floor: floor = ceil is
  // lawful (the forced point); an inverted window is a row that can
  // never fire, whose mandatory image would still inflate the
  // closure — reported away like rate zero, not refused, because
  // the evidence is one rational comparison.
  report ax/wf/tr_carved_window_ordered : forall t : Transition,
      fl : Q, q : Q, ce : EnnRat, k : TrClock.
    t Transition/clock = k, k = {floor: fl, ceil: ce} tkCarved,
    ce = {q: q} enFin
    |- {l: fl, r: q} q_le;

  // Optional gate refinement on the carved wing: a scalar gate over
  // the duration wire, carve = sign-fiber, cited by digest under
  // the SAME qtsl_gate_scalar conformance as every gate citation
  // (the landed genus — reuse, never a new sort; plated gates cite
  // the HPlate aggregate rows the same way). The interval-only case
  // needs no hypernet — floor/ceil are the box carve as data,
  // syntactic where the Zeno and deadline reasoning reads them. In
  // the penalty frame the gate is the {0,inf} face; a graded dwell
  // penalty ("firing early is expensive") is the named softening,
  // design-tense, deliberately not minted.
  tr_dwell_gate : {tr: Transition, gate: HypernetRef} -> Prop;

  // A gate row's subject is a carved-window row: on any other wing
  // the gate would be dead data disagreeing with the clock — the
  // separate-guard disease this wing was built to exclude.
  refuse ax/qtsl/dwell_gate_carved_only_race : forall t : Transition,
      g : HypernetRef, e : EnnRat, k : TrClock.
    {tr: t, gate: g} tr_dwell_gate, t Transition/clock = k,
    k = {majorant: e} tkRace
    |- false;

  refuse ax/qtsl/dwell_gate_carved_only_demonic : forall t : Transition,
      g : HypernetRef, e : EnnRat, k : TrClock.
    {tr: t, gate: g} tr_dwell_gate, t Transition/clock = k,
    k = {dwellMin: e} tkDemonic
    |- false;

  refuse ax/qtsl/dwell_gate_carved_only_forced : forall t : Transition,
      g : HypernetRef, d : Q, k : TrClock.
    {tr: t, gate: g} tr_dwell_gate, t Transition/clock = k,
    k = {dwell: d} tkForced
    |- false;

  // Every dwell gate resolves to a scalar-codomain hypernet — the
  // landed genus conformance, demanded at the citation.
  report ax/wf/dwell_gate_scalar : forall t : Transition,
      g : HypernetRef.
    {tr: t, gate: g} tr_dwell_gate
    |- {gate: g} qtsl_gate_scalar;

  // At most one gate per row is admission conformance (C-TR kin);
  // gate-inside-window — the gate's sign-fiber lies within
  // [floor, ceil] and is nonempty on it — is a side-condition,
  // evaluator-deferred loudly (qtsl_init_member kin):
  qtsl_dwell_gate : {tr: Transition} -> Prop;   // side-condition

  report ax/wf/dwell_gate : forall t : Transition, g : HypernetRef.
    {tr: t, gate: g} tr_dwell_gate
    |- {tr: t} qtsl_dwell_gate;

  qtsl_tr_content : {tr: Transition} -> Prop;             // side-condition
  qtsl_tr_grain   : {sys: System, tr: Transition} -> Prop; // side-condition
  qtsl_tr_endo    : {sys: System, tr: Transition} -> Prop; // side-condition
  qtsl_massone    : {scale: ScaleView} -> Prop;            // side-condition

  report ax/wf/tr_content : forall t : Transition.
    |- {tr: t} qtsl_tr_content;

  report ax/wf/tr_grain : forall s : System, t : Transition.
    {sys: s, tr: t} sys_transition
    |- {sys: s, tr: t} qtsl_tr_grain;

  report ax/wf/tr_endo : forall s : System, t : Transition.
    {sys: s, tr: t} sys_transition
    |- {sys: s, tr: t} qtsl_tr_endo;

  report ax/wf/scale_massone : forall ml : StepBranchList, rp : Poly,
      v : ScaleView.
    v = {mix: ml, rate: rp} mkScaleView
    |- {scale: v} qtsl_massone;

  // ---- the rate cap (revision event 5) ----
  //
  // The scale view elaborates definitionally into the thinning
  // normal form: with probability rate(x)/majorant run the mix,
  // else stay. That elaboration is a KERNEL only where rate(x) <=
  // majorant on the transition's active region — at violating
  // states the branch weights would exceed mass one, and the excess
  // direction has no representation. The obligation was
  // comment-level semantics with no row (the missing-CB-family
  // defect class); this demand is its row. Discharge semantics (the
  // evaluator's, loudly deferred until realized): rate <= majorant
  // on the transition's active region — sound unconditionally, no
  // citation spine. The invariant-scoped weakening (rate <= majorant
  // only on a cited safety-warranted region) is the named additive
  // extension, first-consumer-gated: it adds a warrant spine to a
  // conformance family that otherwise has none. Native-kernel rows
  // owe nothing — their non-stay mass is <= 1 by type.
  qtsl_tr_ratecap : {sys: System, tr: Transition} -> Prop;
      // side-condition

  report ax/wf/tr_ratecap : forall s : System, t : Transition,
      v : ScaleView, k : TrClock, e : EnnRat.
    {sys: s, tr: t} sys_transition, {tr: t, scale: v} tr_scale,
    t Transition/clock = k, k = {majorant: e} tkRace
    |- {sys: s, tr: t} qtsl_tr_ratecap;

  // A scale view on the INSTANT wing is unrepresentable: rate/inf
  // thinning has no reading (the elaborated branch weight is zero —
  // an immediate row that never does anything, or an undefined
  // normal form; neither denotes). Refused rather than documented —
  // measured at the event-5 mint: zero landed consumers carry
  // tr_scale on an enInf clock (fixtures + committed corpora, the
  // S-8 method). A producer wanting instant content presents the
  // kernel directly (tr_kernel), where mass discipline is typed.
  refuse ax/qtsl/tr_scale_race_instant : forall t : Transition,
      v : ScaleView, k : TrClock.
    {tr: t, scale: v} tr_scale, t Transition/clock = k,
    k = {majorant: enInf} tkRace
    |- false;

  // ==========================================================
  // Transition rosters and the firing-count functional
  // ==========================================================
  //
  // A positional carrier of transition citations — the spine the
  // count observable reads. Entity heads in a value-like list ride
  // the QProofList precedent. Duplicate-freedom is whole-list
  // content and rides the roster side-condition at the certificate
  // stratum, never a chased equality; the event-rate envelope
  // formers (SRateLE/SRateGE below, revision event 6) are the
  // spine's rate-stratum co-consumer.

  TrList : Set;

  trlNil  : TrList;
  trlCons : {head: Transition, tail: TrList} -> TrList;

  refuse ax/qtsl/trl_nil_cons_disjoint : forall h : Transition,
      t : TrList, l : TrList.
    l = trlNil, l = {head: h, tail: t} trlCons
    |- false;

  // The count observable: a run functional — the TOTAL number of
  // firings of roster transitions along the run. No horizon, values
  // in [0, inf], the same extended-nonnegative denotation stratum
  // as the running-sup accumulator: an infinite count makes an
  // upper-bound claim FALSE, never ill-formed. Counting is
  // firing-metered per ROSTER MEMBER (schema-level, the
  // grammar-equivariance discipline: one schema, one citation,
  // every extent) — deliberately NOT region-entry counting (that is
  // PCrossStreett's N^R, an omega-premise device) and deliberately
  // NOT the instant-crossing count (CrossBudget's N^f — the Zeno
  // seam's compensator-mass species; different species, not
  // interchangeable). The consuming claim shape this former exists
  // for: SReturnLE {hi: B, ret: {trs: R} retFireCount} — the
  // forall-face count ceiling ("along every admitted law, the total
  // count of R-firings is at most B"), which is what the plated
  // transfer theorem concludes. The >= COUNT face (at least n
  // events — a genuine liveness claim consuming survival mass)
  // remains DELIBERATELY ABSENT; the throughput territory it
  // deferred to is now the rate former SRateGE below (revision
  // event 6) — an envelope on the lower prevision of the count
  // process, never a survival-mass liveness mark.

  retFireCount : {trs: TrList} -> PathObservable;

  // An empty roster is the zero functional — a constant claim in
  // count clothing; canonical form forbids re-spelling (the
  // zero-tick-sum precedent, made structural: blame is local to
  // the constructor).
  refuse ax/qtsl/firecount_nonempty : forall r : PathObservable.
    r = {trs: trlNil} retFireCount
    |- false;

  // Representative constructor-disjointness fixture (the
  // po_int_disc discipline; the full pairwise family is mechanical
  // and rides the admission checklist).
  refuse ax/qtsl/firecount_path_disjoint : forall ts : TrList,
      ps : PathPred, r : PathObservable.
    r = {trs: ts} retFireCount, r = ps retPath
    |- false;

  // Pairing-relative roster conformance (a side-condition at the
  // ground seam, the qtsl_hole_count pattern verbatim): every
  // roster member is a sys_transition row of the paired subject;
  // the roster is duplicate-free (a duplicate double-counts its
  // schema's firings). The demand mints at the certificate stratum,
  // where the pairing is in hand.
  qtsl_firecount_roster : {sys: System, trs: TrList} -> Prop;
      // side-condition

  // ==========================================================
  // The event-rate envelope formers (revision event 6)
  // ==========================================================
  //
  // The from-init affine count envelope over a transition roster —
  // the (rho, sigma) token-bucket pair of the event-rate design
  // (the affine from-init primitive; limsup refused as
  // primitive). SRateLE denotes the region
  //   { x : forall t >= 0,
  //         upper-prevision E_x[N^trs_t] <= rho*t + sigma }
  // and SRateGE its throughput mirror
  //   { x : forall t >= 0,
  //         lower-prevision E_x[N^trs_t] >= rho*t - sigma },
  // where N^trs is the firing-count process of the roster's
  // transitions (the count spine above) — an EXTENDED-NONNEGATIVE
  // process, exactly as the count observable's own comment says:
  // an infinite count makes a finite upper bound FALSE, never
  // ill-formed. Non-explosion is supplied only where a consuming
  // proof route establishes it (the crossing-budget branch prices
  // the one syntactic Zeno engine; dwell floors cap their wings
  // structurally); formation here neither cites nor implies a
  // budget. BOTH faces are floor-claims: each bounds the
  // WHOLE credal body, so both conclude ForallSpec, and the claim
  // DIRECTION selects the envelope (upper bounds read the upper
  // prevision, lower bounds the lower) — certification pessimism
  // on both faces, no attitude knob anywhere. The certified region
  // is a certificate sublevel {V <= sigma}, closed semialgebraic,
  // so the atoms are lawful at positive positions and their
  // complements at negative ones — the region-denotation
  // architecture, unchanged.
  //
  // Free laws (documented here; proofs are one-liners at the
  // mechanized stratum, rule packaging consumer-gated as
  // everywhere):
  //   EQ-R1 (weakening): rho <= rho', sigma <= sigma' gives
  //     SRateLE(rho, sigma, E) contained in
  //     SRateLE(rho', sigma', E) — pointwise on the bound.
  //   EQ-R2 (disjoint-roster sum): disjoint rosters E, E' give
  //     SRateLE_E(rho, sigma) AND SRateLE_E'(rho', sigma')
  //     contained in SRateLE_{E+E'}(rho+rho', sigma+sigma') —
  //     N^{E+E'} = N^E + N^{E'} pathwise, subadditivity of the
  //     upper envelope. The CONVERSE is refused: a sum bound
  //     cannot be split without a per-family certificate
  //     (countermodel: all mass on one family).
  //   EQ-R3 (two-sided gives interval — what keeps from-init
  //     honest): an upper (rho, sigma_u) and a lower (rho,
  //     sigma_l) envelope from init give, PER COMPATIBLE LAW,
  //     E_P[N_{(s,t]}] <= rho*(t-s) + sigma_u + sigma_l for all
  //     0 <= s <= t (subtraction of the two expectation bounds
  //     under one P), with the upper prevision taken last — the
  //     EXPECTATION interval form. The pathwise interval bound is
  //     a separate fact of HARD envelopes only (surely-bounded
  //     counts), never derivable from expectation envelopes: a
  //     single coin-flip firing satisfies (0, 1/2) in expectation
  //     and breaks any pathwise 1/2-count bound. Interval content
  //     is thereby DERIVABLE from two-sided pairs at the tier each
  //     pair lives on, so the from-init primitive loses only
  //     stationarity-based sharpenings (the Harris fence,
  //     deliberately kept).
  //
  // What the family refuses, inherited verbatim from the design:
  // no limsup/ergodic primitive (zero finite-window content is
  // AG-vacuous; the long-run form is derivable sugar) and a
  // fortiori no almost-sure empirical-rate convergence (Harris
  // territory); no stationarity sharpening below sigma_u +
  // sigma_l; JOINT-COLOR model-side rate laws are NOT subsumed —
  // a rate function reading two parties' selected colors jointly
  // is a mechanism-vocabulary gap orthogonal to these spec-side
  // atoms, and nothing here touches it (only finite per-class
  // counts and their additive EQ-R2 sum exist); no within-color
  // order content; no forall-policy or optimality rate claims; no
  // predicate-crossing rates (rosters cite declared transitions BY
  // SORT — crossing multiplicity is unspellable here); no attitude
  // knob. Most are dead by type rather than fenced by oracle: no
  // former exists to spell them.

  SRateLE : {rho: Q, sigma: Q, trs: TrList} -> ForallSpec;
  SRateGE : {rho: Q, sigma: Q, trs: TrList} -> ForallSpec;

  // Envelope parameters are nonnegative rationals (a negative rate
  // or budget is a formation error, not a false claim).
  report ax/wf/srate_le_nonneg : forall rho : Q, sg : Q,
      ts : TrList, f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: ts} SRateLE
    |- {l: 0, r: rho} q_le, {l: 0, r: sg} q_le;

  report ax/wf/srate_ge_nonneg : forall rho : Q, sg : Q,
      ts : TrList, f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: ts} SRateGE
    |- {l: 0, r: rho} q_le, {l: 0, r: sg} q_le;

  // An empty roster is the zero process in envelope clothing —
  // refused at the constructor (the firecount_nonempty pattern
  // verbatim; blame local to the constructor).
  refuse ax/qtsl/srate_le_nonempty : forall rho : Q, sg : Q,
      f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: trlNil} SRateLE
    |- false;

  refuse ax/qtsl/srate_ge_nonempty : forall rho : Q, sg : Q,
      f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: trlNil} SRateGE
    |- false;

  // Both faces land in ONE cap sort, so LE/GE at equal data is a
  // constructor-disjointness refusal (the return_ge_le kin); a
  // representative cross-former fixture rides beside it, the full
  // pairwise family on the admission checklist as everywhere.
  refuse ax/qtsl/srate_ge_le_disjoint : forall rho : Q, sg : Q,
      ts : TrList, f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: ts} SRateLE,
    f = {rho: rho, sigma: sg, trs: ts} SRateGE
    |- false;

  refuse ax/qtsl/srate_return_disjoint : forall rho : Q, sg : Q,
      ts : TrList, b : Q, r : PathObservable, f : ForallSpec.
    f = {rho: rho, sigma: sg, trs: ts} SRateLE,
    f = {hi: b, ret: r} SReturnLE
    |- false;

  // MayBe / grid-completion faces: DELIBERATELY ABSENT. The design
  // names exactly two atoms; a mark-face rate envelope ("some
  // admitted law's expected counts obey the envelope") has no
  // kernel row family and no consumer, and the mark roster's
  // polarity-total discipline is a per-threshold-family fact the
  // count and return families already carry. The absence is a
  // choice on the record, revisited only with a consumer and its
  // own kernel story — a later widening stays additive.

  // ==========================================================
  // Interfaces (the contract stratum systems and specs share)
  // ==========================================================
  //
  // Value-like and hash-consed: two structurally equal interfaces
  // ARE one element, which is what makes "the system's interface
  // equals the specification's interface" a single equality atom at
  // the pairing. Port names are presentation data; position in the
  // in and out lists is what formulas and readouts bind to.
  // Direction is carried by which list a wire sits in, never by a
  // stored polarity. The closed interface is the empty-lists
  // spelling, and hash-consing makes every spelling of it the same
  // element.

  Port      : Set;
  PortList  : Set;
  Iface     : Set;
  IfaceList : Set;

  mkPort : {name: Str, shape: Shape} -> Port;

  ptNil  : PortList;
  ptCons : {head: Port, tail: PortList} -> PortList;

  mkIface : {invars: PortList, outvars: PortList} -> Iface;

  ilNil  : IfaceList;
  ilCons : {head: Iface, tail: IfaceList} -> IfaceList;

  refuse ax/iface/nil_cons_disjoint : forall h : Port, t : PortList,
      l : PortList.
    l = ptNil, l = {head: h, tail: t} ptCons
    |- false;

  // ==========================================================
  // Specifications
  // ==========================================================
  //
  // A specification is an entity packaging FACE COMPONENTS — the
  // record re-sort revision's spelling of the compile target's own
  // algebra: ForallSpec components conjoin invertibly (prevision
  // floors merge by pointwise maximum, one slot), ExistsSpec components aggregate
  // as a list (marks do not merge — no single mark expresses two
  // demands), attitude components render as design scores. The
  // component families are relations, the spec_assume idiom: zero
  // or more rows each, read conjunctively per face. At least one
  // component row per specification (across the three families, or
  // a disjunction row below) is admission conformance — the empty
  // record claims nothing, and the bare feasibility spec is spelled
  // as one SInit(STrue) component. Positional width agreement among
  // components (every component reads the same output-wire block)
  // is arity arithmetic at admission, same family. The root
  // ATTRIBUTE of the earlier edition (Spec/root : Spec -> StateF)
  // retired with the re-sort: a bare-region root was the SInit
  // conflation, and a mixed-face conjunction root is exactly what
  // the record's two lists now spell honestly.
  //
  // Conformance family C-SPEC (admission, per specification):
  // component presence; at most one name/iface/slack row; at most
  // one disjunction row, exclusive with component rows; assumption
  // and interface rows lawful on either shape.
  //
  // A specification still carries NO model binding and no initial
  // data: pairing a specification with its system is the
  // satisfaction judgment's job, and initial conditions are system
  // data. Closed versus open stays an absence distinction: a closed
  // specification has no interface row, and the closed judgment is
  // the empty-interface instance — one judgment kind, no sort split.

  Spec  : Set;   // entity: a named specification
  Slack : Set;   // value-like: a declared candidate gain function;
                 // its membership obligations (zero at zero,
                 // monotone, unbounded) are discharged where the
                 // slack is consumed, never stored

  mkSlack : {gain: Poly} -> Slack;

  spec_forall : {spec: Spec, f: ForallSpec} -> Prop;
      // safety-face components; zero or more, conjoined
  spec_exists : {spec: Spec, e: ExistsSpec} -> Prop;
      // liveness-mark components; zero or more, the mark list
  spec_score : {spec: Spec, h: AttitudeSpec} -> Prop;
      // attitude components; zero or more, each rendering as a
      // design score, never a guarantee
  spec_name : {spec: Spec, name: Str} -> Prop;
      // presentation metadata; at most one per specification is
      // admission conformance
  spec_iface : {spec: Spec, iface: Iface} -> Prop;
      // zero rows = closed; the pairing reads THE interface against
      // the subject's, so at most one is admission conformance
  spec_assume : {spec: Spec, assume: StatePred} -> Prop;
      // zero or more, read conjunctively: each row constrains, and
      // the base-stratum refusal below is row-local either way
  spec_slack : {spec: Spec, slack: Slack} -> Prop;
      // zero rows = qualitative; at most one is admission
      // conformance

  // Spec-level disjunction, admitted at the record TOP: the
  // denotation is the plain union of the two record classes —
  // constructible classes are closed under finite union by
  // definition, so there is nothing to construct and nothing to
  // fear, and the admission never asks the impossible merge (the
  // no-single-floor and no-single-mark facts are about ONE record's
  // slots; a disjunction holds two records side by side under a
  // tag). Discharge is by disjunct selection — rule packaging rides
  // a later event. A disjunction spec carries NO component rows of
  // its own (the refusals below); its class is its arms'. Or-graph
  // acyclicity is admission conformance (C-SPEC), the list-cycle
  // posture.
  spec_or : {spec: Spec, left: Spec, right: Spec} -> Prop;

  refuse ax/wf/spec_or_excl_forall : forall s : Spec, l : Spec,
      r : Spec, f : ForallSpec.
    {spec: s, left: l, right: r} spec_or, {spec: s, f: f} spec_forall
    |- false;

  refuse ax/wf/spec_or_excl_exists : forall s : Spec, l : Spec,
      r : Spec, e : ExistsSpec.
    {spec: s, left: l, right: r} spec_or, {spec: s, e: e} spec_exists
    |- false;

  refuse ax/wf/spec_or_excl_score : forall s : Spec, l : Spec,
      r : Spec, h : AttitudeSpec.
    {spec: s, left: l, right: r} spec_or, {spec: s, h: h} spec_score
    |- false;

  // Assumptions are base-stratum regions over input wires (and
  // timer and schedule parameters): temporal assumptions would
  // reintroduce assume-guarantee circularity and are fenced. A
  // provably nonbase assumption is a load-time contradiction.
  refuse ax/wf/assume_base : forall s : Spec, a : StatePred.
    {spec: s, assume: a} spec_assume, a StatePred/nonbase
    |- false;

  report ax/wf/assume_base_demand : forall s : Spec, a : StatePred.
    {spec: s, assume: a} spec_assume
    |- {f: a} qtsl_base_exact;

  // The component-membership traversal (the derived spec-consumes
  // surface): which cap components a specification consumes,
  // through any depth of disjunction — the machinery every
  // pairing-relative well-formedness demand keys on (the regret
  // formers' hole counting, the firing-count roster conformance,
  // and their successors). Chase walks over producer rows; no walk
  // row mints an element, so the fragment stays terminating by
  // construction.

  spec_consumes : {spec: Spec, f: ForallSpec} -> Prop;
  spec_consumes_mark : {spec: Spec, e: ExistsSpec} -> Prop;
  spec_consumes_score : {spec: Spec, h: AttitudeSpec} -> Prop;
  spec_consumes_ret : {spec: Spec, ret: PathObservable} -> Prop;

  chase ax/spec/consumes_forall : forall s : Spec, f : ForallSpec.
    {spec: s, f: f} spec_forall
    |- {spec: s, f: f} spec_consumes;

  chase ax/spec/consumes_exists : forall s : Spec, e : ExistsSpec.
    {spec: s, e: e} spec_exists
    |- {spec: s, e: e} spec_consumes_mark;

  chase ax/spec/consumes_score : forall s : Spec, h : AttitudeSpec.
    {spec: s, h: h} spec_score
    |- {spec: s, h: h} spec_consumes_score;

  chase ax/spec/consumes_or_left : forall s : Spec, l : Spec,
      r : Spec, f : ForallSpec.
    {spec: s, left: l, right: r} spec_or, {spec: l, f: f} spec_consumes
    |- {spec: s, f: f} spec_consumes;

  chase ax/spec/consumes_or_right : forall s : Spec, l : Spec,
      r : Spec, f : ForallSpec.
    {spec: s, left: l, right: r} spec_or, {spec: r, f: f} spec_consumes
    |- {spec: s, f: f} spec_consumes;

  chase ax/spec/consumes_mark_or_left : forall s : Spec, l : Spec,
      r : Spec, e : ExistsSpec.
    {spec: s, left: l, right: r} spec_or,
    {spec: l, e: e} spec_consumes_mark
    |- {spec: s, e: e} spec_consumes_mark;

  chase ax/spec/consumes_mark_or_right : forall s : Spec, l : Spec,
      r : Spec, e : ExistsSpec.
    {spec: s, left: l, right: r} spec_or,
    {spec: r, e: e} spec_consumes_mark
    |- {spec: s, e: e} spec_consumes_mark;

  chase ax/spec/consumes_score_or_left : forall s : Spec, l : Spec,
      r : Spec, h : AttitudeSpec.
    {spec: s, left: l, right: r} spec_or,
    {spec: l, h: h} spec_consumes_score
    |- {spec: s, h: h} spec_consumes_score;

  chase ax/spec/consumes_score_or_right : forall s : Spec, l : Spec,
      r : Spec, h : AttitudeSpec.
    {spec: s, left: l, right: r} spec_or,
    {spec: r, h: h} spec_consumes_score
    |- {spec: s, h: h} spec_consumes_score;

  // The run-functional projection: which PathObservables a spec's
  // components read — one row per ret-bearing cap former.
  chase ax/spec/ret_return_ge : forall s : Spec, b : Q,
      r : PathObservable, f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {lo: b, ret: r} SReturnGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_return_le : forall s : Spec, b : Q,
      r : PathObservable, f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {hi: b, ret: r} SReturnLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_level_ge : forall s : Spec, b : Q,
      r : PathObservable, t : EnnRat, f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {lo: b, ret: r, thr: t} SLevelGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_level_le : forall s : Spec, b : Q,
      r : PathObservable, t : EnnRat, f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {hi: b, ret: r, thr: t} SLevelLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_return_maybe_ge : forall s : Spec, b : Q,
      r : PathObservable, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark, e = {lo: b, ret: r} SReturnMayBeGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_return_maybe_le : forall s : Spec, b : Q,
      r : PathObservable, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark, e = {hi: b, ret: r} SReturnMayBeLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_level_maybe_ge : forall s : Spec, b : Q,
      r : PathObservable, t : EnnRat, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark,
    e = {lo: b, ret: r, thr: t} SLevelMayBeGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_level_maybe_le : forall s : Spec, b : Q,
      r : PathObservable, t : EnnRat, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark,
    e = {hi: b, ret: r, thr: t} SLevelMayBeLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_hurwicz_ge : forall s : Spec, a : Q, b : Q,
      r : PathObservable, h : AttitudeSpec.
    {spec: s, h: h} spec_consumes_score,
    h = {alpha: a, lo: b, ret: r} SHurwiczGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_hurwicz_le : forall s : Spec, a : Q, b : Q,
      r : PathObservable, h : AttitudeSpec.
    {spec: s, h: h} spec_consumes_score,
    h = {alpha: a, hi: b, ret: r} SHurwiczLE
    |- {spec: s, ret: r} spec_consumes_ret;

  // The path-event projection, and the two nesting arrows walked:
  // run functionals occur inside path events only at the Path-row
  // thresholds (PAtomLE/GE, under any depth of PNotPath), and path
  // events occur inside run functionals only at retPath — so the
  // projection closes the traversal over both indicator arrows, and
  // every reachable PathObservable of a consumed component carries a
  // spec_consumes_ret row. Subterm-directed and element-free: the
  // walk terminates with the chase.
  spec_consumes_path : {spec: Spec, path: PathPred} -> Prop;

  chase ax/spec/path_prob_ge : forall s : Spec, p : Q, ps : PathPred,
      f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {p: p, path: ps} SProbGE
    |- {spec: s, path: ps} spec_consumes_path;

  chase ax/spec/path_prob_le : forall s : Spec, q : Q, ps : PathPred,
      f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {q: q, path: ps} SProbLE
    |- {spec: s, path: ps} spec_consumes_path;

  chase ax/spec/path_prob_maybe_ge : forall s : Spec, p : Q,
      ps : PathPred, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark, e = {p: p, path: ps} SProbMayBeGE
    |- {spec: s, path: ps} spec_consumes_path;

  chase ax/spec/path_prob_maybe_le : forall s : Spec, q : Q,
      ps : PathPred, e : ExistsSpec.
    {spec: s, e: e} spec_consumes_mark, e = {q: q, path: ps} SProbMayBeLE
    |- {spec: s, path: ps} spec_consumes_path;

  chase ax/spec/path_notpath : forall s : Spec, ps : PathPred,
      x : PathPred.
    {spec: s, path: x} spec_consumes_path, x = ps PNotPath
    |- {spec: s, path: ps} spec_consumes_path;

  chase ax/spec/ret_patom_le : forall s : Spec, c : Q,
      r : PathObservable, x : PathPred.
    {spec: s, path: x} spec_consumes_path, x = {c: c, ret: r} PAtomLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_patom_ge : forall s : Spec, c : Q,
      r : PathObservable, x : PathPred.
    {spec: s, path: x} spec_consumes_path, x = {c: c, ret: r} PAtomGE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/path_retpath : forall s : Spec, ps : PathPred,
      r : PathObservable.
    {spec: s, ret: r} spec_consumes_ret, r = ps retPath
    |- {spec: s, path: ps} spec_consumes_path;

  // The roster projection (revision event 6): which transition
  // rosters a spec's components read — the run-functional
  // projection's sibling for roster-carrying cap formers. One row
  // per face. Rosters inside retFireCount observables are already
  // reached through spec_consumes_ret and the firing-count demand
  // at the pairing surface; the two routes converge on ONE demand
  // relation there.
  spec_consumes_trs : {spec: Spec, trs: TrList} -> Prop;

  chase ax/spec/trs_rate_le : forall s : Spec, rho : Q, sg : Q,
      ts : TrList, f : ForallSpec.
    {spec: s, f: f} spec_consumes,
    f = {rho: rho, sigma: sg, trs: ts} SRateLE
    |- {spec: s, trs: ts} spec_consumes_trs;

  chase ax/spec/trs_rate_ge : forall s : Spec, rho : Q, sg : Q,
      ts : TrList, f : ForallSpec.
    {spec: s, f: f} spec_consumes,
    f = {rho: rho, sigma: sg, trs: ts} SRateGE
    |- {spec: s, trs: ts} spec_consumes_trs;

  // The record's own well-formedness walk (side-condition C-SPEC,
  // realized per the header discipline): component presence (at
  // least one component or disjunction row — the empty record
  // claims nothing); at most one name/iface/slack/guard/disjunction
  // row; disjunction exclusive with component rows beyond the
  // refusals' geometric fragment; or-graph acyclicity; and the
  // residual negation-parity walk over each component's formula
  // tree (the typing oracle, re-domained at the record — its old
  // per-root domain retired with Spec/root, and the clauses the
  // grid made unrepresentable retired with it). Demanded per
  // specification, discharged at the ground seam, loudly deferred
  // while unrealized.
  qtsl_spec_wf : {spec: Spec} -> Prop;   // side-condition

  report ax/wf/spec_wf : forall s : Spec.
    |- {spec: s} qtsl_spec_wf;

  // ==========================================================
  // Mechanisms
  // ==========================================================
  //
  // A mechanism is an entity declaring primitive dynamics. Its
  // dynamical content rides exactly one content language: the
  // hybrid/continuous manifest above, or a species field
  // contributed by a frame theory's bridge extension (discrete
  // kernels, chains, nets, structural models — each bridge adds one
  // content family on Mech plus a pairwise exclusivity refusal).
  // There is NO doctrine tag anywhere: "which model class is this"
  // is a query over populated families, because a stored tag is
  // drift risk and makes mixed composites ill-typed. No sort or
  // relation in this file names a model type.
  //
  // Name and interface are total — every mechanism is named and
  // presents an interface, and the wiring walk's completeness
  // consumes the interface obligation (on an interface-less
  // mechanism the interface derivation would silently never fire, a
  // quiet no-match where the theory means a total demand).

  Mech : Set;   // entity: named, owned

  Mech/name  : Mech -> Str;
  Mech/iface : Mech -> Iface;

  mech_manifest : {mech: Mech, manifest: Manifest} -> Prop;
      // the hybrid/continuous content family; two rows would make
      // the generator form ill-posed, so at most one is admission
      // conformance; cross-species exclusivity stays refuse-mode in
      // the bridges
  mech_init_box : {mech: Mech, box: Box} -> Prop;
      // initial conditions, read demonically: several rows read as
      // the demonic union of boxes (the adversary picks the box,
      // then the point) — coherent, and strictly more expressive
      // than one box

  // Interface bindings. An input wire binds a named parameter
  // appearing in the mechanism's field polynomials; an output wire
  // binds a per-mode readout vector in state variables only (the
  // Moore discipline — readout variable scope is a producer
  // obligation at the oracle seam, polynomials being opaque here).

  InBind  : Set;
  OutBind : Set;

  mkInBind  : {mech: Mech, param: Str, port: Port} -> InBind;
  mkOutBind : {mech: Mech, readout: PolyVec, port: Port} -> OutBind;

  // ==========================================================
  // Wirings
  // ==========================================================
  //
  // Equality-based wire identification over positional port paths.
  // A wiring declares its inner interface roster and its outer
  // interface; port equations attach to the hash-consed wiring by
  // reference, so descriptor content never grows the composite
  // former's arity.
  //
  // Conformance family C-SYS-SHAPE (admission, per wiring):
  // identified ports carry equal shapes. Shape agreement concerns
  // ground values, so it is checked at admission rather than
  // concluded by a chased equality the engine would refuse to
  // unify.

  PortPath : Set;
  Wiring   : Set;
  PortEq   : Set;

  ppInner : {pos: Nat, port: Port} -> PortPath;
  ppOuter : {port: Port} -> PortPath;

  mkWiring : {inner: IfaceList, outer: Iface} -> Wiring;

  mkPortEq : {a: PortPath, b: PortPath, wiring: Wiring} -> PortEq;

  qtsl_wiring_shapes : {w: Wiring} -> Prop;   // side-condition
                                              // (C-SYS-SHAPE)

  report ax/wf/wiring_shapes : forall e : PortEq, a : PortPath,
      b : PortPath, w : Wiring.
    e = {a: a, b: b, wiring: w} mkPortEq
    |- {w: w} qtsl_wiring_shapes;

  // ==========================================================
  // Systems
  // ==========================================================
  //
  // A system is a presentation, never the semantic quotient: one
  // mechanism, or a wiring of inner systems. Composition terms are
  // hash-consed structural data — the checker decomposes along
  // them, which is what the quotient erases and why the quotient is
  // not the definition. Naming, ownership, and discovery land where
  // a model BINDS a system element, the same way specifications are
  // named bindings of formula elements.

  System     : Set;
  SystemList : Set;

  SysMech : {mech: Mech} -> System;
  SysWire : {inner: SystemList, wiring: Wiring} -> System;

  syNil  : SystemList;
  syCons : {head: System, tail: SystemList} -> SystemList;

  // Every system presents one interface, stored per element and
  // determined by the axioms below. Store-and-check: the chase
  // computes the presented interface, functionality merges stored
  // with derived, and a disagreement is loud.
  System/iface : System -> Iface;

  chase ax/sys/iface_mech : forall s : System, m : Mech, i : Iface.
    s = {mech: m} SysMech, i = m Mech/iface
    |- s System/iface = i;

  chase ax/sys/iface_wire : forall s : System, w : Wiring,
      inn : SystemList, ifs : IfaceList, o : Iface.
    s = {inner: inn, wiring: w} SysWire,
    w = {inner: ifs, outer: o} mkWiring
    |- s System/iface = o;

  // Positional agreement between a wiring's declared inner
  // interfaces and the inner systems' presented interfaces: a
  // paired walk over the two lists, concluding elementwise
  // interface equality, with length disagreement refused.
  WiringMatch : {ifs: IfaceList, sys: SystemList} -> Prop;

  chase ax/sys/match_root : forall s : System, w : Wiring,
      inn : SystemList, ifs : IfaceList, o : Iface.
    s = {inner: inn, wiring: w} SysWire,
    w = {inner: ifs, outer: o} mkWiring
    |- {ifs: ifs, sys: inn} WiringMatch;

  chase ax/sys/match_cons : forall l1 : IfaceList, l2 : SystemList,
      i : Iface, t1 : IfaceList, s1 : System, t2 : SystemList,
      j : Iface.
    {ifs: l1, sys: l2} WiringMatch,
    l1 = {head: i, tail: t1} ilCons,
    l2 = {head: s1, tail: t2} syCons,
    j = s1 System/iface
    |- i = j, {ifs: t1, sys: t2} WiringMatch;

  refuse ax/sys/match_nil_cons : forall l1 : IfaceList, l2 : SystemList,
      s1 : System, t2 : SystemList.
    {ifs: l1, sys: l2} WiringMatch,
    l1 = ilNil,
    l2 = {head: s1, tail: t2} syCons
    |- false;

  refuse ax/sys/match_cons_nil : forall l1 : IfaceList, l2 : SystemList,
      i : Iface, t1 : IfaceList.
    {ifs: l1, sys: l2} WiringMatch,
    l1 = {head: i, tail: t1} ilCons,
    l2 = syNil
    |- false;

  // Side-condition oracles over the declaration structure: the
  // demand row chases; discharge stays at the evaluator, loudly
  // deferred while unrealized.
  //   qtsl_sys_causal — instantaneous-dependency acyclicity across
  //     a composite (Moore readouts make feedback free; stateless
  //     input-dependent readouts are admissible only under this
  //     check), plus directed-only stochastic wires.
  //   qtsl_sys_w3 — simultaneity resolution: simultaneously enabled
  //     instant transitions carry a declared serialization or a
  //     commutation certificate. Scoped to the instant-fire race
  //     stratum (clock = tkRace at the infinite majorant): demonic
  //     rows are exempt by semantics — interleaving is what the
  //     scheduler seat quantifies, never a defect to resolve — and
  //     forced rows are exempt the same way: a same-instant
  //     forced-vs-forced coincidence resolves through the demonic
  //     seat (the seat inherits ties), never through a
  //     serialization demand.

  qtsl_sys_causal : {s: System} -> Prop;   // side-condition
  qtsl_sys_w3     : {s: System} -> Prop;   // side-condition

  report ax/wf/qtsl_sys_causal : forall s : System, inn : SystemList,
      w : Wiring.
    s = {inner: inn, wiring: w} SysWire
    |- {s: s} qtsl_sys_causal;

  report ax/wf/qtsl_sys_w3 : forall s : System, inn : SystemList,
      w : Wiring.
    s = {inner: inn, wiring: w} SysWire
    |- {s: s} qtsl_sys_w3;

  refuse ax/sys/mech_wire_disjoint : forall s : System, m : Mech,
      inn : SystemList, w : Wiring.
    s = {mech: m} SysMech, s = {inner: inn, wiring: w} SysWire
    |- false;

  // ==========================================================
  // The hole: a composition pattern's open seat
  // ==========================================================
  //
  // A hole is a formal System citizen: a typed placeholder whose
  // interface is the seat's shape — what a filler receives (invars)
  // and must emit (outvars). A comb — "composition pattern with a
  // hole in it" — is an ordinary System term containing a hole
  // occurrence; no context syntax and no binder exists, because the
  // pattern with its hole open IS the subject. The information
  // pattern needs no declaration of its own: which wires reach the
  // hole is carried by the comb term itself (a delayed-trace comb
  // hands the filler exactly the observation channel's outputs; a
  // supervision-package comb hands it the declared observables), so
  // the comparison class of a seat-regret claim is read off the
  // subject, never re-declared per formula — re-declaration is the
  // double-counting the regret design rejected, and silent demonic
  // closure of the hole is the implicit reading its witness refutes.

  SysHole : {iface: Iface} -> System;

  // A hole presents its declared interface — the seat's shape IS
  // the presentation (the third arm of the System/iface
  // determination, beside the mechanism and wiring arms).
  chase ax/sys/iface_hole : forall s : System, i : Iface.
    s = {iface: i} SysHole
    |- s System/iface = i;

  refuse ax/sys/mech_hole_disjoint : forall s : System, m : Mech,
      i : Iface.
    s = {mech: m} SysMech, s = {iface: i} SysHole
    |- false;

  refuse ax/sys/wire_hole_disjoint : forall s : System,
      inn : SystemList, w : Wiring, i : Iface.
    s = {inner: inn, wiring: w} SysWire, s = {iface: i} SysHole
    |- false;

  // Filling is substitution: closed is comb with its unique hole
  // replaced by filler. Lawful iff the filler presents the hole's
  // interface. REFUSE-mode, deliberately (the F-6 review repair): a
  // chased equality here would silently RETYPE a wrong-interfaced
  // filler — engine congruence merges constructor images forward
  // and never clashes them, so the tie is an enforced menu-of-one
  // against the filler's own derived interface, never a repair.
  hole_fill : {comb: System, filler: System, closed: System} -> Prop;

  refuse ax/wf/hole_fill_iface : forall c : System, p : System,
      z : System, i : Iface, j : Iface.
    {comb: c, filler: p, closed: z} hole_fill,
    c = {iface: i} SysHole,
    p System/iface = j,
    not i = j
    |- false;

  // Hole counting is a bounded computation over the term tree — the
  // typing-oracle side-condition pattern verbatim, discharged by
  // the typing evaluator at the ground seam. The chase-expressible
  // half is positive: the regret formers demand count one
  // (linearity: exactly one seat; the demands mint at the pairing).
  // The ZERO half — landed, seat-free formers pair with hole-free
  // subjects, so a hole under an ordinary claim is never silently
  // demonically closed — is absence-keyed and therefore admission
  // conformance (C-CERT-CLAIM gains the clause: a paired subject's
  // hole count matches its spec's regret demand, zero absent regret
  // components), never a chase row.
  qtsl_hole_count : {sys: System, n: Nat} -> Prop;   // side-condition

  // ==========================================================
  // Seat regret: the former pair
  // ==========================================================
  //
  // The subject of a regret claim is a comb; the comparison class is
  // the seat — every System presenting the hole's interface. The
  // achieved and comparison values are credal-LOWER expectations of
  // the run functional on the respective closed composites: residual
  // nondeterminism stays demonic on BOTH sides uniformly (maximin
  // regret — deliberately NOT online-learning pathwise regret, which
  // needs a shared weather trace no compositional semantics
  // supplies). The certificate face carries its filler; the query
  // face carries none — it is well-formed in total ignorance of the
  // answer, and its discharging selection witness CARRIES the filler
  // (the angelic idiom: the witness IS the answer). The two faces
  // are the floor/mark duality one level up, with the quantifier
  // moved from the law seat to the filler seat — which is why "Mark"
  // and not "MayBe": MayBe is the law-seat existential, and the two
  // seats have just been separated. Pairing-relative demands (one
  // hole of the paired subject; the certificate face's filler fills
  // it) mint at the certificate stratum, where the pairing is in
  // hand.

  // Certificate face: no type-correct filler beats pi by more than
  // eps, each judged by its own guaranteed value.
  SRegretLE : {eps: Q, pi: System, ret: PathObservable} -> ForallSpec;

  // Query face: some type-correct filler is eps-optimal.
  SRegretLEMark : {eps: Q, ret: PathObservable} -> ExistsSpec;

  // Regret bounds are nonnegative — eps = 0 is the exact-optimality
  // claim (the certified-gym "optimal, exactly" class), lawful and
  // canonical.
  report ax/wf/sregret_eps_nonneg : forall p : System, e : Q,
      r : PathObservable, f : ForallSpec.
    f = {eps: e, pi: p, ret: r} SRegretLE
    |- {l: 0, r: e} q_le;

  report ax/wf/sregret_mark_eps_nonneg : forall e : Q,
      r : PathObservable, f : ExistsSpec.
    f = {eps: e, ret: r} SRegretLEMark
    |- {l: 0, r: e} q_le;

  // No ge/le disjointness fixture is needed: the pair's record
  // shapes differ (pi-bearing vs not) and their sorts differ, so
  // hash-consing and the grid separate them structurally; and no
  // LE/GE mirror exists — regret is one-sided by definition (a
  // "regret at least" face would be a liveness claim about the
  // seat's spread, a different former for a different day,
  // deliberately not minted here).

  // The run-functional projections for the regret pair (the
  // traversal's two regret rows, stated here where the formers are
  // in scope).
  chase ax/spec/ret_regret : forall s : Spec, e : Q, p : System,
      r : PathObservable, f : ForallSpec.
    {spec: s, f: f} spec_consumes, f = {eps: e, pi: p, ret: r} SRegretLE
    |- {spec: s, ret: r} spec_consumes_ret;

  chase ax/spec/ret_regret_mark : forall s : Spec, e : Q,
      r : PathObservable, m : ExistsSpec.
    {spec: s, e: m} spec_consumes_mark, m = {eps: e, ret: r} SRegretLEMark
    |- {spec: s, ret: r} spec_consumes_ret;

  // ==========================================================
  // Clocks and tick declarations (the hybrid-time seam)
  // ==========================================================
  //
  // One temporal base — real time — with clocks internalized as
  // mechanism state. A discrete-time mechanism in isolation is
  // schedule-generic; a schedule becomes assumption data at a
  // discrete/continuous composition boundary.
  //
  // A tick DECLARATION is hash-consed content: an exact period, or
  // a jitter bracket read as the per-tick demonic draw of the reset
  // interval. A CLOCK is an entity carrying one declaration —
  // identity is the instance, never the content. The distinction is
  // load-bearing and semantic: two components citing the SAME clock
  // element share one demonic realization (one crystal, one draw),
  // while two clocks of equal content draw independently, and the
  // two readings admit different states. Sharing structure is
  // therefore formation data: a composite's schedule assumptions
  // name clock instances, and a shared crystal is the same instance
  // cited twice.
  //
  // Two carriage routes, honestly two: a mechanism may carry its
  // own clock (interior carriage — the timer's reset parameter is
  // mechanism population), and a composite may assume a schedule
  // for one component at its boundary (the assumption slot,
  // attached by reference to the hash-consed wiring, so the
  // composite former's arity never grows). Both are zero-or-more
  // relations.
  //
  // Well-formedness at the value level: periods are strictly
  // positive; jitter brackets are strictly positive and strictly
  // ordered. The strict lower bound refuses Zeno schedules (an
  // admissible zero inter-tick interval) and time reversal at the
  // cheapest stratum, and makes every declared realization class
  // nonempty; the strict ordering makes the degenerate bracket
  // unspellable — its one canonical spelling is the exact form.
  //
  // Conformance family C-SYS-HYBTIME (admission, per wiring): at
  // most one schedule assumption per (wiring, component), and the
  // derived per-wire clock assignment is a function — one clock per
  // wire across both carriage routes.

  TickDecl : Set;   // value-like, hash-consed: declaration content

  tkExact  : {period: Q} -> TickDecl;
  tkJitter : {lo: Q, hi: Q} -> TickDecl;

  report ax/wf/tick_exact_pos : forall p : Q, t : TickDecl.
    t = {period: p} tkExact
    |- {l: 0, r: p} q_lt;

  report ax/wf/tick_jitter_pos : forall l : Q, h : Q, t : TickDecl.
    t = {lo: l, hi: h} tkJitter
    |- {l: 0, r: l} q_lt;

  report ax/wf/tick_jitter_ord : forall l : Q, h : Q, t : TickDecl.
    t = {lo: l, hi: h} tkJitter
    |- {l: l, r: h} q_lt;

  refuse ax/qtsl/tick_exact_jitter_disjoint : forall p : Q, l : Q,
      h : Q, t : TickDecl.
    t = {period: p} tkExact, t = {lo: l, hi: h} tkJitter
    |- false;

  Clock : Set;   // entity: identity asserts a shared realization

  clock_spec : Clock -> TickDecl;   // total: every clock instance
                                    // carries one declaration

  mech_tick : {mech: Mech, clock: Clock} -> Prop;
      // interior carriage: zero or more — no clock, or several
  sched_tick : {wiring: Wiring, comp: Nat, clock: Clock} -> Prop;
      // boundary carriage: the assumption slot, by reference to the
      // hash-consed wiring

  qtsl_hybtime : {w: Wiring} -> Prop;   // side-condition
                                        // (C-SYS-HYBTIME)

  report ax/wf/hybtime : forall w : Wiring, c : Nat, k : Clock.
    {wiring: w, comp: c, clock: k} sched_tick
    |- {w: w} qtsl_hybtime;

  // ==========================================================
  // Funnels
  // ==========================================================
  //
  // A funnel declaration packages a transit claim: a system, the
  // transit and hold specifications, a gate on the state, and a
  // strictly positive budget. The certificate family a funnel's
  // gate carries is certificate-stratum content, contributed where
  // proof and vocabulary meet — never a field here.

  FunnelDecl : Set;

  mkFunnel : {sys: System, transit: Spec, hold: Spec,
              gate: StatePred, budget: Q} -> FunnelDecl;

  report ax/wf/funnel_budget_pos : forall s : System, tr : Spec,
      hd : Spec, g : StatePred, b : Q, f : FunnelDecl.
    f = {sys: s, transit: tr, hold: hd, gate: g, budget: b} mkFunnel
    |- {l: 0, r: b} q_lt;

  // ==========================================================
  // Marked populations (the bag former's reified structure)
  // ==========================================================
  //
  // A bag mechanism holds a marking — a multiset of tokens over one
  // base system — with create and destroy loops. The base system is
  // the one higher-order family in this file: row-reachable
  // dynamics, recursion localized in a single bridge family under
  // the species exclusivity discipline. A bag is over ONE base
  // system and a bag mechanism must have one; both are counting
  // demands and ride admission conformance. Compound stochastic
  // nets are an admissible-tier pattern factoring through this
  // former and the composition patterns — sugar over primitives,
  // with no primitive arm of their own.
  //
  // A marking IS a multiset: one row per token species with its
  // count as data. No canonical ordering apparatus exists because
  // none is needed — rows with count data have no order to
  // canonicalize.
  //
  // Conformance family C-BAG (admission, per bag mechanism):
  // presence and uniqueness of the base row; at most one capacity
  // row; per-identifier uniqueness of loops; at most one marking
  // row per (mechanism, token).

  RateBasis : Set;   // how a delay loop's rate scales
  rbPerSelection : RateBasis;
  rbAggregate    : RateBasis;

  BagLaw : Set;
  blDelay  : {basis: RateBasis} -> BagLaw;
  blGuard  : BagLaw;
  blSynced : BagLaw;

  BagLoop : Set;
  blCreate  : {id: Str, delta: Nat, law: BagLaw} -> BagLoop;
  blDestroy : {id: Str, delta: Nat, law: BagLaw} -> BagLoop;

  refuse ax/qtsl/bag_create_destroy_disjoint : forall i : Str,
      d : Nat, w : BagLaw, l : BagLoop.
    l = {id: i, delta: d, law: w} blCreate,
    l = {id: i, delta: d, law: w} blDestroy
    |- false;

  Token : Set;   // entity: one token species

  mech_bag_base : {mech: Mech, base: System} -> Prop;
  mech_bag_capacity : {mech: Mech, capacity: Nat} -> Prop;
      // zero rows = uncapped, lawful
  mech_bag_loop : {mech: Mech, loop: BagLoop} -> Prop;
  mech_bag_marking : {mech: Mech, token: Token, count: Nat} -> Prop;

  // The count-block enumeration witness (from the judgment-tie
  // scratch lane's executable review — the tie walk's first
  // implementation REFUTED the roster-order convention: the seal
  // canonicalizes op order and this block deliberately declares
  // marking rows orderless, so the token <-> count-wire bijection
  // every coordinate-indexed consumer needs (reset PolyVec
  // positions, grain selMk place literals, spec-atom exponent
  // tuples, the judgment tie's fold dictionaries) was representable
  // NOWHERE in sealed rows; measured: 196/224 false-FAILs on a
  // pristine net under scrambled supports). This row pins it: total
  // on marked species, dense bijection onto 0..P-1 — walk-checked,
  // never presumed (C-BAG gains the density/totality clause). The
  // Lean-tier bag semantics needs the same enumeration for the same
  // reason.
  mech_bag_wire : {mech: Mech, token: Token, wire: Nat} -> Prop;

  qtsl_bag_wf : {mech: Mech} -> Prop;   // side-condition (C-BAG)

  report ax/wf/bag_wf : forall m : Mech, s : System.
    {mech: m, base: s} mech_bag_base
    |- {mech: m} qtsl_bag_wf;

  // ==========================================================
  // The generator-transform stratum
  // ==========================================================
  //
  // The compiled generator map: both functorial passes of the
  // generator transform, compiled once per structure into static
  // multilinear entries over the joint coefficient vector — the
  // certificate bodies AND the twiddle-able system fields — with
  // generator-row values as checkpoint views. Structure is compiled
  // rarely; the innermost loop varies coefficient assignments only.
  //
  // Node INSTANCES (the observation and fold rows that actually
  // derive the result relations) are instance data emitted by the
  // compile stage, never declarations here. Result relations are
  // result-virgin: defined by fold nodes, never asserted by a
  // producer.

  // The row view of a polynomial: one row per monomial (the value
  // face) and one per occupied slot (the structure face). Both are
  // chase-derived spine walks; the slot face has its OWN walk so
  // the structure face's derivation path never touches coefficient
  // values. Canonical polynomials have pairwise-distinct exponent
  // tuples, so set semantics loses no multiplicity here; downstream
  // products protect multiplicity by witness discipline instead.

  MonoRow : {coeff: Q, expts: Shape, poly: Poly} -> Prop;
  SlotRow : {expts: Shape, poly: Poly} -> Prop;

  chase ax/gen/monorow_head : forall e : Shape, c : Q, t : Poly, p : Poly.
    p = {expts: e, coeff: c, tail: t} pTerm
    |- {coeff: c, expts: e, poly: p} MonoRow;

  chase ax/gen/monorow_tail : forall e : Shape, c : Q, t : Poly, p : Poly,
      c2 : Q, e2 : Shape.
    p = {expts: e, coeff: c, tail: t} pTerm,
    {coeff: c2, expts: e2, poly: t} MonoRow
    |- {coeff: c2, expts: e2, poly: p} MonoRow;

  chase ax/gen/slotrow_head : forall e : Shape, c : Q, t : Poly, p : Poly.
    p = {expts: e, coeff: c, tail: t} pTerm
    |- {expts: e, poly: p} SlotRow;

  chase ax/gen/slotrow_tail : forall e : Shape, c : Q, t : Poly, p : Poly,
      e2 : Shape.
    p = {expts: e, coeff: c, tail: t} pTerm,
    {expts: e2, poly: t} SlotRow
    |- {expts: e2, poly: p} SlotRow;

  // Poly-roles: the joint coefficient vector's address space. A
  // role names one twiddle-able polynomial slot in a presentation,
  // by occurrence. Drift and diffusion slots are mode-keyed, the
  // diffusion additionally by driver position in the mode's ordered
  // roster. Rate and reset slots are keyed by the transition entity
  // whose scale view carries them (entity identity individuates
  // occurrences, so no positional occurrence index is needed there)
  // and, for resets, by branch position within the mixture and
  // component within the reset vector. Certificate-body roles are
  // keyed by the certificate family's branch key (a ground Shape
  // tuple, read against the family's axis roster; the width-zero
  // tuple is the scalar) and by body position within that branch,
  // bound at the pairing. The branch key is address data by
  // necessity: the innermost tempo works one branch at a time, but
  // hand-off obligations couple two branches' bodies in one compiled
  // structure, and a body position alone would be ambiguous there.
  // Role resolution — from a role to the polynomial it currently
  // holds — is the compile emitter's job, positional, never a chase
  // walk.

  PolyRole : Set;

  prDrift : {component: Nat, mode: Mode} -> PolyRole;
  prDiff  : {component: Nat, driver: Nat, mode: Mode} -> PolyRole;
  prRate  : {tr: Transition} -> PolyRole;
  prReset : {branch: Nat, component: Nat, tr: Transition} -> PolyRole;
  prCert  : {branch: Shape, body: Nat} -> PolyRole;

  refuse ax/qtsl/prole_drift_rate_disjoint : forall c : Nat, m : Mode,
      t : Transition, r : PolyRole.
    r = {component: c, mode: m} prDrift,
    r = {tr: t} prRate
    |- false;

  // Declared support: the monomial slots of which a role's current
  // coefficients are an assignment. Structure = declared supports +
  // legs + wiring + scopes; a coefficient passing through zero
  // WITHIN declared support is a numerical event, while support
  // growth is a structural edit. The support is separate data by
  // necessity: canonical polynomials forbid zero coefficients, so a
  // superset support cannot ride the polynomial value itself. An
  // absent support row is the degenerate convention (support = the
  // assignment's own slot projection; every zero crossing is then
  // structural — sound, just slower).
  //
  // Conformance family C-GEN-SUPPORT (admission, per role): at most
  // one support row; support width matches the presentation arity;
  // the current assignment's slots are contained in the declared
  // support.

  SlotList : Set;   // canonical slot set: strictly ascending,
                    // uniform width, valueless

  sltNil  : SlotList;
  sltCons : {slot: Shape, tail: SlotList} -> SlotList;

  qtsl_support_canonical : {s: SlotList} -> Prop;   // side-condition

  report ax/wf/support_canonical : forall s : SlotList.
    |- {s: s} qtsl_support_canonical;

  refuse ax/qtsl/slt_nil_cons_disjoint : forall h : Shape, t : SlotList,
      l : SlotList.
    l = sltNil, l = {slot: h, tail: t} sltCons
    |- false;

  RoleSupport : {role: PolyRole, support: SlotList} -> Prop;

  qtsl_role_support : {role: PolyRole} -> Prop;   // side-condition
                                                  // (C-GEN-SUPPORT)

  report ax/wf/role_support : forall r : PolyRole, s : SlotList.
    {role: r, support: s} RoleSupport
    |- {role: r} qtsl_role_support;

  // Moment tables: transfer content known only through its moments,
  // producer-asserted behind a declared trust boundary. Entity-like
  // (identity is the entries, which are rows about it). The derived
  // moment normal form is a compile-stage result relation; where a
  // declaration and the derived family both exist for one
  // occurrence, agreement is a recompute obligation, never a
  // trusted row.

  MomentTable : Set;   // entity: identity is the entries

  MomentTable/width : MomentTable -> Nat;   // presentation arity

  mtEntry : {beta: Shape, table: MomentTable} -> Poly;

  MomentDecl : {tr: Transition, table: MomentTable} -> Prop;
      // this transition's transfer content is presented by its
      // moment table

  MomentRow : {beta: Shape, poly: Poly, tr: Transition} -> Prop;
      // the derived moment normal form — a compile-stage RESULT
      // relation (result-virgin: defined by fold nodes, never
      // asserted)

  // The compiled map, value face and structure face.
  //
  // Families: drift (first derivatives against the drift vector),
  // diffusion (second derivatives against the covariance, the half
  // folded into the constant), transfer (rate-weighted transfer
  // moments over next branches), and the compensator (the negated
  // rate term; mass-one mixtures make it whole-rate). The
  // compensator is a separate family from transfer deliberately,
  // twice over: edit locality (their invalidation cones differ) and
  // the killing-sign discipline (the sign audit must SEE the
  // killing contribution as its own queryable family).

  GenFam : Set;
  gfDrift : GenFam;
  gfDiff  : GenFam;
  gfXfer  : GenFam;
  gfComp  : GenFam;

  refuse ax/qtsl/genfam_drift_diff_disjoint : forall g : GenFam.
    g = gfDrift, g = gfDiff
    |- false;

  SlotRef : Set;
  mkSlotRef : {expts: Shape, role: PolyRole} -> SlotRef;

  SlotRefList : Set;
  srlNil  : SlotRefList;
  srlCons : {head: SlotRef, tail: SlotRefList} -> SlotRefList;

  refuse ax/qtsl/srl_nil_cons_disjoint : forall h : SlotRef,
      t : SlotRefList, l : SlotRefList.
    l = srlNil, l = {head: h, tail: t} srlCons
    |- false;

  // One compiled multilinear entry: at (scope, output slot), the
  // generator coefficient gains const times the product of the
  // referenced slots' coefficients. The summation over entries is
  // definitional, evaluated only where a consumer needs values —
  // never expanded eagerly. Entries are value-like: two entries
  // with equal keys and distinct slot tuples are distinct elements,
  // so de-duplication is constructor identity and "the same entry
  // twice" is unrepresentable. Every derived relation of this
  // stratum is keyed so each edit cone is an index lookup, never a
  // scan; the leg field is the transition occurrence for the jump
  // families and zero for drift and diffusion.

  GenEntry : Set;   // value-like: one compiled multilinear entry

  mkGenEntry : {const: Q, fam: GenFam, leg: Nat, out: Shape,
                scope: Mode, slots: SlotRefList} -> GenEntry;

  GenEntry/derived : GenEntry -> Prop;
      // compiled-map membership — a compile-stage RESULT relation

  // Checkpoint values: per-family generator rows evaluated from the
  // compiled map against current coefficient values, kept separate
  // before the assembly sum (edit locality and the killing-sign
  // discipline), then assembled and zero-filtered. The canonical
  // derived surface carries nonzero coefficients only. All three
  // are compile-stage result relations; the checkpoint face is not
  // the inner loop's evaluator — it is the engine-side surface for
  // obligation views, audits, and the cross-tier differential.

  GenRow : {coeff: Q, expts: Shape, fam: GenFam, leg: Nat,
            scope: Mode} -> Prop;
  GenTotal : {coeff: Q, expts: Shape, scope: Mode} -> Prop;
  GenNz : {coeff: Q, expts: Shape, scope: Mode} -> Prop;

  // Guard rows: every value-coupled scoping assumption the compiled
  // map bakes in is emitted BESIDE the map as a compiled guard — an
  // exact sign condition evaluated in the inner loop's own
  // dataflow. A guard flip is an explicit invalidation event: the
  // inner loop stops trusting the flipped scope's rows and emits a
  // structure edit — refusal-shaped, never silent wrongness. Guards
  // are structure-compiled results, so a producer cannot quietly
  // widen one.

  GuardKind : Set;
  gkContain : GuardKind;   // reset-image containment margin
  gkCell    : GuardKind;   // cell-membership polynomial

  refuse ax/qtsl/guardkind_disjoint : forall k : GuardKind.
    k = gkContain, k = gkCell
    |- false;

  Guard : Set;
  mkGuard : {cond: Poly, kind: GuardKind, leg: Nat, scope: Mode}
    -> Guard;

  Guard/emitted : Guard -> Prop;   // compile-stage RESULT relation

  // ==========================================================
  // The generator-form seam
  // ==========================================================
  //
  // What every battery-class rule needs from a system: given the
  // system and a candidate certificate component (a hypernet from
  // the system's state space to the nonnegative extended reals,
  // named by reference), a hypernet from the state space to the
  // reals saying how the certificate can change with duration.
  //
  // DERIVED, never stored-trusted: the generator pass computes it
  // from the subject's content rows and the certificate component's
  // coefficients; on the wire it is a recompute obligation. The row
  // is keyed per (subject, certificate COMPONENT): a scalar
  // certificate consumes it as one row, and a family-shaped
  // certificate consumes it componentwise. No envelope choice and
  // no certificate arity is encoded here; both live at the rule
  // tier.

  qtsl_gen_form : {sys: System, cert: HypernetRef, gen: HypernetRef}
    -> Prop;   // side-condition (oracle discharge / checker
               // recompute)

  // ==========================================================
  // Deliberately absent from the subject strata (the testable
  // negatives)
  // ==========================================================
  //
  // No doctrine tags and no former-named sorts: "which model class"
  // is a query over populated families. No interval sort and no
  // strict orientation anywhere in the formula grammar: a range is
  // a conjunction of orientation-paired atoms, and strictness is a
  // compiler artifact. No negation-normal-form artifacts: strict
  // literals and negated probability literals arise downstream of
  // the surface and have no rows. No guard field, no forced flag,
  // no rate field, and no source/target fields on transitions: each
  // was presentation, and each is derived from kernel structure,
  // carried by the grain, or owned by the clock. No counting axioms: every at-most-one,
  // presence, mass, and coverage demand is a named admission
  // family, because counting is not geometric. No partial function
  // sorts and no chased equality on ground values. No certificate
  // citations: every certificate-citing field lives with the
  // certificate stratum, where proof and vocabulary meet. No
  // summation trees below the compiled-map stratum: entries carry
  // slot references and one rational constant, and products and
  // sums exist only as fold-node evaluation or execution-lane
  // dataflow, never as rows.

  // ==========================================================
  // FLAVORED CELL SCHEMAS (the certificate's disjunction source)
  // ==========================================================
  //
  // Reconciled here at the omnibus fold. The core cell box takes an
  // abstract SimpC schema, and its semantic well-formedness conjunct
  // (strict-vs-weak exclusion of distinct cells) quantifies over
  // real barycentric weights — not checkable from the schema data by
  // any finite scan. This stratum gives the schema two concrete
  // finitely-presented flavors under which that side condition
  // becomes cheap (tensor-simplicial: additive per-cluster Farkas
  // rows) or free (full-semialgebraic: a theorem of the
  // presentation), plus the finite Farkas certificate rows that
  // repair the raw flavor. Semantic authorities (names cited per
  // declaration): lean/qtsl/Qtsl/CellFlavors.lean (CellSchemaTS,
  // CellSchemaSA, product_exclusion, sign_exclusion),
  // Qtsl/CellFarkas.lean (PairCert, checkPair/checkTable soundness),
  // Qtsl/CellFlavorsInterior.lean (EmptyCellOk consumers).
  //
  // This stratum lives in THIS theory — not the proof tower —
  // because certificates index it: the flavored roster is the
  // disjunction source the certificate sections below consume, and
  // an instance of this theory carries its cell schemas, its
  // obligations, and its verdicts under one header. The proof-tower
  // file ends at the BernsteinLogic theory, which is exactly the
  // fragment the certified external checker consumes.
  //
  // FLAVOR TAGGING: no CellSchema/flavor attribute is stored and no
  // schema-entity sum sort is minted. This is an UNTAGGED-UNION
  // idiom — a cell app is flavor 0 when it has a legacy CellSchema
  // row (app -> SimpC, unchanged), flavor 1 when it has a
  // CellSchemaTS row, and flavor 2 when it has a CellSchemaSA row.
  // The derived flavor is unique exactly when the pairwise denials
  // below hold and the exactly-one count (conformance) passes on
  // saturated rows.

  // ==========================================================
  // Flavor 1: tensor-simplicial (Lean CellSchemaTS)
  // ==========================================================
  //
  // A partition of the D flat ambient dimensions of the host wire
  // type into m clusters --- "every entry in a tensor type is a
  // dimension" --- with one SimpC per cluster; cells are Cartesian
  // products of per-cluster cells, the product roster derived, never
  // stored. The presentation stays O(D + sum_c |K_c|).

  TSSchema : Set;
  TSSchema/host_dim   : TSSchema -> Nat;   // D = totalSize of the host
                                           // wire shape (tie: the
                                           // signature conformance
                                           // clause --- counting)
  TSSchema/n_clusters : TSSchema -> Nat;   // m ("small finite codomain")

  // THE PARTITION TENSOR pi: surface form, a shape-s dtype-nat tensor
  // literal; row form, this total finite function on flat row-major
  // positions --- by the workshop tensor definition they are the same
  // object. Entries < m and positions < D are Index-typing facts
  // (erased to generated range obligations); totality (a value row
  // per position) is conformance (the partition clause), the same
  // posture as SimpC/coord's per-(v,j) totality.
  TSSchema/cluster_of : {s: TSSchema, pos: s TSSchema/host_dim Index}
                          -> s TSSchema/n_clusters Index;

  // Per-cluster complexes: ordinary SimpC values, pool reuse
  // verbatim. (ts, idx) is a key; ambDim(complex) = |cluster| is
  // counting, hence conformance (the partition clause), mirroring
  // Lean dimsMatch.
  TSCluster : Set;
  TSCluster/ts      : TSCluster -> TSSchema;
  TSCluster/idx     : {c: TSCluster} -> c TSCluster/ts TSSchema/n_clusters Index;
  TSCluster/complex : TSCluster -> SimpC;

  // OPTIONAL library-species citation: a cluster whose complex is a
  // library species (e.g. the interval fan) may discharge its
  // exclusion obligation by citing the species' once-proved lemma
  // instead of carrying a Farkas table. Resolution is conformance
  // (the certificates clause), and it BINDS CONTENT, not just the
  // name: the registry must validate that the cluster's actual
  // complex IS the cited species' complex --- checked canonical
  // parameters or content identity --- so the citation yields
  // interior-disjointness of THIS complex; a name that merely
  // resolves proves nothing about an arbitrary labeled complex.
  TSCluster/species : TSCluster -> Str;

  // Key unification: identification relied on downstream.
  chase ax/TSCluster_key : forall c1 : TSCluster, c2 : TSCluster.
    c1 TSCluster/ts = c2 TSCluster/ts,
    c1 TSCluster/idx = c2 TSCluster/idx
    |- c1 = c2;

  // Well-formedness existence --- a constraint statement, never a
  // derivation: chasing it would invent cluster rows.
  report ax/wf/TSCluster_total : forall s : TSSchema,
      i : s TSSchema/n_clusters Index.
    |- exists c : TSCluster.
         c TSCluster/ts = s, c TSCluster/idx = i;

  // Well-formedness existence; the finite check is conformance (the
  // partition clause demands every cluster inhabited).
  // RECORDED DEVIATION: this STRENGTHENS the Lean ground truth ---
  // CellSchemaTS.part need not be surjective (an empty cluster with a
  // 0-dimensional complex is a valid Lean structure, and
  // product_exclusion still applies). The rows deliberately admit
  // only the representable subset with inhabited clusters ("small
  // finite codomain" intent: empty clusters are semantically inert ---
  // drop them at authoring); reconstruction into Lean loses nothing.
  report ax/wf/TSSchema/cluster_inhabited : forall s : TSSchema,
      i : s TSSchema/n_clusters Index.
    |- exists pos : s TSSchema/host_dim Index.
         {s: s, pos: pos} TSSchema/cluster_of = i;

  // App linkage, flavor 1 (mirrors ax/CellSchema_isCell).
  CellSchemaTS : {app: PrimApp, schema: TSSchema} -> Prop;
  // Judged: under chase, a linkage row on an app stored as another
  // primitive would REPAIR the instance by unifying that app's
  // primitive value with PCell --- potentially quotienting Primitive
  // constants --- instead of refusing. Load rejection: the
  // flavor-uniqueness clause extends the certificate plane's
  // "linkage row on a non-Cell app" orphan rejection to this family,
  // checked against the stored primitive BEFORE chase.
  report ax/CellSchemaTS_isCell : forall app : PrimApp, schema : TSSchema.
    {app: app, schema: schema} CellSchemaTS
    |- app PrimApp/prim = PCell;

  // ==========================================================
  // Flavor 2: full-semialgebraic (Lean CellSchemaSA)
  // ==========================================================
  //
  // A finite ordered list of k dimension-1-codomain, cell-free
  // presenting functions with domain the host wire type; cells are
  // the weak-sign combinations {+,-}^k (WEAK two-way signs, never
  // classical {-,0,+}: walls belong to both adjacent cells --- the
  // hemicontinuous convention the core cell box already has, and the
  // convention under which the exclusion side condition is a THEOREM
  // of the presentation: Lean sign_exclusion, zero certificate
  // bytes). The full 2^k roster is implicit (binary output order,
  // sign i = bit i); the presentation stays O(k).
  //
  // PRESENTERS ARE DESIGNATED, NOT CONTAINED (a recorded deviation
  // from the Lean structure): the Lean structure holds each presenter
  // as a first-class Hypernet value; the row world has one implicit
  // hypernet per certificate, so a presenter is a designated
  // (in_wire, out_wire) pair of the certificate's own hypernet --- the
  // region between them. Content-addressing of the store gives
  // sub-hypernet sharing without a sub-hypernet sort; the checker
  // reconstructs the Lean Hypernet value as the dependency cone of
  // out_wire. The wiring condition that all presenters read the same
  // host value (through Copy fan-out) is evaluation-plane, owned by
  // the cell rules' conclusion-form relations, not by these schema
  // rows.

  SASchema : Set;
  SASchema/n_funs : SASchema -> Nat;       // k; full roster arity 2^k
  // The host wire type, stored at SCHEMA level: were it only inferred
  // through presenter ties, a k = 0 schema --- vacuously
  // presenter-free, one whole-space cell --- could link to apps of
  // different input types, and no single Lean hostShape would
  // reconstruct; Lean CellSchemaSA.hostShape is a schema field, so
  // the rows mirror it as one.
  SASchema/host_type : SASchema -> TensorType;

  // Host dtype is Q (Lean domOk). Judged: a constraint statement over
  // untrusted instance rows --- chase-unification would repair by
  // quotient (identify this dtype element with Q) rather than judge.
  // The load-rejection check is the signature clause's STRUCTURAL
  // comparison, run before any equality saturation.
  report ax/wf/SASchema/host_dtype : forall s : SASchema.
    |- s SASchema/host_type TensorType/dtype = Q;

  SAFun : Set;
  SAFun/sa       : SAFun -> SASchema;
  SAFun/idx      : {f: SAFun} -> f SAFun/sa SASchema/n_funs Index;
  SAFun/in_wire  : SAFun -> Wire;          // designated domain wire
  SAFun/out_wire : SAFun -> Wire;          // designated scalar output

  // Key unification.
  chase ax/SAFun_key : forall f1 : SAFun, f2 : SAFun.
    f1 SAFun/sa = f2 SAFun/sa,
    f1 SAFun/idx = f2 SAFun/idx
    |- f1 = f2;

  // Well-formedness existence --- constraint statement.
  report ax/wf/SAFun_total : forall s : SASchema, i : s SASchema/n_funs Index.
    |- exists f : SAFun.
         f SAFun/sa = s, f SAFun/idx = i;

  // Presenter codomain: rank-1 scalar Q --- the adopted codomain shape
  // (rank-1 feeds the sign-complex boxes with zero adapters;
  // revisable at one field). The axis-0 extent = 1 tie is conformance
  // (the signature clause).
  // Judged, not chased: under chase these type equations would repair
  // malformed instances by unifying TensorType/Shape elements,
  // silently corrupting type rows that other wires reference, instead
  // of judging them. Load rejection is the signature clause's
  // structural comparison, pre-saturation. (The host tower's
  // type-consistency axioms keep the chase posture on TRUSTED
  // elaborated rows; these rows arrive from producers.)
  report ax/wf/SAFun/cod_dtype : forall f : SAFun.
    |- f SAFun/out_wire Wire/type TensorType/dtype = Q;
  report ax/wf/SAFun/cod_rank : forall f : SAFun.
    |- {shape: f SAFun/out_wire Wire/type TensorType/shape,
        rank: 1} shapeRankIs;

  // Presenter domain = the schema's host type.
  report ax/wf/SAFun/dom_is_host : forall f : SAFun.
    |- f SAFun/in_wire Wire/type = f SAFun/sa SASchema/host_type;

  // The linked app's input carries the host type (the cell box is
  // 1-in, so this ranges over its one input port). With
  // dom_is_host, presenter domains tie to the app input transitively
  // --- and this tie has content even at k = 0.
  report ax/wf/CellSchemaSA/dom_ties : forall app : PrimApp, s : SASchema,
      ip : InputPort.
    {app: app, schema: s} CellSchemaSA,
    ip InputPort/app = app
    |- ip InputPort/wire Wire/type = s SASchema/host_type;

  // Reflexive-transitive reachability, for the cell-free condition:
  // reachesEq = reaches OR equality.
  reachesEq : {from: Wire, to: Wire} -> Prop;
  chase ax/reachesEq/refl : forall w : Wire.
    |- {from: w, to: w} reachesEq;
  chase ax/reachesEq/reaches : forall w1 : Wire, w2 : Wire.
    {from: w1, to: w2} reaches
    |- {from: w1, to: w2} reachesEq;

  // The designated input lies IN the designated output's dependency
  // cone --- an in-cone MEMBERSHIP tie, not a boundary test: an
  // internal produced wire also passes, and membership is what the
  // Lean reconstruction needs (without this, an unrelated
  // correctly-typed wire could be designated as in_wire --- every type
  // check passes, but the reconstructed presenter cone does not
  // contain the wire, and Lean domOk cannot be built for it; a
  // genuine cut/boundary test rides the cone-difference refinement
  // named below).
  report ax/wf/SAFun/in_reaches_out : forall f : SAFun.
    |- {from: f SAFun/in_wire, to: f SAFun/out_wire} reachesEq;

  // CELL-FREENESS of presenters (Lean Hypernet.CellFree): no cell box
  // in a presenter's dependency cone. Semantic reason: a cell inside
  // a presenter imports boundary nondeterminism into the presenting
  // functions, and the sign fibers as REGIONS lose disjointness-by-
  // construction. Structural reason: one stratum --- a cell schema
  // contains presenters that contain no cell schemas, so the
  // recursion is well-founded on sight. Stated in the STRONG form
  // (whole dependency cone of the designated output). HONEST
  // RESTRICTION (sharpening this design's own planted doubt): the
  // strong form also rejects an SA schema whose HOST INPUT is
  // computed downstream of another cell box --- and that is a required
  // composition shape (nested case analysis as cell boxes composed
  // downstream). Precisely stated (this is a restriction on CORRECTLY
  // WIRED flavored forms, not an admission invariant: the schema rows
  // tie presenter and host by TYPE only, so an instance may pass
  // conformance by designating a clean same-typed presenter off a
  // cell-fed host; the same-host-VALUE wiring check of the flavored
  // conclusion forms is where such an instance fails): a presenter
  // wired to read a cell-fed host value cannot be admitted with its
  // refusal discharged, so SA-after-cell composition is unavailable
  // at this revision; the cone-difference refinement (cone(out) minus
  // cone(in), a bounded side-condition helper of the mask-primitive
  // class) is the named evaluation-plane change that lifts the
  // restriction, and it is REQUIRED before SA-after-cell composition
  // ships --- not merely nice-to-have. This revision trades that
  // completeness for a one-sequent refusal, stated at the composition
  // point.
  refuse ax/wf/SAFun/cell_free : forall f : SAFun, app : PrimApp,
      op : OutputPort.
    app PrimApp/prim = PCell,
    op OutputPort/app = app,
    {from: op OutputPort/wire, to: f SAFun/out_wire} reachesEq
    |- false;

  // App linkage, flavor 2.
  CellSchemaSA : {app: PrimApp, schema: SASchema} -> Prop;
  // Judged, with the same rationale and the same pre-chase orphan
  // check as the flavor-1 linkage above.
  report ax/CellSchemaSA_isCell : forall app : PrimApp, schema : SASchema.
    {app: app, schema: schema} CellSchemaSA
    |- app PrimApp/prim = PCell;

  // ----------------------------------------------------------
  // Flavor uniqueness, the geometric fragment: pairwise
  // exclusivity as refuse-mode denials — the flavor-uniqueness
  // conformance clause's PAIRWISE direction promoted from prose to
  // in-engine rules (the conformance rider: geolog checks
  // everything it can state geometrically). The exactly-one COUNT
  // direction ("at least one linkage") is absence, not premisable
  // in the geometric fragment — it stays a conformance counting
  // clause. Flavor tag 0/1/2 remains DERIVED from which family
  // binds: no stored tag exists to disagree with the payload. The
  // legacy pair denials also give the raw-only proof-node
  // restriction its teeth: a flavored app cited by a raw-only node
  // acquires a legacy row at saturation and refuses here.
  // ----------------------------------------------------------

  refuse ax/wf/flavor_excl_ts_sa : forall app : PrimApp,
      s1 : TSSchema, s2 : SASchema.
    {app: app, schema: s1} CellSchemaTS,
    {app: app, schema: s2} CellSchemaSA
    |- false;

  refuse ax/wf/flavor_excl_legacy_ts : forall app : PrimApp,
      s0 : SimpC, s1 : TSSchema.
    {app: app, schema: s0} CellSchema,
    {app: app, schema: s1} CellSchemaTS
    |- false;

  refuse ax/wf/flavor_excl_legacy_sa : forall app : PrimApp,
      s0 : SimpC, s2 : SASchema.
    {app: app, schema: s0} CellSchema,
    {app: app, schema: s2} CellSchemaSA
    |- false;

  // ----------------------------------------------------------
  // Emptiness marks (the witness-economy design, enacted):
  // emptiness certificates are THE optional schema-level slot ---
  // the 2^k roster mints universal per-cell obligations downstream,
  // and a per-cell emptiness certificate prunes them wholesale
  // (ex falso on the branch; Lean EmptyCellOk and its consumers).
  // Nonemptiness is deliberately NOT schema data: it is existential
  // and discharges at each use site (the consumer's own input point
  // checks the k strict signs). Marks do not change the roster or
  // the box arity --- cells stay, their branches become vacuous.
  // ----------------------------------------------------------

  SAPruned : Set;
  SAPruned/sa   : SAPruned -> SASchema;
  // The marked sign vector, as a characteristic relation on function
  // positions (the mask idiom of Simplex/contains): a row at (c, i)
  // reads "sign i is +"; absence reads "-". No Boolean codomain, no
  // totality question --- every position is meaningful either way.
  // Unlike the host mask idiom, NO extensionality axiom is stated
  // (duplicate marks are semantically idempotent, and canonical
  // one-mark-per-vector reconstruction is conformance: duplicate-free
  // marks --- a recorded deviation from the Simplex_ext convention).
  SAPruned/plus : {c: SAPruned,
                   i: c SAPruned/sa SASchema/n_funs Index} -> Prop;
  // The backing certificate: a proof object whose conclusion is the
  // emptiness judgment for this sign vector (the weak sign system
  // rejected --- genuinely BernCone-shaped: positivity over a
  // semialgebraic set, exactly what the Bernstein machinery checks).
  SAPruned/cert : SAPruned -> Proof;

  // Conclusion-form check for the cited certificate: j's premise is
  // the sign-membership conjunction for c's sign vector over c's
  // schema's presenter output wires, and j's conclusion is FFalse.
  // Bounded computation over sealed finite rows (the
  // cellOutZeroForm class); reference realization rides the
  // evaluation plane.
  saEmptyCellForm : {c: SAPruned, j: Judgment} -> Prop;
  // Judged: an applicability statement whose finite check is the
  // side-condition relation; refusal semantics live at the
  // certificate layer.
  report ax/applicable/SAPruned/cert_form : forall c : SAPruned.
    |- {c: c, j: c SAPruned/cert Proof/concludes} saEmptyCellForm;

  // ==========================================================
  // Farkas exclusion certificates (Lean CellFarkas.PairCert) ---
  // the finite repair for flavor 0, and per-cluster for flavor 1
  // ==========================================================
  //
  // Mask-region membership is linear feasibility in the barycentric
  // weights, so "strict-in-i and weak-in-k" is an LP whose
  // infeasibility has a finite exact-rational Farkas certificate:
  // one certificate per ORDERED off-diagonal cell pair (strict-weak
  // exclusion is not symmetric), 2 * C(n,2) rows per complex.
  // Field list is the checker's row-payload contract: alpha, beta
  // multiply the two sum-to-one rows; gamma the coordinate-matching
  // rows; p, q the sign rows of the two cells. p/q are meaningful on
  // the respective masks only --- the checker reads them nowhere else
  // --- so rows store MASKED ENTRIES ONLY and decode expands absent
  // entries to zero (compatible because the Lean checker ignores p/q
  // off the masks and checks signs on all entries, and zero passes
  // every sign check).
  // Cell indices are Nat against the certificate plane's cell-roster
  // count (nCells lives in the certificate extension revision, not
  // this theory) --- range is conformance (the certificates clause).

  FarkasPairCert : Set;
  FarkasPairCert/complex : FarkasPairCert -> SimpC;
  FarkasPairCert/cell_i  : FarkasPairCert -> Nat;   // read strictly
  FarkasPairCert/cell_k  : FarkasPairCert -> Nat;   // read weakly
  FarkasPairCert/alpha   : FarkasPairCert -> Q;
  FarkasPairCert/beta    : FarkasPairCert -> Q;
  FarkasPairCert/gamma : {f: FarkasPairCert,
                          j: f FarkasPairCert/complex SimpC/amb_dim Index} -> Q;
  FarkasPairCert/p : {f: FarkasPairCert,
                      v: f FarkasPairCert/complex SimpC/n_vertices Index} -> Q;
  FarkasPairCert/q : {f: FarkasPairCert,
                      v: f FarkasPairCert/complex SimpC/n_vertices Index} -> Q;

  // Key unification: at most one certificate per ordered pair.
  chase ax/FarkasPairCert_key : forall f1 : FarkasPairCert, f2 : FarkasPairCert.
    f1 FarkasPairCert/complex = f2 FarkasPairCert/complex,
    f1 FarkasPairCert/cell_i = f2 FarkasPairCert/cell_i,
    f1 FarkasPairCert/cell_k = f2 FarkasPairCert/cell_k
    |- f1 = f2;

  // Rejection sequent --- the diagonal is never certified; the checker
  // skips i = k, so a diagonal row could only be surplus.
  refuse ax/wf/FarkasPairCert/offdiag : forall f : FarkasPairCert.
    f FarkasPairCert/cell_i = f FarkasPairCert/cell_k
    |- false;

  // Certificate validity: the Lean checkPair, clause for clause ---
  // multiplier signs (p, q >= 0 on all entries), the per-vertex row
  // identities on each cell's mask (alpha + gamma . coord(v) kills
  // the strict cell's sign row; beta - gamma . coord(v) kills the
  // weak cell's), and the gap condition (alpha + beta > 0, or
  // alpha + beta = 0 with some masked p entry nonzero). Bounded
  // computation, exact Q; nothing is solved, nothing approximated.
  farkasPairValid : {f: FarkasPairCert} -> Prop;
  // Judged: applicability; refusal at the certificate layer.
  report ax/applicable/FarkasPairCert/valid : forall f : FarkasPairCert.
    |- {f: f} farkasPairValid;

  // ==========================================================
  // Flavored cell citations, flavored cell-rule proof nodes, and
  // per-cell obligation keys (Lean CellFlavorsInterior.lean —
  // restatement + transport of the raw pair's semantic content at
  // flavored schemas; never new soundness)
  // ==========================================================
  //
  // The raw cell-rule nodes (PCellInInterior, PCellOut — the proof
  // tower) key their cell by a flat Nat against a SimpC roster and
  // derive a LEGACY CellSchema row for their app, so they bind
  // flavor-0 apps only. The species below are their flavored
  // generalizations: the same rule pair — pinning (strict interior
  // membership determines the box's one-hot cell) and zeroing (one
  // strict refutation witness kills one indicator) — with the cell
  // CITED THROUGH THE COMPLEX'S OWN STRUCTURE: per-cluster
  // components at flavor 1 (a citation costs O(m) rows, never a
  // flat index into the derived exponential roster), the plus-mask
  // over presenter positions at flavor 2 (O(k)). Exclusion burdens
  // stay SCHEMA-level (per-cluster Farkas rosters or species
  // citations; sign_exclusion free) — nodes and obligations cite
  // cells and carry ZERO per-pair exclusion bytes: the
  // exponential-to-additive collapse is the flavors' designed
  // payoff, and these rows are where certificates spend it.
  // Semantic authorities (CellFlavorsInterior.lean): TS pinning
  // CellSchemaTS.interior_onehot (premise burden additive in the
  // clusters — product_exclusion composed with
  // interior_determines); TS zeroing notMem_of_cluster +
  // onehot_ne_of_cluster (ONE cluster-level refutation kills
  // product membership); SA pinning CellSchemaSA.interior_onehot
  // (hypothesis-free — sign_exclusion is a theorem of the
  // presentation); SA zeroing signNotMem_of_witness +
  // CellSchemaSA.onehot_ne_of_witness (one strict opposite-sign
  // arithmetic atom at a named presenter — no geometry); coverage
  // signMem_total (+ memVia_total_unpruned at pruned rosters);
  // pruning discharge EmptyCellOk.prune_discharge (per-cell
  // obligations checked on unpruned cells extend to every
  // inhabited cell — the branch over a pruned cell is ex falso).

  // --- Cell citations ---------------------------------------
  // TSCellSel: one product cell of a TS schema, cited by its
  // per-cluster components — the complex's structure does the
  // indexing work. Component range (entry < nCells of that
  // cluster's complex) is conformance (the certificates clause's
  // counting posture: cell indices are Nat against the extension
  // plane's roster counters, the FarkasPairCert convention).
  TSCellSel : Set;
  TSCellSel/schema : TSCellSel -> TSSchema;
  TSCellSel/comp : {sel: TSCellSel,
                    cluster: sel TSCellSel/schema TSSchema/n_clusters Index}
    -> Nat;

  // SACellSel: one weak-sign cell of an SA schema, cited by the
  // mask idiom — a row at (sel, i) reads "sign i is +"; ABSENCE
  // reads "-" (SAPruned/plus's convention, including its recorded
  // no-extensionality deviation: duplicate citations are
  // idempotent; canonical dedup is conformance).
  SACellSel : Set;
  SACellSel/schema : SACellSel -> SASchema;
  SACellSel/plus : {sel: SACellSel,
                    i: sel SACellSel/schema SASchema/n_funs Index} -> Prop;

  // --- Flavored conclusion forms (bounded-computation side
  // conditions, the raw quartet's pattern at flavored citations;
  // each destructures the cell application and REJECTS unless the
  // citation is in range and the app's output arity equals the
  // flavor-derived roster size) ------------------------------
  //   tsCellStrictInteriorForm: formula = the strict-interior
  //     conjunction for the cited product cell — per cluster c in
  //     increasing index order, the strict barycentric halfspaces
  //     of component comp(c) in cluster c's complex, vertices in
  //     the raw form's pinned order within each cluster.
  //   tsCellOneHotForm: formula = (b_pos = 1) AND AND_{j != pos}
  //     (b_j = 0) over the app's output wires, pos = the cited
  //     cell's output position under the flavor-1 output order
  //     (mixed-radix big-endian in the cluster index).
  //   tsCellOutWitnessForm: formula = ONE strict separating
  //     barycentric atom at witnessVertex in cluster
  //     witnessCluster's complex, against the cited cell's
  //     component there — witnessVertex must belong to that
  //     component's simplex mask (rejects otherwise). Lean
  //     notMem_of_cluster: one cluster-level refutation.
  //   tsCellOutZeroForm: formula = (b_pos = 0), pos as above.
  //   saCellStrictInteriorForm: formula = per presenter i in
  //     increasing index order, the strict sign-adjusted
  //     inequality on presenter i's output wire, sign read from
  //     the citation mask.
  //   saCellOneHotForm / saCellOutZeroForm: the indicator
  //     equations at the citation's output position (binary
  //     big-endian, bit i = 1 iff sign i is +).
  //   saCellOutWitnessForm: formula = ONE strict opposite-sign
  //     atom at presenter witnessFun against the citation's sign
  //     there (Lean signNotMem_of_witness — plain arithmetic on
  //     one presenter output wire, no geometry).
  // witnessCluster/witnessFun ranges (< m, < k) are conformance,
  // the witnessVertex posture of the raw form.
  tsCellStrictInteriorForm : {app: PrimApp, schema: TSSchema,
                              which: TSCellSel, formula: Formula} -> Prop;
  tsCellOneHotForm         : {app: PrimApp, schema: TSSchema,
                              which: TSCellSel, formula: Formula} -> Prop;
  tsCellOutWitnessForm     : {app: PrimApp, schema: TSSchema,
                              which: TSCellSel, witnessCluster: Nat,
                              witnessVertex: Nat, formula: Formula} -> Prop;
  tsCellOutZeroForm        : {app: PrimApp, schema: TSSchema,
                              which: TSCellSel, formula: Formula} -> Prop;
  saCellStrictInteriorForm : {app: PrimApp, schema: SASchema,
                              which: SACellSel, formula: Formula} -> Prop;
  saCellOneHotForm         : {app: PrimApp, schema: SASchema,
                              which: SACellSel, formula: Formula} -> Prop;
  saCellOutWitnessForm     : {app: PrimApp, schema: SASchema,
                              which: SACellSel, witnessFun: Nat,
                              formula: Formula} -> Prop;
  saCellOutZeroForm        : {app: PrimApp, schema: SASchema,
                              which: SACellSel, formula: Formula} -> Prop;

  // --- The flavored rule pair, flavor 1 (tensor-simplicial) --
  // Field and axiom family: the raw pair's, with schema_bound
  // deriving the FLAVORED linkage — so the flavor-uniqueness
  // teeth cut BOTH ways through the same three refusals: a
  // flavored app cited by a raw-only node acquires a legacy arm
  // and refuses (the legacy-pair denials), and a legacy app cited
  // by a flavored node acquires a flavored arm and refuses (the
  // same denials, other arm). The which_schema tie is judged, not
  // chased (under chase it would repair by unifying schema
  // entities instead of refusing — the type-equation posture of
  // the flavored schema rows above).
  PCellInInteriorTS : Set;
  PCellInInteriorTS/proof   : PCellInInteriorTS -> Proof;
  PCellInInteriorTS/premise : PCellInInteriorTS -> Proof;
  PCellInInteriorTS/cellApp : PCellInInteriorTS -> PrimApp;
  PCellInInteriorTS/schema  : PCellInInteriorTS -> TSSchema;
  PCellInInteriorTS/which   : PCellInInteriorTS -> TSCellSel;

  report ax/applicable/PCellInInteriorTS/app_isCell :
    forall p : PCellInInteriorTS.
    |- p PCellInInteriorTS/cellApp PrimApp/prim = PCell;
  chase ax/applicable/PCellInInteriorTS/schema_bound :
    forall p : PCellInInteriorTS.
    |- {app: p PCellInInteriorTS/cellApp,
        schema: p PCellInInteriorTS/schema} CellSchemaTS;
  report ax/applicable/PCellInInteriorTS/which_schema :
    forall p : PCellInInteriorTS.
    |- p PCellInInteriorTS/which TSCellSel/schema
     = p PCellInInteriorTS/schema;
  report ax/applicable/PCellInInteriorTS/pre :
    forall p : PCellInInteriorTS.
    |- p PCellInInteriorTS/proof Proof/concludes Judgment/pre
     = p PCellInInteriorTS/premise Proof/concludes Judgment/pre;
  report ax/applicable/PCellInInteriorTS/premise_post :
    forall p : PCellInInteriorTS.
    |- {app: p PCellInInteriorTS/cellApp,
        schema: p PCellInInteriorTS/schema,
        which: p PCellInInteriorTS/which,
        formula: p PCellInInteriorTS/premise Proof/concludes Judgment/post}
       tsCellStrictInteriorForm;
  report ax/applicable/PCellInInteriorTS/conclusion :
    forall p : PCellInInteriorTS.
    |- {app: p PCellInInteriorTS/cellApp,
        schema: p PCellInInteriorTS/schema,
        which: p PCellInInteriorTS/which,
        formula: p PCellInInteriorTS/proof Proof/concludes Judgment/post}
       tsCellOneHotForm;

  PCellOutTS : Set;
  PCellOutTS/proof   : PCellOutTS -> Proof;
  PCellOutTS/premise : PCellOutTS -> Proof;
  PCellOutTS/cellApp : PCellOutTS -> PrimApp;
  PCellOutTS/schema  : PCellOutTS -> TSSchema;
  PCellOutTS/which   : PCellOutTS -> TSCellSel;  // nu, the zeroed cell
  PCellOutTS/witnessCluster : PCellOutTS -> Nat; // the refuting cluster
  PCellOutTS/witnessVertex  : PCellOutTS -> Nat; // the separating vertex
                                                 // in that cluster's
                                                 // complex

  report ax/applicable/PCellOutTS/app_isCell :
    forall p : PCellOutTS.
    |- p PCellOutTS/cellApp PrimApp/prim = PCell;
  chase ax/applicable/PCellOutTS/schema_bound :
    forall p : PCellOutTS.
    |- {app: p PCellOutTS/cellApp,
        schema: p PCellOutTS/schema} CellSchemaTS;
  report ax/applicable/PCellOutTS/which_schema :
    forall p : PCellOutTS.
    |- p PCellOutTS/which TSCellSel/schema = p PCellOutTS/schema;
  report ax/applicable/PCellOutTS/pre :
    forall p : PCellOutTS.
    |- p PCellOutTS/proof Proof/concludes Judgment/pre
     = p PCellOutTS/premise Proof/concludes Judgment/pre;
  report ax/applicable/PCellOutTS/premise_post :
    forall p : PCellOutTS.
    |- {app: p PCellOutTS/cellApp, schema: p PCellOutTS/schema,
        which: p PCellOutTS/which,
        witnessCluster: p PCellOutTS/witnessCluster,
        witnessVertex: p PCellOutTS/witnessVertex,
        formula: p PCellOutTS/premise Proof/concludes Judgment/post}
       tsCellOutWitnessForm;
  report ax/applicable/PCellOutTS/conclusion :
    forall p : PCellOutTS.
    |- {app: p PCellOutTS/cellApp, schema: p PCellOutTS/schema,
        which: p PCellOutTS/which,
        formula: p PCellOutTS/proof Proof/concludes Judgment/post}
       tsCellOutZeroForm;

  // --- The flavored rule pair, flavor 2 (full-semialgebraic) --
  // Pinning's exclusion side condition discharges FREE
  // (sign_exclusion); the Cell-Out witness is one strict
  // arithmetic atom — the flavor's zero-certificate-bytes payoff
  // at the rule layer.
  PCellInInteriorSA : Set;
  PCellInInteriorSA/proof   : PCellInInteriorSA -> Proof;
  PCellInInteriorSA/premise : PCellInInteriorSA -> Proof;
  PCellInInteriorSA/cellApp : PCellInInteriorSA -> PrimApp;
  PCellInInteriorSA/schema  : PCellInInteriorSA -> SASchema;
  PCellInInteriorSA/which   : PCellInInteriorSA -> SACellSel;

  report ax/applicable/PCellInInteriorSA/app_isCell :
    forall p : PCellInInteriorSA.
    |- p PCellInInteriorSA/cellApp PrimApp/prim = PCell;
  chase ax/applicable/PCellInInteriorSA/schema_bound :
    forall p : PCellInInteriorSA.
    |- {app: p PCellInInteriorSA/cellApp,
        schema: p PCellInInteriorSA/schema} CellSchemaSA;
  report ax/applicable/PCellInInteriorSA/which_schema :
    forall p : PCellInInteriorSA.
    |- p PCellInInteriorSA/which SACellSel/schema
     = p PCellInInteriorSA/schema;
  report ax/applicable/PCellInInteriorSA/pre :
    forall p : PCellInInteriorSA.
    |- p PCellInInteriorSA/proof Proof/concludes Judgment/pre
     = p PCellInInteriorSA/premise Proof/concludes Judgment/pre;
  report ax/applicable/PCellInInteriorSA/premise_post :
    forall p : PCellInInteriorSA.
    |- {app: p PCellInInteriorSA/cellApp,
        schema: p PCellInInteriorSA/schema,
        which: p PCellInInteriorSA/which,
        formula: p PCellInInteriorSA/premise Proof/concludes Judgment/post}
       saCellStrictInteriorForm;
  report ax/applicable/PCellInInteriorSA/conclusion :
    forall p : PCellInInteriorSA.
    |- {app: p PCellInInteriorSA/cellApp,
        schema: p PCellInInteriorSA/schema,
        which: p PCellInInteriorSA/which,
        formula: p PCellInInteriorSA/proof Proof/concludes Judgment/post}
       saCellOneHotForm;

  PCellOutSA : Set;
  PCellOutSA/proof   : PCellOutSA -> Proof;
  PCellOutSA/premise : PCellOutSA -> Proof;
  PCellOutSA/cellApp : PCellOutSA -> PrimApp;
  PCellOutSA/schema  : PCellOutSA -> SASchema;
  PCellOutSA/which   : PCellOutSA -> SACellSel;  // tau, the zeroed cell
  PCellOutSA/witnessFun : PCellOutSA -> Nat;     // the refuting presenter

  report ax/applicable/PCellOutSA/app_isCell :
    forall p : PCellOutSA.
    |- p PCellOutSA/cellApp PrimApp/prim = PCell;
  chase ax/applicable/PCellOutSA/schema_bound :
    forall p : PCellOutSA.
    |- {app: p PCellOutSA/cellApp,
        schema: p PCellOutSA/schema} CellSchemaSA;
  report ax/applicable/PCellOutSA/which_schema :
    forall p : PCellOutSA.
    |- p PCellOutSA/which SACellSel/schema = p PCellOutSA/schema;
  report ax/applicable/PCellOutSA/pre :
    forall p : PCellOutSA.
    |- p PCellOutSA/proof Proof/concludes Judgment/pre
     = p PCellOutSA/premise Proof/concludes Judgment/pre;
  report ax/applicable/PCellOutSA/premise_post :
    forall p : PCellOutSA.
    |- {app: p PCellOutSA/cellApp, schema: p PCellOutSA/schema,
        which: p PCellOutSA/which,
        witnessFun: p PCellOutSA/witnessFun,
        formula: p PCellOutSA/premise Proof/concludes Judgment/post}
       saCellOutWitnessForm;
  report ax/applicable/PCellOutSA/conclusion :
    forall p : PCellOutSA.
    |- {app: p PCellOutSA/cellApp, schema: p PCellOutSA/schema,
        which: p PCellOutSA/which,
        formula: p PCellOutSA/proof Proof/concludes Judgment/post}
       saCellOutZeroForm;

  // --- Per-cell obligation keys ------------------------------
  // The one-instance representation's obligation plane: a
  // judgment whose subject is one cell of a flavored app's
  // derived roster cites that cell SCHEMA-EXPLICITLY, through the
  // same citation entities the rule pair consumes — never by
  // re-carrying the cell's description in the judgment's own
  // bytes (the unrolled persist_2d shape this vocabulary
  // retires: one file per obligation, each repeating its region).
  // The tie derives the flavored linkage (the nodes' teeth,
  // shared), and the cited cell is functional per (judgment,
  // app). Which FORMULA the judgment carries remains judgment
  // content (value plane, the strata split); pruning interaction
  // is counting plane: per-cell obligation coverage at flavor 2
  // counts over UNPRUNED cells only (Lean prune_discharge — a
  // branch over a pruned cell is ex falso), and emptiness marks
  // never shrink the roster.
  tsCellObligation : {j: Judgment, app: PrimApp, cell: TSCellSel} -> Prop;
  saCellObligation : {j: Judgment, app: PrimApp, cell: SACellSel} -> Prop;

  chase ax/obl/ts_schema_bound : forall j : Judgment, app : PrimApp,
      sel : TSCellSel.
    {j: j, app: app, cell: sel} tsCellObligation
    |- {app: app, schema: sel TSCellSel/schema} CellSchemaTS;
  chase ax/obl/ts_cell_functional : forall j : Judgment,
      app : PrimApp, s1 : TSCellSel, s2 : TSCellSel.
    {j: j, app: app, cell: s1} tsCellObligation,
    {j: j, app: app, cell: s2} tsCellObligation
    |- s1 = s2;
  chase ax/obl/sa_schema_bound : forall j : Judgment, app : PrimApp,
      sel : SACellSel.
    {j: j, app: app, cell: sel} saCellObligation
    |- {app: app, schema: sel SACellSel/schema} CellSchemaSA;
  chase ax/obl/sa_cell_functional : forall j : Judgment,
      app : PrimApp, s1 : SACellSel, s2 : SACellSel.
    {j: j, app: app, cell: s1} saCellObligation,
    {j: j, app: app, cell: s2} saCellObligation
    |- s1 = s2;

// The cell-schema conformance family (loader/evaluation plane, beside
// the certificate plane's admission table; LOAD-REJECTION strength: a
// row bundle violating any clause refuses whole, nothing admitted).
// Stated here as the family's normative text; the reference
// realization is a named next change of the certificate-extension
// (rows-reader) lane --- NOTHING below is implemented yet, and no
// pipeline receipt gates instance rows. "Counting is not geometric"
// --- every clause below is a finite scan or count over sealed rows,
// exactly the class the certificate plane's admission table already
// gates. ORDERING DISCIPLINE: the structural clauses (flavor-
// uniqueness's stored-primitive check, all type comparisons) run
// BEFORE any chase; flavor-uniqueness's exactly-one count runs AGAIN
// on saturated rows (equality saturation can merge apps and collide
// arms); the report-mode wf axioms are judgment producers, never
// gates --- the gates are these clauses.
//
//   Flavor-uniqueness:  every PCell app carries EXACTLY ONE schema
//     linkage row across the three families {CellSchema, CellSchemaTS,
//     CellSchemaSA}; a linkage row of ANY family on an app whose
//     stored primitive is not PCell refuses (the legacy "CellSchema
//     row on a non-Cell app" orphan rejection extended to all three
//     families, checked against stored primitive rows pre-chase); the
//     exactly-one count is re-checked post-saturation. This clause
//     REPLACES and GENERALIZES the certificate plane's legacy "per
//     Cell app, exactly one CellSchema row" and "every Cell app its
//     CellSchema row" clauses (which would otherwise reject every
//     flavored app); the schema-divergence check follows the bound
//     arm. Flavor tag 0/1/2 is derived from the family, never stored.
//     NODE BINDING: every cell-rule proof node unconditionally
//     derives its OWN flavor's linkage row for its app (the
//     schema_bound axioms) --- the raw pair (PCellInInterior,
//     PCellOut) a legacy CellSchema row, the flavored quartet
//     (PCellInInteriorTS/PCellOutTS/PCellInInteriorSA/PCellOutSA,
//     consuming the mechanized CellFlavorsInterior rules) a
//     CellSchemaTS/CellSchemaSA row --- so an app cited by a node of
//     the wrong flavor acquires a second arm at saturation and
//     refuses at the pairwise denials, in every direction. The
//     obligation keys (tsCellObligation/saCellObligation) derive
//     the same arms and inherit the same teeth.
//   Partition (flavor 1):  cluster_of total on 0..D-1 (one value row
//     per position; D = TSSchema/host_dim), entries < n_clusters (the
//     Index-erasure range obligations, mechanically generated); every
//     cluster inhabited (the finite check of
//     ax/wf/TSSchema/cluster_inhabited --- a recorded strengthening of
//     the Lean structure, see the axiom's deviation note); exactly
//     one TSCluster row per index 0..m-1, duplicate-free (the finite
//     check of ax/wf/TSCluster_total + ax/TSCluster_key); per
//     cluster, ambDim(complex) = |cluster| (Lean dimsMatch).
//   Presenters (flavor 2):  exactly one SAFun row per index 0..k-1,
//     duplicate-free (the finite check of ax/wf/SAFun_total +
//     ax/SAFun_key); each presenter's in_wire lies IN its out-cone
//     ({from: in_wire, to: out_wire} reachesEq --- in-cone MEMBERSHIP,
//     not a boundary test; the finite check of
//     ax/wf/SAFun/in_reaches_out --- without it a designated input off
//     the cone reconstructs no Lean domOk).
//   Arity:  the host cell app's output port count equals the derived
//     roster size --- flavor 1: prod_c nCells(K_c); flavor 2: 2^k
//     ALWAYS (emptiness marks never shrink the roster or the arity).
//     Extends the certificate plane's per-app port-arity rule, whose
//     Cell row (1 -> n) reads n from the flavor-derived roster.
//   Output order (normative; these equations match the landed Lean
//     expansion's demonstration instance, whose quadrant flat index
//     is 2*k0 + k1):  flavor 1, mixed-radix BIG-ENDIAN in the cluster
//     index --- output position of the product cell kappa is
//     sum_c kappa_c * prod_{c' > c} nCells(K_{c'})  (cluster 0 most
//     significant); flavor 2, binary BIG-ENDIAN in the function index
//     --- output position of sign vector sigma is
//     sum_i bit_i * 2^(k-1-i)  with bit_i = 1 iff sigma_i = plus
//     (function 0 most significant; at k = 1 this matches the
//     two-cell sign complex's cell order (minus, plus) =
//     positions (0, 1)).  Conclusion-form providers consume these
//     equations.
//   Signature (flavor 1):  host_dim = totalSize(shape of the app's
//     input wire) --- the flavored typing rule's flattening; rank is
//     free (this row resolves the rank-1 seam on the core box).
//   Signature (flavor 2):  ALL type checks are STRUCTURAL comparisons
//     over the stored type rows, run pre-chase (the report-mode type
//     axioms are statements, not gates --- under chase they would
//     repair by unification): host_type's dtype is Q (Lean domOk);
//     the app input wire's type equals host_type --- including at
//     k = 0 (Lean hostShape is schema-level data precisely so
//     presenter-free schemas cannot link apps of different types);
//     each presenter's in_wire type equals host_type; each
//     presenter's out type is rank-1 Q with axis-0 extent 1 (with
//     cod_dtype/cod_rank, the full adopted scalar codomain);
//     cell-freeness (the refusal's finite check: no PCell output in
//     any presenter's out-cone --- see the declaration's restriction
//     note on cells upstream of the host). The same-host-VALUE wiring
//     condition (all presenters read the value the app reads, through
//     Copy fan-out) is evaluation-plane, owned by the FLAVORED cell
//     rules' conclusion forms --- the currently declared cell forms
//     are raw-only, so no schema-only consumer may treat
//     sign_exclusion as discharged at the application level from
//     these rows alone.
//   Certificates:  flavor 0 --- the app's complex carries the FULL
//     off-diagonal FarkasPairCert roster: exactly 2 * C(nCells, 2)
//     rows, one per ordered pair, each passing farkasPairValid;
//     flavor 1 --- per cluster, either the cluster complex's full
//     off-diagonal roster or a species citation whose registry
//     binding validates the COMPLEX CONTENT (canonical parameters /
//     content identity), yielding that complex's exclusion; flavor 2
//     --- no exclusion bytes (sign exclusion is the checker's own
//     lemma; the rider above on what that does NOT discharge
//     applies); emptiness marks --- every SAPruned row's cited proof
//     passes saEmptyCellForm, and marks are duplicate-free per
//     (sa, sign-vector) (canonical one-mark reconstruction of Lean
//     prunedEmpty).
//   Payload totality (SCOPE: this clause governs FarkasPairCert
//     FUNCTION PAYLOADS --- characteristic-relation masks like
//     SAPruned/plus are membership data, where absence IS the minus
//     reading, never a defaulted payload):  every FarkasPairCert
//     carries complex, cell_i, cell_k, alpha, beta EXACTLY ONCE;
//     gamma is DENSE on every ambient coordinate 0..ambDim-1; ONLY p
//     and q may be sparse --- stored keys lie within the respective
//     cells' masks (p in cell_i's, q in cell_k's), absent entries
//     decode to zero, and no other FUNCTION payload of any Layer 11
//     sort has a default. cell_i/cell_k range against the extension
//     plane's nCells counter for the row's complex. TSCluster/species
//     is the one other optional row (absence = the Farkas-roster
//     route).
//   Coverage (flavor 1; the second vacuity door):  per cluster, a
//     coverage obligation --- the cluster's cells must cover its
//     ambient space, else the product schema is partial and sequents
//     vacuate pointwise off-cover. Discharge routes at this revision:
//     a species citation whose registry entry warrants COVERAGE AS
//     WELL AS EXCLUSION (the library-fan route --- the sign complex
//     and the box fans are total by construction), or a per-cluster
//     cover certificate, whose certificate species is NOT YET LANDED
//     Lean-side --- until it lands, TS schemas discharge coverage by
//     species citation ONLY, and a TS schema with a non-species
//     cluster and no cover certificate REFUSES rather than admitting
//     a partial partition. (Flavor 2 full-roster coverage is free by
//     sign totality; flavor 0 coverage remains the raw schema's open
//     door.)
//   Cell citations & obligations:  TSCellSel/comp dense on the
//     schema's clusters 0..m-1 with entries < nCells(that cluster's
//     complex); SACellSel plus-masks duplicate-free per (schema,
//     sign-vector) (the SAPruned canonicalization, shared);
//     PCellOutTS/witnessCluster < m, witnessVertex in the refuted
//     component's simplex mask (the form rejects otherwise);
//     PCellOutSA/witnessFun < k; per-cell obligation FAMILIES that
//     claim roster coverage count over the derived roster at flavor
//     1 and over UNPRUNED cells at flavor 2 (Lean prune_discharge:
//     pruned branches are ex falso; marks never shrink the roster).
//   Pool arms (a named next change, certificate-extension lane):
//     flavored schema entities enter the certificate object graph
//     with their own dense index families (the complex-pool pattern:
//     certificate-level counters authorizing TSSchema/SASchema index
//     rows), and the admission table's density/totality/orphan rows
//     extend accordingly --- designed with the rows-reader work so the
//     admission boundary stays row-closed, and the admission table's
//     Layer 11 rows adopt the payload-totality clause above verbatim.

  // ==========================================================
  // The discharge kit: PHypMultiplier + PVerifiedCover
  // (revision event 6)
  // ==========================================================
  //
  // There is no discharge-plan TIER — a discharge plan IS a
  // packaged admissible proof node, and both rules enter as
  // turnstile-side Proof species in the established omnibus-hosted
  // idiom (the flavored-cell P-species precedent above; PSubdivide
  // is the tower-landed shape of the cover node's indexed premise
  // families + recomputed cover side-condition). Battery row kits
  // (QProofList, head: Proof) consume both with ZERO widening:
  // they are Proof leaves, and every Proof-typed field can cite
  // them from this revision on.
  //
  // PLACEMENT (the NN-leaf P-1 fork's sibling): omnibus for BOTH —
  // one family, one home; the tower file (the certified external
  // checker's stable fragment boundary) stays byte-stable.
  // PHypMultiplier is pure tower vocabulary and COULD live there;
  // the cover node's oracle + cell-form delegates are
  // omnibus-coupled, and splitting the pair across files is the
  // one option priced strictly worse.

  // ---- HypMultiplier: the Farkas/S-procedure discharge ---------------
  //
  // To prove N <= 0 on cell AND {g >= 0} (a row scoped off a child
  // atom): exhibit lam with two premises on the PLAIN cell —
  // lam >= 0, and N + lam*g <= 0. Pure sequent-tier packaged node
  // (the PCut applicability pattern); the cell scoping rides the
  // shared premise pre, and the child atom enters the conclusion
  // pre as its defining formula, which is why the mechanized
  // warrant's bridge hypothesis (childAtom = {x | 0 <= g x}) is
  // syntactically free here. Region-atom dress is the CONSUMING
  // walk's business via region-decode, never this node's.
  PHypMultiplier : Set;
  PHypMultiplier/proof    : PHypMultiplier -> Proof;
  PHypMultiplier/premLam  : PHypMultiplier -> Proof;  // pre |- 0 <= lam
  PHypMultiplier/premComb : PHypMultiplier -> Proof;  // pre |- N + lam*g <= 0
  PHypMultiplier/lam : PHypMultiplier -> Term;   // the multiplier
  PHypMultiplier/g   : PHypMultiplier -> Term;   // the child atom's polynomial
  PHypMultiplier/n   : PHypMultiplier -> Term;   // the row polynomial

  // Applicability (report mode, the PCut pattern; no encoding
  // freedom in CONTENT — the catalogue display is normative):
  //
  // the two premises share their pre (both are rows on the cell):
  report ax/applicable/PHypMultiplier/pre_match :
    forall p : PHypMultiplier.
    |- p PHypMultiplier/premLam Proof/concludes Judgment/pre
     = p PHypMultiplier/premComb Proof/concludes Judgment/pre;

  // premise posts, spelled through the term grammar (the
  // arithmetic tie is SYNTACTIC; the bounded-computation
  // alternative of the PFarkas genre was priced and not taken —
  // the equations below are the whole tie):
  report ax/applicable/PHypMultiplier/lam_post :
    forall p : PHypMultiplier.
    |- p PHypMultiplier/premLam Proof/concludes Judgment/post
     = {l: 0 TConst, r: p PHypMultiplier/lam} FAtomLE;

  report ax/applicable/PHypMultiplier/comb_post :
    forall p : PHypMultiplier.
    |- p PHypMultiplier/premComb Proof/concludes Judgment/post
     = {l: {l: p PHypMultiplier/n,
            r: {l: p PHypMultiplier/lam,
                r: p PHypMultiplier/g} TMul} TAdd,
        r: 0 TConst} FAtomLE;

  // conclusion: pre = premise pre AND the child atom's defining
  // formula; post = the bare row.
  report ax/applicable/PHypMultiplier/pre :
    forall p : PHypMultiplier.
    |- p PHypMultiplier/proof Proof/concludes Judgment/pre
     = {l: p PHypMultiplier/premLam Proof/concludes Judgment/pre,
        r: {l: 0 TConst, r: p PHypMultiplier/g} FAtomLE} FAnd;

  report ax/applicable/PHypMultiplier/post :
    forall p : PHypMultiplier.
    |- p PHypMultiplier/proof Proof/concludes Judgment/post
     = {l: p PHypMultiplier/n, r: 0 TConst} FAtomLE;

  // Side conditions: NONE NEW — the combination step is Farkas
  // territory and the soundness obligation is pointwise over the
  // landed cone/Farkas vocabulary. The global WF invariant covers
  // the judgment shapes; no wiresPos analogue is needed (no
  // combination over sub-conjuncts is performed by the CHECKER —
  // the premises arrive already proven, so the node is vacuous on
  // empty shapes rather than exploitable).

  // ---- VerifiedCover: row on a cover + certified off-components ------
  //
  // To prove the row P on the scope (dom minus the off-region):
  // prove P per cover cell, and per remaining cut cell prove the
  // off formula. The PSubdivide genre: indexed premise families
  // (no list sorts), a pass-the-node cover relation the checker
  // RECOMPUTES, and formula ties carried as FIELDS whose form
  // obligations are CHASED DEMANDS (the proof-calculus convention:
  // side-condition atoms chase as demand rows — a review-round repair;
  // an earlier spelling put the form relation in a report
  // antecedent, which imposes nothing when the row is absent). ALL
  // FOUR warrant hypotheses carry in-component (a second review-round
  // repair: an earlier spelling assigned the scope bridge to the
  // consuming walk, which left the conclusion pre unconstrained —
  // exploitable — and broke walk neutrality; the spelling below
  // restores both).
  //
  // Warrant-hypothesis carriers, named:
  //   hrowC   -> the per-cover-cell premise equations
  //   hcomp   -> the per-off-cell premise equations
  //   hdecomp -> verifiedCoverSplitValid (chased demand)
  //   hbridge -> vcScopeBridgeForm (chased demand on the scope field)
  PVerifiedCover : Set;
  PVerifiedCover/proof : PVerifiedCover -> Proof;
  PVerifiedCover/cx    : PVerifiedCover -> QGridCx;  // the grid context
  PVerifiedCover/dom   : PVerifiedCover -> Box;      // D_m
  PVerifiedCover/ctx   : PVerifiedCover -> Formula;  // ambient Gamma
  PVerifiedCover/off   : PVerifiedCover -> Formula;  // the off-region's
      // defining formula (ONE formula, roster-uniform — the
      // mechanized warrant itself has one Off set)
  PVerifiedCover/scopeF : PVerifiedCover -> Formula; // the scope
      // formula the conclusion pre carries; tied to (dom, off) by
      // the chased bridge demand below — NEVER free

  PVerifiedCover/nCover : PVerifiedCover -> Nat;
  PVerifiedCover/coverCell : {p: PVerifiedCover,
                              k: p PVerifiedCover/nCover Index} -> Nat;
  PVerifiedCover/coverForm : {p: PVerifiedCover,
                              k: p PVerifiedCover/nCover Index} -> Formula;
  PVerifiedCover/coverProof : {p: PVerifiedCover,
                               k: p PVerifiedCover/nCover Index} -> Proof;
      // Gamma AND (x in cell coverCell k) |- P

  PVerifiedCover/nOff : PVerifiedCover -> Nat;
  PVerifiedCover/offCell : {p: PVerifiedCover,
                            j: p PVerifiedCover/nOff Index} -> Nat;
  PVerifiedCover/offForm : {p: PVerifiedCover,
                            j: p PVerifiedCover/nOff Index} -> Formula;
  PVerifiedCover/offProof : {p: PVerifiedCover,
                             j: p PVerifiedCover/nOff Index} -> Proof;
      // Gamma AND (x in cell offCell j) |- off
      // (exact Bernstein upper bounds in practice — cone leaves)

  // The cover relation receives the node itself (PSubdivide's
  // signature-repair idiom — the indexed rosters are field
  // accesses on p). Bounded computation: the grid cut of dom at
  // cx's piece boundaries yields a finite cell set; every cut
  // cell's id appears in exactly one of the two rosters, and every
  // roster id is a cut cell. Fail-closed on holes. CANONICAL-V1
  // POLICY (labeled as policy, not warrant-implied): duplicates,
  // roster overlap, and out-of-cut ids refuse in v1 — the
  // mechanized warrant permits all three (it needs only dom minus
  // the cover inside the union of components), so a later revision
  // may relax; the refusals are walk-simplicity, sound in the
  // over-refusal direction only.
  verifiedCoverSplitValid : {p: PVerifiedCover} -> Prop;

  report ax/applicable/PVerifiedCover/split :
    forall p : PVerifiedCover.
    |- {p: p} verifiedCoverSplitValid;

  // Cell-membership form obligations: each roster formula FIELD is
  // tied to its cell by a JUDGING-mode demand on a bounded-computation
  // form relation (the sa/ts*Form idiom — destructures cx + cell
  // id, verifies the membership conjunction; REJECTS ids out of
  // range). Demand judgments pend at the walk; the oracle discharges
  // each or leaves a loud deferral — absence of discharge is never
  // silent acceptance (the demand-judgment convention).
  vcCellMemberForm : {cx: QGridCx, cell: Nat, formula: Formula} -> Prop;

  report ax/applicable/PVerifiedCover/cover_form :
    forall p : PVerifiedCover, k : p PVerifiedCover/nCover Index.
    |- {cx: p PVerifiedCover/cx,
        cell: {p: p, k: k} PVerifiedCover/coverCell,
        formula: {p: p, k: k} PVerifiedCover/coverForm} vcCellMemberForm;

  report ax/applicable/PVerifiedCover/off_form :
    forall p : PVerifiedCover, j : p PVerifiedCover/nOff Index.
    |- {cx: p PVerifiedCover/cx,
        cell: {p: p, j: j} PVerifiedCover/offCell,
        formula: {p: p, j: j} PVerifiedCover/offForm} vcCellMemberForm;

  // The scope bridge — hbridge's carrier, IN-COMPONENT. Bounded
  // computation: scopeF is the conjunction of dom-membership with
  // the complement of off, the complement computed by the oracle
  // through the NNF atom-inward moves (exact for the nonstrict
  // atom grammar; the negation lives inside the bounded
  // computation, never in the formula grammar):
  vcScopeBridgeForm : {dom: Box, off: Formula, formula: Formula} -> Prop;

  report ax/applicable/PVerifiedCover/scope_bridge :
    forall p : PVerifiedCover.
    |- {dom: p PVerifiedCover/dom, off: p PVerifiedCover/off,
        formula: p PVerifiedCover/scopeF} vcScopeBridgeForm;

  // Premise equations (report mode, PCut pattern) — the roster
  // formula fields appear directly; no relation in any antecedent:
  report ax/applicable/PVerifiedCover/cover_pre :
    forall p : PVerifiedCover, k : p PVerifiedCover/nCover Index.
    |- {p: p, k: k} PVerifiedCover/coverProof Proof/concludes Judgment/pre
     = {l: p PVerifiedCover/ctx,
        r: {p: p, k: k} PVerifiedCover/coverForm} FAnd;

  report ax/applicable/PVerifiedCover/cover_post :
    forall p : PVerifiedCover, k : p PVerifiedCover/nCover Index.
    |- {p: p, k: k} PVerifiedCover/coverProof Proof/concludes Judgment/post
     = p PVerifiedCover/proof Proof/concludes Judgment/post;

  report ax/applicable/PVerifiedCover/off_pre :
    forall p : PVerifiedCover, j : p PVerifiedCover/nOff Index.
    |- {p: p, j: j} PVerifiedCover/offProof Proof/concludes Judgment/pre
     = {l: p PVerifiedCover/ctx,
        r: {p: p, j: j} PVerifiedCover/offForm} FAnd;

  report ax/applicable/PVerifiedCover/off_post :
    forall p : PVerifiedCover, j : p PVerifiedCover/nOff Index.
    |- {p: p, j: j} PVerifiedCover/offProof Proof/concludes Judgment/post
     = p PVerifiedCover/off;

  // The concluded judgment — BOTH sides constrained (a review-round
  // repair: an earlier strawman left the conclusion pre without
  // any equation):
  report ax/applicable/PVerifiedCover/pre :
    forall p : PVerifiedCover.
    |- p PVerifiedCover/proof Proof/concludes Judgment/pre
     = {l: p PVerifiedCover/ctx, r: p PVerifiedCover/scopeF} FAnd;

  // (post: the node's row P is READ OFF the cover premises via
  // cover_post — the conclusion post equals every cover premise's
  // post by that equation family; a degenerate all-off node
  // (nCover = 0) has no row anchor and REFUSES at the split
  // relation, which demands at least one cover cell in v1 —
  // canonical-v1 policy, same class as the duplicate refusal.)

  // Soundness sketch against the components warrant, carrier by
  // carrier: assume Gamma and scopeF (= x in dom, not off — the
  // bridge demand). The split demand gives: the cut of dom is
  // exactly the two rosters. x in dom lands in some cut cell. A
  // cover cell k: coverProof k gives P (hrowC, Gamma-relativized).
  // An off cell j: offProof j gives off (hcomp), contradicting
  // scopeF. Pointwise, exactly the mechanized argument with C :=
  // the cover-cell union and K_j := the off cells. The warrant is
  // dimension-free, so n-D readiness is free at this tier.

  // ==========================================================
  // THE CERTIFICATE SECTIONS (judgments, proofs, batteries,
  // regions, wire composition, stored values, ground programs,
  // and the verdict form)
  // ==========================================================
  //
  // What sits ABOVE the subject: what a certificate IS, as ordinary
  // rows. A revision loading this theory can STATE a satisfaction
  // claim (a System paired with a Spec), COMPILE it into the
  // two-polarity verdict form, and DISCHARGE it through the battery
  // and rule-node vocabulary whose obligations are exact-rational
  // rows a checker replays — never a producer's word. The
  // declaration idioms, identity semantics, and axiom modes are the
  // file header's, unchanged. Proof-content ties that consume a
  // rule node's premise kit (which judgment a node's proof
  // concludes, per-kind conclusion typing, the per-node premise
  // walks) are the rule stratum's material and are deliberately
  // absent here.

  // ==========================================================
  // Judgments and proofs
  // ==========================================================
  //
  // A judgment is an entity: one claim instance, concluded by zero
  // or more proofs. A proof is an entity concluding exactly one
  // judgment. Everything a proof cites — batteries, walks, leaf
  // sequents — hangs off the node sorts below; the polynomial proof
  // calculus's own leaf sort (Proof) arrives by extension and is
  // cited wherever a single exact-rational sequent is the
  // obligation.

  QJudgment : Set;   // entity: one claim instance
  QProof    : Set;   // entity: one proof of one judgment

  QProof/concludes : QProof -> QJudgment;

  // ==========================================================
  // Certificate families and tables
  // ==========================================================
  //
  // A certificate family is an entity naming one family of
  // certificate functions (a barrier, a ranking function, a
  // Lyapunov-shaped envelope), with a table giving its piecewise
  // polynomial content: one row per piece, keyed by the mode the
  // piece applies in and the piece's domain cell. Modes are cited
  // as entities — the manifest's own mode roster, which the
  // producer mints and the table cites (the generator plane's
  // prDrift/prDiff convention) — never by name string: a piece
  // citing a nonexistent mode is unrepresentable rather than a
  // silent key mismatch. Region atoms read families at thresholds.

  QCertFam      : Set;   // entity: one certificate family
  QCertTable    : Set;   // value-like: the family's piecewise rows
  QCertCombList : Set;   // affine combinations of families

  QCertFam/name  : QCertFam -> Str;
  QCertFam/table : QCertFam -> QCertTable;

  qctNil  : QCertTable;
  qctCons : {dom: Box, mode: Mode, tail: QCertTable, val: Poly}
    -> QCertTable;

  qccNil  : QCertCombList;
  qccCons : {coeff: Q, fam: QCertFam, tail: QCertCombList}
    -> QCertCombList;

  // ==========================================================
  // Region atoms
  // ==========================================================
  //
  // The three region languages: a family's sublevel set at a
  // threshold, a box, and an affine combination of families at a
  // threshold. A region atom is value-like — two spellings of one
  // content are one atom — and the three constructors are three
  // distinct languages, never interchangeable spellings.

  QRegionAtom : Set;

  qraSublevel : {cert: QCertFam, thr: Q} -> QRegionAtom;
  qraBox      : Box -> QRegionAtom;
  qraAffine   : {row: QCertCombList, thr: Q} -> QRegionAtom;

  refuse ax/qcert/region_sublevel_box_disjoint : forall c : QCertFam,
      t : Q, b : Box, r : QRegionAtom.
    r = {cert: c, thr: t} qraSublevel, r = b qraBox
    |- false;

  // ==========================================================
  // Proof, rational, box, and natural lists
  // ==========================================================
  //
  // Positional carriers for row kits. QProofList carries proof-leaf
  // kits (battery rows); QRatList carries exact-rational vectors
  // (value tables, cut lists, token coordinates); QBoxList carries
  // covers; QNatList is the generic UNSORTED natural cons-list —
  // deliberately not the ground sequence sort, whose wire connotes
  // a sortedness these carriers do not have (causality ranks, base
  // resolutions).

  QProofList : Set;
  QRatList   : Set;
  QBoxList   : Set;
  QNatList   : Set;

  qplNil  : QProofList;
  qplCons : {head: Proof, tail: QProofList} -> QProofList;

  qrlNil  : QRatList;
  qrlCons : {head: Q, tail: QRatList} -> QRatList;

  qbxNil  : QBoxList;
  qbxCons : {head: Box, tail: QBoxList} -> QBoxList;

  qnlNil  : QNatList;
  qnlCons : {head: Nat, tail: QNatList} -> QNatList;

  refuse ax/qcert/qpl_nil_cons_disjoint : forall h : Proof,
      t : QProofList, l : QProofList.
    l = qplNil, l = {head: h, tail: t} qplCons
    |- false;

  // ==========================================================
  // The satisfaction judgments
  // ==========================================================
  //
  // QSat: the pairing claim — System satisfies Spec. The claim
  // record is whole: subject and specification are exactly-one
  // attributes, read by every consumer. The closing content is
  // optional by ROUTE: a region-warranted root claim carries a
  // warrant (the region-satisfaction child whose formula is the
  // spec's root) and an initial-membership evaluation leaf; a
  // composite claim concluded through the wire-composition family
  // carries neither — its conclusions arrive through that family's
  // premise kits. Optional-by-route content rides relations, never
  // partial functions: geolog functions carry totality obligations,
  // and a partial spelling would smuggle the route split into sort
  // structure. At most one warrant and at most one evaluation row
  // per claim is admission conformance (C-CERT-CLAIM).

  QSat : Set;   // entity: one satisfaction claim

  QSat/judgment : QSat -> QJudgment;
  QSat/sys      : QSat -> System;
  QSat/spec     : QSat -> Spec;

  qsat_warrant : {sat: QSat, warrant: QForallSat} -> Prop;
      // zero rows = the composite route; at most one is admission
      // conformance. The warrant is a forall-face ENTITY (revision
      // event 6: the warrant seam unified onto the verdict
      // stratum's component-on-region claim, below), so which
      // component it warrants is INTRINSIC to the entity — in-row
      // disagreement between a component field and the warrant's
      // formula is unrepresentable, which is what retired the
      // refuse-mode root ties of the earlier edition. A warrant
      // citing a NON-CONSUMED component stays representable and
      // stays caught by the fail-closed membership demand below.
  qsat_eval : {sat: QSat, eval: Proof} -> Prop;
      // the initial-membership evaluation leaf for the
      // degenerate-box-vs-sublevel constructor pair; the other
      // pairs ride the init-membership evaluator below

  // Interface agreement: when the specification carries an
  // interface, it IS the subject's presented one — one
  // equality-generating atom against the store-and-check
  // System/iface (functionality merges stored with derived; a
  // mismatch collapses to a loud clash through interface
  // hash-consing). Closed specifications (no interface row) pair
  // with closed systems as the empty-interface instance, which is a
  // spelling, not a constructor.

  chase ax/qsat/iface_agree : forall r : QSat, y : System, sp : Spec,
      i : Iface.
    r QSat/sys = y,
    r QSat/spec = sp,
    {spec: sp, iface: i} spec_iface
    |- y System/iface = i;

  // THE ADMISSION FENCES (maintenance rule on the cap's admission
  // checklist: a future non-body-anchored ForallSpec family
  // extends the fence in the same revision that adds it): the
  // regret faces are admitted by sort at the verdict form and
  // deliberately never warranted here — a regret component's
  // discharge is the hole-filling machinery's, not a region
  // warrant's.
  refuse ax/qsat/warrant_fence_regret : forall r : QSat,
      c : QForallSat, e : Q, p : System, g : PathObservable.
    {sat: r, warrant: c} qsat_warrant,
    c QForallSat/component = {eps: e, pi: p, ret: g} SRegretLE
    |- false;

  // The initial-membership demand: the subject's initial data lies
  // inside the warrant's region. Discharged per constructor pair at
  // the ground seam (degenerate-box against sublevel is the
  // evaluation leaf; fat box against sublevel is an enclosure
  // family; box against box is interval containment), loudly
  // deferred while unrealized. Composite claims (no warrant row)
  // are untouched — the premise conditions on the warrant.
  qtsl_init_member : {region: QRegionAtom, sys: System} -> Prop;
      // side-condition

  report ax/wf/qsat_init : forall r : QSat, y : System, c : QForallSat.
    r QSat/sys = y,
    {sat: r, warrant: c} qsat_warrant
    |- {region: c QForallSat/region, sys: y} qtsl_init_member;

  // Warrant-component membership (the F-7 review repair): the cited
  // component must be among the claimed spec's consumed components.
  // A side-condition demand, fail-closed at the ground seam (the
  // evaluator checks spec_consumes post-saturation, through any
  // depth of disjunction) — deliberately NOT a derived component
  // row, which would silently rewrite the producer's claim, and
  // deliberately not a negated-membership refusal, which would
  // negate a still-growing derived relation mid-chase.
  qtsl_warrant_member : {spec: Spec, f: ForallSpec} -> Prop;
      // side-condition

  report ax/wf/qsat_warrant_member : forall r : QSat, sp : Spec,
      c : QForallSat.
    {sat: r, warrant: c} qsat_warrant,
    r QSat/spec = sp
    |- {spec: sp, f: c QForallSat/component} qtsl_warrant_member;

  // The per-claim conformance walk (the F-4 review repair — the
  // C-CERT-CLAIM family realized per the header discipline, one
  // demand per satisfaction claim): at-most-one warrant/eval/
  // verdict rows; warrant-route exclusivity (never both qsat_warrant
  // and qsat_guard_warrant); and the HOLE ledger — the paired
  // subject's hole count matches the spec's regret demand (zero
  // holes absent regret components, exactly one with them, and the
  // certificate face's filler fills it), so a holed subject under a
  // seat-free claim is refused at the seam rather than silently
  // demonically closed. Discharged at the ground seam, loudly
  // deferred while unrealized.
  qtsl_cert_claim_wf : {sat: QSat} -> Prop;   // side-condition

  report ax/wf/cert_claim_wf : forall r : QSat.
    |- {sat: r} qtsl_cert_claim_wf;

  // ==========================================================
  // The guarded specification (the record's guard slot) and its
  // warrant route
  // ==========================================================
  //
  // Guard(R, s): the body's guarantee, conditioned on an
  // initial-region antecedent — demanded of every admitted law
  // whose initial marginal is supported in R, with nothing promised
  // off-region. The guard is a predicate ON the subject's initial
  // data, not initial data: the record still binds no model and
  // fixes no initial condition, and the class algebra stays a
  // complement-free distributive lattice (the antecedent is a
  // ground condition on system data, not a behavior class — which
  // is why the conditional lives here and not in StatePred, and why
  // no implication former exists below the cap). The guard region
  // imports the certificate-side region grammar into the record at
  // this slot alone, which is why the slot lives in the certificate
  // sections — the subject strata stay certificate-citation-free by
  // the standing deliberate absence. Zero rows = unguarded; at most
  // one per specification is admission conformance (C-SPEC-GUARD).
  spec_guard : {spec: Spec, region: QRegionAtom} -> Prop;

  // The guarded introduction's warrant route: from the region
  // warrant ALONE — the formula holds from every state of R —
  // conclude the guarded claim, with NO initial-membership premise:
  // the hypothesis the unguarded route discharges at the ground
  // seam (X_0 inside R) is discharged INTO the former instead.
  // Disjoint-by-relation from qsat_warrant, so ax/wf/qsat_init
  // structurally never fires on a guarded introduction — the
  // monotone discharge, no absence-testing anywhere. At most one
  // row per claim, and not alongside a qsat_warrant row, is
  // admission conformance (C-CERT-CLAIM). Elimination — where
  // qtsl_init_member re-enters, recovering the unguarded route —
  // is rule-stratum material, deliberately absent here.
  qsat_guard_warrant : {sat: QSat, warrant: QForallSat} -> Prop;

  // The guarded ties: the claimed spec carries the guard region of
  // the warrant (region_tie — stated as the derived guard row:
  // store-and-check, a disagreeing producer row is a second region
  // on a one-region slot, refused at conformance). The warranted
  // component is intrinsic to the entity (the unified seam — the
  // unguarded route's retired root tie retires here for the same
  // reason), and its consumption membership is the same
  // fail-closed demand.
  chase ax/qguard/region_tie : forall r : QSat, c : QForallSat,
      sp : Spec.
    {sat: r, warrant: c} qsat_guard_warrant,
    r QSat/spec = sp
    |- {spec: sp, region: c QForallSat/region} spec_guard;

  report ax/wf/qguard_warrant_member : forall r : QSat, sp : Spec,
      c : QForallSat.
    {sat: r, warrant: c} qsat_guard_warrant,
    r QSat/spec = sp
    |- {spec: sp, f: c QForallSat/component} qtsl_warrant_member;

  refuse ax/qguard/warrant_fence_regret : forall r : QSat,
      c : QForallSat, e : Q, p : System, g : PathObservable.
    {sat: r, warrant: c} qsat_guard_warrant,
    c QForallSat/component = {eps: e, pi: p, ret: g} SRegretLE
    |- false;

  // ==========================================================
  // Pairing-relative well-formedness demands (the formers whose wf
  // reads the paired subject — minted here, where the pairing is
  // in hand; the gate_scalar admission idiom one stratum up)
  // ==========================================================
  //
  // The shared pairing surface (the F-8 review repair): subject-
  // relative demands key on a DERIVED System-x-Spec pairing
  // relation populated by EVERY direct pairing judgment kind — the
  // exact tier and the statistical tier alike — so a new judgment
  // kind that pairs a subject with a specification joins the
  // demand surface by one populator row, and no kind can bypass
  // the pairing-relative conformance the way a QSat-only premise
  // family would allow.

  qtsl_pairing : {sys: System, spec: Spec} -> Prop;

  chase ax/qsat/pairing : forall r : QSat, y : System, sp : Spec.
    r QSat/sys = y, r QSat/spec = sp
    |- {sys: y, spec: sp} qtsl_pairing;

  chase ax/qsatconf/pairing : forall r : QSatConf, y : System,
      sp : Spec.
    r QSatConf/sys = y, r QSatConf/spec = sp
    |- {sys: y, spec: sp} qtsl_pairing;

  // Seat regret: a claim consuming either regret face demands
  // exactly one hole of the paired subject, on EVERY pairing kind
  // (the qtsl_pairing surface).
  report ax/wf/sregret_one_hole : forall y : System,
      sp : Spec, p : System, e : Q, r : PathObservable,
      f : ForallSpec.
    {sys: y, spec: sp} qtsl_pairing,
    {spec: sp, f: f} spec_consumes,
    f = {eps: e, pi: p, ret: r} SRegretLE
    |- {sys: y, n: 1} qtsl_hole_count;

  report ax/wf/sregret_mark_one_hole : forall y : System,
      sp : Spec, e : Q, r : PathObservable, m : ExistsSpec.
    {sys: y, spec: sp} qtsl_pairing,
    {spec: sp, e: m} spec_consumes_mark,
    m = {eps: e, ret: r} SRegretLEMark
    |- {sys: y, n: 1} qtsl_hole_count;

  // The certificate face's filler must FILL the paired subject's
  // hole (the F-3 review repair — the presence half stated as an
  // enforced existential constraint, never a chased row: chasing
  // would invent closed composites): a lawful hole_fill row from
  // the subject with pi as filler must exist, and its absence is a
  // loud judgment on the claim.
  report ax/wf/sregret_filler_fills : forall y : System,
      sp : Spec, p : System, e : Q, r : PathObservable,
      f : ForallSpec.
    {sys: y, spec: sp} qtsl_pairing,
    {spec: sp, f: f} spec_consumes,
    f = {eps: e, pi: p, ret: r} SRegretLE
    |- exists z : System. {comb: y, filler: p, closed: z} hole_fill;

  // The firing-count roster demand: minted per consumed
  // retFireCount at every pairing (the traversal's
  // spec_consumes_ret closes over disjunction, probability
  // nesting, and the indicator arrows, so no consumed occurrence
  // evades the roster conformance).
  report ax/wf/firecount_roster : forall y : System,
      sp : Spec, ts : TrList, r : PathObservable.
    {sys: y, spec: sp} qtsl_pairing,
    {spec: sp, ret: r} spec_consumes_ret,
    r = {trs: ts} retFireCount
    |- {sys: y, trs: ts} qtsl_firecount_roster;

  // The rate-envelope roster demand (revision event 6): the SAME
  // conformance — every roster member a sys_transition row of the
  // paired subject; the roster duplicate-free — minted per consumed
  // rate-envelope former at every pairing, through the roster
  // projection. One relation, one meaning, two consuming routes.
  report ax/wf/srate_roster : forall y : System, sp : Spec,
      ts : TrList.
    {sys: y, spec: sp} qtsl_pairing,
    {spec: sp, trs: ts} spec_consumes_trs
    |- {sys: y, trs: ts} qtsl_firecount_roster;

  // QSatConf: the statistical tier — the subject satisfies the
  // specification up to the evidence's error budget alpha. A
  // DISTINCT judgment kind, not a QSat field, so that
  // confidence-qualified and exact claims can never be silently
  // mixed: the distinction is a sort distinction the loader cannot
  // blur.

  QSatConf : Set;   // entity: one confidence-qualified claim

  QSatConf/judgment : QSatConf -> QJudgment;
  QSatConf/sys      : QSatConf -> System;
  QSatConf/spec     : QSatConf -> Spec;
  QSatConf/alpha    : QSatConf -> Q;

  chase ax/qsatconf/iface_agree : forall r : QSatConf, y : System,
      sp : Spec, i : Iface.
    r QSatConf/sys = y,
    r QSatConf/spec = sp,
    {spec: sp, iface: i} spec_iface
    |- y System/iface = i;

  // The error budget is a genuine probability, both ends strict:
  // alpha = 0 claims the exact tier in statistical clothes, and
  // alpha = 1 claims nothing.
  report ax/wf/qsatconf_alpha : forall cf : QSatConf, al : Q.
    cf QSatConf/alpha = al
    |- {l: 0, r: al} q_lt, {l: al, r: 1} q_lt;

  // QSpecEquiv: specification equivalence, fields a and b only.
  // Carrier scope is DERIVED from the two sides' former
  // requirements — an equivalence judgment's scope is the
  // intersection of its sides', an empty intersection refuses at
  // conformance, and derived-never-stored means no third field
  // exists to drift.

  QSpecEquiv : Set;   // entity: one equivalence claim

  QSpecEquiv/judgment : QSpecEquiv -> QJudgment;
  QSpecEquiv/a : QSpecEquiv -> Spec;
  QSpecEquiv/b : QSpecEquiv -> Spec;

  // ==========================================================
  // The distance judgments (revision event 6)
  // ==========================================================
  //
  // QDist[d](A, B) <= b — the sibling of QSat at the two-subject
  // face: a distance-functor registry, a subject sum, and one claim
  // entity concluded by proof nodes via QProof/concludes, exactly
  // the QJudgment discipline. The judgment form is the adjudicated
  // =_eps shape (the definite-description reframe: fix T becomes
  // speakable only through the rule whose soundness manufactures
  // the exists-unique). The three concluding node species live with
  // the calculus nodes below.

  // ---- the distance-functor registry ------------------------------
  //
  // Entries are ENTITIES (the mode-roster discipline: cited as
  // entities, never by name string). v0 roster: TV, the
  // gap-pseudometric family (parameterized by its expectation
  // readout), and the W_1 slot — DESIGNED, not realized: no
  // concluding rule family may cite qdW1 until its
  // transport/coupling cell lands (walk-refused, the honest
  // boundary). W_2-product rides the completeness hypothesis at the
  // mechanized tier and enters the registry when its subject sort
  // does.
  QDistEntry : Set;   // entity: one distance-functor registry entry

  qdTV  : QDistEntry;
  qdW1  : QDistEntry;                            // designed; walk-fenced v0
  qdGap : {ret: PathObservable} -> QDistEntry;   // expectation-gap
                                                 // pseudometric at a readout

  refuse ax/qdist/tv_w1_disjoint : forall d : QDistEntry.
    d = qdTV, d = qdW1 |- false;

  refuse ax/qdist/tv_gap_disjoint : forall r : PathObservable,
      d : QDistEntry.
    d = qdTV, d = {ret: r} qdGap |- false;

  refuse ax/qdist/w1_gap_disjoint : forall r : PathObservable,
      d : QDistEntry.
    d = qdW1, d = {ret: r} qdGap |- false;

  // Symmetry-where-flagged: a derived-marker relation the
  // judgment-level admissibles will consume when they mint (the
  // admissibles themselves are deliberately absent — consumer-gated,
  // the credal-stratum calculus-node precedent). All v0 entries are
  // symmetric; the flag exists so a future one-sided entry is
  // expressible without a schema motion.
  qdist_symmetric : {entry: QDistEntry} -> Prop;

  chase ax/qdist/tv_symmetric : |- {entry: qdTV} qdist_symmetric;
  chase ax/qdist/w1_symmetric : |- {entry: qdW1} qdist_symmetric;
  chase ax/qdist/gap_symmetric : forall r : PathObservable.
    |- {entry: {ret: r} qdGap} qdist_symmetric;

  // ---- subjects ---------------------------------------------------
  //
  // The kind's subjects: declared manifests/snapshots AND definite
  // descriptions (fix T), the latter carrying a well-formedness
  // obligation discharged by the concluding rule (QFixBall is the
  // only derivation that makes fix T speakable — the description
  // license is the rule's own soundness exists-unique, no existence
  // stratum consumed).
  QDistSubject : Set;

  qdsSys  : System -> QDistSubject;
      // a component system/manifest subject (QCoupleDrift's sides;
      // QDistTransport's fine/coarse sides)
  qdsSnap : {coords: QRatList} -> QDistSubject;
      // a declared snapshot at exact-Q coordinates (the
      // affine/Euclidean tier); a law-valued snapshot spelling
      // (finite pmf as rows) is the named v2 widening — no
      // committed consumer needs it yet
  qdsFix  : {op: HypernetRef} -> QDistSubject;
      // the definite description fix T — the operator cited by
      // digest, the gate-genus citation pattern; the
      // codomain-shape conformance (endomap on the subject
      // carrier — the gate_scalar sibling) is walk material at the
      // conclusion-resolution step, evaluator-deferred loudly

  refuse ax/qdist/sys_snap_disjoint : forall y : System, c : QRatList,
      s : QDistSubject.
    s = y qdsSys, s = {coords: c} qdsSnap |- false;

  refuse ax/qdist/sys_fix_disjoint : forall y : System,
      h : HypernetRef, s : QDistSubject.
    s = y qdsSys, s = {op: h} qdsFix |- false;

  refuse ax/qdist/snap_fix_disjoint : forall c : QRatList,
      h : HypernetRef, s : QDistSubject.
    s = {coords: c} qdsSnap, s = {op: h} qdsFix |- false;

  // ---- the claim entity (the distance judgment slot) ----------------
  QDistBound : Set;   // entity: one distance claim

  QDistBound/judgment : QDistBound -> QJudgment;
  QDistBound/entry    : QDistBound -> QDistEntry;
  QDistBound/left     : QDistBound -> QDistSubject;
  QDistBound/right    : QDistBound -> QDistSubject;
  QDistBound/bound    : QDistBound -> Q;

  // A distance bound is nonnegative (one rational comparison —
  // report, not refuse, the rate-zero convention).
  report ax/wf/qdist_bound_nonneg : forall b : QDistBound, q : Q.
    b QDistBound/bound = q
    |- {l: 0, r: q} q_le;

  // TV bounds live in [0, 1]: vacuous above 1 but well-formed;
  // deliberately NOT reported — a vacuous bound is a true claim
  // (contrast the inverted carve window, which can never fire).
  // The W_1 fence, v0: no concluding node may cite qdW1 until its
  // transport/coupling cell lands — each node's walk carries the
  // entry-license check (the registry's licensed-rules column,
  // realized walk-side).

  // ==========================================================
  // The timed core (revision event 6)
  // ==========================================================
  //
  // The timed-core equivalence sequent, one layer BELOW the
  // satisfaction judgments: turnstile-side schemata, consumed
  // wherever a timed-core derivation discharges a side sequent.
  // SCOPE: the three basis schemata's slice only; the harvest
  // grows this tier at its own revision (the tier's formula
  // grammar below is sized for the three rules, not the harvest).
  // The tier deliberately does NOT touch ForallSpec/ExistsSpec/
  // Spec: the timed service operator is not a cap former, and the
  // no-modal-dialects-at-the-judgment law is honored by keeping
  // the timed operators INSIDE the tier's own formula sort.
  // Nothing else reads the tier until judgment-side consumers cite
  // timed-core side sequents (a named successor seam, not staged).

  // ---- the tier's formula sort -------------------------------------
  //
  // Timed-core forms over state formulas: the state injection, the
  // timed service operator A_T (debut-as-infimum reading, unpacked
  // without infima: a visit at some t < T + eps for every eps > 0),
  // the box invariant, and the two lattice connectives the three
  // schemata's displays consume.
  TCForm : Set;

  tcState : {arg: StatePred} -> TCForm;
  tcASvc  : {t: Q, arg: TCForm} -> TCForm;    // A_T chi
  tcBox   : {arg: TCForm} -> TCForm;          // Box nu
  tcAnd   : {l: TCForm, r: TCForm} -> TCForm;
  tcOr    : {l: TCForm, r: TCForm} -> TCForm;

  // Deadlines are strictly positive rationals — the schemata's
  // shared side condition, reported at the former.
  report ax/wf/tc_asvc_pos : forall t : Q, f : TCForm, k : TCForm.
    k = {t: t, arg: f} tcASvc
    |- {l: 0, r: t} q_lt;

  // Representative constructor-disjointness (full pairwise family
  // rides the admission checklist, as everywhere).
  refuse ax/tc/state_asvc_disjoint : forall p : StatePred, t : Q,
      f : TCForm, k : TCForm.
    k = {arg: p} tcState, k = {t: t, arg: f} tcASvc |- false;

  refuse ax/tc/box_asvc_disjoint : forall t : Q, f : TCForm,
      g : TCForm, k : TCForm.
    k = {arg: g} tcBox, k = {t: t, arg: f} tcASvc |- false;

  refuse ax/tc/and_or_disjoint : forall a : TCForm, b : TCForm,
      c : TCForm, d : TCForm, k : TCForm.
    k = {l: a, r: b} tcAnd, k = {l: c, r: d} tcOr |- false;

  // ---- the model-class citation --------------------------------------
  //
  // The schemata are class-relative: the relativization schema
  // holds over ALL behaviours (proven closure-free); the
  // first-service pair holds over the fusion-closed
  // attained-debuts class and is INVALID over raw behaviours (the
  // machine-certified countermodels — the side condition is real,
  // not hygiene). The class is data on the claim, so a consumer
  // can never silently launder an attainment-relative equivalence
  // into an unrestricted context.
  TCClass : Set;

  tccAll : TCClass;   // arbitrary behaviours
  tccAtt : TCClass;   // fusion-closed, attained debuts

  refuse ax/tc/class_disjoint : forall k : TCClass.
    k = tccAll, k = tccAtt |- false;

  // ---- the claim entity (the timed-core sequent slot) ----------------
  //
  // A timed-core sequent: lhs REL rhs over a model class, REL in
  // {equivalence, refinement}. The QJudgment discipline: one claim
  // instance, concluded via QProof/concludes.
  TCRel : Set;

  tcrEquiv  : TCRel;   // equivalence (the relativization conclusion)
  tcrRefine : TCRel;   // refinement (the first-service conclusions)

  refuse ax/tc/rel_disjoint : forall k : TCRel.
    k = tcrEquiv, k = tcrRefine |- false;

  QTimedSeq : Set;   // entity: one timed-core sequent claim

  QTimedSeq/judgment : QTimedSeq -> QJudgment;
  QTimedSeq/lhs      : QTimedSeq -> TCForm;
  QTimedSeq/rhs      : QTimedSeq -> TCForm;
  QTimedSeq/rel      : QTimedSeq -> TCRel;
  QTimedSeq/class    : QTimedSeq -> TCClass;

  // ---- the obligation profile spine ----------------------------------
  //
  // The first-service family's (T_i, alpha_i) menu: deadline +
  // obligation pairs, n >= 1 (the mechanized statement is wider
  // than the catalogued n >= 2, harmlessly — the n = 1 instance is
  // degenerate-derivable). v0 obligations are STATE formulas (in
  // the basis cores the obligations are atoms, closed by the
  // grammar); the harvest may widen to TCForm obligations with its
  // own attainment story.
  TCObligList : Set;

  tcoNil  : TCObligList;
  tcoCons : {t: Q, arg: StatePred, tail: TCObligList} -> TCObligList;

  refuse ax/tc/oblig_nil_cons_disjoint : forall t : Q, p : StatePred,
      tl : TCObligList, l : TCObligList.
    l = tcoNil, l = {t: t, arg: p, tail: tl} tcoCons |- false;

  // ---- the three schema nodes -----------------------------------------
  //
  // Premise-free axiom schemata: the nodes carry the instantiation
  // data; the whole verification content is each walk's conclusion
  // resolution (recompute the concluded lhs/rhs shapes from the
  // node's own fields — the FromFold discipline: the concluded
  // claim is never trusted as stored, always re-derived).

  // QInvRelativize — obligation relativization through invariants:
  //   Box nu AND A_T(chi AND nu)  equiv  Box nu AND A_T chi
  // over ALL behaviours (tccAll — the independence witness must
  // deviate in the operator, not the trajectory space).
  QInvRelativize : Set;

  QInvRelativize/proof : QInvRelativize -> QProof;
  QInvRelativize/nu    : QInvRelativize -> StatePred;
  QInvRelativize/chi   : QInvRelativize -> StatePred;
  QInvRelativize/t     : QInvRelativize -> Q;

  report ax/wf/qinvrel_t_pos : forall n : QInvRelativize, t : Q.
    n QInvRelativize/t = t
    |- {l: 0, r: t} q_lt;

  // The walk: concluded claim has rel = tcrEquiv, class = tccAll
  // (the schema owes nothing to the class — stronger classes are
  // weakening, rideable by the future tier calculus, never by this
  // node); lhs/rhs recomputed from (nu, chi, t) as the display's
  // two sides.
  qtsl_tc_invrel : {node: QInvRelativize} -> Prop;   // side-condition

  report ax/wf/tc_invrel_walk : forall n : QInvRelativize.
    |- {node: n} qtsl_tc_invrel;

  // QFirstService — the first-service law, n >= 1:
  //   AND_i A_{T_i} alpha_i  refines  A_{min_i T_i}(fsTarget)
  // fsTarget = OR_i (alpha_i AND AND_{j != i} A_{T_j} alpha_j):
  // some obligation served RIGHT HERE while every other still binds
  // at its ORIGINAL budget. Class tccAtt — attainment is
  // machine-certified NOT removable (the kernel-checked
  // countermodel: the premise can hold while the conclusion fails
  // over raw behaviours).
  QFirstService : Set;

  QFirstService/proof   : QFirstService -> QProof;
  QFirstService/obligs  : QFirstService -> TCObligList;

  // The walk: obligs nonempty; every t > 0 (per-element — list
  // traversal is walk material, the pair-list convention);
  // concluded rel = tcrRefine, class = tccAtt; lhs/rhs recomputed
  // from the profile (min-deadline arithmetic exact); the
  // n-ary-vs-binary separation question is OPEN — the walk claims
  // nothing about derivability from binary instances.
  qtsl_tc_firstservice : {node: QFirstService} -> Prop;
      // side-condition

  report ax/wf/tc_fs_walk : forall n : QFirstService.
    |- {node: n} qtsl_tc_firstservice;

  // QFirstServiceSplit — residual-split first-service, with cutoff
  // 0 < c < min_i T_i:
  //   AND_i A_{T_i} alpha_i  refines
  //     A_c( fsTarget OR residualCell(alpha, T, c) )
  // residualCell = the no-service-by-c branch at TRUE residuals
  // T_i - c (what the plain law cannot reach: residual bookkeeping
  // without time-stamps). Class tccAtt. CITATION GUIDANCE, binding
  // on this row's comments and any successor: independence is
  // certified at gcd classes within the half-integers ONLY; three
  // or more denominators OPEN (the certificate family is
  // necessarily infinite); never cite full rational independence.
  QFirstServiceSplit : Set;

  QFirstServiceSplit/proof  : QFirstServiceSplit -> QProof;
  QFirstServiceSplit/obligs : QFirstServiceSplit -> TCObligList;
  QFirstServiceSplit/cutoff : QFirstServiceSplit -> Q;

  report ax/wf/qfssplit_cutoff_pos : forall n : QFirstServiceSplit,
      c : Q.
    n QFirstServiceSplit/cutoff = c
    |- {l: 0, r: c} q_lt;

  // The walk: everything QFirstService's demands, PLUS c < T_i for
  // every profile entry (per-element, walk-recomputed), residual
  // arithmetic T_i - c exact in the recomputed rhs.
  qtsl_tc_fssplit : {node: QFirstServiceSplit} -> Prop;
      // side-condition

  report ax/wf/tc_fssplit_walk : forall n : QFirstServiceSplit.
    |- {node: n} qtsl_tc_fssplit;

  // ==========================================================
  // The verdict form: polarity as schema content
  // (re-derived at revision event 6: the two lists are the two
  // VARIANCES of the satisfaction cell's certified factorization)
  // ==========================================================
  //
  // A compiled satisfaction verdict carries its demand entries in
  // TWO face-typed lists, and the split is schema content because
  // it is not recoverable from the entries: the same constraint
  // species denotes differently per face. A forall-face entry
  // holds over the WHOLE credal body (the floor reading); an
  // exists-face entry asserts some admitted law attains (the mark
  // reading) — folding the two into one list would erase exactly
  // the distinction the denotation reads, and a mixed list would
  // need per-entry polarity data: the face IS the sort, and
  // face-mismatch is a sort error rather than a checked one. The
  // exists-face list is the verdict's existential conjunct,
  // first-class: an empty exists-face list IS the all-safety
  // claim, true of the zero-mass subject, and a form that derived
  // liveness from floor content would silently certify a dead
  // subject live.
  //
  // Soundness chains interpolations of the satisfaction cell:
  // forall-face entries interpolate on the codomain side (X_0
  // inside the region, the region inside the component's good
  // set); exists-face entries on the domain side (the region
  // inside X_0, plus attainment). Monotone comparisons preserve
  // such factorizations with exactly those variances — the
  // polarity law, stated once here and consumed by every entry
  // family. AttitudeSpec components structurally cannot enter
  // (not monotone in the judgment order — no cells; a design
  // score is not a verdict). The regret faces are admitted by
  // sort, deliberately not emitted, and FENCED at the warrant
  // seam. Entries are compiled DEMANDS on both faces — never
  // themselves evidence (the demands-vs-evidence split; evidence
  // is claim-keyed in the grounded walk below).
  //
  // The form is value-like; its attachment to a claim is a
  // relation (zero rows = not compiled; at most one is admission
  // conformance, C-CERT-CLAIM), and the agreement between the form
  // and the specification it compiles is a recompute obligation at
  // the ground seam — never a trusted row.

  // The forall-face entity: a cap component holds statewise on a
  // region — the sibling of the region-satisfaction judgment, at
  // the component. The component field IS the spec's own
  // ForallSpec constructor: the compile map's content half is the
  // identity, the roster is closed under cap growth by
  // construction, and the cap's own range reports govern.
  QForallSat : Set;   // entity: component-on-region claim, forall face

  QForallSat/judgment  : QForallSat -> QJudgment;
  QForallSat/component : QForallSat -> ForallSpec;
  QForallSat/region    : QForallSat -> QRegionAtom;

  QForallSatList : Set;

  qfsNil  : QForallSatList;
  qfsCons : {head: QForallSat, tail: QForallSatList} -> QForallSatList;

  refuse ax/qfs/nil_cons_disjoint : forall h : QForallSat,
      t : QForallSatList, l : QForallSatList.
    l = qfsNil, l = {head: h, tail: t} qfsCons
    |- false;

  // The exists-face entries: value-like, compile-emitted; ONE
  // constructor — under the SProper mint the entry sum collapses
  // and the exists-face list is uniformly component-cited. MayBe
  // components enter with their own quantifier (no negation
  // dressing); the properness entry cites SProper. Exists-face
  // semantics: some state of the region attains the component's
  // anchored reading; soundness runs the containment the OTHER way
  // (region inside X_0 — the domain-side interpolation), plus the
  // claim-keyed witness obligation. Canonical region: a point-box
  // — nonemptiness free, containment the evaluation leaf.
  QExistsEntry : Set;

  qxeMk : {e: ExistsSpec, region: QRegionAtom} -> QExistsEntry;

  QExistsEntryList : Set;

  qxeNil  : QExistsEntryList;
  qxeCons : {head: QExistsEntry, tail: QExistsEntryList}
    -> QExistsEntryList;

  refuse ax/qxe/nil_cons_disjoint : forall h : QExistsEntry,
      t : QExistsEntryList, l : QExistsEntryList.
    l = qxeNil, l = {head: h, tail: t} qxeCons
    |- false;

  QVerdictForm : Set;

  qvfMk : {forall_face: QForallSatList, exists_face: QExistsEntryList}
    -> QVerdictForm;

  qsat_verdict : {sat: QSat, form: QVerdictForm} -> Prop;

  // Spec-side recompute ONLY (the fibre leg — forms are
  // hash-consed values with no subject field): set agreement +
  // duplicate-free lists, disjunct-relative via the selection
  // witness, exists-face components = the consumed ExistsSpec set
  // (regret mark excepted) PLUS exactly one SProper-cited entry.
  // Subject-side obligations structurally cannot key on
  // {form, spec}: they ride the claim (the grounded walk below).
  qtsl_verdict_compile : {form: QVerdictForm, spec: Spec} -> Prop;
      // side-condition

  report ax/wf/verdict_compile : forall r : QSat, v : QVerdictForm,
      sp : Spec.
    {sat: r, form: v} qsat_verdict,
    r QSat/spec = sp
    |- {form: v, spec: sp} qtsl_verdict_compile;

  // The ONE new judgment relation of the verdict stratum
  // (revision event 6): directional body containment at the state
  // carrier — inner denotation inside outer. Side-condition in the
  // init-membership idiom (evaluator-deferred loudly, per
  // constructor pair). CARRIER SCOPE: operands are region atoms =
  // STATE-carrier bodies; the polarity LAW is carrier-generic
  // (cell-preservation), the relation carrier-indexed — penalty
  // sublevels have no region-atom spelling today; a future typed
  // penalty-body carrier mints its own carrier-indexed relation
  // sharing the transport lemma. The new evaluator family beyond
  // the landed init-member matrix — sublevel-vs-sublevel certified
  // combination — enters with its consumers: no chase row derives
  // this relation at this event; the grounded walk names it per
  // entry, and the weakening node derives it from citation
  // structure when it mints (consumer-gated).
  //
  // The polarity law (a theorem of the carrier — monotone
  // comparisons preserve interpolated cells with these variances;
  // stated once, three consumer families): witness CONTAINS demand
  // on forall-faces; witness CONTAINED IN demand on exists-faces;
  // conservative recomputation composes fail-closed on the demand
  // side. The init-membership demand is the (region, init-body)
  // instance.
  qcred_contains : {outer: QRegionAtom, inner: QRegionAtom} -> Prop;
      // side-condition

  // The grounded walk (claim-keyed; the base leg): the per-claim
  // subject-side obligations, evaluator-deferred loudly —
  //   * per forall-face entry: X_0 inside the entry's region;
  //   * per exists-face entry: the region inside X_0, PLUS the
  //     witness obligation — an attaining law at a point for
  //     authored components; finite-penalty mass for the SProper
  //     entry (the SUPPORT face, never the zero face: the
  //     separating subject has all laws at positive finite
  //     penalty — live at the support face, empty at zero);
  //   * subject agreement for every cited certificate family;
  //   * spec-side recompute stays with qtsl_verdict_compile.
  qtsl_form_grounded : {sat: QSat} -> Prop;   // side-condition

  report ax/wf/form_grounded : forall r : QSat, v : QVerdictForm.
    {sat: r, form: v} qsat_verdict
    |- {sat: r} qtsl_form_grounded;

  // The init bridge node (revision event 6): from a
  // region-satisfaction claim at phi on R, conclude the
  // forall-face claim at SInit(phi) on R — identity content, so
  // landed battery conclusions feed the unified warrant seam
  // without re-emission; producers emit QForallSat directly from
  // the next producer pass onward.
  QInitBridge : Set;   // region claim -> forall-face claim, at SInit

  QInitBridge/proof : QInitBridge -> QProof;
  QInitBridge/child : QInitBridge -> QRegionSat;

  // The walk (side-condition): conclusion resolution ONLY — the
  // concluded forall-face claim's component is SInit at the child's
  // formula and its region is the child's region (the FromFold
  // discipline: the concluded claim is never trusted as stored,
  // always re-derived — identity content makes this walk trivial
  // arithmetic, not unowned). Added at the mint's own adjudication:
  // every node species names its conclusion-resolution owner.
  qtsl_init_bridge : {node: QInitBridge} -> Prop;   // side-condition

  report ax/wf/init_bridge_walk : forall n : QInitBridge.
    |- {node: n} qtsl_init_bridge;

  // ==========================================================
  // Region satisfaction and the compiled-formula calculus
  // ==========================================================
  //
  // QRegionSat: a formula holds on a region — the workhorse
  // judgment the batteries conclude and the calculus nodes
  // compose. QInvScope: a region is invariant from initial data —
  // the scope warrant every battery cites. The calculus nodes
  // (negation-normal-form steps, conjunction, disjunction, the
  // union bound) are entity proof nodes whose premise kits are rule
  // material; their rows here are the citation structure.

  QRegionSat : Set;   // entity: formula-on-region claim
  QInvScope  : Set;   // entity: invariance-scope claim

  QRegionSat/judgment : QRegionSat -> QJudgment;
  QRegionSat/formula  : QRegionSat -> StatePred;
  QRegionSat/region   : QRegionSat -> QRegionAtom;

  QInvScope/judgment : QInvScope -> QJudgment;
  QInvScope/region   : QInvScope -> QRegionAtom;
  QInvScope/init     : QInvScope -> QRegionAtom;

  QRegionSatList : Set;

  qrsNil  : QRegionSatList;
  qrsCons : {head: QRegionSat, tail: QRegionSatList}
    -> QRegionSatList;

  QNegFAlias      : Set;   // negation alias step
  QNNFDoubleNeg   : Set;   // double-negation elimination
  QNNFDeMorganAnd : Set;   // De Morgan over conjunction
  QNNFDeMorganOr  : Set;   // De Morgan over disjunction
  QNNFAtomInwardLE : Set;  // negation into a nonstrict atom
  QNNFAtomInwardGE : Set;
  QAndRegion  : Set;       // conjunction over children
  QOrRegion   : Set;       // disjunction over children
  QUnionBound : Set;       // the union bound over two children

  QNegFAlias/proof : QNegFAlias -> QProof;
  QNegFAlias/child : QNegFAlias -> QRegionSat;
  QNNFDoubleNeg/proof : QNNFDoubleNeg -> QProof;
  QNNFDoubleNeg/child : QNNFDoubleNeg -> QRegionSat;
  QNNFDeMorganAnd/proof : QNNFDeMorganAnd -> QProof;
  QNNFDeMorganAnd/child : QNNFDeMorganAnd -> QRegionSat;
  QNNFDeMorganOr/proof : QNNFDeMorganOr -> QProof;
  QNNFDeMorganOr/child : QNNFDeMorganOr -> QRegionSat;
  QNNFAtomInwardLE/proof : QNNFAtomInwardLE -> QProof;
  QNNFAtomInwardLE/child : QNNFAtomInwardLE -> QRegionSat;
  QNNFAtomInwardGE/proof : QNNFAtomInwardGE -> QProof;
  QNNFAtomInwardGE/child : QNNFAtomInwardGE -> QRegionSat;

  QAndRegion/proof    : QAndRegion -> QProof;
  QAndRegion/children : QAndRegion -> QRegionSatList;
  QAndRegion/region   : QAndRegion -> QRegionAtom;
  QOrRegion/proof    : QOrRegion -> QProof;
  QOrRegion/children : QOrRegion -> QRegionSatList;
  QOrRegion/region   : QOrRegion -> QRegionAtom;

  QUnionBound/proof  : QUnionBound -> QProof;
  QUnionBound/left   : QUnionBound -> QRegionSat;
  QUnionBound/right  : QUnionBound -> QRegionSat;
  QUnionBound/region : QUnionBound -> QRegionAtom;

  // ==========================================================
  // The distance-concluding node species (revision event 6)
  // ==========================================================

  // ---- QCoupleDrift: coupling-witnessed discharge -------------------
  //
  // Concludes QDist[d](M_1, M_2) <= b for d in {TV, gap} from a
  // relational-supermartingale kit over a product-space coupling
  // manifest: coupling rows (marginal identities against the
  // COMPLETED component kernels — absorbing states frozen, the
  // completion carries the freezes), freeze rows (K(p,p) = 1 on
  // both-absorbed p), drift rows (sum_q K(p,q) V(q) <= V(p), every
  // product state), V >= 0 rows, terminal-domination rows (V >= 1
  // disagreeing / V >= |v_1 - v_2| for gap entries, on both-absorbed
  // states), initial marginal rows, and the init tie
  // (sum_p mu_0(p) V(p) <= b). Absorption (the per-component reach
  // criterion) is CHECKER-RECOMPUTED — a per-component graph reach,
  // never a posted row. Coupling emptiness refuses, never lies (the
  // lax-coupling repair is a named future rule family under the
  // extensibility contract, not this node).
  QCoupleDrift : Set;

  QCoupleDrift/proof     : QCoupleDrift -> QProof;
  QCoupleDrift/coupling  : QCoupleDrift -> Manifest;
      // the product-space kernel manifest K (producer-minted; its
      // mode roster is the certificate-table convention)
  QCoupleDrift/cert      : QCoupleDrift -> QCertFam;
      // the relational supermartingale V
  QCoupleDrift/marginals : QCoupleDrift -> QProofList;
  QCoupleDrift/freezes   : QCoupleDrift -> QProofList;
  QCoupleDrift/drifts    : QCoupleDrift -> QProofList;
  QCoupleDrift/nonnegs   : QCoupleDrift -> QProofList;
  QCoupleDrift/terminals : QCoupleDrift -> QProofList;
  QCoupleDrift/inits     : QCoupleDrift -> QProofList;
  QCoupleDrift/tie       : QCoupleDrift -> Proof;

  // The walk (side-condition; semantics = the distance-judgment
  // adjudication + the relational-chain soundness statements,
  // normative): conclusion resolution (the concluded QDistBound's
  // entry is TV or gap — qdW1 refused v0; subjects are a qdsSys
  // pair); subject agreement (the coupling manifest's factor
  // spaces against the component subjects, marginal rows tied to
  // the COMPLETED kernels); per-product-state row coverage;
  // absorption reach recompute; init-tie arithmetic against the
  // concluded bound.
  qtsl_couple_drift : {node: QCoupleDrift} -> Prop;   // side-condition

  report ax/wf/couple_drift_walk : forall n : QCoupleDrift.
    |- {node: n} qtsl_couple_drift;

  // ---- QFixBall: contraction-witnessed discharge --------------------
  //
  // Concludes QDist[d](mu-hat, fix T) <= r — every hypothesis
  // anchored at the KNOWN snapshot, never the unknown fixed point
  // (the anchoring inversion). The description license is
  // discharged BY this rule (exists-unique in the ball,
  // manufactured by the contraction). rho and delta are PINNED,
  // not derived (the dmin witness species: the checker verifies
  // inequalities, never computes an argmin); the radius row is
  // division-free (delta + rho*r <= r). Refusals: rho >= 1
  // (PERRON); registry entries the subject sort does not carry;
  // VAR (v0 means-only).
  QFixBall : Set;

  QFixBall/proof        : QFixBall -> QProof;
  QFixBall/rho          : QFixBall -> Q;
  QFixBall/delta        : QFixBall -> Q;
  QFixBall/contractions : QFixBall -> QProofList;
      // two-point contraction rows on the closed ball (psdCert/
      // operator-norm species at the affine tier)
  QFixBall/residual     : QFixBall -> Proof;
      // d(T mu-hat, mu-hat) <= delta — one concrete sweep at the
      // known point
  QFixBall/radius       : QFixBall -> Proof;
      // delta + rho*r <= r, division-free, r read from the
      // concluded bound by the walk

  report ax/wf/qfixball_rho_range : forall n : QFixBall, q : Q.
    n QFixBall/rho = q
    |- {l: 0, r: q} q_le, {l: q, r: 1} q_lt;

  report ax/wf/qfixball_delta_nonneg : forall n : QFixBall, q : Q.
    n QFixBall/delta = q
    |- {l: 0, r: q} q_le;

  // The walk: conclusion resolution (left = qdsSnap, right = qdsFix
  // — the description-subject cell; this rule is the only speaker
  // of qdsFix v0, and the operator citation's codomain-shape
  // conformance — endomap on the subject carrier, the gate_scalar
  // sibling — is checked here); completeness license for the
  // concluded entry (the completeness hypothesis of the mechanized
  // statement, honest boundary — an entry without a completeness
  // warrant refuses); contraction-row coverage of the ball; radius
  // arithmetic against the concluded bound.
  qtsl_fixball : {node: QFixBall} -> Prop;   // side-condition

  report ax/wf/fixball_walk : forall n : QFixBall.
    |- {node: n} qtsl_fixball;

  // ---- QDistTransport: the built transport cells --------------------
  //
  // The transport matrix's built column, ONE family with the exact
  // cell as the eps = 0 instantiation (the "a value pin IS a
  // singleton carve" degeneracy pattern, applied as "the exact
  // witness IS the eps=0 approximate witness"): per-fine-state
  // sigma-witness rows (tv(pi# K(s,.), Q(pi(s),.)) <= eps), the
  // initial row (mu0_c = pi# mu0_f), and at eps > 0 a DECLARED
  // horizon n with conclusion at n*eps (the compounding law proved,
  // not guessed; sequential witnesses compose at eps_1 + eps_2 — an
  // upper bound, the actual composite defect may be smaller).
  // Unbounded horizons refuse without a contraction row.
  QDistTransport : Set;

  QDistTransport/proof      : QDistTransport -> QProof;
  QDistTransport/projection : QDistTransport -> HypernetRef;
      // pi, the state projection, cited by digest; the
      // map-presentation conformance (fine carrier to coarse
      // carrier — the gate_scalar sibling) is walk material at the
      // conclusion-resolution step
  QDistTransport/eps       : QDistTransport -> Q;
  QDistTransport/horizon   : QDistTransport -> Nat;
      // read at eps > 0 only; the walk ignores it at the exact cell
      // (eps = 0), where the judgment transports unchanged at every
      // horizon
  QDistTransport/witnesses : QDistTransport -> QProofList;
      // one sigma-witness row per fine state
  QDistTransport/initial   : QDistTransport -> Proof;
  QDistTransport/coarse    : QDistTransport -> QProof;
      // the coarse-side judgment citation (strict law-level spec OR
      // a QDist[TV] bound — the built judgment classes; derivation
      // edge, the premise-citation pattern)

  report ax/wf/qdist_transport_eps_nonneg : forall n : QDistTransport,
      q : Q.
    n QDistTransport/eps = q
    |- {l: 0, r: q} q_le;

  // The walk: coarse-citation class check (built classes only —
  // successor cells widen it as they land); per-fine-state witness
  // coverage; exact cell (eps = 0): concluded judgment IS the
  // transported coarse one; eps-cell: concluded QDistBound at
  // entry TV, bound = horizon*eps recomputed exactly; coherence
  // with the wire-composition family (middle-four exchange) is
  // per-cell cargo, not yet discharged for the new cells — the
  // walk does NOT claim it.
  qtsl_dist_transport : {node: QDistTransport} -> Prop;
      // side-condition

  report ax/wf/dist_transport_walk : forall n : QDistTransport.
    |- {node: n} qtsl_dist_transport;

  // Structural side-conditions of the region stratum, discharged at
  // the ground seam where cited by rule kits: closure of a derived
  // enclosure against a manifest, per mode (the mode cited as an
  // entity, the certificate-table convention); the manifest's
  // spectral-gap obligation; a box cover's lower-bound discipline
  // against a region.
  qtsl_dbar_closure : {dbar: Box, m: Manifest, mode: Mode} -> Prop;
      // side-condition
  qtsl_gap_a : {m: Manifest} -> Prop;              // side-condition
  qtsl_lowbound_boxes : {cover: QBoxList, dbar: Box,
                      region: QRegionAtom} -> Prop;
      // side-condition

  // ==========================================================
  // Batteries: the workhorse discharge rows
  // ==========================================================
  //
  // A battery is an entity proof node packaging the exact-rational
  // row kit that discharges one region claim: interiors, guards,
  // lower-bound rows, nonnegativity rows, decay rows, and the
  // threshold tie,
  // each a proof-leaf list replayed by the checker. The `arg` field
  // stores the concluded root formula, so a battery loads
  // independently of any formation row's landing; the walk
  // recomputes the required orientation from the concluded root.

  QSafetyBattery : Set;

  QSafetyBattery/proof : QSafetyBattery -> QProof;
  QSafetyBattery/p : QSafetyBattery -> Q;
  QSafetyBattery/arg : QSafetyBattery -> StatePred;
  QSafetyBattery/cert : QSafetyBattery -> QCertFam;
  QSafetyBattery/interiors : QSafetyBattery -> QProofList;
  QSafetyBattery/guards : QSafetyBattery -> QProofList;
  QSafetyBattery/lowbounds : QSafetyBattery -> QProofList;
  QSafetyBattery/nonnegs : QSafetyBattery -> QProofList;
  QSafetyBattery/avoid : QSafetyBattery -> QRegionAtom;
  QSafetyBattery/scope_warrant : QSafetyBattery -> QInvScope;

  QDeadlineBattery : Set;

  QDeadlineBattery/proof : QDeadlineBattery -> QProof;
  QDeadlineBattery/p : QDeadlineBattery -> Q;
  QDeadlineBattery/deadline : QDeadlineBattery -> Q;
  QDeadlineBattery/arg : QDeadlineBattery -> StatePred;
  QDeadlineBattery/cert : QDeadlineBattery -> QCertFam;
  QDeadlineBattery/target : QDeadlineBattery -> QRegionAtom;
  QDeadlineBattery/decays : QDeadlineBattery -> QProofList;
  QDeadlineBattery/guards : QDeadlineBattery -> QProofList;
  QDeadlineBattery/lowbounds : QDeadlineBattery -> QProofList;
  QDeadlineBattery/nonnegs : QDeadlineBattery -> QProofList;
  QDeadlineBattery/tie : QDeadlineBattery -> Proof;
  QDeadlineBattery/scope_warrant : QDeadlineBattery -> QInvScope;

  QUntilBattery : Set;

  QUntilBattery/proof : QUntilBattery -> QProof;
  QUntilBattery/p : QUntilBattery -> Q;
  QUntilBattery/deadline : QUntilBattery -> Q;
  QUntilBattery/safe_arg : QUntilBattery -> StatePred;
  QUntilBattery/target_arg : QUntilBattery -> StatePred;
  QUntilBattery/avoid : QUntilBattery -> QRegionAtom;
  QUntilBattery/target : QUntilBattery -> QRegionAtom;
  QUntilBattery/cert_avoid : QUntilBattery -> QCertFam;
  QUntilBattery/cert_target : QUntilBattery -> QCertFam;
  QUntilBattery/coeff : QUntilBattery -> Q;
  QUntilBattery/tie : QUntilBattery -> Proof;
  QUntilBattery/interiors : QUntilBattery -> QProofList;
  QUntilBattery/decays : QUntilBattery -> QProofList;
  QUntilBattery/guards : QUntilBattery -> QProofList;
  QUntilBattery/avoid_lowbounds : QUntilBattery -> QProofList;
  QUntilBattery/target_lowbounds : QUntilBattery -> QProofList;
  QUntilBattery/nonnegs : QUntilBattery -> QProofList;
  QUntilBattery/scope_warrant : QUntilBattery -> QInvScope;

  // The recurrence battery: one row kit per (request, response)
  // pair, with a per-pair ranking family and its rank rows.
  QStreettPairList : Set;
  QStreettBattery  : Set;

  qspNil  : QStreettPairList;
  qspCons : {eps: Q, rank_cert: QCertFam, rank_nonnegs: QProofList,
             rank_reqs: QProofList, ranks: QProofList,
             request: QRegionAtom, response: QRegionAtom,
             tail: QStreettPairList} -> QStreettPairList;

  QStreettBattery/proof : QStreettBattery -> QProof;
  QStreettBattery/p : QStreettBattery -> Q;
  QStreettBattery/cert : QStreettBattery -> QCertFam;
  QStreettBattery/avoid : QStreettBattery -> QRegionAtom;
  QStreettBattery/interiors : QStreettBattery -> QProofList;
  QStreettBattery/guards : QStreettBattery -> QProofList;
  QStreettBattery/lowbounds : QStreettBattery -> QProofList;
  QStreettBattery/nonnegs : QStreettBattery -> QProofList;
  QStreettBattery/pairs : QStreettBattery -> QStreettPairList;
  QStreettBattery/scope_warrant : QStreettBattery -> QInvScope;

  // The long-run-average battery: the certificate is the gain/bias
  // pair of the Poisson equation — gain in Q, bias gate a
  // certificate family — with drift rows carrying the constant term
  // INSIDE each row's sequent polynomial, so the discharge species
  // is the landed sign-sequent genre with no new checker
  // architecture. On the upper face the drifts certify
  // gain - reward - generator-of-bias nonnegative on scope and the
  // tie bounds the gain above; on the lower face the orientations
  // flip and the lower-bound rows bound the bias above so the
  // correction term
  // dies in the limit. The walk recomputes the required orientation
  // from the concluded root.
  QAvgBattery : Set;

  QAvgBattery/proof : QAvgBattery -> QProof;
  QAvgBattery/gain : QAvgBattery -> Q;
  QAvgBattery/arg : QAvgBattery -> StatePred;
  QAvgBattery/cert : QAvgBattery -> QCertFam;
  QAvgBattery/drifts : QAvgBattery -> QProofList;
  QAvgBattery/guards : QAvgBattery -> QProofList;
  QAvgBattery/lowbounds : QAvgBattery -> QProofList;
  QAvgBattery/nonnegs : QAvgBattery -> QProofList;
  QAvgBattery/tie : QAvgBattery -> Proof;
  QAvgBattery/scope_warrant : QAvgBattery -> QInvScope;

  // The funnel attachment: the certificate family a funnel
  // declaration's gate rides — the certificate-citing field the
  // subject stratum deliberately leaves to this one. At most one
  // row per funnel is admission conformance (C-CERT-CLAIM).
  funnel_cert : {funnel: FunnelDecl, cert: QCertFam} -> Prop;

  // ==========================================================
  // The block lattice, arenas, and the Morse stratum
  // ==========================================================
  //
  // The invariant-lattice vocabulary: a block lattice names an
  // arena (a cell set over a grid context) and its blocks, each
  // block a facet list whose rows carry sign-sequent proofs. The
  // Morse stratum reads a lattice into a graph-over-regions claim:
  // a directed graph, a cell map, and a vertex-region list, with
  // the discharge node citing containment, transit, and
  // well-formedness kits.

  QDagEdgeList : Set;
  QDag         : Set;
  QCellMap     : Set;
  QVertexRegionList : Set;
  QCellPolyList : Set;
  QFacetList   : Set;
  QBlockList   : Set;
  QBlockLattice : Set;   // entity: one declared lattice

  qdeNil  : QDagEdgeList;
  qdeCons : {dst: Nat, src: Nat, tail: QDagEdgeList} -> QDagEdgeList;

  qdagMk : {edges: QDagEdgeList, vertices: Nat} -> QDag;

  qcmNil : QCellMap;
  qcmVertex : {cell: Nat, tail: QCellMap, vertex: Nat} -> QCellMap;
  qcmTransit : {cell: Nat, tail: QCellMap} -> QCellMap;

  refuse ax/qcert/cellmap_vertex_transit_disjoint : forall c : Nat,
      t : QCellMap, v : Nat, m : QCellMap.
    m = {cell: c, tail: t, vertex: v} qcmVertex,
    m = {cell: c, tail: t} qcmTransit
    |- false;

  qvrNil  : QVertexRegionList;
  qvrCons : {region: StatePred, tail: QVertexRegionList, vertex: Nat}
    -> QVertexRegionList;

  qcpNil  : QCellPolyList;
  qcpCons : {cell: Nat, tail: QCellPolyList, val: Poly}
    -> QCellPolyList;

  // Facet rows: the cell set rides the ground sequence sort; facet
  // indexes the group generator's derived facet enumeration, with
  // the degenerate reading pinned — a singleton group IS the axis,
  // facets zero and one its lower and upper faces.
  qfNil  : QFacetList;
  qfCons : {cells: Shape, facet: Nat, group: Nat, proof: Proof,
            tail: QFacetList} -> QFacetList;

  qbNil  : QBlockList;
  qbCons : {cells: Shape, facets: QFacetList, tail: QBlockList}
    -> QBlockList;

  QBlockLattice/name   : QBlockLattice -> Str;
  QBlockLattice/arena  : QBlockLattice -> Shape;
  QBlockLattice/blocks : QBlockLattice -> QBlockList;
  QBlockLattice/cx     : QBlockLattice -> QGridCx;

  // The arena vocabulary: per-group generators over a partitioned
  // ambient box. An interval generator's cut list is INTERIOR-ONLY
  // (strictly increasing, strictly inside the patch box's axis
  // extent — the extent lives in the grid context, so endpoint
  // duplication is unrepresentable rather than checked); cells per
  // group = cuts + 1, the empty list the trivial subdivision. The
  // simplicial generator carries per-axis base resolutions and one
  // shape-only split tree per base sub-box, each split's axis and
  // cut derived (widest axis, lowest index on ties; exact
  // midpoint). The partition wire rides the ground sequence sort in
  // canonical form, checked at admission; length must equal the
  // ambient dimension.

  QGroupGen  : Set;   // per-group generator
  QGenList   : Set;   // generators aligned with the partition
  QPatchTree : Set;   // split forest; the refinement is derived,
                      // never stored
  QChartRef  : Set;   // chart slot for the sigma-variant reading
  QGridCx    : Set;   // ambient box + patch tree
  QArena     : Set;   // (cx, cells): union of the named closed cells
  QJiSet     : Set;   // join-irreducible index set
  QSplitTree : Set;   // shape-only dyadic split tree
  QSplitList : Set;   // one split tree per base sub-box

  qgenInterval : {cuts: QRatList} -> QGroupGen;

  qstLeaf  : QSplitTree;
  qstSplit : {hi: QSplitTree, lo: QSplitTree} -> QSplitTree;

  qslNil  : QSplitList;
  qslCons : {head: QSplitTree, tail: QSplitList} -> QSplitList;

  qgenKuhn : {res: QNatList, splits: QSplitList} -> QGroupGen;

  refuse ax/qcert/gen_interval_kuhn_disjoint : forall c : QRatList,
      rs : QNatList, sp : QSplitList, g : QGroupGen.
    g = {cuts: c} qgenInterval,
    g = {res: rs, splits: sp} qgenKuhn
    |- false;

  qglNil  : QGenList;
  qglCons : {gen: QGroupGen, tail: QGenList} -> QGenList;

  qchIdentity : QChartRef;
  qchDigest   : {sha256hex: Str} -> QChartRef;
      // reserved digest slot; semantics arrive with the
      // sigma-variant's consumer

  refuse ax/qcert/chart_identity_digest_disjoint : forall s : Str,
      c : QChartRef.
    c = qchIdentity, c = {sha256hex: s} qchDigest
    |- false;

  qptLeaf  : {chart: QChartRef, gens: QGenList, part: Shape}
    -> QPatchTree;
  qptSplit : {axis: Nat, cut: Q, hi: QPatchTree, lo: QPatchTree}
    -> QPatchTree;

  refuse ax/qcert/patch_leaf_split_disjoint : forall ch : QChartRef,
      gs : QGenList, pt : Shape, xi : Nat, ct : Q, hi : QPatchTree,
      lo : QPatchTree, p : QPatchTree.
    p = {chart: ch, gens: gs, part: pt} qptLeaf,
    p = {axis: xi, cut: ct, hi: hi, lo: lo} qptSplit
    |- false;

  qgcMk : {dom: Box, tree: QPatchTree} -> QGridCx;
  qarMk : {cells: Shape, cx: QGridCx} -> QArena;

  qjiNil  : QJiSet;
  qjiCons : {head: Nat, tail: QJiSet} -> QJiSet;

  // A named cell set covers a region — the cover machinery the
  // chart-image discharge cites.
  qtsl_cell_cover : {cells: Shape, cx: QGridCx, region: Box} -> Prop;
      // side-condition

  // The Morse stratum.
  QMorse          : Set;   // entity: graph-over-regions claim
  QMorseDischarge : Set;   // entity: the lattice-reading discharge
  QMorseProduct   : Set;   // entity: the product rule node
  QBlockInv       : Set;   // entity: single-block invariance node
  QLatticeInv     : Set;   // entity: lattice invariance node
  QBasin          : Set;   // entity: basin node

  QMorse/judgment : QMorse -> QJudgment;
  QMorse/graph : QMorse -> QDag;
  QMorse/rho   : QMorse -> QVertexRegionList;
  QMorse/arena : QMorse -> QArena;

  QMorseDischarge/proof : QMorseDischarge -> QProof;
  QMorseDischarge/lattice : QMorseDischarge -> QBlockLattice;
  QMorseDischarge/h : QMorseDischarge -> QCellMap;
  QMorseDischarge/containments : QMorseDischarge -> QProofList;
  QMorseDischarge/transits : QMorseDischarge -> QProofList;
  QMorseDischarge/transit_certs : QMorseDischarge -> QCellPolyList;
  QMorseDischarge/rho_wf : QMorseDischarge -> QProofList;

  QMorseProduct/proof : QMorseProduct -> QProof;
  QMorseProduct/left : QMorseProduct -> QMorse;
  QMorseProduct/right : QMorseProduct -> QMorse;
  QMorseProduct/left_lat : QMorseProduct -> QBlockLattice;
  QMorseProduct/right_lat : QMorseProduct -> QBlockLattice;

  QBlockInv/proof : QBlockInv -> QProof;
  QBlockInv/block : QBlockInv -> QRegionAtom;
  QBlockInv/facets : QBlockInv -> QProofList;
  QBlockInv/init_containment : QBlockInv -> Proof;

  QLatticeInv/proof : QLatticeInv -> QProof;
  QLatticeInv/lattice : QLatticeInv -> QBlockLattice;
  QLatticeInv/init_containment : QLatticeInv -> Proof;
  QLatticeInv/downset : QLatticeInv -> QJiSet;

  QBasin/proof : QBasin -> QProof;
  QBasin/inv : QBasin -> QInvScope;
  QBasin/avoid_disjoint : QBasin -> QProofList;

  // The Morse readout walk — the discharge's completeness and
  // pairing obligation over (graph, cell map, lattice, regions).
  qtsl_morse_readout : {dag: QDag, h: QCellMap, lat: QBlockLattice,
                        rho: QVertexRegionList} -> Prop;
      // side-condition

  // The arena tie: a discharged graph claim's arena IS the
  // lattice's — the same generator and the same cell set, as a
  // stated equation between hash-consed values. The tie is
  // deliberately syntactic; semantic region equality is geometry
  // the certificate does not owe.
  chase ax/qmorsedischarge/arena : forall r : QMorseDischarge,
      p : QProof, j : QMorse, lat : QBlockLattice, k : QJudgment,
      ac : Shape, gc : QGridCx.
    r QMorseDischarge/proof = p,
    p QProof/concludes = k,
    j QMorse/judgment = k,
    r QMorseDischarge/lattice = lat,
    lat QBlockLattice/arena = ac,
    lat QBlockLattice/cx = gc
    |- j QMorse/arena = {cells: ac, cx: gc} qarMk;

  // ==========================================================
  // Zero-existence certificates
  // ==========================================================
  //
  // The sign-battery existence family: 2m face rows over an
  // equidimensional polynomial view, each row a sign sequent on one
  // face of the cell. Existence only — nothing in this family can
  // conclude uniqueness, count, or non-existence. Face geometry is
  // DERIVED from the row's indices, never stored: a
  // producer-supplied face would be a trusted row. Battery row
  // semantics: variables of every component are the cell's axes
  // then the parameter box's axes, positional; row (axis, upper,
  // comp, neg) claims the signed component restricted to the named
  // face nonpositive on the lower face and nonnegative on the
  // upper, with `proof` the sign sequent for exactly that claim.

  QMirandaBattery : Set;

  qmbNil  : QMirandaBattery;
  qmbCons : {axis: Nat, comp: Nat, neg: Nat, proof: Proof,
             tail: QMirandaBattery, upper: Nat} -> QMirandaBattery;

  // Judgment kinds: member claims over polynomial views; cell and
  // parameter atoms are box atoms in the current tier — non-box
  // atoms refuse at the walk.
  QZeroExists        : Set;
  QEquilibriumExists : Set;
  QFixedPointExists  : Set;

  QZeroExists/judgment : QZeroExists -> QJudgment;
  QZeroExists/g : QZeroExists -> PolyVec;
  QZeroExists/cell : QZeroExists -> QRegionAtom;
  QEquilibriumExists/judgment : QEquilibriumExists -> QJudgment;
  QEquilibriumExists/field : QEquilibriumExists -> PolyVec;
  QEquilibriumExists/cell : QEquilibriumExists -> QRegionAtom;
  QFixedPointExists/judgment : QFixedPointExists -> QJudgment;
  QFixedPointExists/map : QFixedPointExists -> PolyVec;
  QFixedPointExists/cell : QFixedPointExists -> QRegionAtom;

  // One rule-node family serves the three judgments — the concluded
  // sort disambiguates. For fixed points the battery's subject is
  // the map minus the identity; the elaboration recompute tying the
  // two is a named deferral at the ground seam.
  QZeroByMiranda : Set;

  QZeroByMiranda/proof : QZeroByMiranda -> QProof;
  QZeroByMiranda/g : QZeroByMiranda -> PolyVec;
  QZeroByMiranda/cell : QZeroByMiranda -> QRegionAtom;
  QZeroByMiranda/battery : QZeroByMiranda -> QMirandaBattery;

  // Derived rule: a strictly-inward facet battery on a box block is
  // the existence battery for the negated field with identity
  // pairing — premises by citation, zero new oracle demand.
  QEquilibriumFromInward : Set;

  QEquilibriumFromInward/proof : QEquilibriumFromInward -> QProof;
  QEquilibriumFromInward/inv : QEquilibriumFromInward -> QBlockInv;

  // The chart-image discharge at per-(patch cell, target cell)
  // granularity: the battery's subject is chart minus target in
  // joint variables, parameters the target cell. Union to a region
  // cover rides the existing cover machinery; a cover is NEVER
  // inferred from an image enclosure.
  QCoverByMiranda : Set;

  QCoverByMiranda/proof : QCoverByMiranda -> QProof;
  QCoverByMiranda/chart : QCoverByMiranda -> PolyVec;
  QCoverByMiranda/wcell : QCoverByMiranda -> QRegionAtom;
  QCoverByMiranda/zcell : QCoverByMiranda -> QRegionAtom;
  QCoverByMiranda/battery : QCoverByMiranda -> QMirandaBattery;

  // The battery walk: completeness (each (axis, face) exactly
  // once), per-axis component agreement, component bijectivity,
  // index ranges — decided-false violations; refusals with no
  // verdict on non-box atoms, non-canonical or over-wide
  // polynomials, list ambiguity, and budgets. The face-restriction
  // recompute (exact-rational substitution) is the walk's
  // derived-sequent authority.
  qtsl_miranda_battery : {battery: QMirandaBattery,
                          cell: QRegionAtom, g: PolyVec,
                          params: QRegionAtom} -> Prop;
      // side-condition

  // ==========================================================
  // Simulation, flattening, growth
  // ==========================================================
  //
  // QSim: exact simulation — the map witnesses the destination
  // coarse-graining the source (one-sided, the refinement
  // preorder). Its discharge cites compatibility squares; its
  // composition is an admissible rule node. QFlatEq: the flat
  // manifest is the flattening of the composite subject, an
  // oracle-shaped recompute whose scope is shared-carrier
  // confinement, stated positively. QLinGrowth: membership in a
  // linear-growth envelope with the constants CARRIED — downstream
  // cells consume the pair arithmetically, never a membership bit.

  // The simulation map as flat (coord, mode, poly) triples: one
  // polynomial per destination coordinate per source mode, the
  // mode cited as an entity (the certificate-table convention).
  QSimMapList : Set;

  qsmNil  : QSimMapList;
  qsmCons : {coord: Nat, mode: Mode, tail: QSimMapList, val: Poly}
    -> QSimMapList;

  QSim          : Set;
  QSimDischarge : Set;
  QSimCompose   : Set;
  QSimTransport : Set;   // transport rule node; its kit is rule
                         // material
  QFlatten      : Set;   // flattening rule node; its kit is rule
                         // material
  QFlatEq       : Set;
  QLinGrowth    : Set;
  QLinGrowthDischarge : Set;

  QSim/judgment : QSim -> QJudgment;
  QSim/src : QSim -> System;
  QSim/dst : QSim -> System;
  QSim/map : QSim -> QSimMapList;

  QSimDischarge/proof : QSimDischarge -> QProof;
  QSimDischarge/squares : QSimDischarge -> QProofList;
      // drift intertwining, guard and reset squares, per-mode-pair
      // domain mapping — proof leaves; the mode-map coverage walk
      // is a named future evaluator, not minted here

  QSimCompose/proof : QSimCompose -> QProof;
  QSimCompose/left : QSimCompose -> QSim;
  QSimCompose/right : QSimCompose -> QSim;

  QSimTransport/proof : QSimTransport -> QProof;
  QFlatten/proof : QFlatten -> QProof;

  QFlatEq/judgment : QFlatEq -> QJudgment;
  QFlatEq/sys : QFlatEq -> System;
  QFlatEq/flat : QFlatEq -> Manifest;

  // The flatten recompute: bounded and deterministic (an oracle,
  // not a rule), composition-unstable (an oracle, not chase).
  // Shared-carrier confinement is the judgment's scope; distinct
  // location carriers refuse.
  qtsl_flatten : {flat: Manifest, sys: System} -> Prop;
      // side-condition

  report ax/wf/qflateq_flatten : forall fe : QFlatEq, y : System,
      m : Manifest.
    fe QFlatEq/sys = y,
    fe QFlatEq/flat = m
    |- {flat: m, sys: y} qtsl_flatten;

  QLinGrowth/judgment : QLinGrowth -> QJudgment;
  QLinGrowth/f : QLinGrowth -> PolyVec;
  QLinGrowth/a : QLinGrowth -> Q;
  QLinGrowth/b : QLinGrowth -> Q;
  QLinGrowth/scope : QLinGrowth -> Box;

  QLinGrowthDischarge/proof : QLinGrowthDischarge -> QProof;
  QLinGrowthDischarge/envelopes : QLinGrowthDischarge -> QProofList;
      // per-coordinate affine-envelope sign sequents on the scope
      // box, exact-rational, checker-replayed

  // ==========================================================
  // The finite-horizon table node
  // ==========================================================
  //
  // The exact deadline-table rule node: the backward-induction
  // value table IS the proof object — a flat (horizon+1) x states
  // value list, time-major, states in declared index order within a
  // row. The table is a SUB-solution: the walk checks, from the
  // node's declaration closure alone, the terminal bound, the goal
  // rows, the step inequality against the kernel, entries within
  // the unit interval, and the threshold against the initial entry.

  QDeadlineTable : Set;

  QDeadlineTable/proof : QDeadlineTable -> QProof;
  QDeadlineTable/table : QDeadlineTable -> QRatList;

  qtsl_deadline_table : {node: QDeadlineTable} -> Prop;
      // side-condition

  report ax/wf/qdeadlinetable_walk : forall n : QDeadlineTable.
    |- {node: n} qtsl_deadline_table;

  // ==========================================================
  // Wire composition
  // ==========================================================
  //
  // QWireCert: the judgment that a wiring certifies its premises
  // into its conclusion with a declared slack — the composition
  // family's judgment sort, concluded by the discharge node and
  // cited by the composition node. The premise list is positional
  // against the wiring's inner-system order; lockstep with a
  // consuming node's components is admission conformance. The
  // slack is the declared candidate gain function of the subject
  // stratum's slack sort; its membership obligations (zero at
  // zero, monotone, unbounded) are certified by the discharge
  // node's row kit, exactly where the slack is consumed.

  QWireCert : Set;   // entity: one wire-certificate judgment
  QSatList  : Set;   // cons-list of satisfaction citations
  QSpecList : Set;   // cons-list of specification references

  qsatNil  : QSatList;
  qsatCons : {head: QSat, tail: QSatList} -> QSatList;

  qspecNil  : QSpecList;
  qspecCons : {head: Spec, tail: QSpecList} -> QSpecList;

  refuse ax/qcert/qsat_nil_cons_disjoint : forall h : QSat,
      t : QSatList, l : QSatList.
    l = qsatNil, l = {head: h, tail: t} qsatCons
    |- false;

  QWireCert/judgment : QWireCert -> QJudgment;
  QWireCert/wiring   : QWireCert -> Wiring;
  QWireCert/premises : QWireCert -> QSpecList;
  QWireCert/out      : QWireCert -> Spec;
  QWireCert/slack    : QWireCert -> Slack;

  // The composition node's premise kit: per-component satisfaction
  // citations (positional against the cited certificate's
  // premises), the causality ranks (one natural per component; the
  // generic unsorted list deliberately — ranks have no sortedness),
  // and the well-posedness row families for the stochastic
  // profiles. The composite slack and the wired composite subject
  // are DERIVED at consumption; the concluded claim carries its own
  // subject and specification, never stored on this node.
  QWireCompose : Set;

  QWireCompose/proof : QWireCompose -> QProof;
  QWireCompose/components : QWireCompose -> QSatList;
  QWireCompose/wirecert : QWireCompose -> QWireCert;
  QWireCompose/ranks : QWireCompose -> QNatList;
  QWireCompose/wellposedness : QWireCompose -> QProofList;

  QWireCertDischarge : Set;

  QWireCertDischarge/proof : QWireCertDischarge -> QProof;
  QWireCertDischarge/zero_eval : QWireCertDischarge -> Proof;
  QWireCertDischarge/monotone_rows : QWireCertDischarge -> QProofList;
  QWireCertDischarge/unbounded : QWireCertDischarge -> Proof;
  QWireCertDischarge/mech_rows : QWireCertDischarge -> QProofList;
  QWireCertDischarge/lens_rows : QWireCertDischarge -> QProofList;

  // The causality walk: from the node's components and ranks and
  // the cited certificate's wiring, one rank per component and
  // strict rank increase along every directed wire — no cyclic
  // wiring can PASS the walk. Bounded recompute over the node's
  // declaration closure, never chase derivation; demanded on every
  // instance.
  qtsl_wire_causality : {node: QWireCompose} -> Prop;
      // side-condition

  report ax/wf/qwirecompose_causality : forall n : QWireCompose.
    |- {node: n} qtsl_wire_causality;

  // GUARD ELIMINATION AT CONSUMPTION (a review-driven repair,
  // landed where the composition consumer reads
  // premises): a guarded satisfaction claim is vacuously true of a
  // subject that starts outside its guard region — so a composition
  // node consuming a guarded premise must discharge the guard's
  // initial-membership before treating the premise as a guarantee.
  // The walk over the component list is the qsatCons spine; the
  // demand re-enters qtsl_init_member exactly where the intro route
  // discharged it into the former. Every OTHER consumer of guarded
  // claims inherits the same duty as its own clause: the verdict
  // compile (qtsl_verdict_compile) is guard-aware or defers, and
  // the equivalence judgment's derived carrier scope treats guard
  // rows as content (both evaluator-side, loudly deferred while
  // unrealized).
  qsat_list_member : {list: QSatList, sat: QSat} -> Prop;

  chase ax/qwire/member_head : forall l : QSatList, h : QSat,
      t : QSatList.
    l = {head: h, tail: t} qsatCons
    |- {list: l, sat: h} qsat_list_member;

  chase ax/qwire/member_tail : forall l : QSatList, h : QSat,
      t : QSatList, m : QSat.
    l = {head: h, tail: t} qsatCons,
    {list: t, sat: m} qsat_list_member
    |- {list: l, sat: m} qsat_list_member;

  report ax/wf/qwirecompose_guard_elim : forall n : QWireCompose,
      l : QSatList, q : QSat, y : System, sp : Spec,
      g : QRegionAtom.
    n QWireCompose/components = l,
    {list: l, sat: q} qsat_list_member,
    q QSat/sys = y,
    q QSat/spec = sp,
    {spec: sp, region: g} spec_guard
    |- {region: g, sys: y} qtsl_init_member;

  // ==========================================================
  // Wire composition, liveness face: the marks node (event 5)
  // ==========================================================
  //
  // QWireComposeMarks: the liveness sibling of QWireCompose —
  // additive; same premise plumbing, NO ranks field, no causality
  // species anywhere near this node. Cyclic wiring is the point:
  // the MarkFlow side condition admits every cycle whose schedule
  // closes and whose instant-loop marks carry jointly-closable
  // carves. Premise kit: per-component conditional-delivery
  // satisfaction citations (the forall-conforming-exists-delivering
  // reading, properness presupposition discharged per premise;
  // positional against the cited certificate's premises, exactly as
  // at QWireCompose), the premises' latency rows (delivery-stage
  // arithmetic + seriality, each at its own profile tier), the wire
  // certificate for plumbing (its causality species is NOT demanded
  // here), the producer's schedule labels and carves (the walk's
  // two columns of side data), the carve + diagonal rows, one BL
  // mark-entailment sequent, and the reused W0-species
  // well-posedness family — whose discharge tier here is STEPWISE
  // properness (the composite stays live at every stage given the
  // schedule), never bare nonemptiness of the behaviour set. The
  // concluded claim carries its own subject and specification,
  // never stored on this node.

  // A carve entry addresses its mark by the wire it rides (the
  // wiring's positional port-path vocabulary) and cites the carving
  // datum: a SCALAR-CODOMAIN GATE HYPERNET by digest, carve = its
  // sign-fiber (the STCarve pattern; value pins survive as
  // singleton carves + dgPoint diagonals — the machine-checked
  // subsumption). For token-population members the gate is PLATED —
  // an HAggWire pooled coordinate, carve = its sublevel/superlevel
  // set; threshold-preservation carve gates are SAFETY-polarity in
  // the transfer discipline, so any monotone fold is admissible
  // (idempotence fences only gap rows — never over-fence here).
  // Producers MAY carve all marks; the walk demands coverage of the
  // nontrivial zero-lag cycles and tolerates the rest (off-cycle
  // carves are derivable — the chaining theorems, at both dial
  // ends). Schedule labels ride the exact-rational spine; a WINDOW
  // (interval label) is to a label exactly what a carve is to a pin
  // — the same measure-zero-to-predicate move in stage-space — and
  // is the named additive widening, deliberately not minted here.
  QCarveList : Set;

  qcvNil  : QCarveList;
  qcvCons : {wire: PortPath, gate: HypernetRef, tail: QCarveList}
    -> QCarveList;

  refuse ax/qcert/qcarve_nil_cons_disjoint : forall w : PortPath,
      g : HypernetRef, t : QCarveList, l : QCarveList.
    l = qcvNil, l = {wire: w, gate: g, tail: t} qcvCons
    |- false;

  // Every carve gate resolves to a scalar-codomain hypernet — the
  // landed genus conformance (oGate's own side-condition), demanded
  // at the citation; reuse, never a new gate sort.
  report ax/wf/qcarve_gate_scalar : forall l : QCarveList,
      w : PortPath, g : HypernetRef, t : QCarveList.
    l = {wire: w, gate: g, tail: t} qcvCons
    |- {gate: g} qtsl_gate_scalar;

  // The diagonal species genus (open, additive): per nontrivial
  // zero-lag cycle, ONE species-tagged certificate that the instant
  // loop restricted to the carve product admits a joint solution —
  // the Z5 discriminant: carve-INVARIANCE is provably insufficient
  // (the machine-checked z5_carvedDelivery_mark /
  // z5_no_carve_closure pair). The fixpoint device lives in the
  // metatheorem per species; the checker verifies only the finite
  // rows.
  DiagKind : Set;

  dgPoint    : DiagKind;   // rational witness point (the r4 value
                           // column, subsumed; also the honest
                           // species for discrete markings —
                           // finitely presentable)
  dgEnum     : DiagKind;   // bounded enumeration, finite instant
                           // alphabets
  dgContract : DiagKind;   // per-edge Lipschitz/gain rows, cycle
                           // product < 1, exact-Q + factor-carve
                           // nonemptiness/closedness (Banach)
  dgConvex   : DiagKind;   // compact-convex carve-genus + convex-
                           // valued instant deliveries (Kakutani)
  dgMonotone : DiagKind;   // order-interval carves + monotone
                           // instant maps (Knaster-Tarski; the
                           // plated/bag-order species)

  refuse ax/qtsl/diag_distinct_point_enum : forall k : DiagKind.
    k = dgPoint, k = dgEnum |- false;
  refuse ax/qtsl/diag_distinct_point_contract : forall k : DiagKind.
    k = dgPoint, k = dgContract |- false;
  refuse ax/qtsl/diag_distinct_point_convex : forall k : DiagKind.
    k = dgPoint, k = dgConvex |- false;
  refuse ax/qtsl/diag_distinct_point_monotone : forall k : DiagKind.
    k = dgPoint, k = dgMonotone |- false;
  refuse ax/qtsl/diag_distinct_enum_contract : forall k : DiagKind.
    k = dgEnum, k = dgContract |- false;
  refuse ax/qtsl/diag_distinct_enum_convex : forall k : DiagKind.
    k = dgEnum, k = dgConvex |- false;
  refuse ax/qtsl/diag_distinct_enum_monotone : forall k : DiagKind.
    k = dgEnum, k = dgMonotone |- false;
  refuse ax/qtsl/diag_distinct_contract_convex : forall k : DiagKind.
    k = dgContract, k = dgConvex |- false;
  refuse ax/qtsl/diag_distinct_contract_monotone : forall k : DiagKind.
    k = dgContract, k = dgMonotone |- false;
  refuse ax/qtsl/diag_distinct_convex_monotone : forall k : DiagKind.
    k = dgConvex, k = dgMonotone |- false;

  // Closure (the dtype pattern): a fresh species would evade the
  // per-species recompute/verify casing of the MarkFlow walk.
  refuse ax/qtsl/diag_kind_closed : forall k : DiagKind.
    not k = dgPoint, not k = dgEnum, not k = dgContract,
    not k = dgConvex, not k = dgMonotone
    |- false;

  // One diagonal certificate: its species tag plus its finite rows
  // (dgPoint/dgEnum recompute directly; dgContract/dgConvex/
  // dgMonotone verify as their rows). First-class carve-genus
  // conformance FLAGS (convexity/completeness/order) are
  // deliberately not minted — the species' rows carry their own
  // citations, and flags arrive with the evaluator's first
  // consumer, additively.
  QDiagCert : Set;

  QDiagCert/kind : QDiagCert -> DiagKind;
  QDiagCert/rows : QDiagCert -> QProofList;

  QDiagList : Set;

  qdgNil  : QDiagList;
  qdgCons : {head: QDiagCert, tail: QDiagList} -> QDiagList;

  refuse ax/qcert/qdiag_nil_cons_disjoint : forall h : QDiagCert,
      t : QDiagList, l : QDiagList.
    l = qdgNil, l = {head: h, tail: t} qdgCons
    |- false;

  QWireComposeMarks : Set;

  QWireComposeMarks/proof : QWireComposeMarks -> QProof;
  QWireComposeMarks/components : QWireComposeMarks -> QSatList;
  QWireComposeMarks/wirecert : QWireComposeMarks -> QWireCert;
  QWireComposeMarks/latency_rows : QWireComposeMarks -> QProofList;
  QWireComposeMarks/schedule : QWireComposeMarks -> QRatList;
      // one rational stage label per demanded mark (the stage
      // column), positional against the demanded marks
  QWireComposeMarks/carves : QWireComposeMarks -> QCarveList;
      // the carve column: one carve per mark on a zero-lag cycle,
      // addressed by wire
  QWireComposeMarks/carve_rows : QWireComposeMarks -> QProofList;
      // per carved mark, PAIRED entries in list order: the
      // CONTAINMENT row (carve refines mark — BernCone-species
      // nonnegativity on the sign-fiber; degenerates to dip-class
      // membership at singleton carves) then the CARVED-DELIVERY
      // citation (the component's conditional-delivery judgment
      // cited AT THE CARVES — the same judgment species as the
      // rule's premises, at tighter events; pointed citations are
      // the singleton case). The pairing is verified by the
      // MarkFlow walk's bounded recompute, where list-shape
      // obligations live.
  QWireComposeMarks/diagonal_rows : QWireComposeMarks -> QDiagList;
      // one species-tagged diagonal certificate per nontrivial
      // zero-lag cycle
  QWireComposeMarks/entailment : QWireComposeMarks -> Proof;
      // the BL sequent: /\_i g_i |- marks(spec_out) — the
      // mark-entailment cut, a la Promise
  QWireComposeMarks/wellposedness : QWireComposeMarks -> QProofList;
      // W0-species reuse; stepwise-properness tier (comment above)

  // The MarkFlow walk: from the node's schedule, carves, latency
  // rows, and the cited certificate's wiring — (stage column)
  // feasibility of the difference-constraint system the latency
  // rows induce at the labels: label equality across instantaneous
  // wires, shifts through delay media; Bellman-Ford-class
  // consistency, bounded recompute over the node's declaration
  // closure, never chase derivation — the exists-dual of
  // qtsl_wire_causality: that walk refuses every cycle, this one
  // admits every cycle whose schedule closes and refuses
  // time-travel. PLUS (carve column) coverage: the stage rows force
  // every admitted cycle to total lag zero and one shared label (a
  // single SCC pass on the instant subgraph), and on each such
  // cycle the marks' carves must be present with their containment
  // + carved-delivery pairs AND one diagonal certificate — the swap
  // loop with swap-closed marks is refused HERE, by the diagonal,
  // where neither stage arithmetic nor carve-invariance can see it.
  // No well-foundedness anywhere; demanded on every instance;
  // registered beside qtsl_wire_causality in the recompute
  // registry (Lean specs: MarkFlowFeasible; CarveClosure, consumed
  // abstractly — the species are its dischargers).
  qtsl_wire_markflow : {node: QWireComposeMarks} -> Prop;
      // side-condition

  report ax/wf/qwirecomposemarks_markflow : forall n : QWireComposeMarks.
    |- {node: n} qtsl_wire_markflow;

  // Guard elimination at consumption, inherited (the standing law:
  // every consumer of guarded claims owns the duty as its own
  // clause): a marks-composition node consuming a guarded premise
  // discharges the guard's initial-membership before treating the
  // premise as a guarantee — the same walk over the same qsatCons
  // spine as at QWireCompose.
  report ax/wf/qwirecomposemarks_guard_elim : forall
      n : QWireComposeMarks,
      l : QSatList, q : QSat, y : System, sp : Spec,
      g : QRegionAtom.
    n QWireComposeMarks/components = l,
    {list: l, sat: q} qsat_list_member,
    q QSat/sys = y,
    q QSat/spec = sp,
    {spec: sp, region: g} spec_guard
    |- {region: g, sys: y} qtsl_init_member;

  // The aggregation-reduction rule node: reduces an aggregate
  // claim through a polytope row plus coupling, count, and moment
  // row kits — each an exact-rational proof-leaf list.
  QAggReduce : Set;

  QAggReduce/proof : QAggReduce -> QProof;
  QAggReduce/polytope_row : QAggReduce -> Proof;
  QAggReduce/coupling_rows : QAggReduce -> QProofList;
  QAggReduce/count_rows : QAggReduce -> QProofList;
  QAggReduce/moment_rows : QAggReduce -> QProofList;

  // ==========================================================
  // Stochastic wires and marginal compatibility
  // ==========================================================
  //
  // A penalty function names convex-analytic content: the
  // indicator of a named cell set, or a registered function class.
  // A stochastic wire carries one with its convexity, lower
  // semicontinuity, and properness row kits. Marginal
  // compatibility packages the per-contributor dominance rows over
  // a shared sample space; the contributor list's shape agreement
  // against the space is an admission demand.

  QPenaltyFun : Set;

  qpfIndicator : {cells: Shape, space: Shape} -> QPenaltyFun;
  qpfNamed : {class: Str, name: Str, space: Shape} -> QPenaltyFun;

  refuse ax/qcert/penalty_indicator_named_disjoint : forall cs : Shape,
      sp : Shape, cl : Str, nm : Str, f : QPenaltyFun.
    f = {cells: cs, space: sp} qpfIndicator,
    f = {class: cl, name: nm, space: sp} qpfNamed
    |- false;

  StochWire : Set;

  StochWire/fun : StochWire -> QPenaltyFun;
  StochWire/convex_rows : StochWire -> QProofList;
  StochWire/lsc_rows : StochWire -> QProofList;
  StochWire/proper_rows : StochWire -> QProofList;

  QStochContribList : Set;

  qscNil  : QStochContribList;
  qscCons : {axes: Shape, fun: QPenaltyFun, tail: QStochContribList}
    -> QStochContribList;

  QMarginalCompat : Set;

  QMarginalCompat/proof : QMarginalCompat -> QProof;
  QMarginalCompat/space : QMarginalCompat -> Shape;
  QMarginalCompat/contributors : QMarginalCompat -> QStochContribList;
  QMarginalCompat/dominance_rows : QMarginalCompat -> QProofList;

  qtsl_stochwire_shape : {contribs: QStochContribList, space: Shape}
    -> Prop;   // side-condition

  report ax/wf/stochwire_shape : forall m : QMarginalCompat,
      sp : Shape, cl : QStochContribList.
    m QMarginalCompat/space = sp,
    m QMarginalCompat/contributors = cl
    |- {contribs: cl, space: sp} qtsl_stochwire_shape;

  // ==========================================================
  // Stored bag values
  // ==========================================================
  //
  // The marked-population CARRIER is subject-stratum content; this
  // stratum stores concrete bag VALUES — initial markings, fixture
  // states, reset images — as a declared per-token rank plus a
  // canonically ordered token list, so that multiset equality is
  // syntactic equality of hash-consed rows. The token count is
  // DERIVED as the list length, never stored: a stored count could
  // disagree with the list; derived it cannot.

  QBagTokList : Set;   // cons-list of token colour vectors
  QBagVal     : Set;   // a stored bag value

  qbtNil  : QBagTokList;
  qbtCons : {head: QRatList, tail: QBagTokList} -> QBagTokList;

  qbagMk : {dim: Nat, tokens: QBagTokList} -> QBagVal;

  // The canonical-multiset receipt: every token's coordinate count
  // equals the declared rank; tokens non-strictly lexicographically
  // ascending under exact-rational compare (duplicates legal —
  // equal tokens hash-cons to one element, so equal-adjacent IS the
  // representative). Refusals with no verdict: unconstructed or
  // ambiguous elements, list cycles, dimension and token-count
  // budgets.
  qtsl_bag_canon : {bag: QBagVal} -> Prop;   // side-condition

  report ax/wf/bag_canon : forall b : QBagVal.
    |- {bag: b} qtsl_bag_canon;

  // ==========================================================
  // Ground probabilistic programs
  // ==========================================================
  //
  // A ground probabilistic logic program as rows: coins (Bernoulli
  // outcomes with exact-rational probabilities, optionally grouped
  // into mutually exclusive switch domains), deterministic facts,
  // coin-attached facts, ground definite clauses, one query atom.
  // Atoms and coins are natural-number identifiers — grounding and
  // interning are producer-side. Coin and atom SETS ride the ground
  // sequence sort as strictly ascending sequences: canonical set
  // representatives, so set equality is row equality.
  //
  // Soundness spine: least models by saturation, and monotonicity
  // of derivability in the fact set — one saturation run settles a
  // whole orthant of worlds. Probability is an event-algebra
  // quantity, never a semiring sum: lower bounds by
  // inclusion-exclusion over coin-set UNIONS, upper bounds by
  // minimum over verified cuts, exact values by world enumeration
  // or compiled decision terms; no bound carries a completeness
  // claim.

  QPlogCoinList   : Set;   // cons-list of coin declarations
  QPlogFactList   : Set;   // cons-list of probabilistic facts
  QPlogClauseList : Set;   // cons-list of ground definite clauses
  QPlogProg       : Set;   // a ground program value
  QPlogSetList    : Set;   // cons-list of coin sets

  qpcNil  : QPlogCoinList;
  qpcCons : {id: Nat, prob: Q, tail: QPlogCoinList} -> QPlogCoinList;
  // The domain-carrying coin constructor: coins sharing a domain
  // are the mutually exclusive outcomes of one switch — exactly one
  // true per world, probabilities totalling one (decided at the
  // well-formedness walk). Absent domain = independent coin;
  // semantics degenerate to the plain reading when no domain
  // appears. World enumeration goes mixed-radix; an explanation row
  // naming two outcomes of one switch describes no possible world;
  // exclusive rows add with no overlap term.
  qpcConsD : {dom: Nat, id: Nat, prob: Q, tail: QPlogCoinList}
    -> QPlogCoinList;

  // A coin is independent or a switch outcome, never both: the two
  // readings book measure differently, and one element wearing both
  // would double-book it.
  refuse ax/qcert/coin_plain_domain_disjoint : forall d : Nat,
      i : Nat, p : Q, t : QPlogCoinList, l : QPlogCoinList.
    l = {id: i, prob: p, tail: t} qpcCons,
    l = {dom: d, id: i, prob: p, tail: t} qpcConsD
    |- false;

  // Coin probabilities are probabilities. The closed interval is
  // deliberate — degenerate coins are representable — and the
  // well-formedness walk owns the rest of the coin discipline.
  report ax/wf/qplog_coin_prob : forall i : Nat, p : Q,
      t : QPlogCoinList, l : QPlogCoinList.
    l = {id: i, prob: p, tail: t} qpcCons
    |- {l: 0, r: p} q_le, {l: p, r: 1} q_le;

  report ax/wf/qplog_coind_prob : forall d : Nat, i : Nat, p : Q,
      t : QPlogCoinList, l : QPlogCoinList.
    l = {dom: d, id: i, prob: p, tail: t} qpcConsD
    |- {l: 0, r: p} q_le, {l: p, r: 1} q_le;

  qpfNil  : QPlogFactList;
  qpfCons : {atom: Nat, coin: Nat, tail: QPlogFactList}
    -> QPlogFactList;

  qpkNil  : QPlogClauseList;
  qpkCons : {body: Shape, head: Nat, tail: QPlogClauseList}
    -> QPlogClauseList;

  qplogMk : {clauses: QPlogClauseList, coins: QPlogCoinList,
             dets: Shape, facts: QPlogFactList, query: Nat}
    -> QPlogProg;

  qpsNil  : QPlogSetList;
  qpsCons : {set: Shape, tail: QPlogSetList} -> QPlogSetList;

  // Well-formedness, decided content: coin identifiers distinct,
  // probabilities exact-rational in the unit interval, switch
  // domains totalling one, facts referencing declared coins,
  // deterministic facts and clause bodies strictly ascending.
  // Refusals: unconstructed or ambiguous elements, list cycles,
  // structural budgets. Demanded per program.
  qtsl_problog_wf : {prog: QPlogProg} -> Prop;   // side-condition

  report ax/wf/problog_wf : forall pg : QPlogProg.
    |- {prog: pg} qtsl_problog_wf;

  // The query derives with exactly the world's coins true — by
  // monotonicity a sound lower-bound contributor whether or not any
  // explanation list is complete. Reads no probabilities.
  qtsl_problog_derives : {prog: QPlogProg, world: Shape} -> Prop;
      // side-condition

  // The query FAILS with the cut's coins false and every other coin
  // true — by monotonicity the query event is contained in the
  // cut's disjunction. The positive spelling of the blocking fact.
  qtsl_problog_blocks : {cut: Shape, prog: QPlogProg} -> Prop;
      // side-condition

  // The exact value by full world enumeration under the product
  // measure; refuses past the enumeration budget, and refuses on
  // non-wellformed programs — no measure to evaluate under.
  qtsl_problog_exact : {p: Q, prog: QPlogProg} -> Prop;
      // side-condition

  // Explanations and the inclusion-exclusion lower bound as one
  // self-contained sound judgment: every explanation row derives
  // AND the bound is inclusion-exclusion over the rows' coin-set
  // UNIONS (a shared coin counts once). Row-count budget refuses.
  qtsl_problog_lower : {expls: QPlogSetList, lo: Q, prog: QPlogProg}
    -> Prop;   // side-condition

  // Cuts and the product upper bound as one self-contained sound
  // judgment: every cut row blocks AND the bound is the minimum
  // over cuts of one minus the product of complements (the empty
  // list demands the vacuous bound).
  qtsl_problog_upper : {cuts: QPlogSetList, hi: Q, prog: QPlogProg}
    -> Prop;   // side-condition

  // The truncated inclusion-exclusion lower bound: every
  // explanation row derives AND the bound is the depth-truncated
  // prefix over the rows' coin-set unions. Even depth required —
  // even-depth prefixes are sound lower bounds at any row count;
  // odd depth is decided false. Sound exactly where the full
  // inclusion-exclusion budget refuses; its own caps refuse.
  qtsl_problog_bonferroni : {depth: Nat, expls: QPlogSetList, lo: Q,
                             prog: QPlogProg} -> Prop;
      // side-condition

  // Compiled decision terms: a decision term denotes a function
  // from worlds to accept-or-reject by path-following. Leaves carry
  // coin sets INLINE as canonical strictly-ascending
  // representatives — dangling row indices are unrepresentable, and
  // hash-consing recovers list compression. Arms are canonical by
  // ascending outcome coin. Sharing is inside the semantics: terms
  // are identified structurally, equal subtrees ARE one element,
  // and the judgment quantifies over paths of the UNFOLDING — sound
  // because no condition mentions node identity; per-path coverage
  // and freshness compose bottom-up as synthesized attributes.

  QPlogDecTree : Set;   // a compiled decision term
  QPlogArmList : Set;   // cons-list of switch arms

  qpdDecide : {coin: Nat, hi: QPlogDecTree, lo: QPlogDecTree}
    -> QPlogDecTree;
  qpdSwitch : {arms: QPlogArmList, dom: Nat} -> QPlogDecTree;
  qpdAccept : {expl: Shape} -> QPlogDecTree;
  qpdReject : {cut: Shape} -> QPlogDecTree;

  qpaNil  : QPlogArmList;
  qpaCons : {child: QPlogDecTree, coin: Nat, tail: QPlogArmList}
    -> QPlogArmList;

  refuse ax/qcert/dec_accept_reject_disjoint : forall s : Shape,
      d : QPlogDecTree.
    d = {expl: s} qpdAccept, d = {cut: s} qpdReject
    |- false;

  // The compiled-term judgment: the value is EXACTLY the query
  // probability, certified by a leaf-covered decision term — exact
  // beyond the enumeration budget. Holds if and only if: the
  // program is well-formed (refuses otherwise); every decide coin
  // is declared and domain-free (a bit-split of a switch outcome
  // would double-book the switch's measure) and every switch's arms
  // are exactly its domain's outcomes once each, ascending, with no
  // coin or domain decided twice on any path — freshness is
  // load-bearing for the fold, not hygiene (a re-decided coin would
  // weight its dead branch where the conditional measure is one);
  // every distinct accept leaf is canonical, declared, names at
  // most one outcome per switch, and its query DERIVES with exactly
  // its coins true; every distinct reject leaf is canonical,
  // declared, and its query FAILS with its coins false and all
  // others true (a cut may name several outcomes of one switch — it
  // denotes their disjunction); on every path of the unfolding the
  // accept set lies within the path's true-set and the reject set
  // within its false-set; and the value equals the exact-rational
  // fold over the term. Partition plus per-leaf monotone orthant
  // arguments force the accept region to BE the query event;
  // antichain completeness is never claimed — a gap surfaces as a
  // cut row failing its blocking run. Refusals with no verdict:
  // cyclic terms, unconstructed or ambiguous elements, budgets.
  qtsl_problog_compiled : {p: Q, prog: QPlogProg, tree: QPlogDecTree}
    -> Prop;   // side-condition

  // ==========================================================
  // Deliberately absent (the testable negatives)
  // ==========================================================
  //
  // No stored nonemptiness certificates: nonemptiness discharges at
  // use sites, and emptiness marks are THE optional slot, carried
  // at the cell stratum where they arise — never verdict content.
  // No polarity folded into constraint species: the verdict form's
  // two lists are the one polarity home, and no battery or region
  // sort carries a polarity flag. No stored composite slack and no
  // stored wired-composite subject on the composition node: both
  // derive at consumption. No stored token counts, no stored
  // refinement of a patch tree, no stored face geometry on a sign
  // battery row, and no stored derived-arena on a lattice: each is
  // derived where consumed, because a stored copy could disagree
  // with its derivation and a derived one cannot. No per-former
  // rows-species vocabulary here: the per-former quadruple (rows,
  // deciders, law, feeding tie) lives with each former's species
  // theory, against this file's judgment and battery genus. No
  // second satisfaction sort for interface-indexed claims: an
  // interface-indexed claim is a claim whose specification carries
  // an interface.

  // ==========================================================
  // THE CERTIFICATE-SHAPE STRATUM (branch-indexed families)
  // ==========================================================
  //
  //
  // The certificate-shape stratum: how a certificate for a
  // battery-class conclusion is INDEXED, and the row species that
  // consume the index. One certificate sort — a branch-indexed family
  // whose nullary case is the scalar — plus the datum that makes the
  // index well-posed: a binding-time tag on every declared
  // nondeterminism axis of the subject presentation.
  //
  // The semantics this shape answers to: a compiled adversary-
  // quantified denotation is a radial UNION of per-resolution bodies,
  // finer than the rectangularization that any per-state envelope
  // interface transmits, and the gap is verdict-visible on both the
  // safety and the liveness face. The certificate therefore parallels
  // the body's disjunctive presentation: axes of nondeterminism that
  // are re-chosen per step enter drift reads as region axes
  // (quantified cellwise where consumed), while axes committed once
  // per run index the certificate family. Which is which is not
  // recoverable from the dynamics — it is presentation data, recorded
  // here, per axis. Without that datum the generator form is
  // ambiguous between the union and its rectangularization.
  //
  // Consumption polarity, fixed by the constructible geometry:
  // containment (safety) faces consume the family universally — every
  // branch certified, or discharged by an emptiness certificate or a
  // domination row; escape (liveness) faces and the feasibility
  // conjunct consume it existentially — one selected branch plus a
  // properness witness on it. The selection is a first-cut slot, not
  // an extension: essentially every specification carries at least
  // one liveness obligation, so essentially every family carries at
  // least one selection.
  //
  // Witness economy: EMPTINESS certificates are the optional slot —
  // an emptiness cert on a branch discharges that branch's
  // universal-side obligations (a branch denoting the zero body
  // contributes nothing to any slice: per-branch ex falso).
  // Nonemptiness is never stored as a slot; it discharges at each use
  // site, as the selection's properness witness. Kill-switches and
  // halting adversaries are modeled as explicit cemetery mass (the
  // step-outcome alphabet already makes sub-stochastic deficit
  // unrepresentable), never as infeasibility — so emptiness reads as
  // contradiction discharge, and near-death branches price honestly
  // through the slice.
  //
  // Conformance family C-CERT-AXES (admission, per system): at most
  // one axis per (system, position); positions contiguous from zero.
  //
  // Conformance family C-CERT-FAM (admission, per family): at most
  // one axis per (family, position), positions contiguous; branch
  // keys of every content row have width equal to the family's axis
  // roster length, each component within its axis's enumerated
  // extent; at most one body reference per (family, branch, body),
  // body positions contiguous per branch; at most one selection row
  // per (family, sel), at most one refining cell per selection and
  // only for a declared selection; at least one selection row unless
  // every consuming conclusion is safety-only (the mandatory-by-
  // default reading); no branch both selection-cited and
  // emptiness-certified; the domination relation irreflexive and
  // acyclic (a domination cycle would discharge every branch);
  // hand-off rows citing body positions the named branches carry.
  // Branch keys are ground data, so every one of these is counting or
  // ground comparison — admission, never geometry.

  // ==========================================================
  // Binding time (the axis contract datum)
  // ==========================================================
  //
  // step: re-chosen at every step — the axis enters drift reads as
  //   a region axis and is quantified cellwise where consumed; no
  //   envelope object is ever materialized (a cellwise row IS the
  //   envelope bound, pointwise).
  // run: committed once per run — the axis indexes the certificate
  //   family (enumerated extent) or extends the bodies' variable
  //   domain (parametric extent).

  BindingTime : Set;

  btStep : BindingTime;
  btRun  : BindingTime;

  refuse ax/cert/bt_disjoint : forall b : BindingTime.
    b = btStep, b = btRun
    |- false;

  // ==========================================================
  // Axis extents
  // ==========================================================
  //
  // An enumerated extent carries its branch count: keys range over
  // 0..count-1. A parametric extent carries a box enclosure of its
  // domain; a semialgebraic refinement of the domain is a cell-
  // schema citation contributed where certificate and cell
  // vocabulary meet, not a field here.

  NDExtent : Set;

  ndEnum  : {count: Nat} -> NDExtent;
  ndParam : {domain: Box} -> NDExtent;

  refuse ax/cert/nd_extent_disjoint : forall c : Nat, d : Box,
      e : NDExtent.
    e = {count: c} ndEnum, e = {domain: d} ndParam
    |- false;

  // A zero-count enumerated axis would make the run-index space
  // empty — zero branches is NOT the scalar (the scalar is one
  // branch under the width-zero key), and an empty family is
  // universally vacuous while satisfying no selection.
  report ax/wf/nd_enum_pos : forall c : Nat, e : NDExtent.
    e = {count: c} ndEnum
    |- {l: 0, r: c} nat_lt;

  // ==========================================================
  // Crossing budgets (the Zeno seam, priced)
  // ==========================================================
  //
  // A crossing budget prices a system's instant crossings: a
  // witness W (polynomial per mode) and a constant c, certifying
  // the expected instant-crossing count — additive species,
  // E[N^f_t] <= W(x0) + c*t; tilted species,
  // E[N^f_T] <= e^{c*T} * W(x0), the superlinear chattering class
  // the additive row honestly refuses. (The superscript keeps the
  // GSHS forced-crossing letter; the schema word is INSTANT — the
  // tkForced wing is deterministic delay, strictly positive, and
  // owes this family nothing.) Instant jump times are
  // predictable debuts, so N^f is its own compensator: no intensity
  // density exists to declare, and the only handle on the expected
  // count is a potential-theoretic witness. This family is that
  // witness's declaration form — rate-bound DECLARES a density
  // bound where a density exists; the budget CERTIFIES a
  // compensator-mass bound where none can.
  //
  // The obligations are the three Z-rows, demanded as
  // side-conditions and discharged at the ground seam, loudly
  // deferred while unrealized:
  //   (Z1) budget-drift, per mode on the mode cell: the per-mode
  //        extended generator (drift + diffusion + the spontaneous
  //        Davis compensator) applied to W, bounded by c (additive)
  //        or by c*W (tilted). Spontaneous resets need no drop —
  //        their W-cost is budgeted inside c through the
  //        compensator term.
  //   (Z2) budget-seam, per INSTANT transition — clock = tkRace at
  //        the infinite majorant — on the guard slab: the reset
  //        decreases W by at least one. The seam-row species at
  //        threshold minus one; the safety seam reads the same
  //        polynomial object at threshold zero. One object, three
  //        obligations. Dirac resets discharge now; finite-leg
  //        kernels loudly defer until the mixture route is
  //        realized at this seam.
  //   (Z3) nonnegativity: W >= 0 on cells and slabs.
  //
  // Scope is the instant stratum only: finite-majorant rows owe no
  // seam obligation (their cost lives in c), and the demonic,
  // forced, and carved-window wings — strict dwell/window floors,
  // so structurally rate-capped
  // at T/d + 1 fires per row per horizon — have neither rates to
  // bound nor instant crossings to count: a budget slot on those
  // strata would be exactly the type error the Zeno reframe
  // killed.
  //
  // POLARITY WIRING, structural — split by quantifier, per the
  // angelic-liveness revision: the attachment slot indexes a
  // forall-face entry of the claim's compiled verdict form, and
  // the indexed entry must be LIVENESS content — progress or a
  // deadline demanded of every admitted law, or a claim that is
  // itself an event-count or tail bound. Those claims genuinely consume
  // non-Zeno of the WHOLE envelope, and the budget is their price.
  // Mark-face (angelic) liveness rows — some admitted law attains —
  // take the asel_warrant slot instead (one witnessed law, no
  // envelope pricing; the selection family below). Safety rows take
  // NEITHER: safety soundness never consumes survival mass, and a
  // spelling that priced a safety row would re-open exactly the
  // polarity confusion the two-list form exists to prevent. A row
  // carrying both slots is a conformance refusal — no judgment
  // consumes both an envelope price and a single-law witness — and
  // the refusal is GLOBAL BY ENTITY, not per claim occurrence: the
  // warrant slot is keyed by the QRegionSat element, so one entity
  // warranted as a mark anywhere and budget-indexed on the
  // forall face anywhere is refused; a producer wanting both readings clones
  // the row entity (hash-consing does not apply — QRegionSat is an
  // entity sort).
  // Attachment is optional; absence mints no C-CB attachment demand
  // here — the consuming liveness rule owns definedness evidence
  // for an unpriced row, and must reject or loudly defer where none
  // is offered.
  //
  // Conformance family C-CB (obligations demanded at admission;
  // deferred while the evaluator is unrealized): per budget, at
  // most one witness row per mode, with mode coverage of the
  // subject's manifest; per attachment, the position indexes into
  // the forall_face list of the claim's compiled form (the
  // verdict's polarity home), the indexed entry is liveness
  // content (progress, deadline, event count — never a safety
  // bound, and never a row also warranted by an angelic
  // selection), and the budget's subject IS the claim's.

  CBSpecies : Set;   // value: which budget-drift species

  cbAdditive : CBSpecies;   // (Z1)  generator of W bounded by c
  cbTilted   : CBSpecies;   // (Z1') generator of W bounded by c*W

  refuse ax/qtsl/cb_species_disjoint : forall k : CBSpecies.
    k = cbAdditive, k = cbTilted
    |- false;

  // Closure (the dtype pattern; retrofitted at the three-wing
  // revision alongside the other enum sorts): a fresh species would
  // evade the drift obligation's additive/tilted casing.
  refuse ax/qtsl/cb_species_closed : forall k : CBSpecies.
    not k = cbAdditive, not k = cbTilted
    |- false;

  CrossBudget : Set;   // entity: one crossing-budget declaration

  CrossBudget/sys     : CrossBudget -> System;
  CrossBudget/species : CrossBudget -> CBSpecies;
  CrossBudget/const   : CrossBudget -> Q;

  // Budget subjects are mechanism-rooted in this revision: the
  // witness roster is per-mode (a manifest's, hence a mechanism's,
  // vocabulary), and the seam demand below joins the subject's
  // DIRECT transition attachments — a wire-composite subject would
  // under-demand its inner systems' instant crossings, so the
  // composite spelling is refused rather than silently
  // under-priced. Composite budgets arrive, if a consumer wants
  // them, as an additive extension: a budget-scoped inner-roster
  // walk premising the seam demand, never a reinterpretation of
  // this refusal.
  refuse ax/qtsl/cb_subject_wire : forall b : CrossBudget, s : System,
      inn : SystemList, w : Wiring.
    b CrossBudget/sys = s, s = {inner: inn, wiring: w} SysWire
    |- false;

  // The per-mode witness roster.
  cb_witness : {cb: CrossBudget, mode: Mode, w: Poly} -> Prop;

  // The budget constant admits zero — the landed rank witness is
  // the additive c = 0 instance — while negative refills are
  // unspellable.
  report ax/wf/cb_const_nonneg : forall b : CrossBudget, c : Q.
    b CrossBudget/const = c
    |- {l: 0, r: c} q_le;

  // The optional liveness attachment: position indexes the
  // forall_face list of the claim's compiled verdict form (the
  // liveness row the budget prices — the polarity wiring above).
  qsat_zeno_budget : {sat: QSat, pos: Nat, cb: CrossBudget} -> Prop;

  qtsl_cb_drift  : {cb: CrossBudget, mode: Mode} -> Prop;
      // side-condition (Z1/Z1')
  qtsl_cb_seam   : {cb: CrossBudget, tr: Transition} -> Prop;
      // side-condition (Z2; Dirac now, mixtures loudly deferred)
  qtsl_cb_nonneg : {cb: CrossBudget} -> Prop;
      // side-condition (Z3)
  qtsl_cb_wf     : {cb: CrossBudget} -> Prop;
      // side-condition (C-CB, roster half)
  qtsl_cb_attach : {sat: QSat, pos: Nat, cb: CrossBudget} -> Prop;
      // side-condition (C-CB, attachment half)

  report ax/wf/cb_drift : forall b : CrossBudget, m : Mode, w : Poly.
    {cb: b, mode: m, w: w} cb_witness
    |- {cb: b, mode: m} qtsl_cb_drift;

  // The seam demand fires exactly on the instant stratum: the
  // premise casing is the plane discriminator at work. The demonic,
  // forced, and carved-window wings acquire no seam obligation —
  // their strict dwell/window floors are the structural cap the
  // budget would otherwise have to price.
  report ax/wf/cb_seam : forall b : CrossBudget, s : System,
      t : Transition, k : TrClock, e : EnnRat.
    b CrossBudget/sys = s,
    {sys: s, tr: t} sys_transition,
    t Transition/clock = k, k = {majorant: e} tkRace, e = enInf
    |- {cb: b, tr: t} qtsl_cb_seam;

  report ax/wf/cb_nonneg : forall b : CrossBudget.
    |- {cb: b} qtsl_cb_nonneg;

  report ax/wf/cb_wf : forall b : CrossBudget.
    |- {cb: b} qtsl_cb_wf;

  report ax/wf/cb_attach : forall r : QSat, p : Nat, b : CrossBudget.
    {sat: r, pos: p, cb: b} qsat_zeno_budget
    |- {sat: r, pos: p, cb: b} qtsl_cb_attach;

  // ==========================================================
  // Angelic liveness: the positional-selection witness
  // ==========================================================
  //
  // Liveness in this schema is angelic: a liveness demand rides
  // the mark list -- some admitted law attains the bound -- so its
  // Zeno precondition is one honest law, never a non-Zeno
  // envelope (the crossing-budget family prices the envelope,
  // where a forall-face progress claim genuinely needs it). The
  // witness exhibits that law positionally: over a region that
  // overapproximates the reachable set (an ordinary safety
  // warrant, cited -- invariant machinery reused, never
  // re-derived), a finite cell cover, per cell a chosen
  // transition. The resolution "fire the choice at its earliest
  // permitted time on relay cells; hold until eps on dwell cells"
  // glues the pointwise rows into one memoryless law.
  //
  // Two cell species:
  //   * DWELL -- where the law sits: the declared exit roster is
  //     complete, its finite majorants sum to at most 1/eps (the
  //     demonic rate cap and the angelic dwell floor are one
  //     number read by two quantifiers), and no instant-clocked
  //     row is active on the cell. (A forced row active on a dwell
  //     cell is structurally capped -- at most T/d + 1 fires per
  //     horizon -- so its count rides the global arithmetic, not
  //     the rate cap; the glue lemma owes the formal casing.)
  //   * RELAY -- where the law only passes through: the choice is
  //     fireable with zero scheduler delay (instant-clocked, or
  //     demonic, forced, or carved-window -- a strictly positive
  //     declared dwell/window floor is the hop's own bought time,
  //     and a carved row's FINITE ceiling additionally bounds the
  //     hop's dwell), it is the only
  //     instant row active on the cell, and its landing enclosure
  //     lands in the DWELL union. Relays cannot chain:
  //     landing-in-dwell is the anti-cascade discipline,
  //     structural rather than counted.
  //
  // Deliberately absent, each absence load-bearing:
  //   * no rules and no judgment kind -- the family is
  //     warrant-side content consumed through the mark list (the
  //     slot below); rule packaging is certificate-stratum work,
  //     parked;
  //   * no budget slot -- a witness that also carried a crossing
  //     budget would re-import the envelope pricing the angelic
  //     reading exists to shed (and a mark both warranted here and
  //     indexed by a zeno_budget row is refused at conformance --
  //     the polarity wiring at the budget family);
  //   * no vacuous route -- the reach row ties an inhabited
  //     initial membership through the cited warrant, and the
  //     mark this family serves demands the very law the witness
  //     constructs: a body whose every law is Zeno admits no
  //     tagging (the search fails with the obstruction cell in
  //     hand), so "live" is never concluded ex falso of an empty
  //     or all-Zeno body -- the same non-vacuous verdict the
  //     inconsistent-system inversion gives algebraic emptiness.
  //
  // The clock reads in the side-conditions cite TrClock's four
  // wings -- tkRace {majorant} / tkDemonic {dwellMin} / tkForced
  // {dwell} / tkCarved {floor, ceil} (revision event 5) -- declared
  // at the Transition former above, whose
  // meter law (guard exit resets; the row's own firing resets)
  // this family's counting leans on.

  ASelKind : Set;

  askDwell : ASelKind;
  askRelay : ASelKind;

  refuse ax/qtsl/asel_kind_disjoint : forall k : ASelKind.
    k = askDwell, k = askRelay
    |- false;

  // Closure: a negated-premise denial, evaluated after saturation
  // (the dtype-closure pattern). Without it a cell carrying a fresh
  // third kind would owe neither species obligation — an unpriced,
  // unclosed liveness choice passing as covered.
  refuse ax/qtsl/asel_kind_closed : forall k : ASelKind.
    not k = askDwell, not k = askRelay
    |- false;

  ASelWitness : Set;   // entity: one selection witness

  ASelWitness/sys   : ASelWitness -> System;
  ASelWitness/eps   : ASelWitness -> Q;
  ASelWitness/reach : ASelWitness -> QRegionSat;
      // the reach row's anchor: an ordinary safety warrant whose
      // region overapproximates the subject's reachable set --
      // invariance and initial membership are ITS obligations,
      // discharged by the existing safety row family; this
      // family only ties identity and agreement (side-condition
      // below), never re-proves reach

  report ax/wf/asel_eps_pos : forall w : ASelWitness, e : Q.
    w ASelWitness/eps = e
    |- {l: 0, r: e} q_lt;

  ASelCell : Set;   // entity: one cell of the cover

  ASelCell/wit    : ASelCell -> ASelWitness;
  ASelCell/dom    : ASelCell -> Box;
  ASelCell/mode   : ASelCell -> Mode;
  ASelCell/kind   : ASelCell -> ASelKind;
  ASelCell/choice : ASelCell -> Transition;

  // The dwell-cell exit roster: the declared transitions charged
  // against the rate cap. Completeness is a side-condition; the
  // sum row is whole-list arithmetic at the evaluator, per the
  // mass-one precedent.
  asel_exit : {cell: ASelCell, tr: Transition} -> Prop;

  // The mark-list slot: a mark whose truth consumes survival
  // cites its witness. Optional by relation; at most one per mark
  // is admission conformance (C-CERT-CLAIM kin), and
  // subject-agreement between the mark's claim and the witness's
  // system rides the same conformance family (the attach demand
  // below). Keying is BY ENTITY: one witness may lawfully warrant
  // many marks, and a mark entity shared between claims is
  // warranted for ALL of them at once — so shared marks demand one
  // agreed witness System, and the both-slots refusal at the
  // budget family reads globally by entity (clone the mark to
  // split readings).
  asel_warrant : {mark: QRegionSat, wit: ASelWitness} -> Prop;

  // Side-conditions (evaluator-deferred, loudly --
  // qtsl_init_member kin):
  qtsl_asel_reach   : {wit: ASelWitness} -> Prop;
      // the cited warrant's subject is the witness's system and
      // its region is the witness's cover target
  qtsl_asel_cover   : {wit: ASelWitness} -> Prop;
      // the cells cover the warrant region, per mode
  qtsl_asel_enabled : {cell: ASelCell} -> Prop;
      // ATTACHMENT before enabledness: the choice is a
      // sys_transition row of the witness's System and the cell's
      // mode belongs to that System's manifest — an unattached
      // transition can be fired by no resolution of the witnessed
      // System, so no active-region test may precede this check;
      // then dom lies in the choice's active region (for a demonic
      // or carved-window choice, its guard range: where the dwell
      // meter runs)
  qtsl_asel_closed  : {cell: ASelCell} -> Prop;
      // the choice's landing enclosure from dom lands in the
      // warrant region
  qtsl_asel_ratecap : {cell: ASelCell} -> Prop;
      // dwell cells: exit roster complete over the witnessed
      // System's attached transitions on dom, finite majorants sum
      // <= 1/eps, no instant-clocked row active; demonic, forced,
      // and carved-window rows contribute no majorant — their
      // strict dwell/window floors are the structural cap (event 5:
      // the window wing joins the floor-capped class)
  qtsl_asel_relay   : {cell: ASelCell} -> Prop;
      // relay cells: the choice is fireable with zero DISCRETIONARY
      // delay on dom — instant-clocked, or demonic/forced/carved
      // past its declared floor (the physical dwell is the floor,
      // never zero; a carved-window choice is relay-eligible
      // exactly as a demonic one, and a FINITE ceil additionally
      // bounds the dwell — the window wing's free non-Zeno timing
      // leg, consumed through these existing witness rows); it is
      // the only instant row active on dom, and its landing
      // enclosure from dom lands in the dwell union
  qtsl_asel_attach  : {mark: QRegionSat, wit: ASelWitness} -> Prop;
      // per warrant row: at most one witness per mark, the mark
      // sits in an exists_face list (never a forall_face list) of its
      // claims'
      // compiled forms, subject-agreement between the mark's
      // claim and the witness's system, and the mark is not also
      // priced by a zeno_budget row (the both-slots refusal)

  report ax/wf/asel_reach : forall w : ASelWitness.
    |- {wit: w} qtsl_asel_reach;

  report ax/wf/asel_cover : forall w : ASelWitness.
    |- {wit: w} qtsl_asel_cover;

  report ax/wf/asel_enabled : forall c : ASelCell.
    |- {cell: c} qtsl_asel_enabled;

  report ax/wf/asel_closed : forall c : ASelCell.
    |- {cell: c} qtsl_asel_closed;

  report ax/wf/asel_ratecap : forall c : ASelCell.
    c ASelCell/kind = askDwell
    |- {cell: c} qtsl_asel_ratecap;

  report ax/wf/asel_relay : forall c : ASelCell.
    c ASelCell/kind = askRelay
    |- {cell: c} qtsl_asel_relay;

  report ax/wf/asel_attach : forall m : QRegionSat, w : ASelWitness.
    {mark: m, wit: w} asel_warrant
    |- {mark: m, wit: w} qtsl_asel_attach;

  // ==========================================================
  // HPlate: plated certificate rows for token-population Systems
  // ==========================================================
  //
  // Enacted at the same revision event as the three-wing TrClock
  // completion, whose Transition and System declarations the rows
  // below read.
  //
  // What this vocabulary is FOR: a certificate about a System whose
  // token count is variable and canonically unbounded needs (a) ONE
  // row per transition schema, not one per instance — grammar
  // equivariance: per-token features are polynomials in the
  // REPRESENTATIVE token's color block, and no expression names
  // "the i-th token" (the plate-mech Lean theorems T-PLATE/T-NAT/
  // T-DESC are the mechanized face); and (b) aggregators whose
  // per-firing footprint rows TRANSFER to the whole marking at
  // every extent. The transfer theorem (independently co-verified
  // in review) fixes which aggregators can carry which polarity:
  //   * safety rows: any monotone commutative-monoid fold
  //     (sum, max, min; conjugated sums) — one monotone translation;
  //   * ranking (gap) rows: ONLY translated-sum scales — (Q,+)
  //     directly, or a conjugated sum READ IN phi-SPACE (the
  //     phi-transformed features summed; the checker never computes
  //     phi^{-1}); gap delta_phi is a pinned positive rational, the
  //     same witness species as the angelic family's eps;
  //   * idempotent folds (max/min/lex): safety and spec atoms only.
  //     A gap row on an idempotent aggregator is LOAD-REJECTED
  //     below — L-IDEM: gap-preservation fails at every scale
  //     (max is a fixed point of conjugation), and the max-carousel
  //     countermodel shows the failure is semantic, not notational.
  //     This is the gamma move: the modeler's trap made
  //     unrepresentable rather than discouraged.
  //   * arity-NORMALIZED aggregates (means, power means) are not
  //     folds at all — a birth changes the denominator under every
  //     untouched token — so they get NO
  //     footprint-row vocabulary here; a normalized quantity enters
  //     certificates only through cleared-denominator direct rows.
  //
  // An aggregate wire is a CONTRACTION ROW over the plate index:
  // index map binding the plate, output set the residual axes,
  // semiring named by the kind cell. The contraction row's gamma
  // side condition governs (every un-hit index
  // is an output — no phantom-axis scaling); sum wires are (Q,+,x)
  // contraction, max wires tropical. The scale-parametric cell
  // ("softale": strictly monotone in
  // every argument, interpolating between sum and max) enters as
  // an optional conjugation datum on the SAME row shape: phi(x)=x^p
  // (integer p: phi-composed features stay polynomial — exact-Q
  // today) or phi(x)=e^{beta x} (enclosure-gated: the certified
  // exp/log enclosure register, already built for the Crooks
  // catalogue lanes). No new primitive; one contraction row.
  //
  // Consumers, at staging time: the QMechForm feature-wire
  // vocabulary (counts are const(1) features aggregated by sum —
  // its "previously covered" plate ambient, now rows); MCC P/T
  // place-invariant certificates (degree-1 polynomials in count
  // wires); and the Minifab remodel (redo Minifab without the
  // fluid approximation, using HPlate, with exact Qtsl
  // certificates for the System with its full combinatorial
  // state space) — queue lengths are sum-plates,
  // bottleneck measures are conjugated-sum territory, and the
  // ranking rows at unbounded lot count are exactly the transfer
  // theorem's jurisdiction. The semicon remodel wave BLOCKS on the
  // revision event that carries these rows.

  HPlate : Set;   // a declared symbolic extent: one exchangeable
                  // token population (a Bag place), plated

  HPlate/sys : HPlate -> System;

  // Per-token feature: a polynomial in the representative token's
  // color block. Equivariance is BY CONSTRUCTION: the feature sees
  // one representative; the grammar has no index literals (the
  // const-refusal theorem), so one feature denotes a family at
  // every extent.
  HFeature : Set;

  HFeature/plate : HFeature -> HPlate;
  HFeature/poly  : HFeature -> Poly;

  // Aggregator kind: the semiring/scale cell of the contraction row.
  HAggKind : Set;

  hagSum     : HAggKind;   // (Q,+): the native ranking-capable scale
  hagMax     : HAggKind;   // tropical; idempotent
  hagMin     : HAggKind;   // tropical dual; idempotent
  hagConjPow : HAggKind;   // conjugated sum, phi(x) = x^p, p integer >= 1
  hagConjExp : HAggKind;   // conjugated sum, phi(x) = e^{beta x}

  // Pairwise distinctness of the five kind cells, whole family
  // (the staged fragment carried the sum/max pair with the rest
  // elided for staging brevity; baked bytes carry the family).
  refuse ax/qtsl/hagg_distinct_sum_max : forall k : HAggKind.
    k = hagSum, k = hagMax
    |- false;

  refuse ax/qtsl/hagg_distinct_sum_min : forall k : HAggKind.
    k = hagSum, k = hagMin
    |- false;

  refuse ax/qtsl/hagg_distinct_sum_pow : forall k : HAggKind.
    k = hagSum, k = hagConjPow
    |- false;

  refuse ax/qtsl/hagg_distinct_sum_exp : forall k : HAggKind.
    k = hagSum, k = hagConjExp
    |- false;

  refuse ax/qtsl/hagg_distinct_max_min : forall k : HAggKind.
    k = hagMax, k = hagMin
    |- false;

  refuse ax/qtsl/hagg_distinct_max_pow : forall k : HAggKind.
    k = hagMax, k = hagConjPow
    |- false;

  refuse ax/qtsl/hagg_distinct_max_exp : forall k : HAggKind.
    k = hagMax, k = hagConjExp
    |- false;

  refuse ax/qtsl/hagg_distinct_min_pow : forall k : HAggKind.
    k = hagMin, k = hagConjPow
    |- false;

  refuse ax/qtsl/hagg_distinct_min_exp : forall k : HAggKind.
    k = hagMin, k = hagConjExp
    |- false;

  refuse ax/qtsl/hagg_distinct_pow_exp : forall k : HAggKind.
    k = hagConjPow, k = hagConjExp
    |- false;

  // Closure (the dtype pattern): a fresh sixth kind would evade the
  // idempotence and gap-capability lattice entirely — a gap row on
  // an unclassified fold would pass the load-reject unexamined.
  refuse ax/qtsl/hagg_kind_closed : forall k : HAggKind.
    not k = hagSum, not k = hagMax, not k = hagMin,
    not k = hagConjPow, not k = hagConjExp
    |- false;

  hagg_idempotent : {kind: HAggKind} -> Prop;

  chase ax/qtsl/hagg_idem_max : |- {kind: hagMax} hagg_idempotent;
  chase ax/qtsl/hagg_idem_min : |- {kind: hagMin} hagg_idempotent;

  // gap-capable = the fold is a translated sum in its reading scale:
  // (Q,+) directly, or phi-space for the conjugated kinds. Max/min
  // are NOT members, in any scale (L-IDEM; conjugation fixes max).
  hagg_gap_capable : {kind: HAggKind} -> Prop;

  chase ax/qtsl/hagg_gap_sum  : |- {kind: hagSum} hagg_gap_capable;
  chase ax/qtsl/hagg_gap_pow  : |- {kind: hagConjPow} hagg_gap_capable;
  chase ax/qtsl/hagg_gap_exp  : |- {kind: hagConjExp} hagg_gap_capable;

  // One pooled coordinate: a contraction row over the plate index.
  HAggWire : Set;

  HAggWire/feat  : HAggWire -> HFeature;
  HAggWire/kind  : HAggWire -> HAggKind;
  HAggWire/param : HAggWire -> Q;   // p (integer >= 1) or beta;
                                    // read only by the conj kinds

  report ax/wf/hagg_pow_param : forall w : HAggWire, p : Q.
    w HAggWire/kind = hagConjPow, w HAggWire/param = p
    |- {l: 1, r: p} q_le;

  // The exponential scale is strictly monotone only at beta > 0:
  // beta = 0 degenerates phi to a constant (no comparison can
  // observe a worsening), and beta < 0 REVERSES the order — a
  // phi-space gap row under a negative beta would certify the
  // wrong direction. Strict, both carriers.
  report ax/wf/hagg_exp_param : forall w : HAggWire, b : Q.
    w HAggWire/kind = hagConjExp, w HAggWire/param = b
    |- {l: 0, r: b} q_lt;

  // Parameter conformance beyond the rational lower bounds is a demanded
  // side-condition (per conjugated wire), discharged at the
  // evaluator: integrality of p (the integer-rounding precedent at
  // count atoms); ORDER-PRESERVATION DOMAIN — an even p is
  // order-preserving only on a certified nonnegative feature
  // range, so even-p wires demand that range certificate (odd p
  // is order-preserving on all of Q); and the exponential kind
  // reads the certified exp/log enclosure register.
  qtsl_hplate_param_wire : {wire: HAggWire} -> Prop;
      // side-condition (conjugation-parameter conformance)

  report ax/wf/hplate_param_wire_pow : forall w : HAggWire.
    w HAggWire/kind = hagConjPow
    |- {wire: w} qtsl_hplate_param_wire;

  report ax/wf/hplate_param_wire_exp : forall w : HAggWire.
    w HAggWire/kind = hagConjExp
    |- {wire: w} qtsl_hplate_param_wire;

  // A plated certificate: a feature dictionary summed over ALL its
  // plates (the disjoint-union fold — the rule catalogue's V = q(k,s)
  // at linear q, which is the fold case the transfer theorem covers;
  // a nonlinear polynomial head over pooled wires is NOT this object
  // and takes the direct polytope row instead).
  HCert : Set;

  HCert/sys  : HCert -> System;
  HCert/kind : HCert -> HAggKind;    // the fold scale of the WHOLE
                                     // certificate; ranking use
                                     // demands gap-capable (below)
  HCert/param : HCert -> Q;

  // The certificate's own scale parameter carries the same lower bounds
  // and the same conformance as a wire's (the reading scale of
  // every footprint row is THIS parameter — leaving it
  // unconstrained would re-open the beta/even-power order holes
  // one carrier over).
  report ax/wf/hcert_pow_param : forall c : HCert, p : Q.
    c HCert/kind = hagConjPow, c HCert/param = p
    |- {l: 1, r: p} q_le;

  report ax/wf/hcert_exp_param : forall c : HCert, b : Q.
    c HCert/kind = hagConjExp, c HCert/param = b
    |- {l: 0, r: b} q_lt;

  qtsl_hplate_param_cert : {cert: HCert} -> Prop;
      // side-condition (as qtsl_hplate_param_wire: integrality,
      // order-preservation domain — even p demands a certified
      // nonnegative range for every feature the certificate
      // reads — and the exp/log enclosure for the exponential
      // kind)

  report ax/wf/hplate_param_cert_pow : forall c : HCert.
    c HCert/kind = hagConjPow
    |- {cert: c} qtsl_hplate_param_cert;

  report ax/wf/hplate_param_cert_exp : forall c : HCert.
    c HCert/kind = hagConjExp
    |- {cert: c} qtsl_hplate_param_cert;

  // the dictionary: which feature carries each plate's contribution
  hcert_feat : {cert: HCert, feat: HFeature} -> Prop;

  // Footprint rows: one per (certificate, transition schema).
  // The row's content is a polynomial sequent in the DISTINGUISHED-
  // TOKEN pattern: consumed representatives' colors, produced terms
  // (moment tables for stochastic resets), guard slab as hypothesis
  // — dimension set by the schema's arity and the dictionary, never
  // by any marking. Discharged by the evaluator through the pooled
  // aggregate compile (the checker never sees a plate).
  HRowPolarity : Set;

  hrpSafety : HRowPolarity;   // fold(produced) <= fold(consumed)
  hrpGap    : HRowPolarity;   // fold(produced) <= fold(consumed) - gap,
                              // in the certificate's reading scale
                              // (phi-space for conjugated kinds)

  refuse ax/qtsl/hrp_disjoint : forall r : HRowPolarity.
    r = hrpSafety, r = hrpGap
    |- false;

  // Closure (the dtype pattern): a fresh fourth polarity would
  // evade the load-rejects and the positivity/nonnegativity
  // reports.
  refuse ax/qtsl/hrp_closed : forall r : HRowPolarity.
    not r = hrpSafety, not r = hrpGap, not r = hrpDropAtMost
    |- false;

  HFootprintRow : Set;

  HFootprintRow/cert     : HFootprintRow -> HCert;
  HFootprintRow/tr       : HFootprintRow -> Transition;
  HFootprintRow/polarity : HFootprintRow -> HRowPolarity;
  HFootprintRow/gap      : HFootprintRow -> Q;   // delta (phi-space);
                                                 // read on hrpGap only

  // THE LOAD-REJECT (the gamma move; the modeler's trap): a gap row
  // whose certificate folds by an idempotent kind is refused at
  // load. Max-plates certify safety, never progress-by-footprint.
  refuse ax/qtsl/hplate_gap_idem : forall r : HFootprintRow, c : HCert, k : HAggKind.
    r HFootprintRow/polarity = hrpGap,
    r HFootprintRow/cert = c,
    c HCert/kind = k,
    {kind: k} hagg_idempotent
    |- false;

  report ax/wf/hplate_gap_pos : forall r : HFootprintRow, g : Q.
    r HFootprintRow/polarity = hrpGap, r HFootprintRow/gap = g
    |- {l: 0, r: g} q_lt;

  // Side-conditions (evaluator-deferred, loudly —
  // qtsl_init_member kin):
  qtsl_hplate_footprint : {row: HFootprintRow} -> Prop;
      // SUBJECT AGREEMENT FIRST (the checker binds c = the row's
      // cert, s = c's System, t = the row's transition, and
      // refuses before any arithmetic unless): t is a
      // sys_transition row of s; every feature the certificate
      // cites (hcert_feat) has its plate's HPlate/sys = s; and
      // each feature and the transition's grain/reset are typed
      // against s's plated state — a foreign or unattached
      // transition can satisfy any sequent while the transferred
      // claim is false of s. THEN the distinguished-token sequent:
      // fold-contribution of the produced side <= consumed side
      // (minus gap, on hrpGap), in the reading scale, under the
      // guard-slab hypotheses, for all colors in the boxes and all
      // residual pooled coordinates in the coupling polytope — a
      // BernCone obligation
  qtsl_hplate_coverage : {cert: HCert} -> Prop;
      // coverage over the SAME attached roster as the footprint
      // contract: every sys_transition of the subject System whose
      // conservative grain/reset footprint MAY touch a cited plate
      // carries a row for this certificate (safety or gap; CLOSED
      // membership — exactly those two polarities count: a
      // dropAtMost row bounds nothing above and never covers, and
      // an evaluator that counted one would silently unsound the
      // landed FromFold nodes) — T2's
      // hypothesis (i); an uncovered may-touch transition is an
      // unpriced edit to the fold. A transition provably disjoint
      // from every cited plate discharges by a frame fact (its
      // fold effect is zero), never by authored row cargo — the
      // may-touch scope recomputes at every load, so an edit that
      // begins touching a plate is caught
  qtsl_hplate_lowbound : {cert: HCert} -> Prop;
      // the fold is bounded below (canonically: >= 0) on reachable
      // markings — discharged via nonnegative features or coupling
      // + count rows; T2's hypothesis (ii), load-bearing (CM5).
      // Demanded per certificate CARRYING A GAP ROW (the rule
      // below): a safety-only certificate consumes no ranking
      // lower bound
  qtsl_hplate_flow : {cert: HCert} -> Prop;
      // between firings the fold does not increase (generator row
      // over the color dynamics) — T2's hypothesis (iii); where the
      // claim is an event-count or expected-crossings bound instead,
      // the crossing-budget family prices it (different species,
      // deliberately not interchangeable)

  report ax/wf/hplate_footprint : forall r : HFootprintRow.
    |- {row: r} qtsl_hplate_footprint;

  report ax/wf/hplate_coverage : forall c : HCert.
    |- {cert: c} qtsl_hplate_coverage;

  // The lower-bound demand mints exactly for ranking use: once per
  // certificate that carries at least one gap-polarity row
  // (idempotent re-derivation per further gap rows).
  report ax/wf/hplate_lowbound : forall c : HCert, r : HFootprintRow.
    r HFootprintRow/cert = c, r HFootprintRow/polarity = hrpGap
    |- {cert: c} qtsl_hplate_lowbound;

  report ax/wf/hplate_flow : forall c : HCert.
    |- {cert: c} qtsl_hplate_flow;

  // The transfer theorem — STATUS: the declared Lean
  // theorem/application contract; this revision mints its data and
  // side-condition demands and does NOT establish it. Once the
  // obligations above and the Lean theorem are discharged, the
  // conclusion SPLITS by row species: for PATHWISE (deterministic-
  // reset) gap rows with every delta >= a common pinned
  // delta_min > 0, firings of gap-rowed transitions along EVERY run
  // number at most fold(m_0) / delta_min — uniformly in token count
  // and interleaving (the telescoping argument). For STOCHASTIC
  // resets the footprint row reads moment tables and the
  // supermartingale machinery bounds the EXPECTED count (with its
  // stopping/integrability hypotheses) — never an every-run bound:
  // a stay-with-probability-half reset has expected gap one yet
  // exceeds any fixed run bound with positive probability. An
  // expectation row is NOT a pathwise row; the two species stay
  // distinct on purpose, and the checker reads the species off the
  // row's reset presentation (Dirac reset = pathwise; moment-table
  // reset = expectation), never off the polarity field alone.

  // ----------------------------------------------------------
  // Worked shape (documentation — the Minifab-shaped toy; exact-Q
  // execution in variadic-plates/transfer_countermodels.py, TOY
  // cell — an EXTERNAL receipt in the design workshop, not shipped
  // beside this theory): two stations A, B as plates; lot color = remaining
  // work w in [0, Wmax]; features vA(w) = w + WB + 2, vB(w) = w + 1
  // (the shaped potential: each lot carries its remaining work at
  // its station plus everything downstream); cert = hagSum over
  // {vA, vB}; rows — procA (consume w>=1 at A, produce w-1 at A):
  // hrpGap 1; moveAB (consume w=0 at A, produce WB at B): hrpGap 1
  // (vA(0) = WB+2 vs vB(WB) = WB+1); procB: hrpGap 1; shipB
  // (consume w=0 at B, produce nothing): hrpGap 1 (fold drops by
  // vB(0) = 1). Coverage total, lower bound by nonnegativity, flow
  // trivial (w static between firings in the toy). Consequence:
  // total firings <= V(m0), at EVERY lot count, one row per schema
  // — five declaration rows where the mode-enumeration route pays
  // a state space exponential in the lot bound. Queue lengths are
  // the const(1) sum-wires; a bottleneck spec atom reads a
  // hagConjPow p=2 wire over per-lot work (spec tier); the max-work
  // safety atom reads a hagMax wire (spec tier); and the NEGATIVE
  // cell — a gap row attempted on the hagMax wire — is exactly the
  // ax/qtsl/hplate_gap_idem refusal above, exercised in the toy.
  //
  // Deliberately absent, each absence load-bearing:
  //   * no judgment kinds, no rules — warrant-side content, parked
  //     per the standing certificate-stratum ruling;
  //   * no mean/power-mean kind — normalization breaks footprint
  //     locality (NEW-CM6), so the vocabulary cannot state the
  //     unsound row;
  //   * no per-instance rows — the schema-level row IS the family,
  //     by grammar equivariance; a per-instance row species would
  //     re-open the countable family this design closes.

  // ==========================================================
  // The plated transfer ties: hplate_token, QPAlwaysFromFold,
  // QFireBoundFromFold
  // ==========================================================
  //
  // The warrant-side completion the HPlate block above marks
  // "deliberately absent... parked": two entity proof nodes in the
  // QDeadlineTable pattern — one side-condition and one
  // unconditional demand each, the whole verification content in
  // the evaluator's walk — plus the plate-population binding the
  // earlier staging elided. Siblings of one FromFold genus, two
  // nodes (the metering-split precedent): the safety face concludes
  // invariants from hrpSafety coverage; the ranking face concludes
  // a count ceiling from hrpGap + a pinned dmin + lowbound + flow.
  // The shared walk preamble (conclusion resolution, sole claim,
  // subject agreement incl. the token bindings, sibling-claim
  // presence, the pathwise-species demand) factors once at the
  // EVALUATOR — never as a parameterized mega-node whose every walk
  // step would case-split on a species tag.

  // The plate-population binding: which bag population a plate
  // names. Zero rows = a symbolic/non-bag population (evaluators
  // defer loudly); at most one row per plate is admission
  // conformance. Entity citation, never name-string, never
  // positional convention — the certificate-table discipline. The
  // token-to-count-wire bijection the walks then need is
  // mech_bag_wire, at the bag block.
  hplate_token : {plate: HPlate, token: Token} -> Prop;

  // The PAlways-from-fold tie node: concludes a QSat's judgment
  // (via QProof/concludes) from plated-fold safety evidence — the
  // inductive-invariant judgment over the demonic composite:
  // coverage telescopes footprint rows pathwise across EVERY
  // resolution of every clock wing; init membership is checked
  // inside the walk (the gym deadline-walk precedent — no
  // qsat_warrant row, no QRegionSat, no boxed region for an
  // unbounded marking). The concluded claim carries its own subject
  // and specification, never stored on this node.
  QPAlwaysFromFold : Set;

  QPAlwaysFromFold/proof : QPAlwaysFromFold -> QProof;

  // Direction citations: upper bounds the fold above (SAtomLE
  // face), lower below (SAtomGE face; its features are the upper's
  // negation in the two-sided/equality case — recomputed by the
  // walk, never trusted). Zero-or-one row each is admission
  // conformance; at-least-one-total is walk-refused (absence is
  // not chase-visible).
  qpaf_upper : {node: QPAlwaysFromFold, cert: HCert} -> Prop;
  qpaf_lower : {node: QPAlwaysFromFold, cert: HCert} -> Prop;

  // The walk (side-condition; the judgment-tie semantics,
  // normative, ten steps: conclusion resolution, spec shape,
  // atom decomposition, cert citations, subject agreement, fold
  // scale, poly correspondence against the count-wire enumeration
  // (mech_bag_wire), init membership from mech_bag_marking,
  // sibling-claim presence, polarity roster — and the
  // pathwise-species demand on covered transitions: an
  // expectation-species footprint row never warrants a
  // surely-PAlways).
  qtsl_palways_fold : {node: QPAlwaysFromFold} -> Prop;
      // side-condition

  report ax/wf/qpalwaysfold_walk : forall n : QPAlwaysFromFold.
    |- {node: n} qtsl_palways_fold;

  // The transfer tie node: concludes a QSat's judgment whose spec
  // root is the firing-count ceiling (SReturnLE at the ForallSpec
  // cap over retFireCount), from ONE gap-rowed plated certificate —
  // the transfer theorem's pathwise face, applied: with footprint/
  // coverage/lowbound/flow discharged, every roster firing drops the
  // fold by at least dmin in the reading scale, the fold never
  // rises anywhere else, and the fold is floored at 0 — so roster
  // firings number at most fold_phi(m_0)/dmin along EVERY run,
  // uniformly in token count and interleaving. Closed-judgment
  // route, deliberately: no qsat_warrant, no QRegionSat, no boxed
  // certificate-family table for an unbounded marking; init
  // arithmetic lives inside the walk, where the gym deadline walk
  // put its threshold check.
  //
  // The cert citation is a FUNCTION, not a relation: a ranking
  // consequence cites exactly one certificate, and exactly-one is
  // semantic here (totality is the sort's own obligation) — the
  // two-direction relation shape of the safety sibling is not this
  // node's.
  //
  // dmin is PINNED, not derived: the checker verifies two exact
  // inequalities (each roster row's gap >= dmin; B * dmin >=
  // fold_phi(m_0)) and never computes an argmin — the untrusted-
  // producer/trustworthy-checker split, the same witness species
  // as the angelic family's eps.
  QFireBoundFromFold : Set;

  QFireBoundFromFold/proof : QFireBoundFromFold -> QProof;
  QFireBoundFromFold/cert  : QFireBoundFromFold -> HCert;
  QFireBoundFromFold/dmin  : QFireBoundFromFold -> Q;

  report ax/wf/qfirebound_dmin_pos : forall n : QFireBoundFromFold,
      d : Q.
    n QFireBoundFromFold/dmin = d
    |- {l: 0, r: d} q_lt;

  // The walk (side-condition; semantics = the transfer-former
  // design memo, normative, twelve steps: conclusion resolution;
  // spec shape; subject agreement incl. roster-membership and
  // hplate_token bindings; reading-scale gate (hagSum/hagConjPow
  // exact, hagConjExp loudly deferred on the enclosure register,
  // idempotent kinds already unrepresentable with gap rows);
  // roster-subset-of-gap-rows; per-roster-row gap >= dmin; ceiling
  // arithmetic B * dmin >= fold_phi(m_0) recomputed from marking
  // rows and the feature dictionary; sibling-claim presence for
  // footprint/coverage/lowbound/flow and the conjugation-parameter
  // family; the ALL-ROWS pathwise-species demand — one moment-table
  // row anywhere on the cited certificate refuses the node, because
  // an expectation-species safety row admits pathwise fold
  // increases and the telescope is pathwise end to end; no non-Zeno
  // consumption — the <= face is prefix-closed and takes no
  // crossing-budget attachment).
  qtsl_firebound_fold : {node: QFireBoundFromFold} -> Prop;
      // side-condition

  report ax/wf/qfirebound_walk : forall n : QFireBoundFromFold.
    |- {node: n} qtsl_firebound_fold;

  // ==========================================================
  // The event-rate envelope certificate lane (revision event 6)
  // ==========================================================
  //
  // Three entity proof nodes concluding satisfaction claims whose
  // spec consumes a rate-envelope component — the closed-judgment
  // route throughout (the deadline-walk precedent: no qsat_warrant,
  // no QRegionSat; init arithmetic lives inside each walk). Node
  // data is row kits in the battery idiom; the whole verification
  // content is each walk's, loudly deferred until its ground-seam
  // realization lands, never silently green.
  //
  // The kernel — STATUS: the declared theorem/application contract
  // (the FromFold-genus convention: this revision mints data and
  // demands and does NOT establish it). Under the upper kit's rows,
  // V(Phi_t) + N^trs_t - rho*t is a supermartingale for every
  // compatible precise process: between jumps the interior row
  // bounds the drift of V plus the counted spontaneous compensator
  // rate by rho; at counted forced/immediate firings the guard
  // row's -1 absorbs the count increment; at un-counted jumps
  // Delta V <= 0. Optional sampling then gives
  // E_x[N^trs_t] <= rho*t + V(x) for every t, and the envelope
  // over compatible laws is taken last: every state of
  // {V <= sigma} inhabits the SRateLE region. The lower kit
  // mirrors it (V + rho*t - N^trs a supermartingale; the counted
  // compensator credits the count's growth), yielding the
  // Foster-Lyapunov throughput shape E_x[N^trs_t] >= rho*t - V(x).

  // The upper-envelope kit. lambda^trs_m — the summed intensity of
  // counted spontaneous transitions in mode m — is READ, never
  // declared: the roster's race majorants (tkRace at finite
  // majorants) bound it, and an instant-clocked roster member
  // (tkRace at the infinite majorant) REFUSES here — no finite
  // intensity exists; the clock node below owns that stratum's
  // route.
  QRateUB : Set;

  QRateUB/proof     : QRateUB -> QProof;
  QRateUB/cert      : QRateUB -> QCertFam;   // the envelope family V
  QRateUB/interiors : QRateUB -> QProofList;
      // per mode: A_m V_m + lambda^trs_m <= rho on the mode cell
  QRateUB/guards_counted : QRateUB -> QProofList;
      // per counted forced/immediate transition slab:
      // V_{m'} after the reset <= V_m - 1 (the -1 absorbs the
      // count increment)
  QRateUB/guards    : QRateUB -> QProofList;
      // per un-counted transition slab: V after the reset <= V
  QRateUB/nonnegs   : QRateUB -> QProofList;
      // V_m >= 0 on the one-step reset closure

  // The walk (side-condition; the event-rate design normative):
  // conclusion resolution — the concluded claim's spec consumes
  // exactly one SRateLE component, whose (rho, sigma, trs) the kit
  // is read against; subject agreement, with the roster conformance
  // demand riding the pairing surface; intensity accounting —
  // lambda^trs_m from the roster's counted spontaneous members'
  // finite race majorants, instant members refused; row-kit
  // coverage (every mode an interior row, every transition slab a
  // guard row of the correct countedness); init membership — X_0
  // inside {V <= sigma}, checked inside the walk.
  qtsl_rate_ub : {node: QRateUB} -> Prop;   // side-condition

  report ax/wf/qrate_ub_walk : forall n : QRateUB.
    |- {node: n} qtsl_rate_ub;

  // The lower-envelope (throughput) kit, the mirror. Two honest
  // riders carried from the design: a demonic throughput claim is
  // usually FALSE for shared-resource composites — a party alone
  // can cap a rendezvous count, never guarantee it — so the
  // practical judgment names its dispatch; and nothing here claims
  // forall-policy content.
  QRateLB : Set;

  QRateLB/proof     : QRateLB -> QProof;
  QRateLB/cert      : QRateLB -> QCertFam;
  QRateLB/interiors : QRateLB -> QProofList;
      // per mode: A_m V_m + rho <= lambda^trs_m on the mode cell
  QRateLB/guards_counted : QRateLB -> QProofList;
      // per counted transition slab: V after the reset <= V + 1
  QRateLB/guards    : QRateLB -> QProofList;
  QRateLB/nonnegs   : QRateLB -> QProofList;

  // The walk carries one step the upper face does not: EXHAUSTION.
  // The concluded SRateGE claim is the all-horizons form, and the
  // mechanized kernel's index-anchored theorem is hypothesis-free
  // only at jump indices — passing to every real horizon consumes
  // almost-sure exhaustion of the jump sequence (the M-form
  // non-explosion side condition, named in the sup-form statement).
  // The walk therefore demands an exhaustion warrant for the
  // subject (dwell-floored and budget-priced wings supply it
  // structurally; a race-only subject's is its own accounting) and
  // refuses or loudly defers absent one — a lane concluding the
  // all-horizons form without this step would over-claim relative
  // to the proven kernel.
  qtsl_rate_lb : {node: QRateLB} -> Prop;   // side-condition

  report ax/wf/qrate_lb_walk : forall n : QRateLB.
    |- {node: n} qtsl_rate_lb;

  // The clock node: an SRateLE conclusion read off the roster's
  // clock syntax alone — every wing duration-free, every wire
  // quantity a count or a rate (the dimensional ruling that
  // dissolved the horizon fork: nothing in duration units enters
  // the wire; count-over-window derives at claim sites that
  // already own a duration). Per-member prices, summed exactly by
  // the walk:
  //   race (tkRace, finite majorant Lambda):
  //     (rho, sigma) gains (Lambda, 0) — rate <= majorant is
  //     definitional under the thinning semantics; the
  //     expectation-tier compensator lemma E[N_t] <= Lambda*t is
  //     this lane's declared proof-tier debt, beside the
  //     meter-discharge arithmetic below;
  //   dwell (tkForced at dwell d; tkDemonic at dwellMin d):
  //     gains (1/d, 1) — at most 1 + t/d firings pathwise by the
  //     dwell floor (the meter-discharge caps, the record
  //     stratum's standing comment-tier debt); pathwise, so the
  //     prevision envelope holds a fortiori;
  //   carved (tkCarved): priced through its floor ONLY, as a
  //     dwell member (1/floor, 1) — the window floor is strictly
  //     positive by its own report row, so every carved member has
  //     this price. The finite CEILING is a deadline (firing
  //     becomes mandatory), never an intensity majorant: pricing
  //     it as a race member would certify a false envelope (a
  //     scheduler may fire every floor-interval regardless of the
  //     ceiling);
  //   instant (tkRace at the infinite majorant): REFUSED without a
  //     cited crossing budget on the same subject (no density
  //     exists to declare — the budget CERTIFIES the compensator
  //     mass; no budget, no bound); with one cited, gains
  //     (c, W(x_0)) from the ADDITIVE species — a tilted budget
  //     refuses, its exponential form having no affine reading.
  // The fold-route wing needs no node here: a total-count ceiling
  // (the transfer tie node above) IS the zero-slope envelope
  // SRateLE(0, B) semantically — a weakening whose rule packaging
  // is consumer-gated, as everywhere.
  QRateFromClocks : Set;

  QRateFromClocks/proof : QRateFromClocks -> QProof;

  // The optional budget citation (zero rows = no instant members
  // admitted; at most one row is admission conformance).
  qrfc_budget : {node: QRateFromClocks, budget: CrossBudget} -> Prop;

  // The walk: conclusion resolution (the spec consumes exactly one
  // SRateLE, whose roster the prices are read from); per-member
  // wing pricing and the exact-rational sum tie against the
  // concluded (rho, sigma); instant members demand the budget
  // citation, species additive, budget subject = the claim's;
  // subject agreement and roster conformance ride the pairing
  // surface.
  qtsl_rate_clocks : {node: QRateFromClocks} -> Prop;
      // side-condition

  report ax/wf/qrate_clocks_walk : forall n : QRateFromClocks.
    |- {node: n} qtsl_rate_clocks;

  // ==========================================================
  // The NN leaf stratum: the ReLU primitive and its rule species
  // (revision event 5)
  // ==========================================================
  //
  // PLACEMENT (the event-5 manifest's P-1): omnibus, deliberately —
  // the tower file is the certified external checker's stable
  // fragment boundary, and the omnibus already hosts BL-adjacent
  // repairs (the flavored cell-schema precedent). The omnibus
  // extends the tower, so Primitive/PrimApp/Proof/Judgment are in
  // scope; the tower stays byte-stable.
  //
  // The packaged signature symbol. NAMING: PReLU follows the
  // primitive roster's convention (PConst, PCell, ...); the NN
  // literature's "parametric ReLU" collision is noted and accepted.
  // Typing: input and output wires carry the same tensor type
  // (type-consistency axioms per the PContract pattern ride the
  // tower's worked-example convention — elementwise ReLU at higher
  // rank is well-formed for the leaf rules; rank 0 is demanded only
  // at the ReLU-Split USE SITE, which has no species here at all).
  PReLU : Primitive;

  // sp[ReLU] NORMATIVE FORM (the sp-axiom convention: implicit in
  // SP_H, available via Ax + AndE, NO PspReLU constructor): for a
  // ReLU application with input wire h and output wire y,
  //
  //   sp[ReLU]  :=  ( h >= 0  AND  y = h )  OR  ( h <= 0  AND  y = 0 )
  //
  // — the defining disjunction ReLU-Split's derivation eliminates
  // over. Realization rides PrimApp.spFact exactly as the cell
  // case; the geolog-formal listing of SP_H membership is the same
  // pending item as sp[Cell]'s — one convention, two primitives,
  // resolved together or not at all.
  //
  // ReLU-Split is a DELIBERATE NON-SPECIES: no proof-term
  // constructor, by catalogue witness — the unpacking IS the rule
  // (orE + EqElim + AndE + Weaken + Cut over sp[ReLU]), and its
  // soundness is its derivability. Its honest burn-down gate is the
  // context-carrying orE's own core-rule adoption question, not
  // vocabulary; the rank-0 typing demand
  // (reluSplit_rank0_necessary: mixed-sign tensor countermodel —
  // semantic necessity) binds whichever form ever arrives.
  //
  // The linkage "ReLU_{h}->{y} in H" needs no relation sort
  // (contrast CellSchema, which ties an app to EXTERNAL schema
  // data): it is (i) the cited app's primitive is PReLU (report
  // rows below), (ii) h is its position-0 input wire, (iii) y its
  // position-0 output wire — key-identified port lookups,
  // destructured by the conclusion-form relations exactly as the
  // cell forms destructure the cell application.
  //
  // Conclusion-form relations (bounded computations at the oracle
  // seam, the cell-form pattern verbatim): each destructures the
  // ReLU application's position-0 ports and REJECTS unless the app
  // is a PReLU application with both ports present; formula = the
  // stated shape over the app's wires, pinned rationals as
  // arguments.
  //
  //   reluPremNonnegForm:  formula = (h >= 0)
  //   reluPremNonposForm:  formula = (h <= 0)
  //   reluOutEqInputForm:  formula = (y = h)   [broadcast-sense
  //     equality — atom truth; substitution still demands EqElim's
  //     own tyEq discipline, unchanged]
  //   reluOutZeroForm:     formula = (y = 0)
  //   reluOutNonnegForm:   formula = (y >= 0)
  //   reluOutDominatesForm: formula = (y >= h)
  //   lirpaPremLoForm:     formula = (a <= h), a pinned
  //   lirpaPremHiForm:     formula = (h <= b), b pinned
  //   lirpaSandwichForm:   formula = (alpha*h + beta <= y)
  //                          AND (y <= gamma*h + delta), all pinned
  reluPremNonnegForm  : {app: PrimApp, formula: Formula} -> Prop;
  reluPremNonposForm  : {app: PrimApp, formula: Formula} -> Prop;
  reluOutEqInputForm  : {app: PrimApp, formula: Formula} -> Prop;
  reluOutZeroForm     : {app: PrimApp, formula: Formula} -> Prop;
  reluOutNonnegForm   : {app: PrimApp, formula: Formula} -> Prop;
  reluOutDominatesForm : {app: PrimApp, formula: Formula} -> Prop;
  lirpaPremLoForm     : {app: PrimApp, a: Q, formula: Formula} -> Prop;
  lirpaPremHiForm     : {app: PrimApp, b: Q, formula: Formula} -> Prop;
  lirpaSandwichForm   : {app: PrimApp, alpha: Q, beta: Q, gamma: Q,
                         delta: Q, formula: Formula} -> Prop;

  // ReLU-Pos: premise Phi |- h >= 0, linkage; concludes Phi |- y = h.
  PReLUPos : Set;
  PReLUPos/proof   : PReLUPos -> Proof;
  PReLUPos/premise : PReLUPos -> Proof;
  PReLUPos/app     : PReLUPos -> PrimApp;

  report ax/applicable/PReLUPos/app_isReLU : forall p : PReLUPos.
    |- p PReLUPos/app PrimApp/prim = PReLU;
  report ax/applicable/PReLUPos/pre : forall p : PReLUPos.
    |- p PReLUPos/proof Proof/concludes Judgment/pre
     = p PReLUPos/premise Proof/concludes Judgment/pre;
  report ax/applicable/PReLUPos/premise_post : forall p : PReLUPos.
    |- {app: p PReLUPos/app,
        formula: p PReLUPos/premise Proof/concludes Judgment/post}
       reluPremNonnegForm;
  report ax/applicable/PReLUPos/conclusion : forall p : PReLUPos.
    |- {app: p PReLUPos/app,
        formula: p PReLUPos/proof Proof/concludes Judgment/post}
       reluOutEqInputForm;

  // ReLU-Neg: premise Phi |- h <= 0, linkage; concludes Phi |- y = 0.
  PReLUNeg : Set;
  PReLUNeg/proof   : PReLUNeg -> Proof;
  PReLUNeg/premise : PReLUNeg -> Proof;
  PReLUNeg/app     : PReLUNeg -> PrimApp;

  report ax/applicable/PReLUNeg/app_isReLU : forall p : PReLUNeg.
    |- p PReLUNeg/app PrimApp/prim = PReLU;
  report ax/applicable/PReLUNeg/pre : forall p : PReLUNeg.
    |- p PReLUNeg/proof Proof/concludes Judgment/pre
     = p PReLUNeg/premise Proof/concludes Judgment/pre;
  report ax/applicable/PReLUNeg/premise_post : forall p : PReLUNeg.
    |- {app: p PReLUNeg/app,
        formula: p PReLUNeg/premise Proof/concludes Judgment/post}
       reluPremNonposForm;
  report ax/applicable/PReLUNeg/conclusion : forall p : PReLUNeg.
    |- {app: p PReLUNeg/app,
        formula: p PReLUNeg/proof Proof/concludes Judgment/post}
       reluOutZeroForm;

  // ReLU-NN: premise-free; linkage only; concludes Phi |- y >= 0
  // (any Phi; the node carries the concluded context via its proof).
  PReLUNN : Set;
  PReLUNN/proof : PReLUNN -> Proof;
  PReLUNN/app   : PReLUNN -> PrimApp;

  report ax/applicable/PReLUNN/app_isReLU : forall p : PReLUNN.
    |- p PReLUNN/app PrimApp/prim = PReLU;
  report ax/applicable/PReLUNN/conclusion : forall p : PReLUNN.
    |- {app: p PReLUNN/app,
        formula: p PReLUNN/proof Proof/concludes Judgment/post}
       reluOutNonnegForm;

  // ReLU-Above: premise-free; linkage only; concludes Phi |- y >= h.
  PReLUAbove : Set;
  PReLUAbove/proof : PReLUAbove -> Proof;
  PReLUAbove/app   : PReLUAbove -> PrimApp;

  report ax/applicable/PReLUAbove/app_isReLU : forall p : PReLUAbove.
    |- p PReLUAbove/app PrimApp/prim = PReLU;
  report ax/applicable/PReLUAbove/conclusion : forall p : PReLUAbove.
    |- {app: p PReLUAbove/app,
        formula: p PReLUAbove/proof Proof/concludes Judgment/post}
       reluOutDominatesForm;

  // LiRPA: two sequent premises (Phi |- a <= h, Phi |- h <= b), the
  // linkage, four pinned slope/offset rationals and two pinned
  // endpoint rationals, and EIGHT closed arithmetic side conditions
  // — a < 0, 0 < b, alpha*a + beta <= 0, beta <= 0,
  // alpha*b + beta <= b, 0 <= gamma*a + delta, 0 <= delta,
  // b <= gamma*b + delta — each ONE exact-rational comparison over
  // pinned fields. The catalogue's count of EIGHT is normative
  // (older prose undercounted at six). The four SINGLE-field
  // comparisons are report rows below; the four AFFINE comparisons
  // ride the qtsl_lirpa_arith side-condition (exact-rational
  // arithmetic beyond single comparisons is walk territory — the
  // ceiling-arithmetic idiom), demanded on every instance. A
  // component consuming fewer than eight is the drift alarm.
  // Concludes Phi |- (alpha*h + beta) <= y AND y <= (gamma*h + delta).
  PLiRPA : Set;
  PLiRPA/proof  : PLiRPA -> Proof;
  PLiRPA/premLo : PLiRPA -> Proof;   // Phi |- a <= h
  PLiRPA/premHi : PLiRPA -> Proof;   // Phi |- h <= b
  PLiRPA/app    : PLiRPA -> PrimApp;
  PLiRPA/a      : PLiRPA -> Q;
  PLiRPA/b      : PLiRPA -> Q;
  PLiRPA/alpha  : PLiRPA -> Q;
  PLiRPA/beta   : PLiRPA -> Q;
  PLiRPA/gamma  : PLiRPA -> Q;
  PLiRPA/delta  : PLiRPA -> Q;

  report ax/applicable/PLiRPA/app_isReLU : forall p : PLiRPA.
    |- p PLiRPA/app PrimApp/prim = PReLU;

  report ax/applicable/PLiRPA/pre_lo : forall p : PLiRPA.
    |- p PLiRPA/proof Proof/concludes Judgment/pre
     = p PLiRPA/premLo Proof/concludes Judgment/pre;

  report ax/applicable/PLiRPA/pre_hi : forall p : PLiRPA.
    |- p PLiRPA/proof Proof/concludes Judgment/pre
     = p PLiRPA/premHi Proof/concludes Judgment/pre;

  report ax/applicable/PLiRPA/premise_lo : forall p : PLiRPA.
    |- {app: p PLiRPA/app, a: p PLiRPA/a,
        formula: p PLiRPA/premLo Proof/concludes Judgment/post}
       lirpaPremLoForm;

  report ax/applicable/PLiRPA/premise_hi : forall p : PLiRPA.
    |- {app: p PLiRPA/app, b: p PLiRPA/b,
        formula: p PLiRPA/premHi Proof/concludes Judgment/post}
       lirpaPremHiForm;

  report ax/applicable/PLiRPA/conclusion : forall p : PLiRPA.
    |- {app: p PLiRPA/app, alpha: p PLiRPA/alpha, beta: p PLiRPA/beta,
        gamma: p PLiRPA/gamma, delta: p PLiRPA/delta,
        formula: p PLiRPA/proof Proof/concludes Judgment/post}
       lirpaSandwichForm;

  report ax/applicable/PLiRPA/a_neg : forall p : PLiRPA, a : Q.
    p PLiRPA/a = a |- {l: a, r: 0} q_lt;

  report ax/applicable/PLiRPA/b_pos : forall p : PLiRPA, b : Q.
    p PLiRPA/b = b |- {l: 0, r: b} q_lt;

  report ax/applicable/PLiRPA/beta_nonpos : forall p : PLiRPA, be : Q.
    p PLiRPA/beta = be |- {l: be, r: 0} q_le;

  report ax/applicable/PLiRPA/delta_nonneg : forall p : PLiRPA, de : Q.
    p PLiRPA/delta = de |- {l: 0, r: de} q_le;

  // The four affine comparisons (alpha*a + beta <= 0, alpha*b +
  // beta <= b, 0 <= gamma*a + delta, b <= gamma*b + delta), one
  // side-condition, demanded on every instance; evaluator-deferred
  // loudly until the provider leg realizes it.
  qtsl_lirpa_arith : {node: PLiRPA} -> Prop;   // side-condition

  report ax/wf/lirpa_arith : forall p : PLiRPA.
    |- {node: p} qtsl_lirpa_arith;

  // ==========================================================
  // The primitive-box semiring cell: contract_{beta, S} (event 5)
  // ==========================================================
  //
  // The core contraction box names its (+)-side: the HPlate
  // aggregate-wire stratum already names
  // its semiring via the kind cell — this lifts the SAME datum to
  // the primitive box, generalizing the Q-fixed sum-of-products to
  // the contraction row's semiring-generic
  // form, and making the hypernet figures' Sigma/Pi boundary
  // annotations formal box-label content. One vocabulary for one
  // concept: the kind cell is HAggKind (sum/max/min/conjugated),
  // the param is read only by the conjugated kinds, both spelled
  // exactly as at HAggWire.
  //
  // BACK-COMPAT IS DEFAULT-ABSENT, NEVER MIGRATION: an application
  // with no cell reads as contract_{beta, Q-sum-of-products} — the
  // status quo semantics, so existing containers carry zero byte
  // motion and landed consumers zero semantic motion. An explicit
  // hagSum cell is lawful (the default made formal — figure-label
  // content).
  //
  // ADMISSION AT THIS REVISION (event 5.1 — the transport lift,
  // widening event-5's sum-only guard: softale-class aggregation is
  // required content for the flagship certificate roster, and the
  // T-TRANSFER conjugated-section theorems carry the boundary
  // story): a cell is admissible iff its kind's celled containers
  // can carry ALL row arithmetic in (Q,+,x) over phi-space values —
  // the class whose containers stay arithmetic-conservative under
  // fragment restriction ONCE that convention is discharged
  // (normative now; positively checked at the evaluator — see the
  // deferral note in each bullet).
  //
  //   hagSum      ADMITTED — phi = id; the default made formal
  //               (figure-label content, as at event 5).
  //   hagConjPow  ADMITTED — phi(x) = x^p, integer p >= 1: the
  //               transformed dictionary is again polynomial, so
  //               the exact tier holds today. ROW DATA ARE
  //               NORMATIVELY PHI-SPACE (transformed features,
  //               delta_phi, range enclosures; the checker never
  //               computes the root); POSITIVE CHECKING IS
  //               DEFERRED at this revision — the
  //               qtsl_contract_cell oracle, when realized, must
  //               check every dependent arithmetic row's
  //               transformed operands, delta_phi, and enclosure,
  //               and until then a non-default cell obtains no
  //               positive verdict, only loud deferral.
  //               Aggregate-scale verdicts are consumer-side
  //               transports (verdict_transport /
  //               pow_verdict_transport — even p only on the
  //               certified nonnegative range), and base-scale gap
  //               moduli ride the factorized witness
  //               delta_phi/(p*bd^(p-1)) (pow_gap_factorized; the
  //               phi(delta) shortcut is refuted:
  //               square_gap_is_not_A_gap). The phi-space
  //               convention is the admission's SOUNDNESS
  //               CONDITION, not a style choice — base-scale row
  //               data would reproduce the fragment-projection
  //               unsoundness below at pow (a celled base-scale
  //               gap claim can be false while its stripped
  //               sum-reading accepts).
  //   hagMax/Min  REFUSED — idempotent: gap-incapable in every
  //               scale (the L-IDEM lemma family), and max is a
  //               fixed point of every monotone rescaling
  //               (max_fold_conj_fixed): no phi-route exists,
  //               structurally. The countermodel below stays
  //               fenced; its admission half is banked at
  //               cwa/ContractGuardChase.geolog (the executable
  //               max-cell refusal representative), and its
  //               numeric halves are Lean-checked
  //               (contract_cell_countermodel_max in the
  //               T-TRANSFER module).
  //   hagConjExp  REFUSED at this revision — transport holds at
  //               abstract strictly-monotone phi, but the
  //               transform is not closed as exact rational
  //               arithmetic on general rational row inputs, so
  //               the exact tier fails; admission awaits a future
  //               certified-enclosure boundary design, whose
  //               conservativity is re-audited at that event.
  //   future kinds REFUSED by the not-equality spelling, closed by
  //               construction.
  //
  // THE FRAGMENT-PROJECTION HAZARD (the event-5 data-plane round's
  // F-2 — still the reason max/min/exp refuse): a cell that
  // REINTERPRETS the box cannot live one file above it — the
  // tower's byte-stable fragment is a certified checker's boundary,
  // and a restriction to that fragment would keep the PContract
  // application and its dependent proof content while stripping the
  // omnibus cell row AND its demand, silently re-reading a
  // max-contraction as sum-of-products (countermodel: contract
  // (1,2)x(1,1) along the shared index — sum certifies 3, max is 2;
  // the projected container would accept the false claim). An
  // ADMITTED conjugated-power cell under the phi-space convention
  // does not have this failure mode: its rows are true (Q,+,x)
  // facts about transformed features, so restriction loses only
  // the interpretation label, never an arithmetic verdict —
  // conditional on the convention's discharge (restriction also
  // strips the convention's own evidence with the cell, which is
  // why the positive claim waits on the evaluator's realized
  // check; until then the loud deferral is the whole verdict). The
  // general semantic discriminator for arbitrary scales still
  // enters AT THE BOX — contract_{beta, S} as constructor content,
  // tower motion — at the certified-checker lane's own revision;
  // this relation's kind cell, parameter lower bounds, and conformance
  // demands remain that widening's pre-staged spelling for the
  // kinds still refused. The refusal makes the unsound projection
  // unrepresentable today rather than discouraged (the phantom-axis
  // precedent).
  //
  // The cell attaches ONLY to contraction boxes: on any other
  // primitive it would be dead data disagreeing with the box's
  // semantics (PReLU included — the fresh primitive above is
  // covered by the not-equality spelling, closed by construction).
  // At most one cell per application is admission conformance
  // (C-CONTRACT, the at-most-one-gate pattern).
  contract_semiring : {app: PrimApp, kind: HAggKind, param: Q}
    -> Prop;

  refuse ax/qtsl/contract_semiring_contract_only : forall
      a : PrimApp, k : HAggKind, q : Q, pr : Primitive.
    {app: a, kind: k, param: q} contract_semiring,
    a PrimApp/prim = pr, not pr = PContract
    |- false;

  // The transport guard (event 5.1, widening event-5's sum-only
  // form): only kinds with an exact phi-space presentation — the
  // identity (hagSum) and the integer conjugated powers
  // (hagConjPow) — are admissible until the box itself carries the
  // scale (see the block comment). Closed against every other kind,
  // current and future, by the not-equality spelling.
  refuse ax/qtsl/contract_semiring_transport_only : forall
      a : PrimApp, k : HAggKind, q : Q.
    {app: a, kind: k, param: q} contract_semiring,
    not k = hagSum, not k = hagConjPow
    |- false;

  // Parameter lower bounds, the HAggWire rows verbatim: the power scale
  // reads p >= 1; the exponential scale is strictly monotone only
  // at beta > 0 (beta = 0 degenerates phi to a constant; beta < 0
  // REVERSES the order).
  report ax/wf/contract_pow_param : forall a : PrimApp, k : HAggKind,
      q : Q.
    {app: a, kind: k, param: q} contract_semiring, k = hagConjPow
    |- {l: 1, r: q} q_le;

  report ax/wf/contract_exp_param : forall a : PrimApp, k : HAggKind,
      q : Q.
    {app: a, kind: k, param: q} contract_semiring, k = hagConjExp
    |- {l: 0, r: q} q_lt;

  // Conjugation-parameter conformance beyond the rational lower bounds
  // (integrality of p; order-preservation domain for even p; the
  // exponential kind's certified enclosure register) — per
  // conjugated cell, discharged at the evaluator, exactly as
  // qtsl_hplate_param_wire.
  qtsl_contract_param : {app: PrimApp} -> Prop;
      // side-condition (conjugation-parameter conformance)

  report ax/wf/contract_param_pow : forall a : PrimApp, k : HAggKind,
      q : Q.
    {app: a, kind: k, param: q} contract_semiring, k = hagConjPow
    |- {app: a} qtsl_contract_param;

  report ax/wf/contract_param_exp : forall a : PrimApp, k : HAggKind,
      q : Q.
    {app: a, kind: k, param: q} contract_semiring, k = hagConjExp
    |- {app: a} qtsl_contract_param;

  // The cell's semantic obligation: the box's contraction row reads
  // in the named (+)-scale (the contraction row's gamma side
  // condition governs unchanged — every un-hit index
  // an output, no phantom-axis scaling; sum cells are (Q,+,x)
  // contraction, max/min tropical, conjugated cells phi-composed).
  // For an ADMITTED conjugated-power cell, "phi-composed" is
  // NORMATIVELY the phi-space presentation: row data live in
  // phi-space (transformed features, delta_phi, range enclosures),
  // the row arithmetic is (Q,+,x) verbatim over those values, and
  // aggregate-scale readings are consumer-side transports — the
  // evaluator's obligations are the T-TRANSFER conjugated-section
  // hypotheses (integrality of p; even-p nonnegative range;
  // factorized gap moduli). Demanded on every cell; loudly deferred
  // until the semiring-generic evaluator realizes it — and BL-tier
  // arithmetic rules whose soundness is (Q,+,x)-specific
  // refuse-or-defer on apps carrying a non-default cell, never
  // evaluate them as sum-of-products.
  qtsl_contract_cell : {app: PrimApp} -> Prop;   // side-condition

  report ax/wf/contract_cell : forall a : PrimApp, k : HAggKind,
      q : Q.
    {app: a, kind: k, param: q} contract_semiring
    |- {app: a} qtsl_contract_cell;

  // ==========================================================
  // The drift-moment tie node: QIntBoundFromSW + the unbounded
  // interval (revision event 5, the spde per-former rung)
  // ==========================================================
  //
  // ivAll: the whole line as a chart-domain coordinate. Dissolves
  // the spde chart-domain fence honestly — the S-SPDE former
  // declares NO state-space domain constraint (a global jet chart),
  // while Mode/domain is total over Box; before this constructor
  // the only spellings were a false bounded box (citation-shaped
  // noise) or no System stratum at all. Consumers of Box that
  // arithmetically need bounded intervals (Bernstein enclosures,
  // init-membership evaluations) REFUSE-OR-DEFER on ivAll at the
  // ground seam, per the positive-check discipline — unbounded is a
  // declaration, never an implicit zero-measure default.
  ivAll : Interval;

  refuse ax/qtsl/interval_all_mk_disjoint : forall lo : Q, hi : Q,
      i : Interval.
    i = ivAll, i = {hi: hi, lo: lo} mkInterval
    |- false;

  // The drift-moment tie node (the SW-m kit's E[int] face):
  // concludes a QSat's judgment (via QProof/concludes) whose spec's
  // sole safety component is the time-integral prevision ceiling —
  // SReturnLE at the ForallSpec cap over poInt{horizon: T, o} —
  // from a drift-moment certificate L V <= -alpha*V + beta with
  // V >= 0: the marginal bound E[V_t] <= max(v0, beta/alpha)
  // integrates to E[int_0^T V dt] <= T*max(v0, beta/alpha), Tonelli
  // on the nonnegative integrand; no Doob, no martingale machinery
  // — the expectation-species conclusion from expectation-species
  // evidence (contrast the FromFold genus's ALL-ROWS pathwise
  // demand, which this node deliberately does not make).
  // Closed-judgment route (the deadline-walk precedent): no
  // qsat_warrant, no QRegionSat; init arithmetic lives inside the
  // walk. The E[sup]/Doob face is DELIBERATELY ABSENT: for the spde
  // family every spectral mode is positive-recurrent, so the
  // horizon-free E[sup] is +inf and an SReturnLE over poSup is
  // FALSE — the design memo carries the countermodel; sound Doob
  // conclusions (beta = 0 genuine supermartingales, probability
  // face) belong to the family that owns them.
  //
  // alpha, beta, v0 are PINNED, not derived: the checker verifies
  // exact inequalities (beta against the spectrum's derived trace;
  // the ceiling B*1 >= T*max(v0, beta/alpha)) and never computes a
  // generator itself — the untrusted-producer/trustworthy-checker
  // split, the same witness species as QFireBoundFromFold's dmin.
  // The gate field ties the observable's identity
  // content-addressed: the walk demands the concluded component's
  // observable be exactly oGate at this reference — a digest
  // equality, never a semantic decode.
  QIntBoundFromSW : Set;

  QIntBoundFromSW/proof : QIntBoundFromSW -> QProof;
  QIntBoundFromSW/gate  : QIntBoundFromSW -> HypernetRef;
  QIntBoundFromSW/alpha : QIntBoundFromSW -> Q;
  QIntBoundFromSW/beta  : QIntBoundFromSW -> Q;
  QIntBoundFromSW/v0    : QIntBoundFromSW -> Q;

  report ax/wf/qintbound_alpha_pos : forall n : QIntBoundFromSW, a : Q.
    n QIntBoundFromSW/alpha = a
    |- {l: 0, r: a} q_lt;

  report ax/wf/qintbound_beta_nonneg : forall n : QIntBoundFromSW, b : Q.
    n QIntBoundFromSW/beta = b
    |- {l: 0, r: b} q_le;

  report ax/wf/qintbound_v0_nonneg : forall n : QIntBoundFromSW, v : Q.
    n QIntBoundFromSW/v0 = v
    |- {l: 0, r: v} q_le;

  // The walk (side-condition; semantics = the rung design memo's
  // section 4, normative, nine steps: conclusion resolution; spec
  // shape — the sole consumed ForallSpec is SReturnLE over poInt;
  // observable tie by digest equality against the gate field;
  // subject resolution — SysMech, sole manifest mode, spectral
  // noise declared; the trace tie beta >= tr(Q) derived by grouped
  // Parseval, zero tail exact, bracket tail at its upper end,
  // divergent REFUSED; ceiling arithmetic B >= T*max(v0,
  // beta/alpha) exact-rational; horizon positivity re-checked; the
  // mode_projection loud-defer register for the generator
  // derivation, the v0 initial-datum derivation, and the
  // functional's semantics — the book's own named obligation for
  // this frame, reported on every verdict, never silent; sibling
  // hygiene — at most one node per claim, and a poSup-reading
  // component anywhere in the claimed spec REFUSES the node: a
  // running-sup component cannot borrow the integral node's
  // warrant).
  qtsl_intbound_sw : {node: QIntBoundFromSW} -> Prop;
      // side-condition

  report ax/wf/qintbound_walk : forall n : QIntBoundFromSW.
    |- {node: n} qtsl_intbound_sw;

  // ==========================================================
  // Nondeterminism axes
  // ==========================================================
  //
  // An axis is an entity: identity is the choice source, exactly as
  // a clock's identity is the shared draw. Two axes of equal extent
  // are distinct sources choosing independently; one axis cited
  // from two positions is the same choice shared. Binding time and
  // extent are total — an untagged axis is unspellable, which is
  // the point.

  NDAxis : Set;   // entity: identity is the choice source

  nd_binding : NDAxis -> BindingTime;
  nd_extent  : NDAxis -> NDExtent;

  // The subject presentation's declared axis roster, positional.
  // Zero rows is lawful: a presentation with no declared axes is
  // the precise world, and every certificate over it is scalar.
  // Sources with structurally forced binding times (the demonic
  // initial-box union is run-bound; a jitter clock's per-tick draw
  // and a demonic transition's scheduler are step-bound) anchor
  // their axes at the per-former transcription legs; the anchor
  // taxonomy is pending residue as data.
  sys_nd_axis : {sys: System, pos: Nat, axis: NDAxis} -> Prop;

  qtsl_nd_roster : {sys: System} -> Prop;   // side-condition
                                            // (C-CERT-AXES)

  report ax/wf/nd_roster : forall s : System, p : Nat, a : NDAxis.
    {sys: s, pos: p, axis: a} sys_nd_axis
    |- {sys: s} qtsl_nd_roster;

  // ==========================================================
  // The certificate family
  // ==========================================================
  //
  // ONE sort. A family's branch-key space is the product of the
  // enumerated run-bound axes it declares, in position order; a
  // branch key is a natural tuple riding the ground Shape sort,
  // read positionally against that roster. The scalar certificate
  // is the nullary case: an empty axis roster, every content row
  // keyed by the width-zero tuple — one branch, not a second sort.
  //
  // Parametric run-bound axes are never enumerated: they extend
  // each body's variable domain (state times parameter — the family
  // in parametric dress, checked cellwise over the product), and
  // the width conformance rides the ground seam with the rest of
  // C-CERT-FAM.
  //
  // The family declares its own index roster by citing axis
  // entities; agreement with the subject's roster is discharged at
  // the pairing, exactly where a specification meets its system.

  CertFam : Set;   // entity: one certificate artifact

  cert_axis : {fam: CertFam, pos: Nat, axis: NDAxis} -> Prop;

  // A family may not split over a step-bound axis: step axes are
  // region axes under every consuming read, and a branch split
  // over one would assert commitment the semantics does not grant.
  refuse ax/cert/axis_step : forall f : CertFam, p : Nat,
      a : NDAxis.
    {fam: f, pos: p, axis: a} cert_axis, a nd_binding = btStep
    |- false;

  // A family may not enumerate a parametric axis: finitely many
  // sample branches under-cover a continuum, and the parametric
  // carriage already expresses the family exactly.
  refuse ax/cert/axis_param : forall f : CertFam, p : Nat,
      a : NDAxis, e : NDExtent, d : Box.
    {fam: f, pos: p, axis: a} cert_axis,
    a nd_extent = e, e = {domain: d} ndParam
    |- false;

  // Per-branch positional body lists. Position semantics (which
  // position is the safety envelope, which are per-pair rankings)
  // is the consuming rule's, exactly as the generator-form seam
  // encodes no certificate arity; positions here are positions.
  cert_body : {fam: CertFam, branch: Shape, body: Nat,
               hn: HypernetRef} -> Prop;

  // ==========================================================
  // Selections (the existential face's slot)
  // ==========================================================
  //
  // One selection: a named branch plus a properness witness on it —
  // the certificate of the feasibility conjunct, and of any escape
  // face, on the selected branch. Selections are id-keyed so a
  // verdict row cites the one it consumes. On parametric axes a
  // selection refines to a sub-cell of the domain product; zero
  // cell rows reads as the whole domain.

  cert_selection : {fam: CertFam, sel: Nat, branch: Shape,
                    witness: HypernetRef} -> Prop;

  cert_sel_cell : {fam: CertFam, sel: Nat, cell: Box} -> Prop;

  // ==========================================================
  // Branch discharge rows (the universal face's economies)
  // ==========================================================

  // THE optional slot: an emptiness certificate discharges the
  // named branch from universal-side certification — its body is
  // the zero body, and a contradictory resolution proves anything.
  cert_branch_empty : {fam: CertFam, branch: Shape,
                       witness: HypernetRef} -> Prop;

  // Grade-domination discharge: the absorbed branch's slice is
  // covered by the dominating branch's on every shared ray, so
  // certifying the dominator certifies both — the sharp verdict
  // where unequal-mass branches would otherwise price
  // conservatively. Validity is a recompute over the subject's
  // branch bodies at the ground seam; irreflexivity and acyclicity
  // ride C-CERT-FAM (branch keys are ground).
  cert_dominates : {fam: CertFam, absorbed: Shape, by: Shape}
    -> Prop;

  // Progressive-revelation coupling: where the run-committed choice
  // is revealed along the run rather than at the start, the branch
  // certificates must agree on shared prefixes — on the locus
  // enclosure, body #body's component at the finer branch is
  // bounded by the coarser branch's. The guard row of the mode
  // graph, generalized to the branch complex.
  cert_handoff : {fam: CertFam, from: Shape, to: Shape, body: Nat,
                  on: Box} -> Prop;

  // ==========================================================
  // The family's structural demand
  // ==========================================================

  qtsl_certfam_wf : {fam: CertFam} -> Prop;   // side-condition
                                              // (C-CERT-FAM)

  report ax/wf/certfam_wf : forall f : CertFam.
    |- {fam: f} qtsl_certfam_wf;

  // ==========================================================
  // Deliberately absent (the testable negatives)
  // ==========================================================
  //
  // No envelope slot: a demonic envelope is a consuming rule's
  // cellwise reading of the step axes, never an interface object —
  // materializing it is where both the recombination incompleteness
  // and the escape-face inexpressibility enter. No judgment kinds,
  // no verdict rows, no polarity lists: the verdict form lives with
  // the certificate sections it consumes. No checker-arm
  // vocabulary: arms are downstream of the baked schema. No
  // per-claim semantic side-conditions (properness, domination,
  // hand-off validity): those discharge where the consuming rule
  // reads the rows, and minting them here would be arm vocabulary
  // in demand-row dress. No branch-key structure sort: keys ride
  // ground Shape, and every constraint over them is admission.

  // ==========================================================
  // EVENT-7 SPLICE (the TimedFloor fragment, minted whole; see
  // the fragment's section comments for per-block provenance and
  // the original MINT TARGET placements — block placement at the
  // theory tail is the assembler's deterministic choice, semantics
  // identical to the exercised concatenation by construction)
  // ==========================================================


  // ==========================================================
  // The schema-meter premise class: TrMeter
  // MINT TARGET: theory Qtsl, the transition-former block, beside
  // qtsl_tr_content (whose conformance every instance of this class
  // consumes — the demand already mints per transition there).
  // ==========================================================
  //
  // TrMeter(t, d): transition t's clock is tkDemonic{d'},
  // tkForced{d'}, or tkCarved{d', .} with 0 < d <= d' (the lower
  // witness POSITIVE by the class's own formation — the wing-level
  // positivity reports establish d' > 0 for the DECLARED floor, not
  // for an arbitrary lower witness), d' finite (the EnnRat-to-Q
  // coercion explicit at the wing read; loud-refuse on a non-finite
  // floor), and qtsl_tr_content discharged. Monotone: the declared
  // floor is the tightest lawful instance. Not a rule; a premise
  // class — its semantic content is the METER LAW: under the
  // declared meter semantics (guard-exit resets; own-firing
  // resets), successive firings of t are separated by >= d of
  // elapsed time — hence N_t(T) <= T/d + 1 on any window,
  // floor(T/d) initialized, under EVERY resolution (Meter.lean,
  // the mechanized authority above; the rate-cap sentence at the
  // clock former, promoted from comment to premise class).
  qtsl_tr_meter : {tr: Transition, d: Q} -> Prop;
      // side-condition

  // Formation reports: the witness is positive, and sits at or
  // below the declared wing floor (one report per dwell-family
  // wing; the coercion is the enFin match).
  report ax/wf/tr_meter_pos : forall t : Transition, d : Q.
    {tr: t, d: d} qtsl_tr_meter
    |- {l: 0, r: d} q_lt;

  report ax/wf/tr_meter_le_forced : forall t : Transition, d : Q,
      df : Q, k : TrClock.
    {tr: t, d: d} qtsl_tr_meter,
    t Transition/clock = k,
    k = {dwell: df} tkForced
    |- {l: d, r: df} q_le;

  report ax/wf/tr_meter_le_demonic : forall t : Transition, d : Q,
      dm : Q, e : EnnRat, k : TrClock.
    {tr: t, d: d} qtsl_tr_meter,
    t Transition/clock = k,
    k = {dwellMin: e} tkDemonic,
    e = {q: dm} enFin
    |- {l: d, r: dm} q_le;

  report ax/wf/tr_meter_le_carved : forall t : Transition, d : Q,
      fl : Q, ce : EnnRat, k : TrClock.
    {tr: t, d: d} qtsl_tr_meter,
    t Transition/clock = k,
    k = {floor: fl, ceil: ce} tkCarved
    |- {l: d, r: fl} q_le;

  // The racing wing has no dwell floor: a meter row on it is
  // refused, never reported (no arithmetic evidence can rescue it —
  // its rate story is the thinning majorant, a different lane).
  refuse ax/qtsl/tr_meter_race : forall t : Transition, d : Q,
      e : EnnRat, k : TrClock.
    {tr: t, d: d} qtsl_tr_meter,
    t Transition/clock = k,
    k = {majorant: e} tkRace
    |- false;

  // The non-finite demonic floor: the meter class's own loud
  // refusal. DELIBERATELY REDUNDANT with the wing-level
  // ax/qtsl/tr_dwellmin_finite (a tkDemonic{enInf} row is already
  // refused at the former). SCOPE, made precise by the stage-4
  // data-plane round (its F-4): this refusal is keyed on a METER
  // FACT ({tr, d} qtsl_tr_meter as a stored row), so it covers
  // seeded/derived meter facts only — a judging-mode meter DEMAND
  // (ax/tf/qpatl_meter) yields a pending judgment, not a fact, and
  // does not arm it. Survival under a future wing-level softening
  // is therefore carried by the row-shape refusals at the lineage
  // section (ax/qtsl/qpatl_row_race / qpatl_row_dem_inf), not by
  // this axiom alone; any such softening must re-run the battery
  // under the modal-era engine.
  refuse ax/qtsl/tr_meter_dem_inf : forall t : Transition, d : Q,
      k : TrClock.
    {tr: t, d: d} qtsl_tr_meter,
    t Transition/clock = k,
    k = {dwellMin: enInf} tkDemonic
    |- false;

  // ==========================================================
  // The third footprint polarity: hrpDropAtMost
  // MINT TARGET: theory Qtsl, the HRowPolarity/HFootprintRow block.
  // The closure refusal ax/qtsl/hrp_closed gains the third disjunct
  // there (the paired patch; the ONE mutation-shaped edit). The
  // upper-coverage contract comment gains the CLOSED-membership
  // compat guard in the same patch: qtsl_hplate_coverage counts
  // exactly rows of polarity hrpSafety or hrpGap — a dropAtMost row
  // bounds nothing above, and an evaluator that counted one toward
  // upper coverage would silently unsound the two landed FromFold
  // nodes. The guard's executable kill site (the coverage evaluator
  // arm's battery mutant) rides the provider successor; minting is
  // blocked on that battery.
  // ==========================================================
  //
  // A footprint row of this polarity asserts, per (certificate,
  // transition schema), the swapped-sides sequent: fold-contribution
  // of the produced side >= consumed side - u, in the certificate's
  // reading scale (phi-space for conjugated kinds), under the
  // guard-slab hypotheses, for all colors in the boxes — "this
  // schema drops the fold by at most u per firing." Same BernCone
  // obligation as the landed polarities with the sides swapped.
  //
  // The pair idiom is free cargo: on one (cert, tr),
  // {hrpSafety, hrpDropAtMost(0)} = exact conservation as checked
  // rows; {hrpGap(g), hrpDropAtMost(g)} = displacement exactly -g —
  // no equality species minted; exactness is a row pair, each half
  // independently discharged.
  hrpDropAtMost : HRowPolarity;

  // The upper displacement bound, read on hrpDropAtMost only (the
  // gap-field discipline mirrored; a separate field, never gap
  // reuse — the positivity semantics differ: non-strict here,
  // strict there).
  HFootprintRow/ubound : HFootprintRow -> Q;

  // NON-strict: u = 0 is the load-bearing never-decreases case,
  // the mirror of hrpSafety.
  report ax/wf/hplate_ub_nonneg : forall r : HFootprintRow, u : Q.
    r HFootprintRow/polarity = hrpDropAtMost,
    r HFootprintRow/ubound = u
    |- {l: 0, r: u} q_le;

  // The gamma move, mirroring hplate_gap_idem: a dropAtMost row
  // whose certificate folds by an idempotent kind is refused at
  // load. Deliberately conservative: whether per-firing lower
  // displacement transfers on max/min is a Lean-tier question, and
  // the counting consumer only reads translated-sum scales
  // regardless; a refuse row relaxes by theorem at a revision
  // event, never tightens.
  refuse ax/qtsl/hplate_ub_idem : forall r : HFootprintRow,
      c : HCert, k : HAggKind.
    r HFootprintRow/polarity = hrpDropAtMost,
    r HFootprintRow/cert = c,
    c HCert/kind = k,
    {kind: k} hagg_idempotent
    |- false;

  // Pairwise disjointness, both new pairs (the baked
  // safety/gap pair keeps its own refusal).
  refuse ax/qtsl/hrp_sd_disjoint : forall r : HRowPolarity.
    r = hrpSafety, r = hrpDropAtMost
    |- false;

  refuse ax/qtsl/hrp_gd_disjoint : forall r : HRowPolarity.
    r = hrpGap, r = hrpDropAtMost
    |- false;

  // The two mirror side-conditions (loudly evaluator-deferred until
  // realized — the qtsl_init_member idiom):
  qtsl_hplate_coverage_lb : {cert: HCert} -> Prop;
      // mirror coverage: every may-touch transition of the subject
      // carries a dropAtMost row for this certificate — the same
      // may-touch recompute as the upper coverage; a transition
      // provably disjoint from every cited plate discharges by a
      // frame fact. NODE-KEYED MINT, deliberately (below): the
      // pair idiom's exactness rows never consume whole-roster
      // lower coverage, so no per-cert unconditional demand exists —
      // only the timed-floor conclusion consumes this, and only its
      // node mints it.
  qtsl_hplate_flow_lb : {cert: HCert} -> Prop;
      // mirror flow: the fold does not DECREASE between firings —
      // trivial at the static-color/Petri profile, a generator-row
      // obligation under color dynamics. Node-keyed, as above. The
      // static-color absorption is the discrete profile's; the
      // continuous lift re-exposes this as a genuine hypothesis.

  // ==========================================================
  // The causal-depth meter node: QPAlwaysTFromLineage
  // MINT TARGET: theory Qtsl, the plated-transfer-ties block,
  // after QFireBoundFromFold. Declared BEFORE the timed-fold node
  // here because that node's offsets step cites this one.
  // PROFILE-GATED at the discrete unfolding: (i) UNIFORM DWELL —
  // every covered row's clock carries the one period d
  // (tkDemonic{d}, tkForced{d}, or tkCarved{floor = d, ceil = d});
  // (ii) ROUND LAW — the subject is declared at the round-indexed
  // step reading (a property of the semantics declaration, never
  // inferred from clock fields); (iii) DEPTH-STATIC COLORS — the
  // cited plates' token colors do not evolve between firings.
  // Demonic rows are ADMITTED: the round law, not the clock kind,
  // carries the induction (Lineage.lean, the authority above).
  // ==========================================================
  //
  // Concludes (via QProof/concludes) a claim whose spec is
  // plate-emptiness (count wires = 0) over plates of declared
  // causal depth >= k, with the horizon T pinned on the node and
  // the walk checking T < k*d STRICTLY: the induction proves
  // emptiness at rounds 0..k-1 (times through (k-1)*d) and permits
  // a depth-k token IN the round-k marking, so the horizon sits
  // strictly below k*d (on the round grid, T = (k-1)*d is the
  // tightest warranted choice).
  //
  // The chi-bracket rows, on the negated depth dictionary
  // chi = -psi, live on this node's cert: per advancing row
  // {hrpGap(1), hrpDropAtMost(1)} — advance exactly 1, BOTH sides
  // load-bearing; per non-advancing covered row
  // {hrpSafety, hrpDropAtMost(0)} — exactly 0. Row classification
  // is READ OFF the bracket rows, never declared. Every bracket
  // row must be of the pathwise (deterministic-reset) species —
  // one moment-table row refuses the node (a stochastic moment row
  // can satisfy BOTH bracket sequents at expected displacement -1
  // while outcomes jump depth by 2 with positive probability,
  // violating the surely conclusion). Birth rows (0-consume/
  // 1-produce) satisfy the advancing bracket only at produced
  // depth 1 and the non-advancing only at depth 0 — both sound as
  // roots; death rows on positive-depth tokens satisfy NEITHER
  // bracket and are refused by bracket coverage — a completeness
  // cost, never an unsoundness.
  QPAlwaysTFromLineage : Set;

  QPAlwaysTFromLineage/proof : QPAlwaysTFromLineage -> QProof;
  QPAlwaysTFromLineage/cert  : QPAlwaysTFromLineage -> HCert;
      // the depth-dictionary certificate; its cited plates ARE the
      // rule's plate roster (function, exactly-one — the
      // ranking-face convention)
  QPAlwaysTFromLineage/depth   : QPAlwaysTFromLineage -> Nat;
  QPAlwaysTFromLineage/period  : QPAlwaysTFromLineage -> Q;
  QPAlwaysTFromLineage/horizon : QPAlwaysTFromLineage -> Q;

  // Formation arithmetic. The depth positivity is the catalogue's
  // formation guard (k = 0 would claim emptiness of depth-0 plates
  // at time 0, contradicted by any lawful initial marking with
  // psi = 0 tokens); the mechanized statement needs NO such
  // hypothesis (k = 0 makes the horizon range empty — vacuous), so
  // the Lean statement is STRONGER than the display and the guard
  // stays walk-side formation, never a soundness input.
  report ax/wf/qpatl_depth_pos : forall n : QPAlwaysTFromLineage,
      k : Nat.
    n QPAlwaysTFromLineage/depth = k
    |- {l: 0, r: k} nat_lt;

  report ax/wf/qpatl_period_pos : forall n : QPAlwaysTFromLineage,
      d : Q.
    n QPAlwaysTFromLineage/period = d
    |- {l: 0, r: d} q_lt;

  report ax/wf/qpatl_horizon_nonneg : forall n : QPAlwaysTFromLineage,
      x : Q.
    n QPAlwaysTFromLineage/horizon = x
    |- {l: 0, r: x} q_le;

  // Unit-lineage (structural): every covered transition consumes at
  // most 1 and produces at most 1 token across the cited plates
  // (reads don't count) — what makes per-token lineage a path: for
  // a row consuming a cited token AND producing a cited successor,
  // the fold-level chi displacement IS the successor's depth minus
  // the consumed token's depth.
  qtsl_unit_lineage : {cert: HCert} -> Prop;
      // side-condition

  // The walk (side-condition; the causal-depth catalogue entry
  // normative): subject agreement; scale gate (hagSum only, v1);
  // bracket-pair presence per covered row; the ALL-ROWS
  // pathwise-species demand on bracket rows; the unit-lineage
  // structural check; the profile check ((i)-(iii) above, incl.
  // depth-static colors); init arithmetic (forall tokens of m_0,
  // psi <= 0 — universally quantified, no empty-marking maximum
  // convention needed); formation arithmetic k >= 1, d > 0; the
  // concluded region's depth arithmetic T < k*d, STRICT.
  qtsl_palwayst_lineage : {node: QPAlwaysTFromLineage} -> Prop;
      // side-condition

  report ax/tf/qpatl_walk : forall n : QPAlwaysTFromLineage.
    |- {node: n} qtsl_palwayst_lineage;

  report ax/tf/qpatl_unit_lineage : forall n : QPAlwaysTFromLineage,
      c : HCert.
    n QPAlwaysTFromLineage/cert = c
    |- {cert: c} qtsl_unit_lineage;

  // The meter demands, at the NODE's period, for EVERY covered row.
  // SCOPE, made precise by the stage-4 data-plane round (its F-3):
  // this mint supplies the LOWER-BOUND subobligation only —
  // TrMeter(t, d_node), sound whenever d_node <= the row's declared
  // floor. It does NOT encode profile condition (i): exact uniform
  // dwell (incl. tkCarved ceil = floor) is checked ONLY by the
  // qtsl_palwayst_lineage walk, and an evaluator that delegated the
  // profile check to TrMeter discharge would be unsound (a node
  // period below a row's actual dwell discharges every TrMeter
  // judgment while the round-grid profile is false). Evaluator
  // mutants owed at the lineage-walk successor: d_node < declared
  // floor; carved ceil != floor. (A future continuous lift
  // revisits.)
  report ax/tf/qpatl_meter : forall n : QPAlwaysTFromLineage,
      c : HCert, r : HFootprintRow, t : Transition, d : Q.
    n QPAlwaysTFromLineage/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/tr = t,
    n QPAlwaysTFromLineage/period = d
    |- {tr: t, d: d} qtsl_tr_meter;

  // Row-shape refusals (stage-4 F-4 repair): a covered row of a
  // lineage cert on a wing that can NEVER satisfy profile condition
  // (i) is refused at the ROW SHAPE — tkRace has no dwell floor at
  // all; tkDemonic{enInf} has no finite one. Keyed on the node/cert/
  // row/clock shape, never on a meter FACT, so these survive any
  // future softening of the wing-level or class-level refusals
  // (which judging-mode demands do not arm — see the tr_meter_dem_inf
  // scope note). Conservative in the hplate_ub_idem sense: a refuse
  // relaxes by theorem at a revision event, never tightens.
  refuse ax/qtsl/qpatl_row_race : forall n : QPAlwaysTFromLineage,
      c : HCert, r : HFootprintRow, t : Transition, e : EnnRat,
      k : TrClock.
    n QPAlwaysTFromLineage/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/tr = t,
    t Transition/clock = k,
    k = {majorant: e} tkRace
    |- false;

  refuse ax/qtsl/qpatl_row_dem_inf : forall n : QPAlwaysTFromLineage,
      c : HCert, r : HFootprintRow, t : Transition, k : TrClock.
    n QPAlwaysTFromLineage/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/tr = t,
    t Transition/clock = k,
    k = {dwellMin: enInf} tkDemonic
    |- false;

  // The offsets relation (second face: cited by a timed-fold node
  // as its offsets premise). AUTHORED DATA the consumer NEVER
  // TRUSTS: the consuming walk RECOMPUTES o_r = (BernCone minimum
  // of the row's consumed-tuple declared depth over its guard box)
  // * d — the recompute-never-trust discipline, because the
  // offset's error sign is the unsound one (a larger o_r makes the
  // timed-fold conclusion easier). A row whose guard box admits no
  // consumed cited token takes the consumer's default o_r := d_r
  // (no offset row minted for it). At most one row per (node, row)
  // is admission conformance — per the base doctrine that tier is a
  // NAMED CHECK AT LOAD, never a chased equality (the engine
  // refuses to unify ground values). DUPLICATE POLICY (stage-4 F-5
  // repair, normative): admission REJECTS a second row per
  // (node, row); a consumer that meets duplicates anyway must
  // refuse, never select — first-row/existential lookup over
  // authored offsets is forbidden (an inflated duplicate would move
  // the timed-fold bound in the unsound direction); every USED
  // value is recomputed, so authored rows are hints plus a
  // conformance surface, never inputs. Evaluator loci owed at the
  // admission successor: OF-1 duplicate rows refuse; OF-2 the
  // recompute discipline (an inflated authored offset changes
  // nothing). This face is UNAFFECTED by the
  // strict-endpoint form: a firing consuming a depth->=k token
  // happens at round >= k, time >= k*d, which is exactly the
  // offset claim (Lineage.lean offset_face/offset_face_time).
  qtsl_lineage_offset : {node: QPAlwaysTFromLineage,
                         row: HFootprintRow, offset: Q} -> Prop;

  report ax/wf/lineage_offset_nonneg : forall
      n : QPAlwaysTFromLineage, r : HFootprintRow, o : Q.
    {node: n, row: r, offset: o} qtsl_lineage_offset
    |- {l: 0, r: o} q_le;

  // ==========================================================
  // The timed goal-floor node: QPAlwaysTFromFold
  // MINT TARGET: theory Qtsl, the plated-transfer-ties block,
  // beside QPAlwaysFromFold/QFireBoundFromFold (the FromFold
  // genus's timed-floor face; the metering-split two-node
  // discipline governs — never a parameterized mega-node).
  // ==========================================================
  //
  // Concludes (via QProof/concludes) a claim at the surely/
  // safety-polarity face: within horizon T, the goal region is not
  // reached — the closed-judgment route (no warrant row, no boxed
  // family; init AND goal arithmetic live inside the walk). The
  // soundness shape (FoldFloor.lean, the authority above): the
  // mirror telescope fold_phi(m_t) >= F - sum_r u_r N_r(t)
  // (pathwise, Dirac resets, translated-sum scales, phi-space for
  // conjugated kinds), the meter law N_r(t) <= max(0,(t-o_r)/d_r)+1
  // per positive-u row, and the ONE exact verification inequality,
  // STRICT:
  //   sum_{r : u_r > 0} u_r * (max(0, (T - o_r)/d_r) + 1) < F - f_g
  // — a run reaching goal by T would force the sum to reach
  // F - f_g, refuted by the strict check. Zeno-robust without a
  // budget: uncounted rows (u_r = 0, instant tkRace included) may
  // fire unboundedly — they cannot drop the fold; the conclusion is
  // safety-polarity and takes no crossing-budget attachment.
  QPAlwaysTFromFold : Set;

  QPAlwaysTFromFold/proof : QPAlwaysTFromFold -> QProof;
  QPAlwaysTFromFold/cert  : QPAlwaysTFromFold -> HCert;
      // function, exactly-one — the ranking-face convention
  QPAlwaysTFromFold/goalfold : QPAlwaysTFromFold -> Q;   // f_g, pinned
  QPAlwaysTFromFold/horizon  : QPAlwaysTFromFold -> Q;   // T, pinned

  report ax/wf/qpatf_horizon_nonneg : forall n : QPAlwaysTFromFold,
      x : Q.
    n QPAlwaysTFromFold/horizon = x
    |- {l: 0, r: x} q_le;

  // The optional offsets citation (zero-or-one row is admission
  // conformance; absent citation means the walk defaults every
  // o_r := d_r).
  qpatf_offsets : {node: QPAlwaysTFromFold,
                   lineage: QPAlwaysTFromLineage} -> Prop;

  // The walk (side-condition; the timed-floor catalogue entry
  // normative, fourteen steps): (i) conclusion resolution (goal :=
  // the complement of the timed-always argument); (ii) subject
  // agreement incl. hplate_token bindings (the factored FromFold
  // preamble); (iii) reading-scale gate (hagSum/hagConjPow exact;
  // hagConjExp loudly deferred on the enclosure register) — and,
  // for hagConjPow, qtsl_hplate_param_cert demanded DISCHARGED
  // (the phi-space telescope is unjustified without it); (iv)
  // goal-fold bound — fold <= f_g on the goal region
  // (support-emptiness or a producer BernCone certificate over the
  // goal region, the walk records which); (v) init arithmetic
  // F := fold_phi(m_0) recomputed from mech_bag_marking + the
  // feature dictionary; (vi) coverage_lb; (vii) per-row
  // swapped-sides footprint sequents; (viii) the ALL-ROWS
  // pathwise-species demand (one moment-table row refuses the
  // node); (ix) flow_lb; (x) meter premises — every row with
  // u_r > 0 has clock in {tkDemonic, tkForced, tkCarved} with
  // floor d_r > 0 and qtsl_tr_content discharged; tkRace with
  // u_r > 0 REFUSES (an instant row that drops the fold has no
  // time floor; tkRace at u_r = 0 is lawful — uncounted,
  // fold-safe); (xi) offsets o_r from the cited lineage node,
  // RECOMPUTED per the offsets relation's own discipline, else
  // o_r := d_r; (xii) the verification inequality above, one
  // exact-Q check, STRICT, T pinned by the producer; (xiii)
  // sibling-claim presence — coverage_lb, per-row footprint,
  // flow_lb, and (for conjugated kinds) the conjugation-parameter
  // family, as sealed claim rows beside the semantic replays of
  // (vi)/(vii)/(ix)/(iii); (xiv) polarity roster (every row read
  // is hrpDropAtMost; ubound read on that polarity only).
  qtsl_palwayst_fold : {node: QPAlwaysTFromFold} -> Prop;
      // side-condition

  report ax/tf/qpatf_walk : forall n : QPAlwaysTFromFold.
    |- {node: n} qtsl_palwayst_fold;

  // The mirror side-condition demands, NODE-KEYED (see the
  // declarations above for why never per-cert).
  report ax/tf/qpatf_coverage_lb : forall n : QPAlwaysTFromFold,
      c : HCert.
    n QPAlwaysTFromFold/cert = c
    |- {cert: c} qtsl_hplate_coverage_lb;

  report ax/tf/qpatf_flow_lb : forall n : QPAlwaysTFromFold,
      c : HCert.
    n QPAlwaysTFromFold/cert = c
    |- {cert: c} qtsl_hplate_flow_lb;

  // The meter demands at the row transition's DECLARED wing floor
  // (one arm per dwell-family wing — the tightest lawful witness by
  // the class's monotonicity; the u_r > 0 gating and the
  // tkRace-with-positive-u refusal are walk arithmetic, step (x):
  // ground comparisons are never chase moves). A dropAtMost row on
  // a race-clocked transition mints NO meter demand here — the
  // walk adjudicates it by its ubound's sign.
  report ax/tf/qpatf_meter_forced : forall n : QPAlwaysTFromFold,
      c : HCert, r : HFootprintRow, t : Transition, d : Q,
      k : TrClock.
    n QPAlwaysTFromFold/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/polarity = hrpDropAtMost,
    r HFootprintRow/tr = t,
    t Transition/clock = k,
    k = {dwell: d} tkForced
    |- {tr: t, d: d} qtsl_tr_meter;

  report ax/tf/qpatf_meter_demonic : forall n : QPAlwaysTFromFold,
      c : HCert, r : HFootprintRow, t : Transition, d : Q,
      e : EnnRat, k : TrClock.
    n QPAlwaysTFromFold/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/polarity = hrpDropAtMost,
    r HFootprintRow/tr = t,
    t Transition/clock = k,
    k = {dwellMin: e} tkDemonic,
    e = {q: d} enFin
    |- {tr: t, d: d} qtsl_tr_meter;

  report ax/tf/qpatf_meter_carved : forall n : QPAlwaysTFromFold,
      c : HCert, r : HFootprintRow, t : Transition, fl : Q,
      ce : EnnRat, k : TrClock.
    n QPAlwaysTFromFold/cert = c,
    r HFootprintRow/cert = c,
    r HFootprintRow/polarity = hrpDropAtMost,
    r HFootprintRow/tr = t,
    t Transition/clock = k,
    k = {floor: fl, ceil: ce} tkCarved
    |- {tr: t, d: fl} qtsl_tr_meter;

  // ==========================================================
  // The singleton clock-to-rate seam: QRateFromClock
  // MINT TARGET: theory Qtsl, the event-rate lane, beside
  // QRateFromClocks. SIBLING NOTE, load-bearing: QRateFromClocks
  // (plural) prices a whole roster by exact per-wing sums — its
  // dwell price is comment-tier debt; THIS node is the singleton
  // TrMeter seam, slack allowed (rho*d >= 1, sigma >= 1), whose
  // LAW is mechanized (Meter.lean rate_envelope: pathwise
  // N <= T/d + 1 <= rho*T + sigma, run-quantified). Different
  // evidence families on one lane — the standing sibling pattern
  // (the fold-route weakening note at the clock node is the same
  // shape). Rosters compose via the disjoint-roster sum free law;
  // this rule is that packaging's first consumer.
  // ==========================================================
  //
  // Concludes (via QProof/concludes) a claim whose spec consumes
  // the singleton rate envelope on {t}. The surely/pathwise face is
  // STRONGER than the concluded prevision face — recorded so a
  // future pathwise rate former can strengthen the conclusion
  // without touching the node.
  QRateFromClock : Set;

  QRateFromClock/proof : QRateFromClock -> QProof;
  QRateFromClock/tr    : QRateFromClock -> Transition;
  QRateFromClock/rho   : QRateFromClock -> Q;
  QRateFromClock/sigma : QRateFromClock -> Q;

  report ax/wf/qrfc1_rho_pos : forall n : QRateFromClock, x : Q.
    n QRateFromClock/rho = x
    |- {l: 0, r: x} q_lt;

  report ax/wf/qrfc1_sigma_ge_one : forall n : QRateFromClock, x : Q.
    n QRateFromClock/sigma = x
    |- {l: 1, r: x} q_le;

  // The racing wing is refused AS SUBJECT (no floor; its rate story
  // is the thinning majorant — the roster node's lane).
  refuse ax/qtsl/rate_clock_race : forall n : QRateFromClock,
      t : Transition, e : EnnRat, k : TrClock.
    n QRateFromClock/tr = t,
    t Transition/clock = k,
    k = {majorant: e} tkRace
    |- false;

  // The walk (side-condition): subject agreement (sys_transition;
  // the firing-count roster conformance on the singleton);
  // qtsl_tr_content presence; WHERE d COMES FROM — the node carries
  // no d field; the walk resolves d DETERMINISTICALLY as the
  // transition's declared clock floor d' read off the wing (finite,
  // coerced to Q; loud-refuse otherwise) and checks rho * d' >= 1 —
  // no producer freedom, and by the meter class's monotonicity the
  // declared floor is the tightest lawful witness, so nothing is
  // lost by pinning it; the two exact-Q envelope inequalities.
  qtsl_rate_clock : {node: QRateFromClock} -> Prop;
      // side-condition

  report ax/tf/qrfc1_walk : forall n : QRateFromClock.
    |- {node: n} qtsl_rate_clock;

  // The meter demand at the declared floor, per dwell-family wing.
  report ax/tf/qrfc1_meter_forced : forall n : QRateFromClock,
      t : Transition, d : Q, k : TrClock.
    n QRateFromClock/tr = t,
    t Transition/clock = k,
    k = {dwell: d} tkForced
    |- {tr: t, d: d} qtsl_tr_meter;

  report ax/tf/qrfc1_meter_demonic : forall n : QRateFromClock,
      t : Transition, d : Q, e : EnnRat, k : TrClock.
    n QRateFromClock/tr = t,
    t Transition/clock = k,
    k = {dwellMin: e} tkDemonic,
    e = {q: d} enFin
    |- {tr: t, d: d} qtsl_tr_meter;

  report ax/tf/qrfc1_meter_carved : forall n : QRateFromClock,
      t : Transition, fl : Q, ce : EnnRat, k : TrClock.
    n QRateFromClock/tr = t,
    t Transition/clock = k,
    k = {floor: fl, ceil: ce} tkCarved
    |- {tr: t, d: fl} qtsl_tr_meter;

  // ==========================================================
  // The kernel-cite support warrant: KSupportWarrant
  // MINT TARGET: theory Qtsl, beside the kernel-citation seam
  // (tr_kernel/mkKernelCite). The angelic-selection enabledness
  // facet's staged witness, carried from its staging residue
  // unchanged in shape.
  // ==========================================================
  //
  // The constraint any repair must respect (the Transition former's
  // own design comment): ENABLING IS DERIVED — the active region is
  // the kernel's non-stay support, and a bare active-region data
  // row could disagree with it. Relational exposure must therefore
  // be certificate-shaped: a warrant TIED to the cited content, so
  // disagreement is a checkable claim discharged at the certificate
  // stratum, never a second source of truth beside the kernel.
  KSupportWarrant : Set;

  // The subject: a kernel citation, BY ELEMENT — the warrant binds
  // the citation, and through its digest the content; re-cited
  // content re-warrants per citation (conformance-per-attachment).
  KSupportWarrant/cite : KSupportWarrant -> KernelCite;

  // The warranted region: a box claimed to lie inside the cited
  // kernel's non-stay support (open-support membership — the
  // strict reading the enabled facet consumes).
  KSupportWarrant/region : KSupportWarrant -> Box;

  // The discharge obligation (evaluator-deferred, loudly): the
  // cited hypernet's tag head, restricted to the region, carries
  // strictly positive non-stay mass everywhere. Where the tag
  // output is polynomial-presented this is a sign-fiber/positivity
  // certificate — the proof tower's jurisdiction, same genus as
  // the landed footprint tiers; elsewhere it refuses (fail-closed).
  // Consumption is a DISCHARGE ROUTE, not a new obligation: the
  // enabled facet's kernel-cite arm grows a warrant-lookup — a
  // warrant whose cite is the choice's kernel content and whose
  // region CONTAINS the cell's dom (box containment, decidable)
  // discharges the facet; absence keeps the named refusal. No
  // change to the selection rows themselves.
  qtsl_ksupport : {w: KSupportWarrant} -> Prop;
      // side-condition

  report ax/wf/ksupport : forall w : KSupportWarrant.
    |- {w: w} qtsl_ksupport;
}
