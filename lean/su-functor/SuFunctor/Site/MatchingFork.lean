import SuFunctor.Site.SiteFunctor

/-! # The matching fork: strict sections are not closed under the compositor

The site dimension's genuine boundary, exhibited.  Window-indexed spec
families come in two section disciplines: **matching** (strict — each
window's class is exactly the restriction of every superwindow's) and
**persistent** (lax — extension carries each window's class into every
superwindow's).  The compositor preserves persistence
(`IsPersistent.image2_boxplusW`); this module proves it does **not**
preserve matching, on an explicit two-window witness:

* stage line `Bool`, windows `{false} ⊆ univ` — one extra time point;
* one-wire interfaces, the constant pattern with singleton apex fibres;
* on the superwindow, two **support walls** through the shared middle
  boundary at the extra time point: the first demands the middle read
  `true` there, the second demands it read `false`;
* their composite is the zero-support wall (the demands contradict
  through the shared middle), which **is** clip-invariant — it extends
  a subwindow penalty — while neither wall is individually
  clip-invariant (a dirac pair with equal clips and different middle
  values separates each);
* hence the matching families generated by the walls have a composite
  whose subwindow component is empty while the restriction-preimage of
  its superwindow component is not: matching fails.

The moral, in the pattern the sibling strata exhibit (demonic transport:
expected laxity dissolves, meets carry the real laxity; the denotation
tier: denotations glue exactly, assessments glue least-committally): the
site dimension leaves the seven functor obligations exactly as strict as
the plain tier's and moves the entire boundary into **which fibre
objects are admissible** — the lax sections, of which the persistent
families are the least-committal completion of window-local spec data.
-/

namespace SuFunctor

namespace Site

noncomputable section

open CategoryTheory CategoryTheory.WireSpan SuFunctor.Plain
open scoped NNReal ENNReal

/-! ## Joint-level fixtures: walls, diracs, and the no-cancellation fact -/

open Classical in
/-- The support wall of a region: permitted exactly on joints supported
inside it, forbidden outright otherwise. -/
def wall {X : Type*} (P : Set X) : Pen X :=
  fun ν => if (↑ν.wt.support : Set X) ⊆ P then 0 else ⊤

theorem wall_apply_of_subset {X : Type*} {P : Set X} {ν : Joint X}
    (h : (↑ν.wt.support : Set X) ⊆ P) : wall P ν = 0 := if_pos h

theorem wall_apply_of_not_subset {X : Type*} {P : Set X} {ν : Joint X}
    (h : ¬ (↑ν.wt.support : Set X) ⊆ P) : wall P ν = ⊤ := if_neg h

/-- The dirac joint at a point: unit mass there. -/
def dirac {X : Type*} (x : X) : Joint X :=
  ⟨Finsupp.single x 1, le_of_eq (Finsupp.sum_single_index rfl)⟩

theorem dirac_wt_support {X : Type*} (x : X) :
    (dirac x).wt.support = {x} :=
  Finsupp.support_single_ne_zero x one_ne_zero

theorem wall_dirac_of_mem {X : Type*} {P : Set X} {x : X} (h : x ∈ P) :
    wall P (dirac x) = 0 :=
  wall_apply_of_subset (by rw [dirac_wt_support]; simpa using h)

theorem wall_dirac_of_not_mem {X : Type*} {P : Set X} {x : X}
    (h : x ∉ P) : wall P (dirac x) = ⊤ :=
  wall_apply_of_not_subset (by rw [dirac_wt_support]; simpa using h)

universe v

/-- Diracs push forward to diracs. -/
theorem push_dirac {X Y : Type v} (f : X → Y) (x : X) :
    (dirac x).push f = dirac (f x) :=
  Joint.ext (by rw [Joint.push_wt]; exact Finsupp.mapDomain_single)

/-- **No cancellation**: a point of positive weight keeps its image
point in the support of the pushforward — nonnegative weights only
accumulate.  (The fact that makes support walls compose honestly.) -/
theorem push_apply_ne_zero {X Y : Type v} (f : X → Y) {ν : Joint X}
    {x : X} (hx : ν.wt x ≠ 0) : (ν.push f).wt (f x) ≠ 0 := by
  classical
  have hle : ν.wt x ≤ (ν.push f).wt (f x) := by
    rw [Joint.push_wt, Finsupp.mapDomain, Finsupp.sum_apply]
    have hmem : x ∈ ν.wt.support := Finsupp.mem_support_iff.mpr hx
    have hstep := Finset.single_le_sum
      (f := fun a => (Finsupp.single (f a) (ν.wt a)) (f x))
      (fun i _ => zero_le) hmem
    rw [Finsupp.single_apply, if_pos rfl] at hstep
    exact hstep
  intro h0
  rw [h0] at hle
  exact hx (le_antisymm hle zero_le)

namespace MatchingFork

/-! ## The two-window witness system -/

/-- The two-window system on the stage line `Bool`: the subwindow
`{false}` inside the full line — one extra time point (`true`). -/
def sysU : Bool → Set Bool
  | true => Set.univ
  | false => {false}

theorem sysU_le : sysU false ⊆ sysU true := fun x _ => Set.mem_univ x

/-- The one-wire interface. -/
def one : WireSpan Bool := ⟨PUnit⟩

/-- The constant pattern with singleton apex fibres. -/
def pat : Pat one one := fun _ _ => PUnit

/-- An apex point of `pat` with the given boundary values. -/
def mk (a b : Bool) : Pat.Tot pat :=
  ⟨fun _ => a, fun _ => b, PUnit.unit⟩

/-- The extra time point of the superwindow. -/
def t₁ : ↥(sysU true) := ⟨true, Set.mem_univ true⟩

/-- The first wall region: the middle boundary (the second boundary of
the first factor's apex) reads `true` at the extra time point. -/
def PM : Set (Traj (sysU true) (Pat.Tot pat)) :=
  {s | (s t₁).2.1 PUnit.unit = true}

/-- The second wall region: the middle boundary (the first boundary of
the second factor's apex) reads `false` at the extra time point. -/
def QN : Set (Traj (sysU true) (Pat.Tot pat)) :=
  {s | (s t₁).1 PUnit.unit = false}

/-- The subwindow's zero-support wall: the composite's whole content,
already expressible before the extra time point exists. -/
def qFalse : Pen (Traj (sysU false) (Pat.Tot (Pat.comp pat pat))) :=
  wall ∅

/-- **The composite wall extends**: the two contradictory middle
demands compose to the zero-support wall, which is the extension of the
subwindow's zero-support wall — the composite forgets exactly the
window-local data that made its factors non-extendable. -/
theorem penExt_qFalse :
    penExt sysU_le qFalse = boxplusW (wall PM) (wall QN) := by
  have hzero_wall : ∀ {Y : Type} (S : Set Y) (μ : Joint Y), μ.wt = 0 →
      wall S μ = 0 := by
    intro Y S μ h
    apply wall_apply_of_subset
    rw [h, Finsupp.support_zero, Finset.coe_empty]
    exact Set.empty_subset S
  funext ν
  by_cases hν : ν.wt = 0
  · rw [show penExt sysU_le qFalse ν = 0 from hzero_wall _ _
        (by rw [Joint.push_wt, hν]; exact Finsupp.mapDomain_zero),
      boxplusW_apply,
      hzero_wall PM _ (by rw [Joint.push_wt, hν]; exact Finsupp.mapDomain_zero),
      hzero_wall QN _ (by rw [Joint.push_wt, hν]; exact Finsupp.mapDomain_zero),
      add_zero]
  · obtain ⟨x₀, hx₀⟩ := Finsupp.ne_iff.mp hν
    have hx₀' : ν.wt x₀ ≠ 0 := hx₀
    have hLHS : penExt sysU_le qFalse ν = ⊤ := by
      apply wall_apply_of_not_subset
      intro hsub
      exact absurd
        (hsub (Finset.mem_coe.mpr (Finsupp.mem_support_iff.mpr
          (push_apply_ne_zero (trajRes sysU_le) hx₀'))))
        (Set.notMem_empty _)
    have hRHS : boxplusW (wall PM) (wall QN) ν = ⊤ := by
      rw [boxplusW_apply]
      by_cases h₁ : (↑(ν.push (trajMap (Pat.compFst pat pat))).wt.support :
          Set (Traj (sysU true) (Pat.Tot pat))) ⊆ PM
      · by_cases h₂ : (↑(ν.push (trajMap (Pat.compSnd pat pat))).wt.support :
            Set (Traj (sysU true) (Pat.Tot pat))) ⊆ QN
        · exfalso
          have hM : trajMap (Pat.compFst pat pat) x₀ ∈ PM :=
            h₁ (Finset.mem_coe.mpr (Finsupp.mem_support_iff.mpr
              (push_apply_ne_zero _ hx₀')))
          have hN : trajMap (Pat.compSnd pat pat) x₀ ∈ QN :=
            h₂ (Finset.mem_coe.mpr (Finsupp.mem_support_iff.mpr
              (push_apply_ne_zero _ hx₀')))
          have hMv : (x₀ t₁).2.2.1 PUnit.unit = true := hM
          have hNv : (x₀ t₁).2.2.1 PUnit.unit = false := hN
          exact absurd (hMv.symm.trans hNv) (by decide)
        · rw [wall_apply_of_not_subset h₂, add_top]
      · rw [wall_apply_of_not_subset h₁, top_add]
    rw [hLHS, hRHS]

/-! ## Neither wall extends individually -/

/-- Constant witness trajectory: middle `true` throughout. -/
def sM₁ : Traj (sysU true) (Pat.Tot pat) := fun _ => mk true true

/-- Perturbed witness: middle flips to `false` at the extra time point
only — same clip as `sM₁`. -/
def sM₂ : Traj (sysU true) (Pat.Tot pat) :=
  fun t => bif t.1 then mk true false else mk true true

theorem clip_sM : trajRes sysU_le sM₁ = trajRes sysU_le sM₂ := by
  funext t
  obtain ⟨tv, htv⟩ := t
  obtain rfl : tv = false := Set.eq_of_mem_singleton htv
  rfl

/-- The first wall is not clip-invariant: no subwindow penalty extends
to it. -/
theorem not_penExt_wallPM
    (q' : Pen (Traj (sysU false) (Pat.Tot pat))) :
    penExt sysU_le q' ≠ wall PM := by
  intro he
  have h1 : q' ((dirac sM₁).push (trajRes sysU_le)) =
      q' ((dirac sM₂).push (trajRes sysU_le)) := by
    rw [push_dirac, push_dirac, clip_sM]
  have h2 := congrFun he (dirac sM₁)
  have h3 := congrFun he (dirac sM₂)
  rw [wall_dirac_of_mem (show sM₁ ∈ PM from rfl)] at h2
  rw [wall_dirac_of_not_mem
    (show sM₂ ∉ PM from fun h => Bool.noConfusion h)] at h3
  exact ENNReal.zero_ne_top ((h2.symm.trans h1).trans h3)

/-- Constant witness for the second wall: middle `false` throughout. -/
def sN₁ : Traj (sysU true) (Pat.Tot pat) := fun _ => mk false true

/-- Perturbed witness: middle flips to `true` at the extra time point
only. -/
def sN₂ : Traj (sysU true) (Pat.Tot pat) :=
  fun t => bif t.1 then mk true true else mk false true

theorem clip_sN : trajRes sysU_le sN₁ = trajRes sysU_le sN₂ := by
  funext t
  obtain ⟨tv, htv⟩ := t
  obtain rfl : tv = false := Set.eq_of_mem_singleton htv
  rfl

/-- The second wall is not clip-invariant either. -/
theorem not_penExt_wallQN
    (q' : Pen (Traj (sysU false) (Pat.Tot pat))) :
    penExt sysU_le q' ≠ wall QN := by
  intro he
  have h1 : q' ((dirac sN₁).push (trajRes sysU_le)) =
      q' ((dirac sN₂).push (trajRes sysU_le)) := by
    rw [push_dirac, push_dirac, clip_sN]
  have h2 := congrFun he (dirac sN₁)
  have h3 := congrFun he (dirac sN₂)
  rw [wall_dirac_of_mem (show sN₁ ∈ QN from rfl)] at h2
  rw [wall_dirac_of_not_mem
    (show sN₂ ∉ QN from fun h => Bool.noConfusion h)] at h3
  exact ENNReal.zero_ne_top ((h2.symm.trans h1).trans h3)

/-! ## The matching families and the fork -/

/-- The matching family generated by the first wall: the wall upstairs,
its restriction-preimage downstairs. -/
def famM : ∀ b, Set (Pen (Traj (sysU b) (Pat.Tot pat)))
  | true => {wall PM}
  | false => penExt sysU_le ⁻¹' {wall PM}

/-- The matching family generated by the second wall. -/
def famN : ∀ b, Set (Pen (Traj (sysU b) (Pat.Tot pat)))
  | true => {wall QN}
  | false => penExt sysU_le ⁻¹' {wall QN}

theorem isMatching_famM : IsMatching sysU famM := by
  intro i j hij
  cases i <;> cases j
  · have hp : penExt hij =
        (id : Pen (Traj (sysU false) (Pat.Tot pat)) → _) :=
      funext fun u => penExt_refl u
    rw [hp, Set.preimage_id]
  · rfl
  · exact absurd (hij (Set.mem_univ true))
      (fun h => Bool.noConfusion (Set.eq_of_mem_singleton h))
  · have hp : penExt hij =
        (id : Pen (Traj (sysU true) (Pat.Tot pat)) → _) :=
      funext fun u => penExt_refl u
    rw [hp, Set.preimage_id]

theorem isMatching_famN : IsMatching sysU famN := by
  intro i j hij
  cases i <;> cases j
  · have hp : penExt hij =
        (id : Pen (Traj (sysU false) (Pat.Tot pat)) → _) :=
      funext fun u => penExt_refl u
    rw [hp, Set.preimage_id]
  · rfl
  · exact absurd (hij (Set.mem_univ true))
      (fun h => Bool.noConfusion (Set.eq_of_mem_singleton h))
  · have hp : penExt hij =
        (id : Pen (Traj (sysU true) (Pat.Tot pat)) → _) :=
      funext fun u => penExt_refl u
    rw [hp, Set.preimage_id]

/-- **M4, the matching fork**: matching families are not closed under
the componentwise compositor.  The composite of the two wall families
has empty subwindow component, while the restriction-preimage of its
superwindow component contains the subwindow's zero-support wall —
strict sections break exactly where the persistent (lax) sections are
proved closed (`IsPersistent.image2_boxplusW`). -/
theorem matching_not_closed_under_compositor :
    ∃ (Φ Ψ : ∀ b, Set (Pen (Traj (sysU b) (Pat.Tot pat)))),
      IsMatching sysU Φ ∧ IsMatching sysU Ψ ∧
        ¬ IsMatching sysU
          (fun b => Set.image2 boxplusW (Φ b) (Ψ b)) := by
  refine ⟨famM, famN, isMatching_famM, isMatching_famN, fun hM => ?_⟩
  have hkey := hM sysU_le
  have hq : qFalse ∈ penExt sysU_le ⁻¹'
      (Set.image2 boxplusW (famM true) (famN true)) := by
    show penExt sysU_le qFalse ∈
      Set.image2 boxplusW (famM true) (famN true)
    rw [penExt_qFalse]
    exact Set.mem_image2_of_mem (Set.mem_singleton _) (Set.mem_singleton _)
  rw [← hkey] at hq
  obtain ⟨qu, hqu, qv, hqv, -⟩ := hq
  exact not_penExt_wallPM qu (Set.mem_singleton_iff.mp hqu)

end MatchingFork

end

