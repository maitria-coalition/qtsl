import SuFunctor.Universe.TransposedGeneration
import SuFunctor.Universe.Sector

/-! # Transposed generation restricts to the radial locus

`SuFunctor.Universe.TransposedGeneration` proves every Vietoris-lsc
functional on the full hyperspace of a second-countable space is a
countable sup of hyperspace rows.  This module restricts the theorem
to closed loci — in particular to the radial locus `RadialCompacts V`,
the system space of the dictionary.

* **The top-off extension** (`extendTop`,
  `lowerSemicontinuous_extendTop`): an lsc functional on a *closed*
  subspace extends to the ambient space by hard violation (`⊤`) off
  the subspace.  Off a closed set, `⊤` is an lsc value: every
  superlevel gains the open complement wholesale, and the relative
  superlevels arrive as traces of ambient opens.
* **Generation restricts to closed loci**
  (`iSup_hyperRows_restrict_eq_self`): the extension is generated by
  ambient rows, every ambient row minorant restricts to a locus
  minorant, and the restricted sup is squeezed between them.  The rows
  themselves restrict — the corollary quantifies over exactly the same
  countable index, rows read through the locus inclusion.
* **The radial instantiation** (`iSup_hyperRows_radial_eq_self`): the
  radial locus is closed (`isClosed_setOf_isRadial`), so every
  Vietoris-lsc functional on `RadialCompacts V` is a countable sup of
  restricted rows — transposed generation for the system space
  itself.
-/

namespace SuFunctor.Universe

open scoped ENNReal
open TopologicalSpace

/-! ## The top-off extension -/

section ExtendTop

variable {Y : Type*} [TopologicalSpace Y]

open Classical in
/-- The top-off extension of a functional on a subspace: hard
violation (`⊤`) off the subspace. -/
noncomputable def extendTop (C : Set Y) (Ψ : C → ℝ≥0∞) : Y → ℝ≥0∞ :=
  fun y => if h : y ∈ C then Ψ ⟨y, h⟩ else ⊤

@[simp] theorem extendTop_coe {C : Set Y} (Ψ : C → ℝ≥0∞) (x : C) :
    extendTop C Ψ x = Ψ x := by
  simp only [extendTop, dif_pos x.2, Subtype.coe_eta]

/-- **The top-off extension of an lsc functional on a closed subspace
is lsc.**  Superlevels gain the open complement wholesale; the
relative superlevels arrive as traces of ambient opens. -/
theorem lowerSemicontinuous_extendTop {C : Set Y} (hC : IsClosed C)
    {Ψ : C → ℝ≥0∞} (hΨ : LowerSemicontinuous Ψ) :
    LowerSemicontinuous (extendTop C Ψ) := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro a
  obtain ⟨V, hV, hVeq⟩ :=
    Topology.IsInducing.subtypeVal.isOpen_iff.mp (hΨ.isOpen_preimage a)
  rcases eq_or_ne a ⊤ with rfl | ha
  · -- no value exceeds `⊤`: the superlevel is empty
    have hempty : extendTop C Ψ ⁻¹' Set.Ioi ⊤ = ∅ := by
      ext y
      simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_empty_iff_false,
        iff_false]
      exact not_top_lt
    rw [hempty]
    exact isOpen_empty
  · -- below `⊤`, the superlevel is an ambient open joined with the
    -- open complement of the subspace
    have heq : extendTop C Ψ ⁻¹' Set.Ioi a = V ∪ Cᶜ := by
      ext y
      simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_union,
        Set.mem_compl_iff]
      by_cases hy : y ∈ C
      · have hval : extendTop C Ψ y = Ψ ⟨y, hy⟩ := dif_pos hy
        have hmemV : a < Ψ ⟨y, hy⟩ ↔ y ∈ V := by
          constructor
          · intro hlt
            have hm : (⟨y, hy⟩ : C) ∈ Subtype.val ⁻¹' V := by
              rw [hVeq]
              exact hlt
            exact hm
          · intro hyV
            have hm : (⟨y, hy⟩ : C) ∈ Subtype.val ⁻¹' V := hyV
            rw [hVeq] at hm
            exact hm
        rw [hval, hmemV]
        simp [hy]
      · have hval : extendTop C Ψ y = ⊤ := dif_neg hy
        rw [hval]
        simp [hy, ha.lt_top]
    rw [heq]
    exact hV.union hC.isOpen_compl

end ExtendTop

/-! ## Generation restricts to closed loci -/

section RestrictedGeneration

variable {X : Type*} [TopologicalSpace X]

/-- **Generation restricts to closed loci.**  On a closed locus of the
hyperspace of a second-countable space, every Vietoris-lsc functional
is the pointwise supremum of its restricted hyperspace-row minorants —
the same countable index as the ambient theorem, rows read through the
locus inclusion. -/
theorem iSup_hyperRows_restrict_eq_self [SecondCountableTopology X]
    {C : Set (NonemptyCompacts X)} (hC : IsClosed C)
    {Ψ : C → ℝ≥0∞} (hΨ : LowerSemicontinuous Ψ) :
    ∃ B : Set (Set X), B.Countable ∧ (∀ U ∈ B, IsOpen U)
      ∧ (⨆ (q : ℚ) (u : Finset (Set X)) (_ : ↑u ⊆ B) (_ : 0 < q)
          (_ : ∀ K : C, hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u ↑K ≤ Ψ K),
          fun K : C => hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u ↑K) = Ψ := by
  have hΦ : LowerSemicontinuous (extendTop C Ψ) :=
    lowerSemicontinuous_extendTop hC hΨ
  obtain ⟨B, hBc, hBopen, hB⟩ := iSup_hyperRows_eq_self hΦ
  refine ⟨B, hBc, hBopen, ?_⟩
  apply le_antisymm
  · -- each admissible restricted row is a minorant of `Ψ`
    exact iSup_le fun q => iSup_le fun u => iSup_le fun _ => iSup_le fun _ =>
      iSup_le fun hmin => fun K => hmin K
  · -- `Ψ` is the restriction of the extension, which the ambient rows
    -- generate; ambient minorants restrict to locus minorants
    intro K
    calc Ψ K = extendTop C Ψ ↑K := (extendTop_coe Ψ K).symm
      _ = (⨆ (q : ℚ) (u : Finset (Set X)) (_ : ↑u ⊆ B) (_ : 0 < q)
            (_ : ∀ K', hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u K'
              ≤ extendTop C Ψ K'),
            hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u) ↑K := by rw [hB]
      _ ≤ _ := by
          simp only [iSup_apply]
          refine iSup_le fun q => iSup_le fun u => iSup_le fun hu =>
            iSup_le fun hq => iSup_le fun hminA => ?_
          have hminR : ∀ K' : C,
              hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u ↑K' ≤ Ψ K' := by
            intro K'
            have h := hminA (↑K' : NonemptyCompacts X)
            rwa [extendTop_coe] at h
          exact le_iSup_of_le q (le_iSup_of_le u (le_iSup_of_le hu
            (le_iSup_of_le hq (le_iSup_of_le hminR le_rfl))))

end RestrictedGeneration

/-! ## The radial instantiation -/

section RadialGeneration

variable {V : Type*} [Fintype V]

/-- **Transposed generation on the radial locus.**  Every Vietoris-lsc
functional on the system space `RadialCompacts V` is a countable sup
of finite mins of restricted graded atoms: the radial locus is closed
in the hyperspace (`isClosed_setOf_isRadial`), so the top-off
extension applies and the ambient rows restrict. -/
theorem iSup_hyperRows_radial_eq_self
    {Ψ : RadialCompacts V → ℝ≥0∞} (hΨ : LowerSemicontinuous Ψ) :
    ∃ B : Set (Set (BelState V)), B.Countable ∧ (∀ U ∈ B, IsOpen U)
      ∧ (⨆ (q : ℚ) (u : Finset (Set (BelState V))) (_ : ↑u ⊆ B) (_ : 0 < q)
          (_ : ∀ K : RadialCompacts V,
            hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u ↑K ≤ Ψ K),
          fun K : RadialCompacts V =>
            hyperRow (ENNReal.ofReal q) (⋃₀ ↑u) u ↑K) = Ψ :=
  iSup_hyperRows_restrict_eq_self isClosed_setOf_isRadial hΨ

end RadialGeneration

end SuFunctor.Universe
