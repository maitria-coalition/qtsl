import Mathlib.Topology.Sets.VietorisTopology
import Mathlib.Topology.Compactness.LocallyCompact

/-! # The Fell topology: hyperspace vocabulary at the noncompact stratum

The record layer's graph face lives on closed subsets of a stage
space.  On a compact ambient the Vietoris topology serves (and the
library provides it); on a noncompact ambient — unbounded horizons,
noncompact state — the correct hyperspace topology is the **Fell
topology**: hit classes over open sets together with miss classes over
**compact** sets (equivalently, powersets of complements of compacts).
Trading the Vietoris upper face (miss classes over all closed sets)
for the compactly-indexed one is what buys the two structural theorems
of this module:

* **the hyperspace of closed sets is compact over every ambient
  space** (`FellCloseds.compactSpace`, by Alexander's subbasis
  theorem), and
* **Hausdorff as soon as the ambient is locally compact**
  (`FellCloseds.t2Space`) — with no separation hypothesis on the
  ambient at all.

The citizen-class vocabulary survives the loss of ambient compactness
with its polarities intact:

* hit classes of open sets are open
  (`FellCloseds.isOpen_inter_nonempty_of_isOpen`),
* miss classes of compact sets are open
  (`FellCloseds.isOpen_disjoint_of_isCompact`),
* safety classes `{F | ↑F ⊆ A}` of closed sets are closed
  (`FellCloseds.isClosed_subsets_of_isClosed`),
* hit classes of compact sets are closed
  (`FellCloseds.isClosed_inter_nonempty_of_isCompact`).

What does *not* survive is quantified exactly by the escape specimen:
the singleton of the empty set is always closed
(`FellCloseds.isClosed_singleton_bot`) but is open **iff the ambient
is compact** (`FellCloseds.isOpen_singleton_bot_iff_compactSpace`).
On a noncompact ambient a family of closed sets can drain off every
compact set and converge to the empty set, so `∅` is a genuine
boundary citizen of the noncompact hyperspace, never an isolated
point — while its Vietoris counterpart is clopen unconditionally.
This is why miss classes of *closed noncompact* sets are not open
here: avoiding a set that stretches to infinity is not finitely
refutable.

On a compact Hausdorff ambient the layer collapses: Fell and Vietoris
agree on the powerset (`fell_eq_vietoris`; the inclusion
`vietoris_le_fell` needs only Hausdorffness), so the compact-stratum
hyperspace development is the compact case of this one.

Every statement here is stratum-general: the ambient is an arbitrary
topological space unless a theorem names local compactness (the
Hausdorff theorem), Hausdorffness (the collapse), or T1 (the escape
specimen's forward direction).
-/

namespace SuFunctor.Universe

open Set Topology TopologicalSpace

variable {α : Type*} [TopologicalSpace α]

variable (α) in
/-- The Fell topology on the powerset of a topological space,
generated by the hit classes `{s | (s ∩ U).Nonempty}` of open sets `U`
and the miss classes `{s | Disjoint s K}` of **compact** sets `K`.
Restricted to closed sets (`FellCloseds`) this is the classical Fell
hyperspace topology. -/
@[reducible]
protected def fell : TopologicalSpace (Set α) :=
  .generateFrom <|
    (fun K => {s : Set α | Disjoint s K}) '' {K | IsCompact K}
      ∪ (fun V => {s : Set α | (s ∩ V).Nonempty}) '' {V | IsOpen V}

attribute [local instance] SuFunctor.Universe.fell

namespace fell

/-- Miss classes of compact sets are Fell-open: the upper subbasis. -/
theorem isOpen_disjoint_of_isCompact {K : Set α} (hK : IsCompact K) :
    IsOpen {s : Set α | Disjoint s K} :=
  isOpen_generateFrom_of_mem <| .inl ⟨K, hK, rfl⟩

/-- Hit classes of open sets are Fell-open: the lower subbasis, shared
with the Vietoris topology. -/
theorem isOpen_inter_nonempty_of_isOpen {U : Set α} (hU : IsOpen U) :
    IsOpen {s : Set α | (s ∩ U).Nonempty} :=
  isOpen_generateFrom_of_mem <| .inr ⟨U, hU, rfl⟩

/-- Hit classes of compact sets are Fell-closed (complements of the
upper subbasis). -/
theorem isClosed_inter_nonempty_of_isCompact {K : Set α} (hK : IsCompact K) :
    IsClosed {s : Set α | (s ∩ K).Nonempty} := by
  rw [← isOpen_compl_iff]
  convert isOpen_disjoint_of_isCompact hK using 1
  ext s
  simp [Set.not_nonempty_iff_eq_empty, Set.disjoint_iff_inter_eq_empty]

/-- Safety classes of closed sets are Fell-closed: a violation is a
hit of the open complement.  No compactness enters — this citizen
class survives every stratum. -/
theorem isClosed_subsets_of_isClosed {A : Set α} (hA : IsClosed A) :
    IsClosed {s : Set α | s ⊆ A} := by
  rw [← isOpen_compl_iff]
  convert isOpen_inter_nonempty_of_isOpen hA.isOpen_compl using 1
  ext s
  simp [Set.inter_compl_nonempty_iff]

omit [TopologicalSpace α] in
/-- A miss class is the powerset of the complement: the Fell subbasis
in its compact-subsets-plus-open-complements presentation. -/
theorem disjoint_eq_powerset_compl (K : Set α) :
    {s : Set α | Disjoint s K} = (Kᶜ).powerset := by
  ext s
  simp [Set.mem_powerset_iff, Set.subset_compl_iff_disjoint_right]

/-- **Alexander compactness of the Fell hyperspace**: the family of
closed subsets of ANY ambient space is Fell-compact.  Given a subbasic
open cover, the closed complement of all the hit opens must itself be
covered — necessarily by a miss class, whose compact index `K` is then
covered by the hit opens; finitely many of those hits, together with
that one miss, already cover every closed set (one missing `K` is in
the miss class; one meeting `K` meets one of the finitely many opens
covering `K`). -/
theorem isCompact_setOf_isClosed : IsCompact {s : Set α | IsClosed s} := by
  classical
  refine isCompact_generateFrom rfl fun P hP hcover => ?_
  set 𝒰 : Set (Set α) := {V | IsOpen V ∧ {s : Set α | (s ∩ V).Nonempty} ∈ P} with h𝒰
  have hA : IsClosed (⋃₀ 𝒰)ᶜ := (isOpen_sUnion fun V hV => hV.1).isClosed_compl
  obtain ⟨t, htP, hAt⟩ := mem_sUnion.mp (hcover hA)
  rcases hP htP with ⟨K, hK, rfl⟩ | ⟨V, hV, rfl⟩
  · -- the complement of the hit opens misses `K`, so `K ⊆ ⋃₀ 𝒰`
    have hKsub : K ⊆ ⋃₀ 𝒰 := fun x hxK => by
      by_contra hx
      exact Set.disjoint_left.mp hAt hx hxK
    rw [sUnion_eq_biUnion] at hKsub
    obtain ⟨𝒱, h𝒱sub, h𝒱fin, hK𝒱⟩ :=
      hK.elim_finite_subcover_image (fun V hV => hV.1) hKsub
    refine ⟨insert {s : Set α | Disjoint s K}
        ((fun V => {s : Set α | (s ∩ V).Nonempty}) '' 𝒱), ?_, ?_, ?_⟩
    · exact insert_subset_iff.mpr
        ⟨htP, image_subset_iff.mpr fun V hV => (h𝒱sub hV).2⟩
    · exact (h𝒱fin.image _).insert _
    · intro F _
      by_cases hFK : Disjoint F K
      · exact mem_sUnion_of_mem hFK (mem_insert _ _)
      · rw [Set.not_disjoint_iff] at hFK
        obtain ⟨x, hxF, hxK⟩ := hFK
        obtain ⟨V, hV𝒱, hxV⟩ := mem_iUnion₂.mp (hK𝒱 hxK)
        have hFV : F ∈ {s : Set α | (s ∩ V).Nonempty} := ⟨x, hxF, hxV⟩
        exact mem_sUnion_of_mem hFV
          (mem_insert_of_mem _ (mem_image_of_mem _ hV𝒱))
  · -- the complement of the hit opens cannot itself hit one of them
    exfalso
    obtain ⟨x, hxA, hxV⟩ := hAt
    have hV𝒰 : V ∈ 𝒰 := by rw [h𝒰]; exact ⟨hV, htP⟩
    exact hxA (mem_sUnion_of_mem hxV hV𝒰)

end fell

/-- On a Hausdorff ambient the Vietoris topology refines the Fell
topology: every compact miss class is the powerset of an open
complement.  This is the general (noncompact) half of the collapse
dictionary. -/
theorem vietoris_le_fell [T2Space α] :
    TopologicalSpace.vietoris α ≤ SuFunctor.Universe.fell α := by
  rw [SuFunctor.Universe.fell, le_generateFrom_iff_subset_isOpen]
  rintro _ (⟨K, hK, rfl⟩ | ⟨U, hU, rfl⟩)
  · show IsOpen[TopologicalSpace.vietoris α] {s : Set α | Disjoint s K}
    rw [fell.disjoint_eq_powerset_compl]
    exact hK.isClosed.isOpen_compl.powerset_vietoris
  · show IsOpen[TopologicalSpace.vietoris α] {s : Set α | (s ∩ U).Nonempty}
    exact vietoris.isOpen_inter_nonempty_of_isOpen hU

/-- **The compact collapse**: on a compact Hausdorff ambient the Fell
and Vietoris topologies on the powerset coincide — closed and compact
sets are the same objects there, so the two upper faces have the same
index class.  The compact-stratum hyperspace development is the
compact case of the Fell one. -/
theorem fell_eq_vietoris [CompactSpace α] [T2Space α] :
    SuFunctor.Universe.fell α = TopologicalSpace.vietoris α := by
  refine le_antisymm ?_ vietoris_le_fell
  rw [TopologicalSpace.vietoris, le_generateFrom_iff_subset_isOpen]
  rintro _ (⟨U, hU, rfl⟩ | ⟨U, hU, rfl⟩)
  · show IsOpen[SuFunctor.Universe.fell α] U.powerset
    have h : U.powerset = {s : Set α | Disjoint s Uᶜ} := by
      rw [fell.disjoint_eq_powerset_compl, compl_compl]
    rw [h]
    exact fell.isOpen_disjoint_of_isCompact hU.isClosed_compl.isCompact
  · show IsOpen[SuFunctor.Universe.fell α] {s : Set α | (s ∩ U).Nonempty}
    exact fell.isOpen_inter_nonempty_of_isOpen hU

variable (α) in
/-- The closed subsets of a topological space, as a carrier for the
Fell topology.  A separate structure from `TopologicalSpace.Closeds`,
deliberately: the library equips `Closeds` with the Hausdorff (e)metric
on (e)metric ambients, and an unconditional hyperspace topology
instance there would compete with it.  Includes the empty set — at the
noncompact stratum the empty set is the escape limit and belongs in
the carrier. -/
structure FellCloseds where
  /-- the underlying closed set -/
  carrier : Set α
  /-- the carrier is closed -/
  isClosed' : IsClosed carrier

namespace FellCloseds

instance : SetLike (FellCloseds α) α where
  coe := carrier
  coe_injective F G h := by cases F; cases G; congr

protected theorem isClosed (F : FellCloseds α) : IsClosed (F : Set α) :=
  F.isClosed'

@[ext]
protected theorem ext {F G : FellCloseds α} (h : (F : Set α) = G) : F = G :=
  SetLike.coe_injective h

instance : Bot (FellCloseds α) := ⟨⟨∅, isClosed_empty⟩⟩

@[simp]
theorem coe_bot : ((⊥ : FellCloseds α) : Set α) = ∅ := rfl

@[simp]
theorem coe_mk (s : Set α) (h : IsClosed s) :
    ((⟨s, h⟩ : FellCloseds α) : Set α) = s := rfl

/-- The Fell topology on the closed sets, as the subspace topology of
the powerset Fell topology. -/
instance topology : TopologicalSpace (FellCloseds α) :=
  .induced (↑) (SuFunctor.Universe.fell α)

theorem isEmbedding_coe : IsEmbedding ((↑) : FellCloseds α → Set α) where
  injective := SetLike.coe_injective
  eq_induced := rfl

theorem continuous_coe : Continuous ((↑) : FellCloseds α → Set α) :=
  isEmbedding_coe.continuous

/-- Hit classes of open sets are open on the closed-set carrier. -/
theorem isOpen_inter_nonempty_of_isOpen {U : Set α} (hU : IsOpen U) :
    IsOpen {F : FellCloseds α | ((F : Set α) ∩ U).Nonempty} :=
  continuous_coe.isOpen_preimage _ <| fell.isOpen_inter_nonempty_of_isOpen hU

/-- Miss classes of compact sets are open on the closed-set carrier. -/
theorem isOpen_disjoint_of_isCompact {K : Set α} (hK : IsCompact K) :
    IsOpen {F : FellCloseds α | Disjoint (F : Set α) K} :=
  continuous_coe.isOpen_preimage _ <| fell.isOpen_disjoint_of_isCompact hK

/-- Hit classes of compact sets are closed on the closed-set
carrier. -/
theorem isClosed_inter_nonempty_of_isCompact {K : Set α} (hK : IsCompact K) :
    IsClosed {F : FellCloseds α | ((F : Set α) ∩ K).Nonempty} :=
  (fell.isClosed_inter_nonempty_of_isCompact hK).preimage continuous_coe

/-- Safety classes of closed sets are closed on the closed-set
carrier, at every stratum. -/
theorem isClosed_subsets_of_isClosed {A : Set α} (hA : IsClosed A) :
    IsClosed {F : FellCloseds α | (F : Set α) ⊆ A} :=
  (fell.isClosed_subsets_of_isClosed hA).preimage continuous_coe

/-- **The Fell hyperspace of closed sets is compact for every ambient
space** — no hypotheses at all.  Local compactness of the ambient is
where the hyperspace becomes Hausdorff (`t2Space`), not where it
becomes compact. -/
instance compactSpace : CompactSpace (FellCloseds α) := by
  refine ⟨?_⟩
  have himg : ((↑) : FellCloseds α → Set α) '' univ = {s : Set α | IsClosed s} := by
    ext s
    constructor
    · rintro ⟨F, -, rfl⟩
      exact F.isClosed
    · intro hs
      exact ⟨⟨s, hs⟩, mem_univ _, rfl⟩
  refine isEmbedding_coe.isInducing.isCompact_iff.mpr ?_
  rw [himg]
  exact fell.isCompact_setOf_isClosed

/-- Separation of two closed sets, one containing a point the other
misses: a compact interpolant between the point and the second set's
complement yields a hit class through its interior and a miss class
over it. -/
theorem exists_separating_of_mem_diff [LocallyCompactSpace α]
    {F G : FellCloseds α} {x : α} (hxF : x ∈ (F : Set α)) (hxG : x ∉ (G : Set α)) :
    ∃ u v : Set (FellCloseds α),
      IsOpen u ∧ IsOpen v ∧ F ∈ u ∧ G ∈ v ∧ Disjoint u v := by
  obtain ⟨L, hLcomp, hxL, hLG⟩ :=
    exists_compact_between isCompact_singleton G.isClosed.isOpen_compl
      (singleton_subset_iff.mpr hxG)
  refine ⟨{H : FellCloseds α | ((H : Set α) ∩ interior L).Nonempty},
    {H : FellCloseds α | Disjoint (H : Set α) L},
    isOpen_inter_nonempty_of_isOpen isOpen_interior,
    isOpen_disjoint_of_isCompact hLcomp,
    ⟨x, hxF, singleton_subset_iff.mp hxL⟩,
    Set.disjoint_left.mpr fun a haG haL => hLG haL haG, ?_⟩
  rw [Set.disjoint_left]
  rintro H ⟨a, haH, haInt⟩ hHmiss
  exact Set.disjoint_left.mp hHmiss haH (interior_subset haInt)

/-- **The Fell hyperspace of a locally compact space is Hausdorff** —
with no separation hypothesis on the ambient.  This is where the Fell
topology earns its keep: on a locally compact ambient the (always
compact) hyperspace is compact Hausdorff. -/
instance t2Space [LocallyCompactSpace α] : T2Space (FellCloseds α) := by
  constructor
  intro F G hFG
  have hne : ¬((F : Set α) ⊆ (G : Set α) ∧ (G : Set α) ⊆ (F : Set α)) :=
    fun ⟨h1, h2⟩ => hFG (FellCloseds.ext (subset_antisymm h1 h2))
  rcases not_and_or.mp hne with h | h
  · obtain ⟨x, hxF, hxG⟩ := not_subset.mp h
    exact exists_separating_of_mem_diff hxF hxG
  · obtain ⟨x, hxG, hxF⟩ := not_subset.mp h
    obtain ⟨u, v, hu, hv, hGu, hFv, huv⟩ := exists_separating_of_mem_diff hxG hxF
    exact ⟨v, u, hv, hu, hFv, hGu, huv.symm⟩

/-- The empty set is always a closed point of the Fell hyperspace: its
complement is the hit class of the whole space. -/
theorem isClosed_singleton_bot : IsClosed {(⊥ : FellCloseds α)} := by
  rw [← isOpen_compl_iff]
  have heq : ({(⊥ : FellCloseds α)}ᶜ : Set (FellCloseds α))
      = {F : FellCloseds α | ((F : Set α) ∩ univ).Nonempty} := by
    ext F
    simp only [mem_compl_iff, mem_singleton_iff, mem_setOf_eq, inter_univ,
      nonempty_iff_ne_empty]
    constructor
    · intro h hFe
      exact h (FellCloseds.ext (by rw [coe_bot]; exact hFe))
    · intro h hF
      exact h (by rw [hF, coe_bot])
  rw [heq]
  exact isOpen_inter_nonempty_of_isOpen isOpen_univ

/-- **The escape specimen**: the empty set is an *isolated* point of
the Fell hyperspace iff the ambient is compact.  On a noncompact T1
ambient, every neighborhood of `∅` is a finite conjunction of compact
miss demands, and a point outside their union yields a nonempty closed
set inside the neighborhood — closed sets can drain off every compact
and converge to `∅`.  (The Vietoris counterpart `{∅}` is clopen
unconditionally; this divergence is the whole content of trading miss
faces.) -/
theorem isOpen_singleton_bot_iff_compactSpace [T1Space α] :
    IsOpen {(⊥ : FellCloseds α)} ↔ CompactSpace α := by
  classical
  constructor
  · intro h
    have hbasis :=
      (TopologicalSpace.isTopologicalBasis_of_subbasis
        (rfl : SuFunctor.Universe.fell α = _)).isInducing isEmbedding_coe.isInducing
    obtain ⟨b, hb, hbot, hsub⟩ := hbasis.exists_subset_of_mem_open (mem_singleton _) h
    obtain ⟨t, ⟨f, ⟨hffin, hfsub⟩, rfl⟩, rfl⟩ := hb
    have hbot' : (∅ : Set α) ∈ ⋂₀ f := by simpa using hbot
    have hmiss : ∀ t ∈ f, ∃ K, IsCompact K ∧ t = {s : Set α | Disjoint s K} := by
      intro t htf
      rcases hfsub htf with ⟨K, hK, rfl⟩ | ⟨V, hV, rfl⟩
      · exact ⟨K, hK, rfl⟩
      · exact absurd (mem_sInter.mp hbot' _ htf) (by simp)
    choose K hKcomp hKeq using hmiss
    haveI : Finite (↥f) := hffin.to_subtype
    have hK₀comp : IsCompact (⋃ t : ↥f, K t t.2) :=
      isCompact_iUnion fun t => hKcomp t t.2
    suffices hK₀univ : (univ : Set α) ⊆ ⋃ t : ↥f, K t t.2 by
      exact ⟨univ_subset_iff.mp hK₀univ ▸ hK₀comp⟩
    intro x _
    by_contra hx
    have hmem : (⟨{x}, isClosed_singleton⟩ : FellCloseds α) ∈ (↑) ⁻¹' ⋂₀ f := by
      simp only [mem_preimage, mem_sInter, coe_mk]
      intro t htf
      rw [hKeq t htf]
      refine Set.disjoint_left.mpr ?_
      intro a ha haK
      rw [mem_singleton_iff] at ha
      subst ha
      exact hx (mem_iUnion.mpr ⟨⟨t, htf⟩, haK⟩)
    have hcontra : ({x} : Set α) = ∅ := by
      have h' := congrArg (fun F : FellCloseds α => (F : Set α))
        (mem_singleton_iff.mp (hsub hmem))
      simp only [coe_mk, coe_bot] at h'
      exact h'
    exact singleton_ne_empty x hcontra
  · intro h
    haveI := h
    have heq : {(⊥ : FellCloseds α)}
        = {F : FellCloseds α | Disjoint (F : Set α) univ} := by
      ext F
      simp only [mem_singleton_iff, mem_setOf_eq,
        Set.disjoint_iff_inter_eq_empty, inter_univ]
      constructor
      · intro h'
        rw [h', coe_bot]
      · intro h'
        exact FellCloseds.ext (by rw [h', coe_bot])
    rw [heq]
    exact isOpen_disjoint_of_isCompact isCompact_univ

end FellCloseds

end SuFunctor.Universe
