import SuFunctor.Universe.VietorisStratum
import SuFunctor.Universe.IdealPoint

/-! # The locally-closed citizen layer

The spec stratum of the coupled judgment, packaged as a layer of the
construction in its own right.  Its citizens are the **locally closed**
classes of the hyperspace — one closed containment face, finitely many
open escape faces (`crescentClass`) — and its disjunctions are the
**constructible** classes (finite unions of locally closed sets,
`dnfClass` / `IsConstructibleUnion`).  The layer's entailment is
decided by a finite family of pointwise domination rows: the
**blocking criterion** (`coupled_union_refinement_iff`), which
settles the completeness question that per-disjunct matching
(`coupled_refinement_iff`) and diamond splitting (`diamond_splitting`)
left open.

Headline facts, each with its proof or an exact witness below:

* **The blocking criterion.**  For a premise atom against a finite
  disjunction of conclusion atoms, model-class inclusion holds iff
  every *selection* — a choice, per conclusion disjunct, of either its
  safety floor or one of its liveness demands — is *blocked*: some
  member of the premise's demand family, or some unselected conclusion
  floor, sits below the join of the premise floor with the selected
  demands.  Each block is one pointwise domination row against a
  finite join; the criterion needs **no satisfiability hypothesis**
  (an inconsistent premise is blocked through its own liveness slot —
  ex falso at the entailment level is derived, not postulated).
* **Matching and splitting are its two extremal faces, and are not
  complete.**  The compiled refinement order and diamond splitting
  are the selections with, respectively, everything selected at one
  matched disjunct, and shared floors.  They are jointly incomplete:
  `exists_essential_floor_raise` exhibits a valid union-refinement
  whose conclusion carries a safety floor *not below* the premise
  floor (matching only lowers floors; splitting preserves them), with
  neither conclusion disjunct alone containing the premise class.
* **Floor-relative normalization** (`coupledSat_image_sup_floor_iff`):
  joining the safety floor into every liveness demand changes no
  verdict — the re-presentation that makes demand-covering
  componentwise is canonical and internal.  The floor-free covering is
  incomplete (`exists_naive_cover_incomplete`): the `u ⊔ v'`-coupling
  of the compiled order is load-bearing.
* **The constructible stratum.**  Classes of coupled DNFs are finite
  unions of crescents (`dnfClass`), hence constructible in the
  classical finitary sense (`IsConstructibleUnion`).  Mathlib's
  `IsConstructible` is deliberately *not* used: it is the
  spectral-space notion (the Boolean subalgebra generated by open
  retrocompact sets), and on a connected compact Hausdorff space —
  the hyperspace of the compact connected carrier is one — the only
  open retrocompact sets are `∅` and the whole space, so that notion
  degenerates; the finitary notion is the one the spec algebra
  generates.  Atom conjunction is exact at the class level
  (`crescentClass_inter_crescentClass`), so the constructible layer is
  closed under both connectives.
* **Systems are the ideal points of the layer**
  (`crescentClass_dipTheory_inter_radial`): among radial bodies, the
  infinitary crescent of the atom `(σ, all citizens σ dips under)` is
  exactly the singleton `{compileNC σ}` — the crescent presentation of
  a system, as a class identity.  Finitely many crescents never pin a
  system (`singletons_not_definable`); the full dip-theory crescent
  pins it exactly.
* **The bottom body satisfies nothing**
  (`compileNC_top_notMem_crescentClass`): the compile of the
  everywhere-`⊤` penalty is the single point `{0}`, which contains
  nothing that could escape any body — ex falso inversion in
  hyperspace form.
-/

namespace SuFunctor.Universe

open scoped ENNReal
open TopologicalSpace

/-! ## The blocking criterion

Pure order theory, on an arbitrary carrier: no topology enters.  A
*selection* against a finite family of conclusion atoms picks, for
each disjunct, either `none` — avoid it at its safety floor — or one
of its liveness demands — avoid it by dominating that demand.  The
*canonical adversary* of a selection is the least system honoring the
premise floor and every selected demand; the criterion says the
inclusion holds iff every selection's adversary is already refuted by
one pointwise domination row. -/

section Blocking

variable {K : Type*} {m : ℕ}

/-- A selection against the conclusion family `𝒱'`: for each disjunct,
`none` (avoid at the floor) or one of its liveness demands (avoid by
domination). -/
def SelValid (𝒱' : Fin m → Set (K → ℝ≥0∞))
    (c : Fin m → Option (K → ℝ≥0∞)) : Prop :=
  ∀ j w, c j = some w → w ∈ 𝒱' j

/-- The canonical adversary of a selection: the premise floor joined
with every selected demand — the least system that honors the floor
and dominates the selections. -/
noncomputable def selSup (u : K → ℝ≥0∞) (c : Fin m → Option (K → ℝ≥0∞)) : K → ℝ≥0∞ :=
  u ⊔ ⨆ j, (c j).getD 0

theorem le_selSup_left {u : K → ℝ≥0∞} {c : Fin m → Option (K → ℝ≥0∞)} :
    u ≤ selSup u c :=
  le_sup_left

theorem le_selSup_of_eq_some {u : K → ℝ≥0∞} {c : Fin m → Option (K → ℝ≥0∞)}
    {j : Fin m} {w : K → ℝ≥0∞} (h : c j = some w) : w ≤ selSup u c := by
  have h1 : w ≤ (c j).getD 0 := by simp [h]
  exact h1.trans ((le_iSup (fun j' => (c j').getD 0) j).trans le_sup_right)

theorem selSup_le {u σ : K → ℝ≥0∞} {c : Fin m → Option (K → ℝ≥0∞)}
    (hu : u ≤ σ) (hc : ∀ j w, c j = some w → w ≤ σ) : selSup u c ≤ σ := by
  refine sup_le hu (iSup_le fun j => ?_)
  rcases hj : c j with _ | w
  · simp
  · simpa using hc j w hj

/-- A selection is **blocked** when some demanded dip is already
refuted against its canonical adversary: a premise demand, or the
floor of an unselected conclusion disjunct, sits below `selSup u c` —
one pointwise domination row against a finite join. -/
def Blocked (u : K → ℝ≥0∞) (𝒱 : Set (K → ℝ≥0∞)) (u' : Fin m → K → ℝ≥0∞)
    (c : Fin m → Option (K → ℝ≥0∞)) : Prop :=
  (∃ v ∈ 𝒱, v ≤ selSup u c) ∨ ∃ j, c j = none ∧ u' j ≤ selSup u c

/-- **The blocking criterion**: over any class `P` containing the
canonical adversaries, the model class of a premise atom is contained
in the union of the model classes of finitely many conclusion atoms
iff every valid selection is blocked.

Both halves of the coupled judgment enter as domination rows: the
criterion is complete for union-refinement, and it consumes no
satisfiability hypothesis — an inconsistent premise (some demand at or
below its floor) blocks every selection through its own liveness
slot, so ex falso at the entailment level is a theorem of the
criterion, not a convention. -/
theorem coupled_union_refinement_iff {P : (K → ℝ≥0∞) → Prop} {u : K → ℝ≥0∞}
    {𝒱 : Set (K → ℝ≥0∞)} {u' : Fin m → K → ℝ≥0∞}
    {𝒱' : Fin m → Set (K → ℝ≥0∞)}
    (hPc : ∀ c, SelValid 𝒱' c → P (selSup u c)) :
    (∀ σ, P σ → CoupledSat σ u 𝒱 → ∃ j, CoupledSat σ (u' j) (𝒱' j))
      ↔ ∀ c, SelValid 𝒱' c → Blocked u 𝒱 u' c := by
  constructor
  · -- completeness: an unblocked selection's adversary is a
    -- counterexample, so inclusion forces blocking.
    intro h c hc
    by_cases hdip : ∀ v ∈ 𝒱, Dip (selSup u c) v
    · obtain ⟨j, hj⟩ := h _ (hPc c hc) ⟨le_selSup_left, hdip⟩
      rcases hcj : c j with _ | w
      · exact Or.inr ⟨j, hcj, hj.1⟩
      · obtain ⟨μ, hμ⟩ := hj.2 w (hc j w hcj)
        exact absurd hμ (not_lt.mpr (le_selSup_of_eq_some hcj μ))
    · push Not at hdip
      obtain ⟨v, hv, hnd⟩ := hdip
      exact Or.inl ⟨v, hv, not_dip_iff_le.mp hnd⟩
  · -- soundness: a model avoiding every disjunct induces a selection
    -- whose adversary it dominates; the block refutes one of the
    -- model's own dips.
    intro h σ _ hsat
    by_contra hno
    push Not at hno
    classical
    obtain ⟨c, hcs, hcn⟩ : ∃ c : Fin m → Option (K → ℝ≥0∞),
        (∀ j w, c j = some w → w ∈ 𝒱' j ∧ w ≤ σ)
          ∧ ∀ j, c j = none → ¬ ∃ w ∈ 𝒱' j, w ≤ σ := by
      refine ⟨fun j => if h' : ∃ w ∈ 𝒱' j, w ≤ σ then some h'.choose else none,
        fun j w hjw => ?_, fun j hj h' => ?_⟩
      · dsimp only at hjw
        by_cases h' : ∃ w ∈ 𝒱' j, w ≤ σ
        · rw [dif_pos h'] at hjw
          exact Option.some_inj.mp hjw ▸ h'.choose_spec
        · rw [dif_neg h'] at hjw
          exact absurd hjw (by simp)
      · dsimp only at hj
        rw [dif_pos h'] at hj
        exact absurd hj (by simp)
    have hsel : SelValid 𝒱' c := fun j w hjw => (hcs j w hjw).1
    have hcle : selSup u c ≤ σ := selSup_le hsat.1 fun j w hjw => (hcs j w hjw).2
    rcases h c hsel with ⟨v, hv, hvle⟩ | ⟨j, hjnone, hule⟩
    · obtain ⟨μ, hμ⟩ := hsat.2 v hv
      exact absurd hμ (not_lt.mpr ((hvle.trans hcle) μ))
    · exact hno j ⟨hule.trans hcle,
        fun w hw => dip_iff_not_le.mpr fun hle => hcn j hjnone ⟨w, hw, hle⟩⟩

end Blocking

/-! ## Floor-relative normalization, and the incompleteness of the
floor-free covering -/

section FloorRelative

variable {K : Type*}

/-- Against a system honoring the floor, dips under a floor-joined mark
are dips under the mark: the floor-relative normalization of a
liveness demand is invisible to the judgment. -/
theorem dip_sup_floor_iff {σ u v : K → ℝ≥0∞} (hsafe : u ≤ σ) :
    Dip σ (u ⊔ v) ↔ Dip σ v := by
  constructor
  · rintro ⟨μ, hμ⟩
    rw [Pi.sup_apply, lt_sup_iff] at hμ
    rcases hμ with h | h
    · exact absurd h (not_lt.mpr (hsafe μ))
    · exact ⟨μ, h⟩
  · exact fun h => h.mono_mark le_sup_right

/-- **Floor-relative normalization**: joining the safety floor into
every liveness demand changes no verdict.  Every atom has a normal
form whose demands all sit at or above its floor, and the compiled
order's demand-covering is plain componentwise against normalized
demands — the re-presentation is canonical and internal. -/
theorem coupledSat_image_sup_floor_iff {σ u : K → ℝ≥0∞}
    {𝒱 : Set (K → ℝ≥0∞)} :
    CoupledSat σ u ((u ⊔ ·) '' 𝒱) ↔ CoupledSat σ u 𝒱 := by
  constructor
  · rintro ⟨hsafe, hlive⟩
    exact ⟨hsafe, fun v hv =>
      (dip_sup_floor_iff hsafe).mp (hlive _ ⟨v, hv, rfl⟩)⟩
  · rintro ⟨hsafe, hlive⟩
    refine ⟨hsafe, ?_⟩
    rintro w ⟨v, hv, rfl⟩
    exact (dip_sup_floor_iff hsafe).mpr (hlive v hv)

end FloorRelative

variable {V : Type*} [Fintype V]

/-- **The floor-free covering is incomplete**: an atom and its
floor-relative normalization have identical verdicts against every
system, while the normalized demand `u ⊔ v` does not sit below `v`.
Componentwise slot comparison misses entailments that the compiled
order's `u ⊔ v'`-coupling sees — the coupling is load-bearing.
Exact witness: two walls on the two-outcome flat carrier. -/
theorem exists_naive_cover_incomplete :
    ∃ u v : ProbPenalty (Fin 2),
      LowerSemicontinuous u ∧ LowerSemicontinuous v
        ∧ (∀ σ, CoupledSat σ u {u ⊔ v} ↔ CoupledSat σ u {v})
        ∧ ¬ u ⊔ v ≤ v := by
  classical
  refine ⟨probWall {μ : ProbState (Fin 2) | (1:ℝ)/2 < (μ : Fin 2 → ℝ) 0}ᶜ,
    probWall {μ : ProbState (Fin 2) | (μ : Fin 2 → ℝ) 0 < 1/2}ᶜ, ?_, ?_, ?_, ?_⟩
  · exact lowerSemicontinuous_probWall_iff.mpr
      (isOpen_lt continuous_const
        ((continuous_apply 0).comp continuous_subtype_val)).isClosed_compl
  · exact lowerSemicontinuous_probWall_iff.mpr
      (isOpen_lt ((continuous_apply 0).comp continuous_subtype_val)
        continuous_const).isClosed_compl
  · intro σ
    constructor
    · rintro ⟨hsafe, hlive⟩
      refine ⟨hsafe, ?_⟩
      rintro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      exact (dip_sup_floor_iff hsafe).mp (hlive _ (Set.mem_singleton _))
    · rintro ⟨hsafe, hlive⟩
      refine ⟨hsafe, ?_⟩
      rintro w hw
      rw [Set.mem_singleton_iff] at hw
      subst hw
      exact (dip_sup_floor_iff hsafe).mpr (hlive _ (Set.mem_singleton _))
  · intro hle
    have h0 := hle (ProbState.dirac 0)
    have hu : probWall {μ : ProbState (Fin 2) |
        (1:ℝ)/2 < (μ : Fin 2 → ℝ) 0}ᶜ (ProbState.dirac 0) = ⊤ := by
      refine probWall_apply_of_not_mem ?_
      rw [Set.mem_compl_iff, not_not, Set.mem_setOf_eq,
        ProbState.dirac_apply_same]
      norm_num
    have hv : probWall {μ : ProbState (Fin 2) |
        (μ : Fin 2 → ℝ) 0 < 1/2}ᶜ (ProbState.dirac 0) = 0 := by
      refine probWall_apply_of_mem ?_
      rw [Set.mem_compl_iff, Set.mem_setOf_eq, ProbState.dirac_apply_same]
      norm_num
    rw [Pi.sup_apply, hu, hv, top_sup_eq, top_le_iff] at h0
    exact ENNReal.zero_ne_top h0

/-- **Floor-raising is essential**: a valid union-refinement whose
conclusion carries a disjunct with a safety floor *not below* the
premise floor, and with neither conclusion disjunct alone containing
the premise class.  Per-disjunct matching can only lower floors along
a derivation and shared-floor diamond splitting preserves them, so no
composition of the two rules reaches this conclusion; the blocking
criterion certifies it (the selection avoiding the raised-floor
disjunct is blocked by that very floor sitting below the join of the
premise floor with the other disjunct's demand).

Data: on the two-outcome flat carrier, premise `(0, {⊤})` (bare
properness); conclusion `(wall past 3/4, {⊤}) ∨ (0, {wall past 1/2})`
— either the system walls the region past `1/2` off entirely (and then
already satisfies the *stronger* floor walling past `3/4`), or it
realizes some distribution past `1/2` at finite penalty. -/
theorem exists_essential_floor_raise :
    ∃ u₁ w : ProbPenalty (Fin 2),
      LowerSemicontinuous u₁ ∧ LowerSemicontinuous w
        ∧ (∀ σ : ProbPenalty (Fin 2), CoupledSat σ 0 {(⊤ : ProbPenalty (Fin 2))} →
            CoupledSat σ u₁ {(⊤ : ProbPenalty (Fin 2))} ∨ CoupledSat σ 0 {w})
        ∧ ¬ (∀ σ : ProbPenalty (Fin 2), LowerSemicontinuous σ →
              CoupledSat σ 0 {(⊤ : ProbPenalty (Fin 2))} →
              CoupledSat σ u₁ {(⊤ : ProbPenalty (Fin 2))})
        ∧ ¬ (∀ σ : ProbPenalty (Fin 2), LowerSemicontinuous σ →
              CoupledSat σ 0 {(⊤ : ProbPenalty (Fin 2))} →
              CoupledSat σ 0 {w})
        ∧ ¬ u₁ ≤ (0 : ProbPenalty (Fin 2)) := by
  classical
  set U : Set (ProbState (Fin 2)) := {μ | (3:ℝ)/4 < (μ : Fin 2 → ℝ) 0} with hUdef
  set W : Set (ProbState (Fin 2)) := {μ | (1:ℝ)/2 < (μ : Fin 2 → ℝ) 0} with hWdef
  have hUopen : IsOpen U :=
    isOpen_lt continuous_const ((continuous_apply 0).comp continuous_subtype_val)
  have hWopen : IsOpen W :=
    isOpen_lt continuous_const ((continuous_apply 0).comp continuous_subtype_val)
  have hUW : U ⊆ W := by
    intro μ hμ
    rw [hUdef, Set.mem_setOf_eq] at hμ
    rw [hWdef, Set.mem_setOf_eq]
    linarith
  refine ⟨probWall Uᶜ, probWall Wᶜ,
    lowerSemicontinuous_probWall_iff.mpr hUopen.isClosed_compl,
    lowerSemicontinuous_probWall_iff.mpr hWopen.isClosed_compl,
    ?_, ?_, ?_, ?_⟩
  · -- validity: wall it off (and inherit the raised floor), or reach it
    rintro σ ⟨-, hlive⟩
    have hproper : Dip σ (⊤ : ProbPenalty (Fin 2)) :=
      hlive ⊤ (Set.mem_singleton _)
    by_cases hW : ∃ μ ∈ W, σ μ ≠ ⊤
    · refine Or.inr ⟨pi_zero_le σ, ?_⟩
      rintro v hv
      rw [Set.mem_singleton_iff] at hv
      subst hv
      exact dip_probWall_compl_iff.mpr hW
    · push Not at hW
      refine Or.inl ⟨probWall_le_iff.mpr fun μ hμ => ?_, ?_⟩
      · rw [Set.notMem_compl_iff] at hμ
        exact hW μ (hUW hμ)
      · rintro v hv
        rw [Set.mem_singleton_iff] at hv
        subst hv
        exact hproper
  · -- the raised-floor disjunct alone does not contain the premise class
    intro h
    have h0 := h 0 lowerSemicontinuous_const
      ⟨le_rfl, by
        rintro v hv
        rw [Set.mem_singleton_iff] at hv
        subst hv
        exact ⟨ProbState.dirac 0, by
          rw [Pi.zero_apply, Pi.top_apply]
          exact ENNReal.zero_lt_top⟩⟩
    have hle := h0.1 (ProbState.dirac 0)
    have hu : probWall Uᶜ (ProbState.dirac 0) = ⊤ := by
      refine probWall_apply_of_not_mem ?_
      rw [Set.notMem_compl_iff, hUdef, Set.mem_setOf_eq,
        ProbState.dirac_apply_same]
      norm_num
    rw [hu, Pi.zero_apply, top_le_iff] at hle
    exact ENNReal.zero_ne_top hle
  · -- the flat-floor disjunct alone does not contain the premise class
    intro h
    have hσlsc : LowerSemicontinuous (probWall Wᶜ : ProbPenalty (Fin 2)) :=
      lowerSemicontinuous_probWall_iff.mpr hWopen.isClosed_compl
    have hproper : Dip (probWall Wᶜ : ProbPenalty (Fin 2))
        (⊤ : ProbPenalty (Fin 2)) := by
      refine ⟨ProbState.dirac 1, ?_⟩
      have hmem : ProbState.dirac 1 ∈ Wᶜ := by
        rw [Set.mem_compl_iff, hWdef, Set.mem_setOf_eq,
          ProbState.dirac_apply_of_ne (by decide : (0 : Fin 2) ≠ 1)]
        norm_num
      rw [probWall_apply_of_mem hmem, Pi.top_apply]
      exact ENNReal.zero_lt_top
    have h0 := h (probWall Wᶜ) hσlsc
      ⟨pi_zero_le _, by
        rintro v hv
        rw [Set.mem_singleton_iff] at hv
        subst hv
        exact hproper⟩
    obtain ⟨μ, hμ⟩ := h0.2 (probWall Wᶜ) (Set.mem_singleton _)
    exact absurd hμ (lt_irrefl _)
  · -- the raised floor is genuinely raised
    intro hle
    have h0 := hle (ProbState.dirac 0)
    have hu : probWall Uᶜ (ProbState.dirac 0) = ⊤ := by
      refine probWall_apply_of_not_mem ?_
      rw [Set.notMem_compl_iff, hUdef, Set.mem_setOf_eq,
        ProbState.dirac_apply_same]
      norm_num
    rw [hu, Pi.zero_apply, top_le_iff] at h0
    exact ENNReal.zero_ne_top h0

/-! ## The constructible stratum -/

section Constructible

variable {X : Type*} [TopologicalSpace X]

/-- Finite unions of locally closed sets: constructible sets in the
classical, finitary sense.

Deliberately not mathlib's `IsConstructible`, which is the
spectral-space notion — the Boolean subalgebra generated by *open
retrocompact* sets.  On a connected compact Hausdorff space (the
hyperspace of a compact connected carrier is one) every compact open
is clopen, hence `∅` or the whole space, so the spectral notion
degenerates there; the finitary notion below is the algebra the spec
layer actually generates. -/
def IsConstructibleUnion (s : Set X) : Prop :=
  ∃ (n : ℕ) (C : Fin n → Set X),
    (∀ i, IsLocallyClosed (C i)) ∧ s = ⋃ i, C i

theorem IsLocallyClosed.isConstructibleUnion {s : Set X}
    (h : IsLocallyClosed s) : IsConstructibleUnion s :=
  ⟨1, fun _ => s, fun _ => h, (Set.iUnion_const s).symm⟩

theorem IsConstructibleUnion.union {s t : Set X}
    (hs : IsConstructibleUnion s) (ht : IsConstructibleUnion t) :
    IsConstructibleUnion (s ∪ t) := by
  obtain ⟨n, C, hC, rfl⟩ := hs
  obtain ⟨n', C', hC', rfl⟩ := ht
  refine ⟨n + n', Fin.append C C', fun i => ?_, ?_⟩
  · refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · rw [Fin.append_left]
      exact hC i
    · rw [Fin.append_right]
      exact hC' i
  · ext x
    simp only [Set.mem_union, Set.mem_iUnion]
    constructor
    · rintro (⟨i, hi⟩ | ⟨i, hi⟩)
      · exact ⟨Fin.castAdd n' i, by rwa [Fin.append_left]⟩
      · exact ⟨Fin.natAdd n i, by rwa [Fin.append_right]⟩
    · rintro ⟨i, hi⟩
      revert hi
      refine Fin.addCases (fun j => ?_) (fun j => ?_) i
      · intro hj
        rw [Fin.append_left] at hj
        exact Or.inl ⟨j, hj⟩
      · intro hj
        rw [Fin.append_right] at hj
        exact Or.inr ⟨j, hj⟩

end Constructible

/-! ## DNF classes on the hyperspace -/

/-- The hyperspace class of a coupled DNF: the union of its disjuncts'
crescents. -/
def dnfClass {n : ℕ} (u : Fin n → ProbPenalty V)
    (𝒱 : Fin n → Set (ProbPenalty V)) :
    Set (NonemptyCompacts (BelState V)) :=
  ⋃ i, crescentClass (u i) (𝒱 i)

/-- The judgment against a DNF transports to membership of the body in
the DNF's class. -/
theorem compileNC_mem_dnfClass_iff [Nonempty V] {σ : ProbPenalty V}
    (hσ : LowerSemicontinuous σ) {n : ℕ} {u : Fin n → ProbPenalty V}
    {𝒱 : Fin n → Set (ProbPenalty V)} :
    compileNC σ hσ ∈ dnfClass u 𝒱 ↔ ∃ i, CoupledSat σ (u i) (𝒱 i) := by
  simp only [dnfClass, Set.mem_iUnion]
  exact exists_congr fun i => compileNC_mem_crescentClass_iff hσ

/-- **DNF classes are constructible**: finite unions of locally closed
crescents.  The coupled DNF is the constructible normal form of the
spec algebra. -/
theorem isConstructibleUnion_dnfClass {n : ℕ} {u : Fin n → ProbPenalty V}
    {𝒱 : Fin n → Set (ProbPenalty V)} (hu : ∀ i, LowerSemicontinuous (u i))
    (h𝒱 : ∀ i, (𝒱 i).Finite)
    (hlsc : ∀ i, ∀ v ∈ 𝒱 i, LowerSemicontinuous v) :
    IsConstructibleUnion (dnfClass u 𝒱) :=
  ⟨n, fun i => crescentClass (u i) (𝒱 i),
    fun i => isLocallyClosed_crescentClass (hu i) (h𝒱 i) (hlsc i), rfl⟩

/-- Atom conjunction is exact at the class level: crescents intersect
to crescents, with safety floors joining and liveness demands
accumulating.  With `dnfClass` distributing over this identity, the
constructible layer is closed under both connectives. -/
theorem crescentClass_inter_crescentClass {u₁ u₂ : ProbPenalty V}
    {𝒱₁ 𝒱₂ : Set (ProbPenalty V)} :
    crescentClass u₁ 𝒱₁ ∩ crescentClass u₂ 𝒱₂
      = crescentClass (u₁ ⊔ u₂) (𝒱₁ ∪ 𝒱₂) := by
  ext K
  simp only [Set.mem_inter_iff, mem_crescentClass_iff, compile_sup,
    Set.subset_inter_iff]
  constructor
  · rintro ⟨⟨h1, e1⟩, h2, e2⟩
    refine ⟨⟨h1, h2⟩, fun v hv => ?_⟩
    rcases hv with hv | hv
    · exact e1 v hv
    · exact e2 v hv
  · rintro ⟨⟨h1, h2⟩, e⟩
    exact ⟨⟨h1, fun v hv => e v (Set.mem_union_left _ hv)⟩,
      ⟨h2, fun v hv => e v (Set.mem_union_right _ hv)⟩⟩

/-! ## Systems are the ideal points of the layer -/

/-- **The crescent presentation of a system, as a class identity**:
among radial bodies, the infinitary crescent of the atom
`(σ, all citizens σ dips under)` is exactly the singleton
`{compileNC σ}`.  Finitely many crescents never pin a system
(`singletons_not_definable`); the full dip-theory crescent pins it
exactly — systems are the ideal points of the locally-closed layer. -/
theorem crescentClass_dipTheory_inter_radial [Nonempty V] {σ : ProbPenalty V}
    (hσ : LowerSemicontinuous σ) :
    crescentClass σ {v | LowerSemicontinuous v ∧ Dip σ v}
        ∩ {K : NonemptyCompacts (BelState V) | IsRadial (K : Set (BelState V))}
      = {compileNC σ hσ} := by
  ext K
  simp only [Set.mem_inter_iff, mem_crescentClass_iff, Set.mem_setOf_eq,
    Set.mem_singleton_iff]
  constructor
  · rintro ⟨⟨hsub, hesc⟩, hrad⟩
    have hKC : (K : Set (BelState V)) = compile σ :=
      eq_compile_of_subset_of_escapes K.isCompact.isClosed hrad K.nonempty hsub
        (fun v hv hd => by
          obtain ⟨x, hx1, hx2⟩ := hesc v ⟨hv, hd⟩
          exact ⟨x, hx1, hx2⟩)
    exact SetLike.ext' (by rw [hKC, coe_compileNC])
  · rintro rfl
    refine ⟨⟨by rw [coe_compileNC], ?_⟩, ?_⟩
    · rintro v ⟨hv, hdip⟩
      rw [coe_compileNC]
      obtain ⟨x, hx1, hx2⟩ := dip_iff_compile_escape.mp hdip
      exact ⟨x, hx1, hx2⟩
    · rw [coe_compileNC]
      exact isRadial_compile σ

/-- **The bottom body satisfies nothing**: the compile of the
everywhere-`⊤` penalty is the single point `{0}`, and `0` lies in
every body, so the bottom body contains nothing that could escape any
liveness body.  Ex falso inversion, hyperspace form: under the
option-A reading (every liveness slot nonempty) the bottom body lies
in no spec class at all. -/
theorem compileNC_top_notMem_crescentClass [Nonempty V] {u : ProbPenalty V}
    {𝒱 : Set (ProbPenalty V)} (h𝒱 : 𝒱.Nonempty)
    (htop : LowerSemicontinuous (⊤ : ProbPenalty V)) :
    compileNC (⊤ : ProbPenalty V) htop ∉ crescentClass u 𝒱 := by
  rw [mem_crescentClass_iff]
  rintro ⟨-, hesc⟩
  obtain ⟨v, hv⟩ := h𝒱
  obtain ⟨x, hx1, hx2⟩ := hesc v hv
  rw [coe_compileNC] at hx1
  obtain ⟨μ, γ, h0, hγ, he⟩ := hx1
  rw [Pi.top_apply, grade_top] at hγ
  exact hx2 ⟨μ, γ, h0, by rw [le_antisymm hγ h0]; exact grade_nonneg _, he⟩

end SuFunctor.Universe
