import SuFunctor.Universe.VietorisStratum
import Mathlib.MeasureTheory.Measure.ProbabilityMeasure

/-! # The general subprobability carrier

The radial-compile dictionary of `SuFunctor.Universe.VietorisDictionary` /
`SuFunctor.Universe.ImageChar` lives, at the finite stratum, on weight
functions over a finite outcome type.  This module builds the carrier the
chapter's definitions are actually stated over: **finite Borel measures of
total mass at most one** on an arbitrary topological measurable space,
with the subspace topology of the weak (narrow) topology on finite
measures.  Point-free reading: the carrier is the hyperspace-ready state
space whose lower opens are generated by strict lower bounds on
integrals against bounded continuous observations — mass is one such
observation, and the one that is *continuous* in both polarities.

* `SubProbabilityMeasure X` — the carrier `Δ≤1(X)`, as the subtype
  `{μ : FiniteMeasure X // μ.mass ≤ 1}`.  (Deliberately the same subtype
  spelling as the point-free development's classical face, so the two
  can later be reconciled by a re-export; this module depends only on
  mathlib.)
* scaling — the ℝ≥0-scaling toolkit: `scale` (ray-down motion of the
  carrier), `scalePoint` (a probability direction scaled into the
  carrier), continuity of both coordinates of the scaling action, proved
  directly from the defining `testAgainstNN` characterization of the
  weak topology so no `ContinuousSMul` instance is presupposed.
* polar decomposition — every state is zero or a positive mass times a
  unique probability direction (`exists_polar`, `polar_scale_eq`,
  `polar_state_eq`), with mathlib's `FiniteMeasure.normalize` as the
  direction.
* `gradeN` — the ℝ≥0 face of the grade map `e^{-·}` of
  `SuFunctor.Universe.VietorisDictionary`, with the unconditional
  round trip `gradeInv_grade` and the left-limit lemma
  `le_gradeN_of_forall_lt` (pure grade algebra: the topological
  closedness proof consumes it in place of any liminf machinery).
-/

namespace SuFunctor.Universe.General

open MeasureTheory Filter
open scoped ENNReal NNReal Topology BoundedContinuousFunction

variable (X : Type*) [MeasurableSpace X] [TopologicalSpace X]
  [OpensMeasurableSpace X]

/-- The **general subprobability carrier**: finite Borel measures of
total mass at most one, with the subspace topology of the weak topology
on finite measures.  Mass strictly below one is meaningful — a model
licensed to lose mass — and the zero measure is the bottom state, the
lawful denotation of infeasibility. -/
def SubProbabilityMeasure : Type _ :=
  {μ : FiniteMeasure X // μ.mass ≤ 1}

namespace SubProbabilityMeasure

variable {X}

/-- The underlying finite measure. -/
def toFiniteMeasure (ν : SubProbabilityMeasure X) : FiniteMeasure X := ν.1

instance : Coe (SubProbabilityMeasure X) (FiniteMeasure X) :=
  ⟨toFiniteMeasure⟩

@[simp] theorem coe_mk (μ : FiniteMeasure X) (h : μ.mass ≤ 1) :
    ((⟨μ, h⟩ : SubProbabilityMeasure X) : FiniteMeasure X) = μ := rfl

theorem mass_le_one (ν : SubProbabilityMeasure X) :
    (ν : FiniteMeasure X).mass ≤ 1 := ν.2

theorem ext {ν ρ : SubProbabilityMeasure X}
    (h : (ν : FiniteMeasure X) = (ρ : FiniteMeasure X)) : ν = ρ :=
  Subtype.ext h

/-- The subspace topology of the weak topology on finite measures. -/
instance : TopologicalSpace (SubProbabilityMeasure X) :=
  inferInstanceAs (TopologicalSpace {μ : FiniteMeasure X // μ.mass ≤ 1})

theorem continuous_toFiniteMeasure :
    Continuous
      (toFiniteMeasure : SubProbabilityMeasure X → FiniteMeasure X) :=
  continuous_subtype_val

/-- The carrier is the *closed* sublevel of the continuous mass
observation, so its inclusion into the finite measures is a closed
embedding: closed sets of the carrier have closed images. -/
theorem isClosedEmbedding_toFiniteMeasure :
    Topology.IsClosedEmbedding
      (toFiniteMeasure : SubProbabilityMeasure X → FiniteMeasure X) :=
  Topology.IsClosedEmbedding.subtypeVal <|
    (isClosed_le FiniteMeasure.continuous_mass continuous_const :
      IsClosed {μ : FiniteMeasure X | μ.mass ≤ 1})

theorem isClosed_image_toFiniteMeasure {R : Set (SubProbabilityMeasure X)}
    (hR : IsClosed R) : IsClosed (toFiniteMeasure '' R) :=
  isClosedEmbedding_toFiniteMeasure.isClosedMap _ hR

/-- The bottom state: the zero measure. -/
instance : Zero (SubProbabilityMeasure X) :=
  ⟨⟨0, by rw [FiniteMeasure.zero_mass]; exact zero_le_one⟩⟩

@[simp] theorem coe_zero :
    ((0 : SubProbabilityMeasure X) : FiniteMeasure X) = 0 := rfl

theorem mass_eq_zero_iff (ν : SubProbabilityMeasure X) :
    (ν : FiniteMeasure X).mass = 0 ↔ ν = 0 := by
  constructor
  · intro h
    refine ext ?_
    rw [coe_zero, ← FiniteMeasure.mass_zero_iff]
    exact h
  · intro h
    rw [h, coe_zero, FiniteMeasure.zero_mass]

/-! ## The scaling toolkit -/

/-- Mass of a scaled finite measure. -/
theorem mass_smul (c : ℝ≥0) (μ : FiniteMeasure X) :
    (c • μ).mass = c * μ.mass := by
  have h : ((c • μ).mass : ℝ≥0∞) = ((c * μ.mass : ℝ≥0) : ℝ≥0∞) := by
    rw [FiniteMeasure.ennreal_mass, FiniteMeasure.toMeasure_smul,
      Measure.smul_apply, ENNReal.smul_def, smul_eq_mul, ENNReal.coe_mul,
      FiniteMeasure.ennreal_mass]
  exact_mod_cast h

/-- Weak-topology continuity of scaling, scalar coordinate: for a fixed
finite measure, the ray through it is continuously parametrized.  Proved
from the `testAgainstNN` characterization, presupposing no
`ContinuousSMul` instance. -/
theorem continuous_smul_scalar (μ : FiniteMeasure X) :
    Continuous fun c : ℝ≥0 => c • μ := by
  rw [continuous_iff_continuousAt]
  intro c
  have key : Tendsto (fun γ : ℝ≥0 => γ • μ) (𝓝 c) (𝓝 (c • μ)) := by
    rw [FiniteMeasure.tendsto_iff_forall_testAgainstNN_tendsto]
    intro f
    simp only [FiniteMeasure.smul_testAgainstNN_apply, smul_eq_mul]
    exact tendsto_id.mul_const _
  exact key

/-- Weak-topology continuity of scaling, measure coordinate: scaling by a
fixed factor is continuous. -/
theorem continuous_smul_measure (c : ℝ≥0) :
    Continuous fun μ : FiniteMeasure X => c • μ := by
  rw [continuous_iff_continuousAt]
  intro μ
  have key : Tendsto (fun ν : FiniteMeasure X => c • ν) (𝓝 μ)
      (𝓝 (c • μ)) := by
    rw [FiniteMeasure.tendsto_iff_forall_testAgainstNN_tendsto]
    intro f
    simp only [FiniteMeasure.smul_testAgainstNN_apply, smul_eq_mul]
    exact ((FiniteMeasure.tendsto_iff_forall_testAgainstNN_tendsto.mp
      tendsto_id) f).const_mul _
  exact key

/-- Ray-down motion of the carrier: scaling a state by `t ≤ 1`. -/
noncomputable def scale (t : ℝ≥0) (ht : t ≤ 1) (ν : SubProbabilityMeasure X) :
    SubProbabilityMeasure X :=
  ⟨t • (ν : FiniteMeasure X), by
    rw [mass_smul]
    exact mul_le_one' ht ν.mass_le_one⟩

@[simp] theorem coe_scale (t : ℝ≥0) (ht : t ≤ 1)
    (ν : SubProbabilityMeasure X) :
    ((scale t ht ν : SubProbabilityMeasure X) : FiniteMeasure X)
      = t • (ν : FiniteMeasure X) := rfl

/-- A probability direction scaled into the carrier. -/
noncomputable def scalePoint (c : ℝ≥0) (hc : c ≤ 1) (μ : ProbabilityMeasure X) :
    SubProbabilityMeasure X :=
  ⟨c • μ.toFiniteMeasure, by
    rw [mass_smul, ProbabilityMeasure.mass_toFiniteMeasure, mul_one]
    exact hc⟩

@[simp] theorem coe_scalePoint (c : ℝ≥0) (hc : c ≤ 1)
    (μ : ProbabilityMeasure X) :
    ((scalePoint c hc μ : SubProbabilityMeasure X) : FiniteMeasure X)
      = c • μ.toFiniteMeasure := rfl

/-- `scalePoint` is continuous in its direction. -/
theorem continuous_scalePoint (c : ℝ≥0) (hc : c ≤ 1) :
    Continuous fun μ : ProbabilityMeasure X => scalePoint c hc μ :=
  Continuous.subtype_mk
    ((continuous_smul_measure c).comp
      ProbabilityMeasure.toFiniteMeasure_continuous) _

/-! ## Polar decomposition -/

/-- Polar decompositions agree in their radial coordinate: the scale is
the total mass. -/
theorem polar_scale_eq {γ γ' : ℝ≥0} {μ μ' : ProbabilityMeasure X}
    (h : γ • μ.toFiniteMeasure = γ' • μ'.toFiniteMeasure) : γ = γ' := by
  have hm := congrArg FiniteMeasure.mass h
  rwa [mass_smul, mass_smul, ProbabilityMeasure.mass_toFiniteMeasure,
    ProbabilityMeasure.mass_toFiniteMeasure, mul_one, mul_one] at hm

/-- At nonzero scale, polar decompositions agree in their angular
coordinate too. -/
theorem polar_direction_eq {γ : ℝ≥0} (hγ : γ ≠ 0)
    {μ μ' : ProbabilityMeasure X}
    (h : γ • μ.toFiniteMeasure = γ • μ'.toFiniteMeasure) : μ = μ' := by
  have h1 : μ.toFiniteMeasure = μ'.toFiniteMeasure := by
    calc μ.toFiniteMeasure = (γ⁻¹ * γ) • μ.toFiniteMeasure := by
          rw [inv_mul_cancel₀ hγ, one_smul]
      _ = γ⁻¹ • (γ • μ.toFiniteMeasure) := by rw [mul_smul]
      _ = γ⁻¹ • (γ • μ'.toFiniteMeasure) := by rw [h]
      _ = (γ⁻¹ * γ) • μ'.toFiniteMeasure := by rw [mul_smul]
      _ = μ'.toFiniteMeasure := by rw [inv_mul_cancel₀ hγ, one_smul]
  exact (ProbabilityMeasure.toFiniteMeasure_isEmbedding X).injective h1

/-- The normalization of a scaled probability direction recovers the
direction. -/
theorem normalize_smul_prob [Nonempty X] {γ : ℝ≥0} (hγ : γ ≠ 0)
    (μ : ProbabilityMeasure X) :
    (γ • μ.toFiniteMeasure).normalize = μ := by
  have hmass : (γ • μ.toFiniteMeasure).mass = γ := by
    rw [mass_smul, ProbabilityMeasure.mass_toFiniteMeasure, mul_one]
  have hnz : (γ • μ.toFiniteMeasure) ≠ 0 := by
    rw [← FiniteMeasure.mass_nonzero_iff, hmass]
    exact hγ
  apply (ProbabilityMeasure.toFiniteMeasure_isEmbedding X).injective
  have hself := (γ • μ.toFiniteMeasure).self_eq_mass_smul_normalize
  rw [hmass] at hself
  have hkey := congrArg (fun ρ : FiniteMeasure X => γ⁻¹ • ρ) hself
  simpa [smul_smul, inv_mul_cancel₀ hγ] using hkey.symm

/-- **Polar decomposition**: every state of the carrier is the bottom
state or a positive mass times a probability direction. -/
theorem exists_polar [Nonempty X] (ν : SubProbabilityMeasure X) :
    ν = 0 ∨ ∃ (μ : ProbabilityMeasure X) (m : ℝ≥0), 0 < m ∧ m ≤ 1
      ∧ (ν : FiniteMeasure X) = m • μ.toFiniteMeasure := by
  rcases eq_or_ne ((ν : FiniteMeasure X).mass) 0 with hm | hm
  · exact Or.inl ((mass_eq_zero_iff ν).mp hm)
  · refine Or.inr ⟨(ν : FiniteMeasure X).normalize,
      (ν : FiniteMeasure X).mass, pos_iff_ne_zero.mpr hm, ν.mass_le_one,
      (ν : FiniteMeasure X).self_eq_mass_smul_normalize⟩

end SubProbabilityMeasure

/-! ## The ℝ≥0 face of the grade map -/

/-- The grade map `e^{-·}` of the topological stratum, valued in `ℝ≥0`:
mass is an `ℝ≥0` coordinate on the general carrier, so the grade budget
it is compared against is packaged on the same scale. -/
noncomputable def gradeN (a : ℝ≥0∞) : ℝ≥0 :=
  ⟨grade a, grade_nonneg a⟩

@[simp] theorem coe_gradeN (a : ℝ≥0∞) : (gradeN a : ℝ) = grade a := rfl

@[simp] theorem gradeN_zero : gradeN 0 = 1 := by
  ext; simp

@[simp] theorem gradeN_top : gradeN ⊤ = 0 := by
  ext; simp

theorem gradeN_le_one (a : ℝ≥0∞) : gradeN a ≤ 1 := by
  rw [← NNReal.coe_le_coe]
  exact grade_le_one a

theorem gradeN_anti {a b : ℝ≥0∞} (h : a ≤ b) : gradeN b ≤ gradeN a := by
  rw [← NNReal.coe_le_coe]
  exact grade_anti h

theorem gradeN_le_gradeN_iff {a b : ℝ≥0∞} : gradeN b ≤ gradeN a ↔ a ≤ b := by
  rw [← NNReal.coe_le_coe]
  exact grade_le_grade_iff

theorem gradeN_lt_gradeN_iff {a b : ℝ≥0∞} : gradeN b < gradeN a ↔ a < b := by
  rw [← NNReal.coe_lt_coe]
  exact grade_lt_grade_iff

theorem gradeN_pos {a : ℝ≥0∞} (h : a ≠ ⊤) : 0 < gradeN a := by
  rw [← NNReal.coe_lt_coe]
  exact grade_pos h

theorem gradeN_eq_zero_iff {a : ℝ≥0∞} : gradeN a = 0 ↔ a = ⊤ := by
  constructor
  · intro h
    by_contra hne
    exact absurd h (gradeN_pos hne).ne'
  · intro h
    rw [h, gradeN_top]

/-- The grade inverse undoes the grade — on **all** of `ℝ≥0∞`, hard
violation included.  (The finite stratum recorded only the other round
trip, `grade_gradeInv`; this direction is what makes the gauge penalty
of a compile literally the compiled penalty, with no citizenship
hypothesis.) -/
theorem gradeInv_grade (a : ℝ≥0∞) : gradeInv (grade a) = a := by
  by_cases ha : a = ⊤
  · rw [ha, grade_top, gradeInv, if_pos le_rfl]
  · rw [grade_of_ne_top ha, gradeInv,
      if_neg (not_le.mpr (Real.exp_pos _)), Real.log_exp, neg_neg,
      ENNReal.ofReal_toReal ha]

/-- The grade inverse of scale zero is hard violation. -/
theorem gradeInv_zero : gradeInv (0 : ℝ) = ⊤ := if_pos le_rfl

/-- The order dictionary between the grade inverse and the grade's ℝ≥0
face, on the unit interval of scales: `−log c ≤ y ↔ e^{-y} ≤ c`. -/
theorem gradeInv_le_iff {c : ℝ≥0} (hc : c ≤ 1) {y : ℝ≥0∞} :
    gradeInv (c : ℝ) ≤ y ↔ gradeN y ≤ c := by
  rcases eq_or_ne c 0 with rfl | hc0
  · rw [NNReal.coe_zero, gradeInv_zero]
    constructor
    · intro h
      rw [top_le_iff.mp h, gradeN_top]
    · intro h
      rw [gradeN_eq_zero_iff.mp (le_antisymm h (zero_le))]
  · have hcpos : (0 : ℝ) < c := by
      exact_mod_cast pos_iff_ne_zero.mpr hc0
    have hc1 : (c : ℝ) ≤ 1 := by exact_mod_cast hc
    rw [← grade_le_grade_iff (a := gradeInv (c : ℝ)) (b := y),
      grade_gradeInv hcpos hc1]
    constructor
    · intro h
      exact NNReal.coe_le_coe.mp (by rw [coe_gradeN]; exact h)
    · intro h
      have hcoe : (gradeN y : ℝ) ≤ (c : ℝ) := NNReal.coe_le_coe.mpr h
      rw [coe_gradeN] at hcoe
      exact hcoe

/-- **The left-limit lemma**: a scale below every grade strictly before
`a` is below the grade of `a`.  Pure grade algebra — this is the whole
of the "left continuity of `e^{-·}`" that the closedness proof needs,
with no liminf machinery. -/
theorem le_gradeN_of_forall_lt {a : ℝ≥0∞} {c : ℝ≥0} (hc : c ≤ 1)
    (h : ∀ y, y < a → c ≤ gradeN y) : c ≤ gradeN a := by
  by_contra hlt
  rw [not_le] at hlt
  -- midpoint scale strictly between `gradeN a` and `c`
  set t : ℝ≥0 := (gradeN a + c) / 2 with ht
  have htlt : gradeN a < t := by
    rw [ht]
    exact left_lt_add_div_two.mpr hlt
  have httc : t < c := by
    rw [ht]
    exact add_div_two_lt_right.mpr hlt
  have htpos : (0 : ℝ) < t := by
    have : (0 : ℝ≥0) < t := lt_of_le_of_lt zero_le htlt
    exact_mod_cast this
  have ht1 : (t : ℝ) ≤ 1 := by
    have : t ≤ 1 := le_of_lt (lt_of_lt_of_le httc hc)
    exact_mod_cast this
  -- the ray height whose grade is exactly `t`
  have hgy : grade (gradeInv (t : ℝ)) = t := grade_gradeInv htpos ht1
  have hgyN : gradeN (gradeInv (t : ℝ)) = t := by
    ext
    rw [coe_gradeN, hgy]
  have hya : gradeInv (t : ℝ) < a := by
    rw [← gradeN_lt_gradeN_iff, hgyN]
    exact htlt
  have := h _ hya
  rw [hgyN] at this
  exact absurd (lt_of_le_of_lt this httc) (lt_irrefl c)

end SuFunctor.Universe.General
