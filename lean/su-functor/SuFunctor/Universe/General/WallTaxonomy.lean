import Mathlib.MeasureTheory.Measure.Portmanteau
import SuFunctor.Universe.General.CredalPoset
import SuFunctor.Universe.General.CheckerAnchor

/-! # The wall-fragment taxonomy: possibilistic lifts and threshold regions

The kernel-checked spine of the wall-fragment adjudication, whose
expected verdicts were preregistered and committed before this file.

Two zero-set species of two-valued (wall) penalties, over the general
subprobability carrier:

* `possibilisticBody C` — the possibilistic lift of an allowed set `C`:
  states whose mass avoids `Cᶜ` entirely.  This is the support-condition
  form of "generated by the convex hull of a collection of Dirac
  deltas" (the hull presentation is a prose theorem, not mechanized
  here), the
  Spivak–Schultz behaviour-type image shape (the TTT inclusion's
  `indPen` zero-sets), and the *wall fragment* proper.
* `leRegion A t` — the upper-threshold region: mass on `A` at most `t`.
  The battery-conclusion shape (`P̄(bad) ≤ t`), one prevision polarity.
* `geRegion F p` — the lower-threshold region (`P(F) ≥ p`), the other
  prevision polarity.

The spine:

* `possibilisticBody_eq_leRegion_zero` — walls are degenerate batteries:
  the possibilistic lift is the threshold-zero region of the complement.
* `isUltra_leRegion` — every LE-threshold region over an open event is a
  Kosoy–Appel ultracontribution (nonempty, closed, convex,
  pointwise-down-closed), hence a citizen of the landed atlas at the
  prevision-shaped node — *not* at the classical-credal node, which is
  the down-closure of a single top-face set (the 08:09 distinction).
* `isUltra_possibilisticBody` — the wall fragment sits inside that class
  (the degenerate-battery identity, applied).
* `isClosed_geRegion` — the GE polarity closes over closed events (the
  Portmanteau polarity discipline, kernel-visible)...
* `not_ptwiseDown_geRegion` — ...but is *not* pointwise-down-closed: the
  polarity split.  GE-verdicts are maximal-slice content (the
  ray-versus-singleton seam), not radial content.
* `leRegion_half_ne_possibilisticBody` — the separation that settles the
  naming: a genuine probability threshold (`p = 1/2`, two-point carrier,
  rational witness) is *no* possibilistic lift.  The checkers certify
  strictly more than the wall fragment.
-/

namespace SuFunctor.Universe.General.WallTaxonomy

open MeasureTheory Filter Set
open scoped ENNReal NNReal Topology

open SuFunctor.Universe.General.CredalPoset

variable {X : Type*} [MeasurableSpace X] [TopologicalSpace X]
  [OpensMeasurableSpace X]

/-! ## The two zero-set species -/

/-- The **possibilistic lift** of an allowed set `C`: subprobability
states supported in `C` (mass on the forbidden complement exactly
zero).  The support-condition form of "the closed convex hull of the
Dirac deltas on `C`", and the Spivak–Schultz behaviour-type image
shape. -/
def possibilisticBody (C : Set X) : Set (SubProbabilityMeasure X) :=
  {ν | ((ν : FiniteMeasure X) : Measure X) Cᶜ = 0}

/-- The **upper-threshold region** (battery-conclusion shape): states
whose mass on the event `A` is at most `t`. -/
def leRegion (A : Set X) (t : ℝ≥0∞) : Set (SubProbabilityMeasure X) :=
  {ν | ((ν : FiniteMeasure X) : Measure X) A ≤ t}

/-- The **lower-threshold region** (the `P ≥ p` polarity): states whose
mass on the event `F` is at least `p`. -/
def geRegion (F : Set X) (p : ℝ≥0∞) : Set (SubProbabilityMeasure X) :=
  {ν | p ≤ ((ν : FiniteMeasure X) : Measure X) F}

omit [TopologicalSpace X] [OpensMeasurableSpace X] in
theorem mem_possibilisticBody_iff {C : Set X} {ν : SubProbabilityMeasure X} :
    ν ∈ possibilisticBody C ↔ ((ν : FiniteMeasure X) : Measure X) Cᶜ = 0 :=
  Iff.rfl

omit [TopologicalSpace X] [OpensMeasurableSpace X] in
theorem mem_leRegion_iff {A : Set X} {t : ℝ≥0∞} {ν : SubProbabilityMeasure X} :
    ν ∈ leRegion A t ↔ ((ν : FiniteMeasure X) : Measure X) A ≤ t :=
  Iff.rfl

omit [TopologicalSpace X] [OpensMeasurableSpace X] in
theorem mem_geRegion_iff {F : Set X} {p : ℝ≥0∞} {ν : SubProbabilityMeasure X} :
    ν ∈ geRegion F p ↔ p ≤ ((ν : FiniteMeasure X) : Measure X) F :=
  Iff.rfl

/-! ## T1 — walls are degenerate batteries -/

omit [TopologicalSpace X] [OpensMeasurableSpace X] in
/-- **Walls are degenerate batteries**: the possibilistic lift of `C`
is the threshold-`0` upper region of the forbidden complement. -/
theorem possibilisticBody_eq_leRegion_zero (C : Set X) :
    possibilisticBody C = leRegion Cᶜ 0 := by
  ext ν
  simp [possibilisticBody, leRegion]

/-! ## T2–T4 — the order-and-mixture structure of threshold regions -/

/-- **Convexity**: threshold regions are mixture-closed. -/
theorem convexBody_leRegion (A : Set X) (t : ℝ≥0∞) :
    ConvexBody (leRegion A t) := by
  intro ν hν ρ hρ a b hab
  simp only [leRegion, Set.mem_setOf_eq] at hν hρ ⊢
  rw [SubProbabilityMeasure.coe_mix, FiniteMeasure.toMeasure_add,
    FiniteMeasure.toMeasure_smul, FiniteMeasure.toMeasure_smul,
    Measure.add_apply, Measure.smul_apply, Measure.smul_apply,
    ENNReal.smul_def, ENNReal.smul_def, smul_eq_mul, smul_eq_mul]
  calc (a : ℝ≥0∞) * ((ν : FiniteMeasure X) : Measure X) A
        + (b : ℝ≥0∞) * ((ρ : FiniteMeasure X) : Measure X) A
      ≤ (a : ℝ≥0∞) * t + (b : ℝ≥0∞) * t :=
        add_le_add (mul_le_mul_right hν _) (mul_le_mul_right hρ _)
    _ = ((a + b : ℝ≥0) : ℝ≥0∞) * t := by
        rw [ENNReal.coe_add, add_mul]
    _ = t := by rw [hab, ENNReal.coe_one, one_mul]

omit [TopologicalSpace X] [OpensMeasurableSpace X] in
/-- **Pointwise-down closure**: an upper threshold survives setwise
decrease. -/
theorem ptwiseDown_leRegion (A : Set X) (t : ℝ≥0∞) :
    PtwiseDown (leRegion A t) := by
  intro ρ hρ ν hle
  exact le_trans (hle A) hρ

/-- **Nonemptiness**: the bottom state is in every upper-threshold
region. -/
theorem nonempty_leRegion (A : Set X) (t : ℝ≥0∞) :
    (leRegion A t).Nonempty := by
  refine ⟨0, ?_⟩
  show (((0 : SubProbabilityMeasure X) : FiniteMeasure X) : Measure X) A ≤ t
  rw [SubProbabilityMeasure.coe_zero, FiniteMeasure.toMeasure_zero]
  simp

/-! ## T5 — closedness, by the Portmanteau polarity discipline -/

/-- **The GE polarity closes over closed events**: `{ν | p ≤ ν F}` is
narrowly closed when `F` is closed — one Portmanteau leg, filter form. -/
theorem isClosed_geRegion [HasOuterApproxClosed X] {F : Set X}
    (hF : IsClosed F) (p : ℝ≥0∞) : IsClosed (geRegion F p) := by
  refine isClosed_of_closure_subset fun ν hν => ?_
  have hcp : ClusterPt ν (𝓟 (geRegion F p)) := mem_closure_iff_clusterPt.mp hν
  set L : Filter (SubProbabilityMeasure X) := 𝓝 ν ⊓ 𝓟 (geRegion F p) with hL
  haveI : L.NeBot := hcp
  have hid : Tendsto (fun ρ : SubProbabilityMeasure X => ρ) L (𝓝 ν) :=
    tendsto_id.mono_left inf_le_left
  have htend : Tendsto
      (fun ρ : SubProbabilityMeasure X => (ρ : FiniteMeasure X)) L
      (𝓝 (ν : FiniteMeasure X)) :=
    (SubProbabilityMeasure.isClosedEmbedding_toFiniteMeasure.continuous.tendsto
      ν).comp hid
  have hport := FiniteMeasure.limsup_measure_closed_le_of_tendsto htend hF
  have hev : ∀ᶠ ρ : SubProbabilityMeasure X in L,
      p ≤ ((ρ : FiniteMeasure X) : Measure X) F := by
    rw [hL, eventually_inf_principal]
    exact Eventually.of_forall fun ρ hρ => hρ
  show p ≤ ((ν : FiniteMeasure X) : Measure X) F
  exact le_trans (le_limsup_of_frequently_le' hev.frequently) hport

/-- **The LE polarity closes over open events**: `{ν | ν A ≤ t}` is
narrowly closed when `A` is open.  On the subprobability carrier the
total mass is *not* fixed, so the probability-measure complement trick
is replaced by the additive mass split `ν A + ν Aᶜ = ν univ` — mass is
narrowly continuous, the complement is closed, and the two Portmanteau
ingredients cancel without any `ℝ≥0∞` subtraction. -/
theorem isClosed_leRegion [HasOuterApproxClosed X] {A : Set X}
    (hA : IsOpen A) (t : ℝ≥0∞) : IsClosed (leRegion A t) := by
  refine isClosed_of_closure_subset fun ν hν => ?_
  have hcp : ClusterPt ν (𝓟 (leRegion A t)) := mem_closure_iff_clusterPt.mp hν
  set L : Filter (SubProbabilityMeasure X) := 𝓝 ν ⊓ 𝓟 (leRegion A t) with hL
  haveI : L.NeBot := hcp
  have hid : Tendsto (fun ρ : SubProbabilityMeasure X => ρ) L (𝓝 ν) :=
    tendsto_id.mono_left inf_le_left
  have htend : Tendsto
      (fun ρ : SubProbabilityMeasure X => (ρ : FiniteMeasure X)) L
      (𝓝 (ν : FiniteMeasure X)) :=
    (SubProbabilityMeasure.isClosedEmbedding_toFiniteMeasure.continuous.tendsto
      ν).comp hid
  -- Portmanteau on the closed complement
  have hport : (L.limsup fun ρ : SubProbabilityMeasure X =>
      ((ρ : FiniteMeasure X) : Measure X) Aᶜ)
      ≤ ((ν : FiniteMeasure X) : Measure X) Aᶜ :=
    FiniteMeasure.limsup_measure_closed_le_of_tendsto htend hA.isClosed_compl
  -- mass is narrowly continuous
  have hmass : Tendsto (fun ρ : SubProbabilityMeasure X =>
      ((ρ : FiniteMeasure X) : Measure X) Set.univ) L
      (𝓝 (((ν : FiniteMeasure X) : Measure X) Set.univ)) := by
    have h1 : Tendsto (fun ρ : SubProbabilityMeasure X =>
        ((ρ : FiniteMeasure X).mass : ℝ≥0∞)) L
        (𝓝 ((ν : FiniteMeasure X).mass : ℝ≥0∞)) :=
      (ENNReal.continuous_coe.tendsto _).comp
        ((FiniteMeasure.continuous_mass.tendsto _).comp htend)
    simpa only [FiniteMeasure.ennreal_mass] using h1
  -- on the region, the mass split bounds the total by `t + ν Aᶜ`
  have hev : ∀ᶠ ρ : SubProbabilityMeasure X in L,
      ((ρ : FiniteMeasure X) : Measure X) Set.univ
        ≤ t + ((ρ : FiniteMeasure X) : Measure X) Aᶜ := by
    have hmem : ∀ᶠ ρ : SubProbabilityMeasure X in L, ρ ∈ leRegion A t := by
      rw [hL, eventually_inf_principal]
      exact Eventually.of_forall fun ρ hρ => hρ
    refine hmem.mono fun ρ hρ => ?_
    have hsplit : ((ρ : FiniteMeasure X) : Measure X) A
        + ((ρ : FiniteMeasure X) : Measure X) Aᶜ
        = ((ρ : FiniteMeasure X) : Measure X) Set.univ :=
      measure_add_measure_compl hA.measurableSet
    rw [← hsplit]
    exact add_le_add (mem_leRegion_iff.mp hρ) le_rfl
  -- assemble: ν univ ≤ t + ν Aᶜ
  have hbound : ((ν : FiniteMeasure X) : Measure X) Set.univ
      ≤ t + ((ν : FiniteMeasure X) : Measure X) Aᶜ := by
    have h1 : ((ν : FiniteMeasure X) : Measure X) Set.univ
        = L.limsup (fun ρ : SubProbabilityMeasure X =>
            ((ρ : FiniteMeasure X) : Measure X) Set.univ) :=
      hmass.limsup_eq.symm
    have hbdd : L.IsBoundedUnder (· ≤ ·)
        (fun ρ : SubProbabilityMeasure X =>
          ((ρ : FiniteMeasure X) : Measure X) Aᶜ) :=
      ⟨⊤, Eventually.of_forall fun _ => le_top⟩
    have hcob : L.IsCoboundedUnder (· ≤ ·)
        (fun ρ : SubProbabilityMeasure X =>
          ((ρ : FiniteMeasure X) : Measure X) Aᶜ) :=
      ⟨0, fun _ _ => zero_le⟩
    calc ((ν : FiniteMeasure X) : Measure X) Set.univ
        = L.limsup (fun ρ : SubProbabilityMeasure X =>
            ((ρ : FiniteMeasure X) : Measure X) Set.univ) := h1
      _ ≤ L.limsup (fun ρ : SubProbabilityMeasure X =>
            t + ((ρ : FiniteMeasure X) : Measure X) Aᶜ) :=
          limsup_le_limsup hev
      _ = t + L.limsup (fun ρ : SubProbabilityMeasure X =>
            ((ρ : FiniteMeasure X) : Measure X) Aᶜ) :=
          limsup_const_add L _ t hbdd hcob
      _ ≤ t + ((ν : FiniteMeasure X) : Measure X) Aᶜ :=
          add_le_add le_rfl hport
  -- cancel the (finite) complement mass
  have hsplitν : ((ν : FiniteMeasure X) : Measure X) A
      + ((ν : FiniteMeasure X) : Measure X) Aᶜ
      = ((ν : FiniteMeasure X) : Measure X) Set.univ :=
    measure_add_measure_compl hA.measurableSet
  have hchain : ((ν : FiniteMeasure X) : Measure X) A
      + ((ν : FiniteMeasure X) : Measure X) Aᶜ
      ≤ t + ((ν : FiniteMeasure X) : Measure X) Aᶜ := by
    rw [hsplitν]; exact hbound
  show ((ν : FiniteMeasure X) : Measure X) A ≤ t
  exact (ENNReal.add_le_add_iff_right (measure_ne_top _ _)).mp hchain

/-! ## The ultracontribution placement -/

/-- **Battery regions are ultracontributions**: every upper-threshold
region over an open event is nonempty, closed, convex, and
pointwise-down-closed — a Kosoy–Appel citizen, placed at the landed
atlas's prevision-shaped node. -/
theorem isUltra_leRegion [HasOuterApproxClosed X] {A : Set X}
    (hA : IsOpen A) (t : ℝ≥0∞) : IsUltra (leRegion A t) :=
  ⟨nonempty_leRegion A t, isClosed_leRegion hA t, convexBody_leRegion A t,
    ptwiseDown_leRegion A t⟩

/-- **The wall fragment sits inside the same class**: possibilistic
lifts of closed allowed sets are ultracontributions — by the
degenerate-battery identity, nothing else. -/
theorem isUltra_possibilisticBody [HasOuterApproxClosed X] {C : Set X}
    (hC : IsClosed C) : IsUltra (possibilisticBody C) := by
  rw [possibilisticBody_eq_leRegion_zero]
  exact isUltra_leRegion hC.isOpen_compl 0

/-! ## The polarity split -/

/-- **GE regions are not down-closed**: the bottom state sits below any
full-mass member yet fails a positive lower threshold.  The GE polarity
is maximal-slice content, not radial content — the ray-versus-singleton
seam, kernel-visible. -/
theorem not_ptwiseDown_geRegion [Nonempty X] :
    ∃ (F : Set X) (p : ℝ≥0∞), ¬ PtwiseDown (geRegion F p) := by
  obtain ⟨x⟩ := ‹Nonempty X›
  refine ⟨Set.univ, 1, fun h => ?_⟩
  set δ : SubProbabilityMeasure X :=
    SubProbabilityMeasure.scalePoint 1 le_rfl
      ⟨Measure.dirac x, Measure.dirac.isProbabilityMeasure⟩ with hδdef
  have hδcoe : ((δ : FiniteMeasure X) : Measure X) = Measure.dirac x := by
    rw [hδdef, SubProbabilityMeasure.coe_scalePoint, one_smul]
    rfl
  have hδmem : δ ∈ geRegion Set.univ 1 := by
    show (1 : ℝ≥0∞) ≤ ((δ : FiniteMeasure X) : Measure X) Set.univ
    rw [hδcoe]
    simp
  have h0 : (0 : SubProbabilityMeasure X) ∈ geRegion Set.univ 1 := by
    refine h δ hδmem 0 ?_
    rw [SubProbabilityMeasure.coe_zero, FiniteMeasure.toMeasure_zero]
    exact Measure.zero_le _
  have h1 := h0
  rw [mem_geRegion_iff, SubProbabilityMeasure.coe_zero,
    FiniteMeasure.toMeasure_zero] at h1
  simp at h1

/-! ## The separation: thresholds are not possibilistic -/

/-- **The naming separation**: over the two-point carrier, the genuine
probability threshold `ν {true} ≤ 1/2` is *no* possibilistic lift — for
any candidate allowed set, one of two rational witnesses refuses: the
Dirac at `true` (in the lift when `true` is allowed, mass `1 > 1/2`),
or the half-Dirac (mass `1/2` passes the threshold, but its forbidden
mass is `1/2 ≠ 0` when `true` is forbidden).  The shipped checkers
certify strictly more than the wall fragment. -/
theorem leRegion_half_ne_possibilisticBody :
    ∀ C : Set Bool,
      leRegion {b : Bool | b = true} (((2 : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞)
        ≠ possibilisticBody C := by
  intro C hEq
  have htrue_mem : (true : Bool) ∈ {b : Bool | b = true} := rfl
  by_cases htrue : (true : Bool) ∈ C
  · -- the Dirac at `true`
    set δ : SubProbabilityMeasure Bool :=
      SubProbabilityMeasure.scalePoint 1 le_rfl
        ⟨Measure.dirac true, Measure.dirac.isProbabilityMeasure⟩ with hδdef
    have hδcoe : ((δ : FiniteMeasure Bool) : Measure Bool)
        = Measure.dirac true := by
      rw [hδdef, SubProbabilityMeasure.coe_scalePoint, one_smul]
      rfl
    have hmem : δ ∈ possibilisticBody C := by
      show ((δ : FiniteMeasure Bool) : Measure Bool) Cᶜ = 0
      rw [hδcoe, Measure.dirac_apply]
      exact Set.indicator_of_notMem (Set.notMem_compl_iff.mpr htrue) _
    have hnot : δ ∉ leRegion {b : Bool | b = true}
        (((2 : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞) := by
      rw [mem_leRegion_iff, hδcoe, Measure.dirac_apply,
        Set.indicator_of_mem htrue_mem]
      simp only [Pi.one_apply]
      intro hle
      have hlt : (((2 : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞) < 1 := by
        rw [ENNReal.coe_lt_one_iff]
        norm_num
      exact absurd hle (not_le.mpr hlt)
    rw [hEq] at hnot
    exact hnot hmem
  · -- the half-Dirac at `true`
    set η : SubProbabilityMeasure Bool :=
      SubProbabilityMeasure.scalePoint (2 : ℝ≥0)⁻¹ (by norm_num)
        ⟨Measure.dirac true, Measure.dirac.isProbabilityMeasure⟩ with hηdef
    have hηcoe : ((η : FiniteMeasure Bool) : Measure Bool)
        = ((2 : ℝ≥0)⁻¹ : ℝ≥0) • Measure.dirac true := by
      rw [hηdef, SubProbabilityMeasure.coe_scalePoint,
        FiniteMeasure.toMeasure_smul]
      rfl
    have hmem : η ∈ leRegion {b : Bool | b = true}
        (((2 : ℝ≥0)⁻¹ : ℝ≥0) : ℝ≥0∞) := by
      rw [mem_leRegion_iff, hηcoe, Measure.smul_apply, Measure.dirac_apply,
        Set.indicator_of_mem htrue_mem]
      simp [ENNReal.smul_def]
    have hnot : η ∉ possibilisticBody C := by
      rw [mem_possibilisticBody_iff, hηcoe, Measure.smul_apply,
        Measure.dirac_apply, Set.indicator_of_mem (Set.mem_compl htrue)]
      simp only [Pi.one_apply, smul_eq_mul, ENNReal.smul_def, mul_one]
      exact ENNReal.coe_ne_zero.mpr (by norm_num)
    rw [hEq] at hmem
    exact hnot hmem

end SuFunctor.Universe.General.WallTaxonomy
