/-! ## The two fragment-gate tiers the landed S4 fixtures left
unmeasured (mirrors of `refuse_region_tier`) -/

/-- The spec-equivalence tier staged: a `QSpecEquiv` row (element 17)
beside the intact evaluation route — both compared specs are the
fixture's own.  (Counters derived from the pinned dump at generation
time, never hardcoded to a revision.) -/
def fixtureOpsSpecEquivTier : List GOp :=
  fixtureDecls ++
    [.elta (.ext 0 153)] ++                                  -- 17 : QSpecEquiv
    fixtureGround ++ fixtureSpecRows ++ fixtureClaimRows ++
    [.funa (.ext 0 932) [.ref (.loc 17)] (.ref (.loc 0)),    -- QSpecEquiv/judgment
     .funa (.ext 0 933) [.ref (.loc 17)] (.ref (.loc 2)),    -- QSpecEquiv/a
     .funa (.ext 0 934) [.ref (.loc 17)] (.ref (.loc 2))]    -- QSpecEquiv/b

/-- **The spec-equivalence tier refuses at the fragment gate.** -/
theorem refuse_specequiv_tier :
    acceptQtslOps fixtureDeps fixtureOpsSpecEquivTier = none :=
  Option.isNone_iff_eq_none.mp (by decide)

/-- The invariance-scope tier staged: a `QInvScope` row (element 18)
over a region atom (element 17), beside the intact evaluation route. -/
def fixtureOpsInvScopeTier : List GOp :=
  fixtureDecls ++
    [.elta (.ext 0 146),                                     -- 17 : QRegionAtom
     .elta (.ext 0 156)] ++                                  -- 18 : QInvScope
    fixtureGround ++ fixtureSpecRows ++ fixtureClaimRows ++
    [.funa (.ext 0 941) [.ref (.loc 18)] (.ref (.loc 0)),    -- QInvScope/judgment
     .funa (.ext 0 942) [.ref (.loc 18)] (.ref (.loc 17)),   -- QInvScope/region
     .funa (.ext 0 943) [.ref (.loc 18)] (.ref (.loc 17))]   -- QInvScope/init

/-- **The invariance-scope tier refuses at the fragment gate.** -/
theorem refuse_invscope_tier :
    acceptQtslOps fixtureDeps fixtureOpsInvScopeTier = none :=
  Option.isNone_iff_eq_none.mp (by decide)

