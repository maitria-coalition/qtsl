/-! ## The parse tie (generic) -/

/-- The sealed single-commit shape of a container's bytes, as decidable
data: the reflection reader's verdict projected to (skeleton deps, body
ops).  `none` for a refused container or any commit count ≠ 1. -/
def commitShape (bs : Bytes) : Option (List Bytes × List GOp) :=
  match readGeologSealed bs with
  | .err _ _ _ => none
  | .ok g =>
    match g.commits with
    | [commit] => some (commit.cskel.deps, commit.cbody.ops)
    | _ => none

/-- Bytes-level acceptance factors through the parse tie: a sealed
container of shape `some (deps, ops)` is accepted exactly as its op
stream. -/
theorem acceptQtslSealedW_eq_of_commitShape {bs : Bytes}
    {deps : List Bytes} {ops : List GOp}
    (h : commitShape bs = some (deps, ops)) :
    acceptQtslSealedW bs = acceptQtslOpsW deps ops := by
  unfold commitShape at h
  split at h
  any_goals contradiction
  rename_i g hread
  split at h
  any_goals contradiction
  rename_i commit hcommits
  injection h with h
  rw [Prod.mk.injEq] at h
  unfold acceptQtslSealedW
  rw [hread]
  show (match g.commits with
        | [commit] => acceptQtslOpsW commit.cskel.deps commit.cbody.ops
        | _ => none)
      = acceptQtslOpsW deps ops
  rw [hcommits]
  show acceptQtslOpsW commit.cskel.deps commit.cbody.ops
      = acceptQtslOpsW deps ops
  rw [h.1, h.2]

