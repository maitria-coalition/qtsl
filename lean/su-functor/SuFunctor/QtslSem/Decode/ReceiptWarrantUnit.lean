    commitShape realUnitBytes = some (realUnitDeps, realUnitOps) := by
  decide

/-- The unit scans against the widened pin table. -/
theorem realUnit_scan :
    scanQtslOps realUnitDeps realUnitOps = .ok realUnitTbls := by
  decide

/-- The unit assembles to the expected presentation. -/
theorem realUnit_assemble :
    assembleQtsl realUnitTbls = .ok realUnitPres := by
  decide

/-- The membership leaf's sequent decodes as expected (`rfl`, not
`decide`: `Sequent` carries no `DecidableEq`). -/
theorem realUnit_leaf_seq :
    leafSequent realUnitTbls 11 = .ok realUnitLeafSeq := by
  rfl

/-- The leaf is accepted through the ground route (`dif_pos` across the
Rat gate). -/
theorem acceptGroundLeaf_realUnit :
    acceptGroundLeaf 86 realUnitLeafSeq = some realUnitLeaf := by
  have key : acceptGroundLeaf 86 realUnitLeafSeq =
      if _h : (Formula.atom .le (.add (.mul (.const 1) (.const 2)) (.mul (.const 1) (.const 1)))
          (.const 3)).evalClosed = some true then
        some realUnitLeaf
      else none := rfl
  rw [key, dif_pos realUnitEval]

/-- The warranted claim is accepted with the expected cargo (the
fixture proof discipline: small `rfl` key equations, `decide` for the
demand-row check, the landed leaf lemma across the gate). -/
theorem acceptWarrantSat_realUnit :
    acceptWarrantSat realUnitTbls [⟨87, 80, 54, 85⟩]
      realUnitSatVal 55 87 11 = some realUnitWarrant := by
  have key : acceptWarrantSat realUnitTbls [⟨87, 80, 54, 85⟩]
      realUnitSatVal 55 87 11 =
      (if (realUnitTbls.relRows "qtsl_init_member").contains
          [.ref (.loc 85), .ref (.loc 77)] then
        match acceptLeaf realUnitTbls 86 11 with
        | none => none
        | some l =>
          some { elem := 86, sysElem := 77, fElem := 55,
                 phiElem := 54, region := ⟨87, 80, 54, 85⟩,
                 root_tie := rfl, leaf := l }
      else none) := rfl
  have hleaf : acceptLeaf realUnitTbls 86 11 = some realUnitLeaf := by
    have k2 : acceptLeaf realUnitTbls 86 11 =
        acceptGroundLeaf 86 realUnitLeafSeq := by
      unfold acceptLeaf
      rw [realUnit_leaf_seq]
    rw [k2, acceptGroundLeaf_realUnit]
  rw [key,
    if_pos (by decide :
      ((realUnitTbls.relRows "qtsl_init_member").contains
        [.ref (.loc 85), .ref (.loc 77)]) = true),
    hleaf]
  rfl

/-- The claim roster is accepted whole. -/
