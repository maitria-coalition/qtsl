    acceptClaimsW realUnitTbls realUnitPres.regionSats
      realUnitPres.sats = some [.inr realUnitWarrant] := by
  have key : acceptClaimsW realUnitTbls realUnitPres.regionSats
      realUnitPres.sats =
      (match acceptWarrantSat realUnitTbls [⟨87, 80, 54, 85⟩]
          realUnitSatVal 55 87 11 with
       | none => none
       | some aw => some [.inr aw]) := rfl
  rw [key, acceptWarrantSat_realUnit]

/-- **Ops-level acceptance**: the producer's canonical op stream is
accepted whole with the expected presentation and entry roster. -/
theorem accept_realUnit_ops :
    acceptQtslOpsW realUnitDeps realUnitOps = some realUnitAccepted := by
  have k1 : acceptQtslOpsW realUnitDeps realUnitOps =
      (match assembleQtsl realUnitTbls with
       | .error _ => none
       | .ok pres =>
         if acceptFragmentGateW pres then
           match acceptClaimsW realUnitTbls pres.regionSats
               pres.sats with
           | none => none
           | some es => some ⟨pres, es⟩
         else none) := by
    unfold acceptQtslOpsW
    rw [realUnit_scan]
    rfl
  rw [k1, realUnit_assemble]
  show (if acceptFragmentGateW realUnitPres then
          match acceptClaimsW realUnitTbls realUnitPres.regionSats
              realUnitPres.sats with
          | none => none
          | some es => some (⟨realUnitPres, es⟩ : QtslAcceptedW)
        else none) = some realUnitAccepted
  rw [if_pos (by decide :
      acceptFragmentGateW realUnitPres = true),
    acceptClaimsW_realUnit]
  rfl

