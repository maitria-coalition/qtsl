/-- The staged leaf's gate fact (`norm_num`, per the campaign's
lesson (j): closed `Rat` arithmetic is not kernel-reducible under the
`Decidable` instances). -/
theorem realUnitEval :
    (Formula.atom .le (.add (.mul (.const 1) (.const 2)) (.mul (.const 1) (.const 1)))
      (.const 3)).evalClosed = some true := by
  norm_num [Formula.evalClosed, Term.evalQ?, BowTie.evalQ]

