namespace Decode

open PPLC.Geolog (Bytes ElemRef)

/-- Pin kind: sort declarations, valued functions (constructor and
field rows share the `funa` wire shape — the reading is the
consumer's), and relations (ordinary and side-condition). -/
inductive QPinKind where
  | sort | fn | rel
  deriving Repr, DecidableEq

/-- One pinned declaration: its name, kind, and op counter in each of
the two baked closures. -/
structure QPin where
  name : String
  kind : QPinKind
  qc : Nat
  dc : Nat
  deriving Repr, DecidableEq

