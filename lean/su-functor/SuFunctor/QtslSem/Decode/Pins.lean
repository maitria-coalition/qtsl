/-- The cap-former roster: the constructor names a shallow spec
COMPONENT decode recognizes at event 4 — `ForallSpec`/`ExistsSpec`
valued formers (the component re-sort retired `Spec/root`; the
`STrue`/…/`SNot` family is now `StatePred`-valued and stays pinned
for the scan, but is no longer a component roster). -/
def capFormers : List String :=
  ["SInit",
   "SProbGE", "SProbLE", "SProbMayBeGE", "SProbMayBeLE",
   "SReturnGE", "SReturnLE", "SReturnMayBeGE", "SReturnMayBeLE",
   "SHurwiczGE", "SHurwiczLE", "SLevelGE", "SLevelLE"]

set_option maxRecDepth 2048 in
/-- Table well-formedness, checked at compile time: no duplicate
names, and no duplicate counters within either closure column.  (The
recursion-depth bump arrived with the 125-row event-4 table —
`eraseDups` recursion tips past the default around ~120 rows — and
still covers the 182-row night-2 widening.) -/
theorem qtslPins_wf :
    ((qtslPins.map QPin.name).eraseDups.length = qtslPins.length
      ∧ ((qtslPins.map QPin.qc).eraseDups.length = qtslPins.length
      ∧ (qtslPins.map QPin.dc).eraseDups.length = qtslPins.length)) := by
  decide

/-- Which pinned revision's table a dependency chid selects, and
whether it is the qc column: the primary (event 5.1) pair.  (The
event-4 legacy lane rode here between the e5.1 re-pin and the e5.1
re-emission of the real-byte warrant unit; a dep naming a superseded
revision now refuses at scan, `schema_ref_unpinned`.) -/
def closureOf (chid : Bytes) : Option (List QPin × Bool) :=
  if chid == chidQcV1 then some (qtslPins, true)
  else if chid == chidDcV1 then some (qtslPins, false)
  else none

/-- Resolve an external element reference against the pin tables: the
dependency's chid must be one of the pinned baked-closure revisions,
and the counter must be pinned in that revision's table, in that
closure's column. -/
def resolveQPin (deps : List Bytes) (r : ElemRef) : Option QPin :=
  match r with
  | .loc _ => none
  | .ext d c =>
    match deps[d]? with
    | none => none
    | some chid =>
      match closureOf chid with
      | none => none
      | some (tbl, isQc) =>
        tbl.find? (fun p => (if isQc then p.qc else p.dc) == c)

