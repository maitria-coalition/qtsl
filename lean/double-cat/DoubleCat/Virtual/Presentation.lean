import DoubleCat.Virtual
import DoubleCat.Virtual.Functor
import DoubleCat.Virtual.OfPseudo
import DoubleCat.Virtual.FreePromotion
import DoubleCat.Virtual.Promote

/-!
# Presentations of virtual double categories, and semantics off them

A deductive theory whose rules are multi-premise entailments presents a
virtual double category: objects and tight arrows form the ambient tight
category, judgment forms are the loose generators, and each rule is a
multicell generator — a finite string of judgment premises over one
judgment conclusion, framed by tight arrows.  This file constructs, in
the thin case (cells are the *existence* of a derivation, matching every
instance in this development):

* `CategoryTheory.VdcPresentation`: the generating datum — loose
  generators over a tight category, and gated rule generators with a
  `LoosePath` of premises, a single conclusion, and tight side
  boundaries.  The tight boundaries are genuinely used: presentations
  whose rules all have identity tight sides collapse to entailment
  structures over a set of judgments, while rules along nonidentity
  tight arrows (transport along a simulation, composition along a
  wiring) need the double reading.
* `CategoryTheory.VdcPresentation.DerivT` / `DerivSeqT`: the derivation
  calculus freely generated by the rules — generators, identity cells,
  and simultaneous substitution (the covering-sequence shape of
  `DoubleCat.Virtual`, with tight boundaries composing).
* `CategoryTheory.Presented`: the presented virtual double category —
  the carrier wraps the tight category, loose arrows are the loose
  generators, and a multicell is (proof-irrelevantly) the existence of
  a derivation.  Lawful by `VirtualDoubleCategory.of_subsingleton`.
* `CategoryTheory.VdcInterpretation`: an interpretation of a
  presentation in a thin pseudo double category — a tight functor, a
  loose interpretation of the generators, and **one component cell per
  gated rule generator**.  The reading (`interpDeriv`) extends
  components to all derivations by structural recursion: generators to
  components, identities to unitors, substitution to fold-composition.
* `CategoryTheory.VdcInterpretation.functor`: the induced functor of
  virtual double categories out of the presented one, and
  `CategoryTheory.VdcInterpretation.sem`: its transpose across the free
  promotion (`VirtualDoubleFunctor.promoteThin`) — a lax (indeed
  pseudo, `sem_isPseudo`) double functor from the free promotion of the
  presented virtual double category.  Functoriality on composites comes
  from the universal property, never from an induction at a call site:
  the components on the generators are the only semantic obligations.

The target is required to be *thin* (proof-irrelevant cells), which is
the hypothesis of the mechanized transpose `promoteThin`; semantics
valued in judgment layers — classes ordered by inclusion, propositions
ordered by implication — are of this kind.
-/

namespace CategoryTheory

open VirtualDoubleCategoryData VirtualDoubleCategoryStruct

universe w t v u w₂ t₂ v₂ u₂

set_option linter.checkUnivs false in
/-- A presentation of a virtual double category over a tight category
`C`: loose generators, and rule (multicell) generators.  Each rule `r`
has a composable string of loose premises `tops r`, a single loose
conclusion `bot r`, tight side boundaries `left r` and `right r`, and a
side-condition gate `gate r` (the row-shaped hypotheses under which the
rule instance is enabled). -/
structure VdcPresentation.{w', t', v', u'} (C : Type u') [Category.{v'} C] :
    Type (max u' v' (w' + 1) (t' + 1)) where
  /-- Loose generators (judgment forms) from `a` to `b`. -/
  Loose : C → C → Type w'
  /-- Rule instances (a rule tag together with its side-condition
  data). -/
  Rule : Type t'
  /-- Which instances are enabled — the side conditions as a gate. -/
  gate : Rule → Prop
  /-- Top-left corner of a rule's frame. -/
  srcL : Rule → C
  /-- Top-right corner of a rule's frame. -/
  srcR : Rule → C
  /-- Bottom-left corner of a rule's frame. -/
  tgtL : Rule → C
  /-- Bottom-right corner of a rule's frame. -/
  tgtR : Rule → C
  /-- The premise string of a rule. -/
  tops : (r : Rule) → LoosePath Loose (srcL r) (srcR r)
  /-- The conclusion of a rule. -/
  bot : (r : Rule) → Loose (tgtL r) (tgtR r)
  /-- The tight source side of a rule's multicell. -/
  left : (r : Rule) → (srcL r ⟶ tgtL r)
  /-- The tight target side of a rule's multicell. -/
  right : (r : Rule) → (srcR r ⟶ tgtR r)

namespace VdcPresentation

mutual

/-- Derivation trees over a presentation: the multicells of the virtual
double category freely generated by the rules.  Constructors: the rule
generators (gated), the identity multicell on a loose generator, and
simultaneous substitution of a covering sequence of derivations
(`DerivSeqT`) into a derivation. -/
inductive DerivT {C : Type u} [Category.{v} C]
    (P : VdcPresentation.{w, t, v, u} C) :
    ∀ {a b c d : C}, LoosePath P.Loose a b → P.Loose c d → (a ⟶ c) →
      (b ⟶ d) → Type (max u v w t)
  /-- A rule generator, enabled by its gate. -/
  | gen (r : P.Rule) (hr : P.gate r) :
      DerivT P (P.tops r) (P.bot r) (P.left r) (P.right r)
  /-- The identity multicell on a loose generator. -/
  | id {a b : C} (q : P.Loose a b) : DerivT P (.single q) q (𝟙 a) (𝟙 b)
  /-- Simultaneous substitution: a covering sequence of derivations
  splices into a derivation over the covered string. -/
  | subst {a b c d e e' : C} {qs : LoosePath P.Loose c d} {s : P.Loose e e'}
      {f : c ⟶ e} {g : d ⟶ e'} {ps : LoosePath P.Loose a b} {u : a ⟶ c}
      {v : b ⟶ d} (α : DerivT P qs s f g) (V : DerivSeqT P qs ps u v) :
      DerivT P ps s (u ≫ f) (v ≫ g)

/-- Covering sequences of derivation trees: one derivation per edge of
the covered string, consecutive entries sharing their boundary tight
arrow — the `CellSeq` shape of `DoubleCat.Virtual`, instantiated at
derivations. -/
inductive DerivSeqT {C : Type u} [Category.{v} C]
    (P : VdcPresentation.{w, t, v, u} C) :
    ∀ {a b c d : C}, LoosePath P.Loose c d → LoosePath P.Loose a b →
      (a ⟶ c) → (b ⟶ d) → Type (max u v w t)
  /-- The empty covering, at a tight arrow. -/
  | nil {a c : C} (f : a ⟶ c) : DerivSeqT P .nil .nil f f
  /-- Prepend a derivation to a covering sequence, sharing the boundary
  tight arrow. -/
  | cons {a a₁ b c c₁ d : C} {ps₁ : LoosePath P.Loose a a₁}
      {q : P.Loose c c₁} {u : a ⟶ c} {w' : a₁ ⟶ c₁}
      {qs : LoosePath P.Loose c₁ d} {rs : LoosePath P.Loose a₁ b}
      {v : b ⟶ d} (α : DerivT P ps₁ q u w')
      (V : DerivSeqT P qs rs w' v) :
      DerivSeqT P (.cons q qs) (ps₁.comp rs) u v

end

/-- Transport a covering sequence of derivations along an equality of its
domain strings (the loose-direction cast, as for `CellSeq.castDom`). -/
def DerivSeqT.castDom {C : Type u} [Category.{v} C]
    {P : VdcPresentation.{w, t, v, u} C} {a b c d : C}
    {qs : LoosePath P.Loose c d} {ps ps' : LoosePath P.Loose a b}
    {u : a ⟶ c} {v : b ⟶ d} (hp : ps = ps') (V : DerivSeqT P qs ps u v) :
    DerivSeqT P qs ps' u v :=
  hp ▸ V

/-- Transport a covering sequence of derivations along an equality of its
covered strings. -/
def DerivSeqT.castCod {C : Type u} [Category.{v} C]
    {P : VdcPresentation.{w, t, v, u} C} {a b c d : C}
    {qs qs' : LoosePath P.Loose c d} {ps : LoosePath P.Loose a b}
    {u : a ⟶ c} {v : b ⟶ d} (hq : qs = qs') (V : DerivSeqT P qs ps u v) :
    DerivSeqT P qs' ps u v :=
  hq ▸ V

end VdcPresentation

/-- The carrier of the virtual double category presented by `P`: the
tight category, wrapped so that the presented loose structure does not
collide with any structure `C` itself may carry (the `FreePromotion`
pattern). -/
structure Presented {C : Type u} [Category.{v} C]
    (P : VdcPresentation.{w, t, v, u} C) : Type u where
  /-- Wrap an object. -/
  of ::
  /-- Unwrap an object. -/
  un : C

namespace Presented

open VdcPresentation

variable {C : Type u} [Category.{v} C] {P : VdcPresentation.{w, t, v, u} C}

instance : Category.{v} (Presented P) where
  Hom a b := a.un ⟶ b.un
  id a := 𝟙 a.un
  comp f g := f ≫ g

/-- The underlying-object functor of the presented carrier: it
unwraps. -/
def unFunctor (P : VdcPresentation.{w, t, v, u} C) : Presented P ⥤ C where
  obj := Presented.un
  map f := f

/-- Read a string of loose arrows over the presented carrier as a string
of loose generators over `C` (the identity on edges, unwrapping the
endpoints). -/
abbrev pathUn {a b : Presented P}
    (ps : LoosePath (fun x y : Presented P => P.Loose x.un y.un) a b) :
    LoosePath P.Loose a.un b.un :=
  ps.map Presented.un fun {_ _} e => e

@[simp] theorem pathUn_nil {a : Presented P} :
    pathUn (.nil : LoosePath (fun x y : Presented P => P.Loose x.un y.un) a a)
      = .nil := rfl

@[simp] theorem pathUn_cons {a b c : Presented P}
    (e : P.Loose a.un b.un)
    (p : LoosePath (fun x y : Presented P => P.Loose x.un y.un) b c) :
    pathUn (.cons e p) = .cons e (pathUn p) := rfl

theorem pathUn_comp {a b c : Presented P}
    (ps : LoosePath (fun x y : Presented P => P.Loose x.un y.un) a b)
    (qs : LoosePath (fun x y : Presented P => P.Loose x.un y.un) b c) :
    pathUn (ps.comp qs) = (pathUn ps).comp (pathUn qs) :=
  LoosePath.map_comp _ _ ps qs

instance : VirtualDoubleCategoryData (Presented P) where
  Loose a b := P.Loose a.un b.un
  Cell ps q f g := PLift (Nonempty (DerivT P (pathUn ps) q f g))

instance {a b c d : Presented P} (ps : LoosePath Loose a b) (q : Loose c d)
    (f : a ⟶ c) (g : b ⟶ d) : Subsingleton (Cell ps q f g) :=
  inferInstanceAs (Subsingleton (PLift _))

/-- A covering sequence of presented multicells yields a covering
sequence of derivations. -/
theorem cellSeq_derivSeq {a b c d : Presented P}
    {qs : LoosePath Loose c d} {ps : LoosePath Loose a b} {u : a ⟶ c}
    {v : b ⟶ d} (V : CellSeq qs ps u v) :
    Nonempty (DerivSeqT P (pathUn qs) (pathUn ps) u v) := by
  induction V with
  | nil f =>
      exact ⟨((DerivSeqT.nil (P := P) f).castDom pathUn_nil.symm).castCod
        pathUn_nil.symm⟩
  | cons β V ih =>
      obtain ⟨W⟩ := ih
      obtain ⟨d⟩ := β.down
      exact ⟨(DerivSeqT.cons d W).castDom (pathUn_comp _ _).symm⟩

instance : VirtualDoubleCategoryStruct (Presented P) where
  cid q := ⟨⟨.id q⟩⟩
  ccomp α V :=
    ⟨(cellSeq_derivSeq V).elim fun W => α.down.elim fun d => ⟨d.subst W⟩⟩

/-- The presented virtual double category is lawful: its multicells are
proof-irrelevant. -/
instance : VirtualDoubleCategory (Presented P) :=
  .of_subsingleton fun _ _ _ _ => inferInstanceAs (Subsingleton (PLift _))

end Presented

section Interpretation

open VdcPresentation

variable {C : Type u} [Category.{v} C]
variable {D : Type u₂} [Category.{v₂} D]
  [PseudoDoubleCategoryStruct.{w₂, t₂, v₂, u₂} D]

open PseudoDoubleCategoryStruct in
/-- An interpretation of a presentation in a pseudo double category: a
tight functor, a loose interpretation of the generators, and one
component cell per gated rule generator — the semantic content of each
rule, on its own boundary.  Everything else (`interpDeriv`, `functor`,
`sem`) is assembly. -/
structure VdcInterpretation (P : VdcPresentation.{w, t, v, u} C)
    (D : Type u₂) [Category.{v₂} D]
    [PseudoDoubleCategoryStruct.{w₂, t₂, v₂, u₂} D] where
  /-- The action on the tight category. -/
  tight : C ⥤ D
  /-- The interpretation of the loose generators. -/
  interpLoose : ∀ {a b : C}, P.Loose a b →
    PseudoDoubleCategoryStruct.Loose (tight.obj a) (tight.obj b)
  /-- The component on a gated rule generator: a target cell from the
  fold of the interpreted premises to the interpreted conclusion, on the
  image boundary. -/
  component : ∀ (r : P.Rule), P.gate r →
    PseudoDoubleCategoryStruct.Cell
      (((P.tops r).map tight.obj fun {_ _} e => interpLoose e).fold)
      (interpLoose (P.bot r))
      (tight.map (P.left r)) (tight.map (P.right r))

namespace VdcInterpretation

attribute [local instance] VirtualDoubleCategoryStruct.ofPseudo

open PseudoDoubleCategoryStruct

variable {P : VdcPresentation.{w, t, v, u} C}

mutual

/-- **The reading of a derivation**: every derivation over the
presentation has a target cell — generators map to their components,
identities to right unitors, substitution to fold-composition.  Stated
as mere existence (the target is thin wherever this is consumed). -/
theorem interpDeriv (I : VdcInterpretation P D) {a b c d : C}
    {ps : LoosePath P.Loose a b} {q : P.Loose c d} {f : a ⟶ c}
    {g : b ⟶ d} (t : DerivT P ps q f g) :
    Nonempty (PseudoDoubleCategoryStruct.Cell
      ((ps.map I.tight.obj fun {_ _} e => I.interpLoose e).fold)
      (I.interpLoose q) (I.tight.map f) (I.tight.map g)) :=
  match ps, q, f, g, t with
  | _, _, _, _, .gen r hr => ⟨I.component r hr⟩
  | _, _, _, _, .id q => by
      exact ⟨Cell.cast (I.tight.map_id _).symm (I.tight.map_id _).symm
        (lRightUnitor (I.interpLoose q))⟩
  | _, _, _, _, .subst α V => by
      exact (interpDeriv I α).elim fun cα =>
        (interpDerivSeq I V).elim fun cV =>
          ⟨Cell.cast (I.tight.map_comp _ _).symm (I.tight.map_comp _ _).symm
            (VirtualDoubleCategoryData.seqFoldAux cV ≫ᵥ cα)⟩
termination_by structural t

/-- The reading of a covering sequence of derivations: a covering
sequence of target cells over the mapped strings. -/
theorem interpDerivSeq (I : VdcInterpretation P D) {a b c d : C}
    {qs : LoosePath P.Loose c d} {ps : LoosePath P.Loose a b}
    {u : a ⟶ c} {v : b ⟶ d} (V : DerivSeqT P qs ps u v) :
    Nonempty (CellSeq (C := D)
      (qs.map I.tight.obj fun {_ _} e => I.interpLoose e)
      (ps.map I.tight.obj fun {_ _} e => I.interpLoose e)
      (I.tight.map u) (I.tight.map v)) :=
  match qs, ps, u, v, V with
  | _, _, _, _, .nil f => by exact ⟨.nil (I.tight.map f)⟩
  | _, _, _, _, .cons α V => by
      exact (interpDeriv I α).elim fun cα =>
        (interpDerivSeq I V).elim fun cV =>
          ⟨(CellSeq.cons cα cV).castDom (LoosePath.map_comp _ _ _ _).symm⟩
termination_by structural V

end

variable (I : VdcInterpretation P D)

/-- Mapping a string over the presented carrier through the composite
object action factors through unwrapping. -/
theorem pathUn_map : ∀ {a b : Presented P}
    (ps : LoosePath (fun x y : Presented P => P.Loose x.un y.un) a b),
    ps.map (Presented.unFunctor P ⋙ I.tight).obj
        (fun {_ _} e => I.interpLoose e)
      = (Presented.pathUn ps).map I.tight.obj fun {_ _} e => I.interpLoose e
  | _, _, .nil => rfl
  | _, _, .cons _ p => congrArg (LoosePath.cons _) (pathUn_map p)

variable [PseudoDoubleCategory D]

/-- **The induced functor of virtual double categories** out of the
presented virtual double category: objects and tight arrows through the
tight functor, loose generators through the loose interpretation,
multicells through the reading of their derivations. -/
noncomputable def functor
    (hD : ∀ {a b c d : D} (m : PseudoDoubleCategoryStruct.Loose a b)
      (n : PseudoDoubleCategoryStruct.Loose c d) (f : a ⟶ c) (g : b ⟶ d),
      Subsingleton (PseudoDoubleCategoryStruct.Cell m n f g)) :
    VirtualDoubleFunctor (Presented P) D :=
  VirtualDoubleFunctor.ofThin (fun ps q f g => hD ps.fold q f g)
    (Presented.unFunctor P ⋙ I.tight)
    (fun {_ _} e => I.interpLoose e)
    (fun {_ _ _ _ ps q f g} α =>
      Eq.mp
        (congrArg
          (fun p => PseudoDoubleCategoryStruct.Cell p.fold
            (I.interpLoose q) (I.tight.map f) (I.tight.map g))
          (pathUn_map I ps).symm)
        (Classical.choice (α.down.elim fun d => interpDeriv I d)))

/-- **The semantics off the presentation**: the transpose of the induced
functor across the free promotion — a lax double functor from the free
promotion of the presented virtual double category, determined by the
components on the rule generators alone (functoriality on composites is
the universal property of the free construction). -/
noncomputable def sem
    (hD : ∀ {a b c d : D} (m : PseudoDoubleCategoryStruct.Loose a b)
      (n : PseudoDoubleCategoryStruct.Loose c d) (f : a ⟶ c) (g : b ⟶ d),
      Subsingleton (PseudoDoubleCategoryStruct.Cell m n f g)) :
    LaxDoubleFunctor (FreePromotion (Presented P)) D :=
  (functor I hD).promoteThin hD

/-- The semantics is pseudo, inherited from the transpose. -/
theorem sem_isPseudo
    (hD : ∀ {a b c d : D} (m : PseudoDoubleCategoryStruct.Loose a b)
      (n : PseudoDoubleCategoryStruct.Loose c d) (f : a ⟶ c) (g : b ⟶ d),
      Subsingleton (PseudoDoubleCategoryStruct.Cell m n f g)) :
    (sem I hD).IsPseudo :=
  (functor I hD).promoteThin_isPseudo hD

end VdcInterpretation

end Interpretation

end CategoryTheory
