import Pointfree.Valuation.Promotion
import Mathlib.Topology.Order
import Mathlib.Topology.Semicontinuity.Basic
import Mathlib.Topology.Instances.ENNReal.Lemmas

/-! # The narrow topology, and why the dagger chart forces it

Two topologies on spaces of valuations:

* On the **probability face** `Prob M`, the **lower (Scott) topology**:
  generated by the sub-basic opens `{ν | r < ν a}`.  Evaluation at
  every frame element is lower semicontinuous *by construction* — the
  point-free face of the portmanteau open half, true here by definition
  rather than by theorem.
* On the **subprobability carrier** `SubProb L`, the **narrow
  topology**: generated by the same lower half-spaces *plus* the mass
  half-spaces `{μ | μ ⊤ < r}`.  The extra generators make total mass
  upper semicontinuous — and with lower semicontinuity of `μ ↦ μ ⊤`
  already among the lower generators, mass is a (two-sidedly)
  continuous coordinate: liveness walls `{p ≤ μ ⊤}` are closed.

**The identity this module exists for** (`induced_promote_eq`): the
narrow topology *is* the plain lower topology of the promoted carrier,
pulled back along the dagger chart —

> `TopologicalSpace.induced promote (lower topology on Prob (L × Prop))`
> `= narrow topology on SubProb L`.

The mass-upper half-spaces are not an extra choice: they are the
dagger coordinate's own lower half-spaces, `{ν | 1 - r < ν (⊥, True)}`,
read through the chart.  Classically the analogous statement — total
mass is weakly continuous on subprobability measures, because the
missing mass is an honest coordinate of the one-point completion — is a
theorem about `C_b(X ⊔ {†})`; point-free it is a statement about
generated topologies, proved by rewriting sub-basic opens.  In
particular the carrier's topology is *forced* by the chart: no
convention enters beyond the Scott topology of the probability face.
-/

namespace Pointfree

open scoped ENNReal
open TopologicalSpace

variable {L : Type*} [Order.Frame L]

/-! ## ENNReal complement bookkeeping -/

theorem lt_one_sub_iff {y m : ℝ≥0∞} (hm : m ≠ ∞) :
    y < 1 - m ↔ y + m < 1 :=
  (ENNReal.cancel_of_ne hm).lt_tsub_iff_right

theorem one_sub_lt_one_sub_iff {m r : ℝ≥0∞} (hm : m ≠ ∞) (hr : r ≤ 1) :
    1 - r < 1 - m ↔ m < r := by
  rw [lt_one_sub_iff hm]
  have hcancel : AddLECancellable (1 - r : ℝ≥0∞) :=
    ENNReal.cancel_of_ne (lt_of_le_of_lt tsub_le_self ENNReal.one_lt_top).ne
  rw [← hcancel.lt_tsub_iff_left, ENNReal.sub_sub_cancel ENNReal.one_ne_top hr]

/-! ## The lower topology on the probability face -/

namespace Prob

variable (M : Type*) [Order.Frame M]

/-- Sub-basic opens of the lower (Scott) topology: evaluation
half-spaces. -/
def lowerGenerators : Set (Set (Prob M)) :=
  {S | ∃ (a : M) (r : ℝ≥0∞), S = {μ : Prob M | r < μ a}}

/-- The probability face carries the lower (Scott) topology. -/
instance instTopologicalSpace : TopologicalSpace (Prob M) :=
  generateFrom (lowerGenerators M)

variable {M}

/-- Evaluation at a frame element is lower semicontinuous **by
construction** — the point-free portmanteau open half, definitional. -/
theorem lowerSemicontinuous_eval (a : M) :
    LowerSemicontinuous fun μ : Prob M => μ a := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  exact isOpen_generateFrom_of_mem ⟨a, y, rfl⟩

end Prob

/-! ## The narrow topology on the subprobability carrier -/

namespace SubProb

variable (L)

/-- Evaluation half-spaces (the lower/Scott generators). -/
def lowerGenerators : Set (Set (SubProb L)) :=
  {S | ∃ (a : L) (r : ℝ≥0∞), S = {μ : SubProb L | r < μ a}}

/-- Mass-upper half-spaces: the generators that make total mass upper
semicontinuous. -/
def massUpperGenerators : Set (Set (SubProb L)) :=
  {S | ∃ r : ℝ≥0∞, S = {μ : SubProb L | μ ⊤ < r}}

/-- The narrow sub-basis: evaluation half-spaces together with
mass-upper half-spaces. -/
def narrowGenerators : Set (Set (SubProb L)) :=
  lowerGenerators L ∪ massUpperGenerators L

/-- The subprobability carrier carries the narrow topology. -/
instance instTopologicalSpace : TopologicalSpace (SubProb L) :=
  generateFrom (narrowGenerators L)

variable {L}

/-- Evaluation at a frame element is lower semicontinuous by
construction. -/
theorem lowerSemicontinuous_eval (a : L) :
    LowerSemicontinuous fun μ : SubProb L => μ a := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  exact isOpen_generateFrom_of_mem (Or.inl ⟨a, y, rfl⟩)

/-- Total mass is upper semicontinuous by construction. -/
theorem upperSemicontinuous_mass :
    UpperSemicontinuous fun μ : SubProb L => μ ⊤ := by
  rw [upperSemicontinuous_iff_isOpen_preimage]
  intro y
  exact isOpen_generateFrom_of_mem (Or.inr ⟨y, rfl⟩)

/-- **Liveness walls are closed**: the narrow topology is exactly rich
enough to make "at least `p` of the mass survives" a closed condition.
(The lower topology alone would not — this is what the mass generators
purchase, and the dagger chart shows the purchase is not a choice.) -/
theorem isClosed_liveness_wall (p : ℝ≥0∞) :
    IsClosed {μ : SubProb L | p ≤ μ ⊤} := by
  have h : {μ : SubProb L | p ≤ μ ⊤} = {μ : SubProb L | μ ⊤ < p}ᶜ := by
    ext μ
    simp [not_lt]
  rw [h]
  exact (isOpen_generateFrom_of_mem (Or.inr ⟨p, rfl⟩)).isClosed_compl

/-- The complement-mass coordinate `μ ↦ 1 - μ ⊤` is lower
semicontinuous — the dagger coordinate's own lower semicontinuity,
seen from the subprobability side. -/
theorem lowerSemicontinuous_one_sub_mass :
    LowerSemicontinuous fun μ : SubProb L => 1 - μ ⊤ := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  by_cases hy : y < 1
  · have h : (fun μ : SubProb L => 1 - μ ⊤) ⁻¹' Set.Ioi y
        = {μ : SubProb L | μ ⊤ < 1 - y} := by
      ext μ
      show y < 1 - μ ⊤ ↔ μ ⊤ < 1 - y
      rw [lt_one_sub_iff (μ.apply_ne_top ⊤), lt_one_sub_iff (lt_of_lt_of_le hy le_top).ne,
        add_comm]
    rw [h]
    exact isOpen_generateFrom_of_mem (Or.inr ⟨1 - y, rfl⟩)
  · have h : (fun μ : SubProb L => 1 - μ ⊤) ⁻¹' Set.Ioi y = ∅ := by
      ext μ
      simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_empty_iff_false, iff_false, not_lt]
      exact le_trans tsub_le_self (not_lt.mp hy)
    rw [h]
    exact isOpen_empty

/-! ## The identity: the narrow topology is the pulled-back Scott topology -/

open Valuation in
/-- **The dagger chart forces the narrow topology.**  The topology
induced on the subprobability carrier by the promotion — from the
*plain lower topology* of the probability face over the dagger frame —
is exactly the narrow topology: the mass-upper generators are the
dagger coordinate's own lower half-spaces, read through the chart. -/
theorem induced_promote_eq :
    TopologicalSpace.induced (promote : SubProb L → Prob (L × Prop))
        (Prob.instTopologicalSpace (L × Prop))
      = SubProb.instTopologicalSpace L := by
  classical
  rw [show Prob.instTopologicalSpace (L × Prop)
        = generateFrom (Prob.lowerGenerators (L × Prop)) from rfl,
    show SubProb.instTopologicalSpace L
        = generateFrom (narrowGenerators L) from rfl,
    induced_generateFrom_eq]
  apply le_antisymm
  · -- every narrow generator is open in the pulled-back topology
    rw [le_generateFrom_iff_subset_isOpen]
    rintro S (⟨a, r, rfl⟩ | ⟨r, rfl⟩)
    · -- evaluation half-spaces pull back from the `(a, False)` half-spaces
      have h : {μ : SubProb L | r < μ a}
          = promote ⁻¹' {ν : Prob (L × Prop) | r < ν (a, False)} := by
        ext μ
        show r < μ a ↔ r < promote μ (a, False)
        rw [promote_apply_false]
      rw [h]
      exact isOpen_generateFrom_of_mem
        (Set.mem_image_of_mem _ ⟨(a, False), r, rfl⟩)
    · -- mass half-spaces pull back from the dagger coordinate
      by_cases hr : r ≤ 1
      · have h : {μ : SubProb L | μ ⊤ < r}
            = promote ⁻¹' {ν : Prob (L × Prop) | 1 - r < ν (⊥, True)} := by
          ext μ
          show μ ⊤ < r ↔ 1 - r < promote μ (⊥, True)
          rw [promote_dagger,
            one_sub_lt_one_sub_iff (μ.apply_ne_top ⊤) hr]
        rw [h]
        exact isOpen_generateFrom_of_mem
          (Set.mem_image_of_mem _ ⟨(⊥, True), 1 - r, rfl⟩)
      · have h : {μ : SubProb L | μ ⊤ < r} = Set.univ := by
          ext μ
          simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
          exact lt_of_le_of_lt μ.mass_le_one (not_le.mp hr)
        rw [h]
        exact TopologicalSpace.GenerateOpen.univ
  · -- every pulled-back generator is narrow-open
    rw [le_generateFrom_iff_subset_isOpen]
    rintro S ⟨T, ⟨⟨a, p⟩, r, rfl⟩, rfl⟩
    have h : promote ⁻¹' {ν : Prob (L × Prop) | r < ν (a, p)}
        = {μ : SubProb L | r < μ a + Valuation.daggerInd (1 - μ ⊤) p} := rfl
    rw [h]
    -- the target is a sublevel-complement of a lower semicontinuous map
    have hlsc : LowerSemicontinuous
        fun μ : SubProb L => μ a + Valuation.daggerInd (1 - μ ⊤) p := by
      by_cases hp : p
      · simp only [Valuation.daggerInd_of hp]
        exact (lowerSemicontinuous_eval a).add lowerSemicontinuous_one_sub_mass
      · simp only [Valuation.daggerInd_of_not hp, add_zero]
        exact lowerSemicontinuous_eval a
    exact lowerSemicontinuous_iff_isOpen_preimage.mp hlsc r

/-- The dagger chart as a homeomorphism: the subprobability carrier
with its narrow topology is the probability face of the dagger frame
with its plain lower topology. -/
noncomputable def promoteHomeomorph : SubProb L ≃ₜ Prob (L × Prop) :=
  (promoteEquiv (L := L)).toHomeomorphOfIsInducing ⟨induced_promote_eq.symm⟩

@[simp] theorem promoteHomeomorph_apply (μ : SubProb L) :
    (promoteHomeomorph (L := L)) μ = promote μ := rfl

theorem continuous_promote : Continuous (promote : SubProb L → Prob (L × Prop)) :=
  (promoteHomeomorph (L := L)).continuous

theorem continuous_restrict :
    Continuous (Prob.restrict : Prob (L × Prop) → SubProb L) :=
  (promoteHomeomorph (L := L)).symm.continuous

end SubProb

end Pointfree
