#print axioms Qtsl.DiamondSite.interior_le_subset_chron
#print axioms Qtsl.DiamondSite.interior_le_eq_chron
#print axioms Qtsl.DiamondSite.mem_closure_chronUp_iff
#print axioms Qtsl.DiamondSite.isOpen_chron_rel_interval
#print axioms Qtsl.DiamondSite.interior_le_eq_chron_interval
#print axioms Qtsl.DiamondSite.interior_le_eq_lt_real
