import QtslAux.DiamondSite
import Mathlib.Topology.Bases
import Mathlib.Topology.Order.Basic
import Mathlib.Topology.MetricSpace.Pseudo.Lemmas

/-! # Chronology as the interior of causality: the order-theoretic identification

The interior-pair record locus (the general-support replacement for the
per-timeline bundle form, in the semantic-universe development) is
stated on the **interior of the comparability relation**; its
closedness theorem consumes openness of that interior — the (S1) site
hypothesis.  This module supplies the order-theoretic content at
`ChronologyKit` generality (the Martin–Panangaden bicontinuity
fragment, arXiv:gr-qc/0407094 — no manifold, no metric):

* **`isOpen_chron_rel`** — over any topology in which the chronological
  rays `↟a = {x | a ≪ x}` and `↡b = {x | x ≪ b}` are open, the
  chronology relation is open in `X × X`: one interpolation
  `x ≪ m ≪ y` yields the product-open box `↡m ×ˢ ↟m` inside `≪`, by
  the kit's mixing laws.  (A single interpolation suffices; the
  two-endpoint form is not needed here.)

* **`interior_le_subset_chron` / `interior_le_eq_chron`** — with the
  **chronological density** `p ∈ closure ↟p`, push-up identifies the
  interior of the causal order with chronology:
  `int(≤) = ≪` in `X × X`.  The inclusion `≪ ⊆ int(≤)` is ray-openness
  plus `le_of_chron`; the converse takes a product-open box inside
  `≤`, a chronological successor `s'` of `s` inside its side (density),
  and pushes up: `s ≪ s' ≤ t`.

* **`intervalTopology`** — the topology generated by the rays — and
  **`mem_closure_chronUp_iff`**: in the interval topology, the density
  at `p` holds **iff `p` has a chronological successor at all**.
  Density is an `interpolate` + `up_filtered` consequence (the
  filtered half of bicontinuity — the derived Grothendieck topology
  consumed only the mixing laws and interpolation; this is where the
  remaining fields earn their keep at the point-set grade), but only
  on points with nonempty chronological future: the bare kit admits
  maxima, and at a chronological maximum the density fails with the
  future empty.  The corollaries `isOpen_chron_rel_interval` and
  `interior_le_eq_chron_interval` (under future-nonemptiness) package
  the identification for the interval topology itself.

* **the classical column** (`interior_le_eq_lt_real`): at
  `linearOrderKit ℝ` with the standard topology,
  `int(≤) = (<)` in `ℝ × ℝ` — rays are `Ioi`/`Iio`, density is
  `closure_Ioi`.  The (0+1)-dimensional shadow of the identification,
  witnessed concretely.

On a globally hyperbolic spacetime the instantiation reads:
`int(J⁺) = I⁺` with the interval topology the manifold topology
(Martin–Panangaden); the one genuinely metric site hypothesis of the
record-locus theorem — upper semicontinuity of the time-separation —
is *not* order-theoretic and is deliberately not claimed here (in a
general spacetime the time-separation is only lower semicontinuous;
upper semicontinuity is where global hyperbolicity is consumed —
classical Lorentzian geometry, cited at the chapter, not
formalized). -/

namespace Qtsl
namespace DiamondSite

open Set Topology TopologicalSpace

variable {X : Type*} [PartialOrder X] {K : ChronologyKit X}

/-! ## The chronological rays -/

/-- The chronological future ray `↟a`. -/
def chronUp (K : ChronologyKit X) (a : X) : Set X := {x | K.chron a x}

/-- The chronological past ray `↡b`. -/
def chronDown (K : ChronologyKit X) (b : X) : Set X := {x | K.chron x b}

@[simp]
theorem mem_chronUp {a x : X} : x ∈ chronUp K a ↔ K.chron a x := Iff.rfl

@[simp]
theorem mem_chronDown {b x : X} : x ∈ chronDown K b ↔ K.chron x b := Iff.rfl

/-! ## The identification, over any ray-compatible topology -/

section Compatible

variable [TopologicalSpace X]

/-- **Chronology is open** wherever the chronological rays are open:
one interpolation `x ≪ m ≪ y` places `(x, y)` in the product-open box
`↡m ×ˢ ↟m`, which the mixing laws keep inside `≪`. -/
theorem isOpen_chron_rel (hup : ∀ a, IsOpen (chronUp K a))
    (hdown : ∀ b, IsOpen (chronDown K b)) :
    IsOpen {r : X × X | K.chron r.1 r.2} := by
  rw [isOpen_iff_forall_mem_open]
  rintro ⟨x, y⟩ hxy
  obtain ⟨m, hxm, hmy⟩ := K.interpolate hxy
  refine ⟨chronDown K m ×ˢ chronUp K m, ?_, (hdown m).prod (hup m),
    ⟨hxm, hmy⟩⟩
  rintro ⟨u, v⟩ ⟨hu, hv⟩
  exact K.chron_of_le_chron (K.le_of_chron hu) hv

/-- Chronology sits inside the interior of causality: ray-openness
plus `le_of_chron`. -/
theorem chron_subset_interior_le (hup : ∀ a, IsOpen (chronUp K a))
    (hdown : ∀ b, IsOpen (chronDown K b)) :
    {r : X × X | K.chron r.1 r.2} ⊆ interior {r : X × X | r.1 ≤ r.2} :=
  interior_maximal (fun _ hr => K.le_of_chron hr)
    (isOpen_chron_rel hup hdown)

/-- **Push-up eats the interior**: under chronological density
(`p ∈ closure ↟p`), an interior point of the causal order is a
chronological pair — a product-open box inside `≤` contains a
chronological successor `s'` of `s` on its first side, and
`s ≪ s' ≤ t` pushes up. -/
theorem interior_le_subset_chron
    (hdens : ∀ p : X, p ∈ closure (chronUp K p)) :
    interior {r : X × X | r.1 ≤ r.2} ⊆ {r : X × X | K.chron r.1 r.2} := by
  rintro ⟨s, t⟩ hst
  obtain ⟨O, hOsub, hOopen, hmemO⟩ := mem_interior.mp hst
  obtain ⟨U, V, hU, hV, hsU, htV, hUV⟩ := isOpen_prod_iff.mp hOopen s t hmemO
  obtain ⟨s', hs'U, hs's⟩ := mem_closure_iff.mp (hdens s) U hU hsU
  have hs't : s' ≤ t := hOsub (hUV (mk_mem_prod hs'U htV))
  exact K.chron_of_chron_le hs's hs't

/-- **The identification**: over a ray-compatible topology with
chronological density, chronology *is* the interior of causality —
`int(≤) = ≪` in `X × X`.  The (S1) site hypothesis of the interior-pair
record locus, discharged order-theoretically. -/
theorem interior_le_eq_chron (hup : ∀ a, IsOpen (chronUp K a))
    (hdown : ∀ b, IsOpen (chronDown K b))
    (hdens : ∀ p : X, p ∈ closure (chronUp K p)) :
    interior {r : X × X | r.1 ≤ r.2} = {r : X × X | K.chron r.1 r.2} :=
  Subset.antisymm (interior_le_subset_chron hdens)
    (chron_subset_interior_le hup hdown)

end Compatible

/-! ## The interval topology, and density from interpolation -/

/-- The **interval topology** of a chronology kit: generated by the
chronological rays.  On a globally hyperbolic spacetime this is the
manifold topology (Martin–Panangaden); on a dense linear order it is
the order topology's open-interval base. -/
@[reducible]
def intervalTopology (K : ChronologyKit X) : TopologicalSpace X :=
  .generateFrom (range (chronUp K) ∪ range (chronDown K))

theorem isOpen_chronUp_interval (a : X) :
    IsOpen[intervalTopology K] (chronUp K a) :=
  isOpen_generateFrom_of_mem (.inl ⟨a, rfl⟩)

theorem isOpen_chronDown_interval (b : X) :
    IsOpen[intervalTopology K] (chronDown K b) :=
  isOpen_generateFrom_of_mem (.inr ⟨b, rfl⟩)

/-- The finite-constraint step of the density argument: a point with
*some* chronological successor has one below finitely many
chronological upper bounds and above `p` — `interpolate` shrinks
toward one bound, `up_filtered` reconciles with the running witness,
and only the down-ray constraints ever need the shrink (up-ray
membership regenerates by push-up from `p` itself). -/
private theorem exists_chron_mem_sInter (K : ChronologyKit X) {p : X}
    (hne : ∃ x, K.chron p x) :
    ∀ {f : Set (Set X)}, f.Finite →
      f ⊆ range (chronUp K) ∪ range (chronDown K) → p ∈ ⋂₀ f →
      ∃ x, K.chron p x ∧ x ∈ ⋂₀ f := by
  intro f hf
  induction f, hf using Set.Finite.induction_on with
  | empty =>
      intro _ _
      obtain ⟨x, hx⟩ := hne
      exact ⟨x, hx, by simp⟩
  | @insert t f htf hffin ih =>
      intro hsub hp
      have hpf : p ∈ ⋂₀ f := fun u hu => hp u (mem_insert_of_mem _ hu)
      have hpt : p ∈ t := hp t (mem_insert _ _)
      obtain ⟨x, hpx, hxf⟩ :=
        ih (fun u hu => hsub (mem_insert_of_mem _ hu)) hpf
      rcases hsub (mem_insert t f) with ⟨a, rfl⟩ | ⟨b, rfl⟩
      · -- an up-ray constraint: the running witness already serves,
        -- membership regenerating by push-up from `p`
        refine ⟨x, hpx, ?_⟩
        rintro u (rfl | hu)
        · exact K.chron_of_chron_le hpt (K.le_of_chron hpx)
        · exact hxf u hu
      · -- a down-ray constraint: interpolate toward the bound and
        -- reconcile with the running witness
        have hpb : K.chron p b := hpt
        obtain ⟨cmid, hpc, hcb⟩ := K.interpolate hpb
        obtain ⟨x', hpx', hx'x, hx'c⟩ := K.up_filtered hpx hpc
        refine ⟨x', hpx', ?_⟩
        rintro u (rfl | hu)
        · exact K.chron_of_le_chron hx'c hcb
        · rcases hsub (mem_insert_of_mem _ hu) with ⟨a, rfl⟩ | ⟨b', rfl⟩
          · exact K.chron_of_chron_le (hpf _ hu) (K.le_of_chron hpx')
          · exact K.chron_of_le_chron hx'x (hxf _ hu)

/-- **Chronological density, priced exactly**: in the interval
topology, `p ∈ closure ↟p` iff `p` has a chronological successor at
all.  Density is an interpolation consequence — but only where the
chronological future is nonempty: the bare kit admits maxima, and
there the density fails (the closure of the empty ray is empty).  This
is the honest boundary of "density comes free from bicontinuity". -/
theorem mem_closure_chronUp_iff (K : ChronologyKit X) (p : X) :
    letI := intervalTopology K
    p ∈ closure (chronUp K p) ↔ ∃ x, K.chron p x := by
  letI := intervalTopology K
  constructor
  · intro hp
    by_contra hne
    have hempty : chronUp K p = ∅ :=
      eq_empty_iff_forall_notMem.mpr fun x hx => hne ⟨x, hx⟩
    rw [hempty, closure_empty] at hp
    exact hp
  · intro hne
    rw [mem_closure_iff]
    intro O hO hpO
    obtain ⟨b, hbB, hpb, hbO⟩ :=
      (isTopologicalBasis_of_subbasis
        (rfl : intervalTopology K = _)).exists_subset_of_mem_open hpO hO
    obtain ⟨f, ⟨hffin, hfsub⟩, rfl⟩ := hbB
    obtain ⟨x, hpx, hxf⟩ := exists_chron_mem_sInter K hne hffin hfsub hpb
    exact ⟨x, hbO hxf, hpx⟩

/-- Chronology is open in the interval topology: the rays generate. -/
theorem isOpen_chron_rel_interval (K : ChronologyKit X) :
    letI := intervalTopology K
    IsOpen {r : X × X | K.chron r.1 r.2} := by
  letI := intervalTopology K
  exact isOpen_chron_rel (fun a => isOpen_chronUp_interval a)
    (fun b => isOpen_chronDown_interval b)

/-- **The identification at the interval topology**: on a kit with no
chronological maxima (every point has a successor — a globally
hyperbolic window's interior, the open classical timeline),
`int(≤) = ≪` in the interval topology.  The two lemmas the
interior-pair record locus names as its (S1), packaged at bicontinuous
generality. -/
theorem interior_le_eq_chron_interval (K : ChronologyKit X)
    (hfut : ∀ p : X, ∃ x, K.chron p x) :
    letI := intervalTopology K
    interior {r : X × X | r.1 ≤ r.2} = {r : X × X | K.chron r.1 r.2} := by
  letI := intervalTopology K
  exact interior_le_eq_chron (fun a => isOpen_chronUp_interval a)
    (fun b => isOpen_chronDown_interval b)
    (fun p => (mem_closure_chronUp_iff K p).mpr (hfut p))

/-! ## The classical column, witnessed -/

/-- **The (0+1)-dimensional shadow**: on `ℝ` with the standard
topology and the classical kit (`chron = <`), the interior of `≤` in
`ℝ × ℝ` is `<`.  Rays are `Ioi`/`Iio`; density is `closure_Ioi`. -/
theorem interior_le_eq_lt_real :
    interior {r : ℝ × ℝ | r.1 ≤ r.2} = {r : ℝ × ℝ | r.1 < r.2} :=
  interior_le_eq_chron (K := linearOrderKit ℝ)
    (fun a => isOpen_Ioi) (fun b => isOpen_Iio)
    (fun p => by
      show p ∈ closure (Ioi p)
      rw [closure_Ioi]
      exact self_mem_Ici)

end DiamondSite
end Qtsl

