import QtslAux.Imprecise.Credal
import Mathlib.Data.Fintype.Pi

/-! # Composition of credal sets and the Hurwicz criterion

This module composes finite credal sets in two stages and analyses how the
lower/upper expectation envelopes and the Hurwicz criterion behave under
composition.

* `FinPMF.compProd p q`: the joint law on `X × Y` of a first stage `p : FinPMF X`
  and a transition family `q : X → FinPMF Y`, with the Fubini-style identity
  `FinPMF.exp_compProd`.
* `compFam M K`: the composite credal set on `X × Y` generated by a first-stage
  credal set `M : ι → FinPMF X` and, for each `x`, a second-stage credal set
  `K x : κ x → FinPMF Y`; a member is indexed by a first-stage index together
  with a selection `σ : (x : X) → κ x` choosing a second-stage member at
  every `x`.
* `lowerE_compFam` / `upperE_compFam`: the tower (iterated-expectation) laws for
  the envelopes — the composite lower expectation is the iterated lower
  expectation, and dually for the upper; `le_lowerE_compFam` is the associated
  one-sided certificate rule.
* `hurwicz α M f = α * upperE M f + (1 - α) * lowerE M f`, the Hurwicz
  optimism-pessimism mixture, with its two composite evaluations `rootHurwicz`
  (evaluated on the composite credal set) and `stagewiseHurwicz` (evaluated
  stage by stage). At the endpoints the two agree (`stagewiseHurwicz_zero`,
  `stagewiseHurwicz_one`), and `rootHurwicz_eq_mix` writes the root evaluation
  as the `α`-mixture of the endpoint evaluations; strictly between the
  endpoints the two evaluations differ in general (see
  `QtslAux.Imprecise.TowerWitness`).
-/

namespace Qtsl.Imprecise

open Finset

section CompProd

variable {X Y : Type*} [Fintype X] [Fintype Y]

def FinPMF.compProd (p : FinPMF X) (q : X → FinPMF Y) : FinPMF (X × Y) where
  prob := fun xy => p.prob xy.1 * (q xy.1).prob xy.2
  nonneg := fun xy => mul_nonneg (p.nonneg _) ((q xy.1).nonneg _)
  total := by
    rw [← Finset.univ_product_univ, Finset.sum_product]
    have h : ∀ x : X, ∑ y : Y, p.prob x * (q x).prob y = p.prob x := fun x => by
      rw [← Finset.mul_sum, (q x).total, mul_one]
    rw [Finset.sum_congr rfl fun x _ => h x, p.total]

theorem FinPMF.exp_compProd (p : FinPMF X) (q : X → FinPMF Y) (f : X × Y → ℚ) :
    (p.compProd q).exp f = p.exp fun x => (q x).exp fun y => f (x, y) := by
  simp only [FinPMF.exp, FinPMF.compProd]
  rw [← Finset.univ_product_univ, Finset.sum_product]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun y _ => by dsimp only; exact mul_assoc _ _ _

end CompProd

section CompFam

variable {X Y : Type*} [Fintype X] [Fintype Y] [DecidableEq X]
variable {ι : Type*} [Fintype ι] [Nonempty ι]
variable {κ : X → Type*} [∀ x, Fintype (κ x)] [∀ x, Nonempty (κ x)]

def compFam (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y) :
    ι × ((x : X) → κ x) → FinPMF (X × Y) :=
  fun iσ => (M iσ.1).compProd fun x => K x (iσ.2 x)

theorem lowerE_compFam (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) :
    lowerE (compFam M K) f
      = lowerE M fun x => lowerE (K x) fun y => f (x, y) := by
  apply le_antisymm
  ·
    obtain ⟨i₀, hi₀⟩ := exists_eq_lowerE M fun x => lowerE (K x) fun y => f (x, y)
    choose σ hσ using fun x => exists_eq_lowerE (K x) fun y => f (x, y)
    calc lowerE (compFam M K) f
        ≤ (compFam M K (i₀, σ)).exp f := lowerE_le_exp _ f (i₀, σ)
      _ = (M i₀).exp fun x => (K x (σ x)).exp fun y => f (x, y) :=
          FinPMF.exp_compProd _ _ f
      _ = (M i₀).exp fun x => lowerE (K x) fun y => f (x, y) :=
          (M i₀).exp_congr fun x => (hσ x).symm
      _ = lowerE M fun x => lowerE (K x) fun y => f (x, y) := hi₀.symm
  ·
    refine le_lowerE ?_
    rintro ⟨i, σ⟩
    rw [show compFam M K (i, σ) = (M i).compProd fun x => K x (σ x) from rfl,
      FinPMF.exp_compProd]
    calc lowerE M (fun x => lowerE (K x) fun y => f (x, y))
        ≤ (M i).exp fun x => lowerE (K x) fun y => f (x, y) :=
          lowerE_le_exp M _ i
      _ ≤ (M i).exp fun x => (K x (σ x)).exp fun y => f (x, y) :=
          (M i).exp_mono fun x => lowerE_le_exp (K x) _ (σ x)

theorem upperE_compFam (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) :
    upperE (compFam M K) f
      = upperE M fun x => upperE (K x) fun y => f (x, y) := by
  apply le_antisymm
  ·
    refine upperE_le ?_
    rintro ⟨i, σ⟩
    rw [show compFam M K (i, σ) = (M i).compProd fun x => K x (σ x) from rfl,
      FinPMF.exp_compProd]
    calc (M i).exp (fun x => (K x (σ x)).exp fun y => f (x, y))
        ≤ (M i).exp fun x => upperE (K x) fun y => f (x, y) :=
          (M i).exp_mono fun x => exp_le_upperE (K x) _ (σ x)
      _ ≤ upperE M fun x => upperE (K x) fun y => f (x, y) :=
          exp_le_upperE M _ i
  ·
    obtain ⟨i₀, hi₀⟩ := exists_eq_upperE M fun x => upperE (K x) fun y => f (x, y)
    choose σ hσ using fun x => exists_eq_upperE (K x) fun y => f (x, y)
    calc upperE M (fun x => upperE (K x) fun y => f (x, y))
        = (M i₀).exp fun x => upperE (K x) fun y => f (x, y) := hi₀
      _ = (M i₀).exp fun x => (K x (σ x)).exp fun y => f (x, y) :=
          (M i₀).exp_congr fun x => hσ x
      _ = (compFam M K (i₀, σ)).exp f := (FinPMF.exp_compProd _ _ f).symm
      _ ≤ upperE (compFam M K) f := exp_le_upperE _ f (i₀, σ)

theorem le_lowerE_compFam (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) (V₂ : X → ℚ) (v₁ : ℚ)
    (h₂ : ∀ x (j : κ x), V₂ x ≤ (K x j).exp fun y => f (x, y))
    (h₁ : ∀ i, v₁ ≤ (M i).exp V₂) :
    v₁ ≤ lowerE (compFam M K) f := by
  refine le_lowerE ?_
  rintro ⟨i, σ⟩
  rw [show compFam M K (i, σ) = (M i).compProd fun x => K x (σ x) from rfl,
    FinPMF.exp_compProd]
  exact (h₁ i).trans ((M i).exp_mono fun x => h₂ x (σ x))

end CompFam

section HurwiczDef

variable {X : Type*} [Fintype X] {ι : Type*} [Fintype ι] [Nonempty ι]

def hurwicz (α : ℚ) (M : ι → FinPMF X) (f : X → ℚ) : ℚ :=
  α * upperE M f + (1 - α) * lowerE M f

@[simp] theorem hurwicz_zero (M : ι → FinPMF X) (f : X → ℚ) :
    hurwicz 0 M f = lowerE M f := by simp [hurwicz]

@[simp] theorem hurwicz_one (M : ι → FinPMF X) (f : X → ℚ) :
    hurwicz 1 M f = upperE M f := by simp [hurwicz]

end HurwiczDef

section Hurwicz

variable {X Y : Type*} [Fintype X] [Fintype Y] [DecidableEq X]
variable {ι : Type*} [Fintype ι] [Nonempty ι]
variable {κ : X → Type*} [∀ x, Fintype (κ x)] [∀ x, Nonempty (κ x)]

def rootHurwicz (α : ℚ) (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) : ℚ :=
  hurwicz α (compFam M K) f

def stagewiseHurwicz (α : ℚ) (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) : ℚ :=
  hurwicz α M fun x => hurwicz α (K x) fun y => f (x, y)

theorem stagewiseHurwicz_zero (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) :
    stagewiseHurwicz 0 M K f = lowerE (compFam M K) f := by
  unfold stagewiseHurwicz
  rw [hurwicz_zero, lowerE_compFam]
  exact lowerE_congr fun x => hurwicz_zero (K x) fun y => f (x, y)

theorem stagewiseHurwicz_one (M : ι → FinPMF X) (K : (x : X) → κ x → FinPMF Y)
    (f : X × Y → ℚ) :
    stagewiseHurwicz 1 M K f = upperE (compFam M K) f := by
  unfold stagewiseHurwicz
  rw [hurwicz_one, upperE_compFam]
  exact upperE_congr fun x => hurwicz_one (K x) fun y => f (x, y)

theorem rootHurwicz_eq_mix (α : ℚ) (M : ι → FinPMF X)
    (K : (x : X) → κ x → FinPMF Y) (f : X × Y → ℚ) :
    rootHurwicz α M K f
      = α * stagewiseHurwicz 1 M K f + (1 - α) * stagewiseHurwicz 0 M K f := by
  rw [stagewiseHurwicz_one, stagewiseHurwicz_zero]
  rfl

end Hurwicz

end Qtsl.Imprecise
