import QtslAux.QuantumOuterStorey

/-! # The (ℰ, D)-structure: quantum measures on a finite index, and conservativity

The outer-storey linearization, kernel-checked at finite grade: the
index of alternatives (for the outer storey: causal orders/profiles)
acquires a **quantum measure** — Sorkin's grade-2 measure, presented by
its decoherence functional — and records on the index classicalize it
back to an ordinary probability row. Everything here is finite: the
atom set `ι` is a `Fintype`, the event algebra is `Finset ι` (every
finite Boolean algebra is the powerset of its atoms), and the derived
History space is finite-dimensional linear algebra.

* **The structure.** `QuantumMeasure ι` packages atom-level Gram data:
  a matrix `gram : Matrix ι ι ℂ`, positive semidefinite (hermiticity
  included) and normalized (`∑∑ gram = 1`). The **event form**
  `eventForm A B = ∑_{a∈A} ∑_{b∈B} gram a b` then provably satisfies
  the Gell-Mann–Hartle/Dowker–Johnston–Sorkin axioms: hermitian
  (`eventForm_conj`), bi-additive over disjoint joins
  (`eventForm_union_left`/`_right`), strongly positive — the
  event-level Gram matrix is itself positive semidefinite
  (`eventGram_posSemidef`, by the incidence-matrix sandwich) — and
  normalized at the top event (`eventForm_univ`). The diagonal
  `sorkinMeasure A = eventForm A A` is a grade-2 measure in Sorkin's
  sum-rule hierarchy (gr-qc/9401003): the grade-3 sum rule holds
  identically (`sorkin_grade3` — from bi-additivity alone, no
  positivity consumed), while grade-2 interference (`interference`)
  is nonvanishing on the coherent-switch witness below.

* **Presentations.** The decoherence functional of any family of class
  operators at a state is positive semidefinite as a matrix on the
  index (`presentationGram_posSemidef`, the Gram factorization
  `Wᴴ * W`), so every presentation with unit total weight yields a
  quantum measure (`ofPresentation`) — the compilation direction:
  amplitudes enter upstream, only their Gram shadow becomes structure.

* **Conservativity.** A diagonal quantum measure IS the classical
  embedding of its probability row, as a structure equality
  (`isDiagonal_eq_classical`): the event form collapses to the
  intersection measure (`isDiagonal_eventForm_inter`), interference
  vanishes (`isDiagonal_interference`) and additivity is restored
  (`isDiagonal_additive`) — grade 2 degenerates to grade 1. Records on
  the index force exactly this: `records_conservativity` chains the
  record hypotheses through `records_imply_medium` — whose index type
  was always generic — so a recorded presentation's quantum measure
  equals a classical one, and `records_eventForm` states the collapse
  concretely: the entire complex event form is the intersection
  measure of the branch-weight row. The classical, set-indexed
  picture is the record-rich fixed point; the D-form field costs
  nothing there.

* **The derived History space** (Dowker–Johnston–Sorkin,
  arXiv:1002.0589 §§3.1–3.2, at finite grade where completion is
  vacuous). The free vector space on events is `Finset ι → ℂ`; the
  degenerate inner product is `gnsForm u v = star u ⬝ᵥ (eventGram *ᵥ
  v)`; the null space is the kernel of the event Gram matrix, and
  membership is characterized by the vanishing of the form
  (`mem_gnsNull_iff`, via positive semidefiniteness). The quotient
  `HistoryHilbert` identifies events exactly when the form cannot
  distinguish them (`mk_eq_mk_iff`). Bi-additivity makes the
  additivity-defect vectors `δ_A + δ_B − δ_{A⊔B}` null
  (`defectVector_mem_gnsNull`) — linear structure is generated by
  events and cut down by exactly what the measure cannot distinguish —
  and consequently the atom classes span the whole space
  (`span_atomClasses`): 2^|ι| generators collapse to at most |ι|.
  Spanning is claimed, injectivity deliberately not: null atoms are
  possible (a zero-weight branch's class is zero).

* **Witnesses on an index of orders.** `switchMeasure` — the
  `QuantumOuterStorey` coherent switch, normalized — is a quantum
  measure on `SwitchOrder`
  whose grade-2 interference is `2/5 ≠ 0`
  (`switchMeasure_interference`, `switchMeasure_not_isDiagonal`):
  strictly quantum on an index of temporal orders. `controlledMeasure`
  — the same switch with an orthogonal pointer — is diagonal
  (`controlledMeasure_isDiagonal`) and literally equal to a classical
  measure (`controlledMeasure_eq_classical`): the regime pair of the
  outer-storey design at measure grade. `zMeasure` — a recorded
  two-outcome presentation on the 3-4-5 state — exercises
  `records_conservativity` end-to-end with an explicit record family
  (`zMeasure_conservative`), probability row `(9/25, 16/25)`
  (`zMeasure_probRow`).

Scope fences inherited from the record tier: finite index, matrix
grade, pure states in the presentations; continuum event algebras
(Isham–Linden territory) are out of scope. ℂ enters in exactly one
place: the codomain of `gram`. -/

namespace Qtsl

namespace QuantumDForm

open Matrix QuantumRecords QuantumOuterStorey
open scoped ComplexOrder Kronecker

variable {ι : Type*} [Fintype ι]

/-- A **quantum measure structure** on a finite index of mutually
exclusive alternatives (Sorkin's grade-2 measure, presented by its
atom-level Gram data): a positive semidefinite complex matrix with
unit total weight. The event form and its Sorkin measure are derived
below; the Gell-Mann–Hartle/Dowker–Johnston–Sorkin axioms are theorems
about them. -/
structure QuantumMeasure (ι : Type*) [Fintype ι] where
  /-- The atom-level decoherence data: `gram α β` is the overlap of
  alternatives `α` and `β`. -/
  gram : Matrix ι ι ℂ
  /-- Strong positivity (hermiticity included). -/
  posSemidef : gram.PosSemidef
  /-- Unit total weight: the top event has measure one. -/
  normalized : ∑ α, ∑ β, gram α β = 1

namespace QuantumMeasure

/-- A quantum measure is determined by its Gram data. -/
theorem ext {Q₁ Q₂ : QuantumMeasure ι} (h : Q₁.gram = Q₂.gram) : Q₁ = Q₂ := by
  cases Q₁
  cases Q₂
  subst h
  rfl

variable (Q : QuantumMeasure ι)

/-! ## The event algebra: `Finset ι` is the general finite case -/

/-- The event form: the bi-additive extension of the Gram data to the
event algebra `Finset ι`. -/
noncomputable def eventForm (A B : Finset ι) : ℂ :=
  ∑ a ∈ A, ∑ b ∈ B, Q.gram a b

/-- The Sorkin (quantum) measure: the diagonal of the event form. -/
noncomputable def sorkinMeasure (A : Finset ι) : ℂ := Q.eventForm A A

/-- **Axiom 1 (hermitian)**: the event form is conjugate-symmetric. -/
theorem eventForm_conj (A B : Finset ι) :
    Q.eventForm B A = star (Q.eventForm A B) := by
  simp only [eventForm, star_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
  exact (Q.posSemidef.1.apply b a).symm

/-- **Axiom 2 (bi-additive), left**: additive in the first argument
over disjoint joins. -/
theorem eventForm_union_left [DecidableEq ι] {A₁ A₂ : Finset ι}
    (h : Disjoint A₁ A₂) (B : Finset ι) :
    Q.eventForm (A₁ ∪ A₂) B = Q.eventForm A₁ B + Q.eventForm A₂ B := by
  simp only [eventForm]
  exact Finset.sum_union h

/-- **Axiom 2 (bi-additive), right**. -/
theorem eventForm_union_right [DecidableEq ι] (A : Finset ι)
    {B₁ B₂ : Finset ι} (h : Disjoint B₁ B₂) :
    Q.eventForm A (B₁ ∪ B₂) = Q.eventForm A B₁ + Q.eventForm A B₂ := by
  simp only [eventForm]
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun a _ => Finset.sum_union h

/-- The event-level Gram matrix: the event form as a matrix on the
(finite) event algebra. -/
noncomputable def eventGram : Matrix (Finset ι) (Finset ι) ℂ :=
  Matrix.of fun A B => Q.eventForm A B

/-- **Axiom 3 (strongly positive)**: the event-level Gram matrix is
positive semidefinite — by the incidence-matrix sandwich `Nᴴ * gram *
N`, where `N a A = [a ∈ A]`. -/
theorem eventGram_posSemidef [DecidableEq ι] : Q.eventGram.PosSemidef := by
  have h : Q.eventGram
      = (Matrix.of fun (a : ι) (A : Finset ι) => if a ∈ A then (1 : ℂ) else 0)ᴴ
        * Q.gram
        * (Matrix.of fun (a : ι) (A : Finset ι) => if a ∈ A then (1 : ℂ) else 0) := by
    ext A B
    simp only [eventGram, Matrix.of_apply, eventForm, Matrix.mul_apply,
      Matrix.conjTranspose_apply, apply_ite (star : ℂ → ℂ), star_one,
      star_zero, ite_mul, mul_ite, one_mul, mul_one, zero_mul, mul_zero,
      Finset.sum_ite_mem, Finset.univ_inter]
    rw [Finset.sum_comm]
  rw [h]
  exact Q.posSemidef.conjTranspose_mul_mul_same _

/-- **Axiom 4 (normalized)**: the top event has unit measure. -/
theorem eventForm_univ : Q.eventForm Finset.univ Finset.univ = 1 :=
  Q.normalized

/-! ## The Sorkin hierarchy: quantum is grade 2 -/

/-- The grade-2 identity: the measure of a disjoint union exceeds the
sum of its parts by the two cross terms of the event form. -/
theorem sorkinMeasure_union [DecidableEq ι] {A B : Finset ι}
    (h : Disjoint A B) :
    Q.sorkinMeasure (A ∪ B)
      = Q.sorkinMeasure A + Q.sorkinMeasure B
        + (Q.eventForm A B + Q.eventForm B A) := by
  simp only [sorkinMeasure]
  rw [Q.eventForm_union_left h (A ∪ B), Q.eventForm_union_right A h,
    Q.eventForm_union_right B h]
  ring

/-- Grade-2 interference: the additivity defect of the Sorkin
measure. -/
noncomputable def interference [DecidableEq ι] (A B : Finset ι) : ℂ :=
  Q.sorkinMeasure (A ∪ B) - Q.sorkinMeasure A - Q.sorkinMeasure B

/-- On disjoint events the interference is the sum of the two cross
terms. -/
theorem interference_eq [DecidableEq ι] {A B : Finset ι}
    (h : Disjoint A B) :
    Q.interference A B = Q.eventForm A B + Q.eventForm B A := by
  simp only [interference, Q.sorkinMeasure_union h]
  ring

/-- **The Sorkin grade-3 sum rule** (gr-qc/9401003, eq. (1) at `k = 3`):
the three-set additivity defect vanishes identically — a quantum
measure sits at grade 2 of the sum-rule hierarchy. Bi-additivity
alone carries this; no positivity is consumed. -/
theorem sorkin_grade3 [DecidableEq ι] {A B C : Finset ι}
    (hAB : Disjoint A B) (hAC : Disjoint A C) (hBC : Disjoint B C) :
    Q.sorkinMeasure (A ∪ B ∪ C)
      = Q.sorkinMeasure (A ∪ B) + Q.sorkinMeasure (A ∪ C)
        + Q.sorkinMeasure (B ∪ C)
        - Q.sorkinMeasure A - Q.sorkinMeasure B - Q.sorkinMeasure C := by
  have hABC : Disjoint (A ∪ B) C := Finset.disjoint_union_left.mpr ⟨hAC, hBC⟩
  rw [Q.sorkinMeasure_union hABC, Q.sorkinMeasure_union hAB,
    Q.sorkinMeasure_union hAC, Q.sorkinMeasure_union hBC,
    Q.eventForm_union_left hAB C, Q.eventForm_union_right C hAB]
  ring

end QuantumMeasure

/-! ## Presentations: the record-tier bridge -/

section Presentation

variable {d : Type*} [Fintype d]

/-- The decoherence functional of any presentation (class operators at
a state) is positive semidefinite as a matrix on the index: it is the
Gram matrix `Wᴴ * W` of the branch vectors. -/
theorem presentationGram_posSemidef (C : ι → Matrix d d ℂ) (ψ : d → ℂ) :
    (Matrix.of fun α β => decoherenceFunctional C ψ α β).PosSemidef := by
  have h : (Matrix.of fun α β => decoherenceFunctional C ψ α β)
      = (Matrix.of fun (i : d) (α : ι) => star ((C α *ᵥ ψ) i))ᴴ
        * (Matrix.of fun (i : d) (α : ι) => star ((C α *ᵥ ψ) i)) := by
    ext α β
    simp only [Matrix.of_apply, decoherenceFunctional, Matrix.mul_apply,
      Matrix.conjTranspose_apply, dotProduct, Pi.star_apply, star_star]
    exact Finset.sum_congr rfl fun i _ => mul_comm _ _
  rw [h]
  exact Matrix.posSemidef_conjTranspose_mul_self _

/-- A presentation with unit total weight yields a quantum measure:
the compilation direction — amplitudes upstream, Gram shadow as
structure. -/
noncomputable def QuantumMeasure.ofPresentation (C : ι → Matrix d d ℂ)
    (ψ : d → ℂ)
    (hnorm : ∑ α, ∑ β, decoherenceFunctional C ψ α β = 1) :
    QuantumMeasure ι where
  gram := Matrix.of fun α β => decoherenceFunctional C ψ α β
  posSemidef := presentationGram_posSemidef C ψ
  normalized := hnorm

@[simp] theorem QuantumMeasure.ofPresentation_gram (C : ι → Matrix d d ℂ)
    (ψ : d → ℂ) (hnorm) (α β : ι) :
    (QuantumMeasure.ofPresentation C ψ hnorm).gram α β
      = decoherenceFunctional C ψ α β := rfl

end Presentation

namespace QuantumMeasure

variable (Q : QuantumMeasure ι)

/-! ## Classicalization: conservativity over the record-rich fixed point -/

/-- A quantum measure is diagonal when its atoms do not interfere —
the record-forced regime. -/
def IsDiagonal : Prop := ∀ ⦃α β : ι⦄, α ≠ β → Q.gram α β = 0

/-- The probability row: the (real) diagonal of the Gram data. -/
noncomputable def probRow (α : ι) : ℝ := (Q.gram α α).re

theorem probRow_nonneg (α : ι) : 0 ≤ Q.probRow α := by
  have h : (0 : ℂ) ≤ Q.gram α α := Q.posSemidef.diag_nonneg
  simpa [probRow] using (Complex.le_def.mp h).1

/-- Diagonal Gram entries are (nonnegative) reals. -/
theorem gram_diag_ofReal (α : ι) : Q.gram α α = (Q.probRow α : ℂ) := by
  have h : (0 : ℂ) ≤ Q.gram α α := Q.posSemidef.diag_nonneg
  have him : (Q.gram α α).im = 0 := by
    simpa using ((Complex.le_def.mp h).2).symm
  apply Complex.ext
  · simp [probRow]
  · simp [him]

/-- For a diagonal quantum measure the probability row is an honest
probability distribution. -/
theorem probRow_sum (hd : Q.IsDiagonal) : ∑ α, Q.probRow α = 1 := by
  have hrow : ∀ α : ι, ∑ β, Q.gram α β = (Q.probRow α : ℂ) := fun α => by
    rw [Finset.sum_eq_single_of_mem α (Finset.mem_univ α)
      fun β _ hβ => hd (Ne.symm hβ)]
    exact Q.gram_diag_ofReal α
  have h : ((∑ α, Q.probRow α : ℝ) : ℂ) = 1 := by
    push_cast
    calc ∑ α, (Q.probRow α : ℂ)
        = ∑ α, ∑ β, Q.gram α β :=
          Finset.sum_congr rfl fun α _ => (hrow α).symm
      _ = 1 := Q.normalized
  exact_mod_cast h

/-- The classical embedding: an ordinary probability row, viewed as a
(diagonal) quantum measure. -/
noncomputable def classical [DecidableEq ι] (p : ι → ℝ) (hp : ∀ α, 0 ≤ p α)
    (hsum : ∑ α, p α = 1) : QuantumMeasure ι where
  gram := Matrix.diagonal fun α => (p α : ℂ)
  posSemidef := .diagonal fun α => by
    rw [Complex.le_def]
    constructor
    · simpa using hp α
    · simp
  normalized := by
    have h : ∀ α : ι, ∑ β, Matrix.diagonal (fun γ => (p γ : ℂ)) α β
        = (p α : ℂ) := fun α => by
      rw [Finset.sum_eq_single_of_mem α (Finset.mem_univ α)
        fun β _ hβ => Matrix.diagonal_apply_ne _ (Ne.symm hβ)]
      exact Matrix.diagonal_apply_eq _ α
    calc ∑ α, ∑ β, Matrix.diagonal (fun γ => (p γ : ℂ)) α β
        = ∑ α, (p α : ℂ) := Finset.sum_congr rfl fun α _ => h α
      _ = ((∑ α, p α : ℝ) : ℂ) := by push_cast; rfl
      _ = 1 := by rw [hsum]; exact Complex.ofReal_one

@[simp] theorem classical_gram [DecidableEq ι] (p : ι → ℝ) (hp) (hsum) :
    (classical p hp hsum).gram = Matrix.diagonal fun α => (p α : ℂ) := rfl

theorem classical_isDiagonal [DecidableEq ι] (p : ι → ℝ) (hp) (hsum) :
    (classical p hp hsum).IsDiagonal :=
  fun _ _ h => Matrix.diagonal_apply_ne _ h

/-- The classical event form is the intersection measure: `D(A, B) =
p(A ∩ B)`. -/
theorem classical_eventForm [DecidableEq ι] (p : ι → ℝ) (hp) (hsum)
    (A B : Finset ι) :
    (classical p hp hsum).eventForm A B = ∑ a ∈ A ∩ B, (p a : ℂ) := by
  simp only [eventForm, classical_gram]
  calc ∑ a ∈ A, ∑ b ∈ B, Matrix.diagonal (fun γ => (p γ : ℂ)) a b
      = ∑ a ∈ A, if a ∈ B then (p a : ℂ) else 0 := by
        refine Finset.sum_congr rfl fun a _ => ?_
        by_cases hB : a ∈ B
        · rw [if_pos hB, Finset.sum_eq_single_of_mem a hB
            fun b _ hb => Matrix.diagonal_apply_ne _ (Ne.symm hb)]
          exact Matrix.diagonal_apply_eq _ a
        · rw [if_neg hB]
          exact Finset.sum_eq_zero fun b hb =>
            Matrix.diagonal_apply_ne _ (by rintro rfl; exact hB hb)
    _ = ∑ a ∈ A ∩ B, (p a : ℂ) := Finset.sum_ite_mem _ _ _

/-- A diagonal event form is the intersection measure of its
probability row: the entire complex structure is recoverable from the
classical object. -/
theorem isDiagonal_eventForm_inter [DecidableEq ι] (hd : Q.IsDiagonal)
    (A B : Finset ι) :
    Q.eventForm A B = ∑ a ∈ A ∩ B, (Q.probRow a : ℂ) := by
  simp only [eventForm]
  calc ∑ a ∈ A, ∑ b ∈ B, Q.gram a b
      = ∑ a ∈ A, if a ∈ B then (Q.probRow a : ℂ) else 0 := by
        refine Finset.sum_congr rfl fun a _ => ?_
        by_cases hB : a ∈ B
        · rw [if_pos hB, Finset.sum_eq_single_of_mem a hB
            fun b _ hb => hd (Ne.symm hb)]
          exact Q.gram_diag_ofReal a
        · rw [if_neg hB]
          exact Finset.sum_eq_zero fun b hb =>
            hd (by rintro rfl; exact hB hb)
    _ = ∑ a ∈ A ∩ B, (Q.probRow a : ℂ) := Finset.sum_ite_mem _ _ _

/-- Diagonal quantum measures do not interfere: grade 2 degenerates to
grade 1. -/
theorem isDiagonal_interference [DecidableEq ι] (hd : Q.IsDiagonal)
    {A B : Finset ι} (h : Disjoint A B) : Q.interference A B = 0 := by
  rw [Q.interference_eq h]
  have h1 : Q.eventForm A B = 0 := by
    refine Finset.sum_eq_zero fun a ha => Finset.sum_eq_zero fun b hb => ?_
    exact hd (by rintro rfl; exact absurd hb (Finset.disjoint_left.mp h ha))
  have h2 : Q.eventForm B A = 0 := by
    rw [Q.eventForm_conj, h1, star_zero]
  rw [h1, h2, add_zero]

/-- Diagonal quantum measures are finitely additive: the classical
measure axiom, restored. -/
theorem isDiagonal_additive [DecidableEq ι] (hd : Q.IsDiagonal)
    {A B : Finset ι} (h : Disjoint A B) :
    Q.sorkinMeasure (A ∪ B) = Q.sorkinMeasure A + Q.sorkinMeasure B := by
  have hi := Q.isDiagonal_interference hd h
  simp only [interference] at hi
  linear_combination hi

/-- **Conservativity, structural form**: a diagonal quantum measure IS
the classical embedding of its probability row — a structure equality.
The discrete, set-indexed picture is the fixed point of
classicalization, and the D-form extension costs nothing there. -/
theorem isDiagonal_eq_classical [DecidableEq ι] (hd : Q.IsDiagonal) :
    Q = classical Q.probRow Q.probRow_nonneg (Q.probRow_sum hd) := by
  apply ext
  ext α β
  by_cases h : α = β
  · subst h
    rw [classical_gram, Matrix.diagonal_apply_eq]
    exact Q.gram_diag_ofReal α
  · rw [classical_gram, Matrix.diagonal_apply_ne _ h, hd h]

variable {d : Type*} [Fintype d]

theorem ofPresentation_isDiagonal {C : ι → Matrix d d ℂ} {ψ : d → ℂ}
    {hnorm : ∑ α, ∑ β, decoherenceFunctional C ψ α β = 1}
    (hmed : MediumDecoherent C ψ) :
    (ofPresentation C ψ hnorm).IsDiagonal :=
  fun _ _ h => hmed _ _ h

/-- The single point where the record tier enters: records force
medium decoherence (`records_imply_medium`, index-generic), hence
diagonality of the presentation's quantum measure. -/
private theorem records_isDiagonal {C R : ι → Matrix d d ℂ} {ψ : d → ℂ}
    {hnorm : ∑ α, ∑ β, decoherenceFunctional C ψ α β = 1}
    (hherm : ∀ α, (R α).IsHermitian)
    (horth : ∀ α β, α ≠ β → R α * R β = 0)
    (hrec : ∀ α, C α *ᵥ ψ = R α *ᵥ ψ) :
    (ofPresentation C ψ hnorm).IsDiagonal :=
  ofPresentation_isDiagonal (records_imply_medium C R ψ hherm horth hrec)

/-- **The conservativity theorem**: records on the index classicalize
the quantum measure back to today's discrete assembly. A presentation
carrying a record family (mutually orthogonal Hermitian observables
correlated with the class operators) has a quantum measure equal to a
classical one — the probability row is the branch-weight row, and the
extension is conservative over the record-rich fixed point. -/
theorem records_conservativity [DecidableEq ι] {C R : ι → Matrix d d ℂ}
    {ψ : d → ℂ}
    (hnorm : ∑ α, ∑ β, decoherenceFunctional C ψ α β = 1)
    (hherm : ∀ α, (R α).IsHermitian)
    (horth : ∀ α β, α ≠ β → R α * R β = 0)
    (hrec : ∀ α, C α *ᵥ ψ = R α *ᵥ ψ) :
    ∃ (p : ι → ℝ) (hp : ∀ α, 0 ≤ p α) (hs : ∑ α, p α = 1),
      ofPresentation C ψ hnorm = classical p hp hs := by
  have hd := records_isDiagonal (hnorm := hnorm) hherm horth hrec
  exact ⟨_, _, _, (ofPresentation C ψ hnorm).isDiagonal_eq_classical hd⟩

/-- **Conservativity, concrete face**: under records, the entire
complex event form is the intersection measure of the branch-weight
row — the discrete assembly, exactly. -/
theorem records_eventForm [DecidableEq ι] {C R : ι → Matrix d d ℂ}
    {ψ : d → ℂ}
    (hnorm : ∑ α, ∑ β, decoherenceFunctional C ψ α β = 1)
    (hherm : ∀ α, (R α).IsHermitian)
    (horth : ∀ α β, α ≠ β → R α * R β = 0)
    (hrec : ∀ α, C α *ᵥ ψ = R α *ᵥ ψ) (A B : Finset ι) :
    (ofPresentation C ψ hnorm).eventForm A B
      = ∑ a ∈ A ∩ B, ((decoherenceFunctional C ψ a a).re : ℂ) := by
  have hd := records_isDiagonal (hnorm := hnorm) hherm horth hrec
  exact (ofPresentation C ψ hnorm).isDiagonal_eventForm_inter hd A B

/-! ## The derived History space (Dowker–Johnston–Sorkin, finite grade)

The free vector space on events, the degenerate inner product given by
the event Gram matrix, the null ideal as its kernel, and the quotient.
At finite dimension the completion step of the GNS construction is
vacuous, so the quotient IS the History Hilbert space. -/

section GNS

/-- The DJS degenerate inner product on the free vector space over
events (conjugate-linear in the first slot). -/
noncomputable def gnsForm (u v : Finset ι → ℂ) : ℂ :=
  star u ⬝ᵥ (Q.eventGram *ᵥ v)

theorem gnsForm_self_nonneg [DecidableEq ι] (v : Finset ι → ℂ) :
    0 ≤ Q.gnsForm v v :=
  Q.eventGram_posSemidef.dotProduct_mulVec_nonneg v

theorem gnsForm_conj [DecidableEq ι] (u v : Finset ι → ℂ) :
    Q.gnsForm v u = star (Q.gnsForm u v) := by
  simp only [gnsForm]
  rw [Matrix.star_dotProduct]
  congr 1
  rw [Matrix.star_mulVec, ← Matrix.dotProduct_mulVec,
    Q.eventGram_posSemidef.1.eq]

/-- The null ideal: the kernel of the event Gram matrix. -/
noncomputable def gnsNull : Submodule ℂ (Finset ι → ℂ) :=
  LinearMap.ker Q.eventGram.mulVecLin

/-- Null vectors are exactly the vectors the form cannot see: `v` is
null iff `⟨v, v⟩_D = 0` (positive semidefiniteness makes the kernel
and the isotropic set coincide). -/
theorem mem_gnsNull_iff [DecidableEq ι] (v : Finset ι → ℂ) :
    v ∈ Q.gnsNull ↔ Q.gnsForm v v = 0 := by
  simp only [gnsNull, LinearMap.mem_ker, Matrix.mulVecLin_apply]
  exact (Q.eventGram_posSemidef.dotProduct_mulVec_zero_iff v).symm

theorem gnsForm_null_right (u : Finset ι → ℂ) {v : Finset ι → ℂ}
    (hv : v ∈ Q.gnsNull) : Q.gnsForm u v = 0 := by
  have h : Q.eventGram *ᵥ v = 0 := by
    simpa only [gnsNull, LinearMap.mem_ker, Matrix.mulVecLin_apply] using hv
  simp [gnsForm, h]

theorem gnsForm_null_left [DecidableEq ι] {u : Finset ι → ℂ}
    (hu : u ∈ Q.gnsNull) (v : Finset ι → ℂ) : Q.gnsForm u v = 0 := by
  rw [Q.gnsForm_conj v u, Q.gnsForm_null_right v hu, star_zero]

/-- The History Hilbert space at finite grade: free vectors on events
modulo the null ideal — derived from the quantum measure, never
postulated. -/
abbrev HistoryHilbert := (Finset ι → ℂ) ⧸ Q.gnsNull

/-- Two event vectors have the same class exactly when the form cannot
distinguish them. -/
theorem mk_eq_mk_iff [DecidableEq ι] (u v : Finset ι → ℂ) :
    (Submodule.Quotient.mk u : Q.HistoryHilbert) = Submodule.Quotient.mk v
      ↔ Q.gnsForm (u - v) (u - v) = 0 := by
  rw [Submodule.Quotient.eq]
  exact Q.mem_gnsNull_iff _

/-- The additivity-defect vector of a pair of events. -/
noncomputable def defectVector [DecidableEq ι] (A B : Finset ι) :
    Finset ι → ℂ :=
  Pi.single A 1 + Pi.single B 1 - Pi.single (A ∪ B) 1

/-- The event Gram matrix applied to an event indicator is the
corresponding column of the event form. -/
theorem eventGram_mulVec_single [DecidableEq ι] (X : Finset ι) :
    Q.eventGram *ᵥ Pi.single X (1 : ℂ) = fun W => Q.eventForm W X := by
  funext W
  show (fun Y => Q.eventGram W Y) ⬝ᵥ Pi.single X (1 : ℂ) = _
  rw [dotProduct_single, mul_one]
  rfl

/-- **Bi-additivity generates the null ideal**: the additivity defects
`δ_A + δ_B − δ_{A⊔B}` of disjoint events are null. Linear structure is
generated by events and cut down by exactly what the measure cannot
distinguish — the Dowker–Johnston–Sorkin mechanism, kernel-checked. -/
theorem defectVector_mem_gnsNull [DecidableEq ι] {A B : Finset ι}
    (h : Disjoint A B) :
    defectVector A B ∈ Q.gnsNull := by
  simp only [gnsNull, LinearMap.mem_ker, Matrix.mulVecLin_apply,
    defectVector]
  rw [Matrix.mulVec_sub, Matrix.mulVec_add, Q.eventGram_mulVec_single,
    Q.eventGram_mulVec_single, Q.eventGram_mulVec_single]
  funext W
  simp only [Pi.add_apply, Pi.sub_apply, Pi.zero_apply]
  rw [Q.eventForm_union_right W h]
  ring

/-- In the History space, the class of a disjoint union is the sum of
the classes: quotient-level additivity. -/
theorem mk_single_union [DecidableEq ι] {A B : Finset ι}
    (h : Disjoint A B) :
    (Submodule.Quotient.mk (Pi.single (A ∪ B) (1 : ℂ)) : Q.HistoryHilbert)
      = Submodule.Quotient.mk (Pi.single A 1)
        + Submodule.Quotient.mk (Pi.single B 1) := by
  rw [← Submodule.Quotient.mk_add, Submodule.Quotient.eq]
  have h1 := neg_mem (Q.defectVector_mem_gnsNull h)
  have h2 : -defectVector A B
      = Pi.single (A ∪ B) (1 : ℂ) - (Pi.single A 1 + Pi.single B 1) := by
    simp only [defectVector]
    abel
  rwa [h2] at h1

/-- Every event indicator is, modulo nulls, the sum of its atoms'
indicators. -/
theorem single_sub_sum_atoms_mem_gnsNull [DecidableEq ι] (A : Finset ι) :
    (Pi.single A (1 : ℂ) - ∑ a ∈ A, Pi.single ({a} : Finset ι) 1)
      ∈ Q.gnsNull := by
  classical
  induction A using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty, sub_zero, gnsNull, LinearMap.mem_ker,
      Matrix.mulVecLin_apply]
    rw [Q.eventGram_mulVec_single]
    funext W
    simp [eventForm]
  | insert a s ha ih =>
    have hdisj : Disjoint ({a} : Finset ι) s :=
      Finset.disjoint_singleton_left.mpr ha
    have key := add_mem (neg_mem (Q.defectVector_mem_gnsNull hdisj)) ih
    have heq : -defectVector ({a} : Finset ι) s
          + (Pi.single s (1 : ℂ) - ∑ x ∈ s, Pi.single ({x} : Finset ι) 1)
        = Pi.single (insert a s) (1 : ℂ)
          - ∑ x ∈ insert a s, Pi.single ({x} : Finset ι) 1 := by
      rw [Finset.sum_insert ha, Finset.insert_eq]
      simp only [defectVector]
      abel
    rwa [heq] at key

/-- **The atom classes span the History space**: the 2^|ι| event
generators collapse, modulo nulls, to at most |ι| atom classes.
(Spanning only — null atoms are possible, so injectivity is
deliberately not claimed.) -/
theorem span_atomClasses [DecidableEq ι] :
    Submodule.span ℂ (Set.range fun a : ι =>
        (Submodule.Quotient.mk (Pi.single ({a} : Finset ι) (1 : ℂ))
          : Q.HistoryHilbert))
      = ⊤ := by
  rw [Submodule.eq_top_iff']
  intro x
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  have hu : (Submodule.Quotient.mk u : Q.HistoryHilbert)
      = ∑ A : Finset ι, u A • Submodule.Quotient.mk (Pi.single A 1) := by
    conv_lhs => rw [pi_eq_sum_univ' u]
    rw [← Submodule.mkQ_apply, map_sum]
    simp only [map_smul, Submodule.mkQ_apply]
  rw [hu]
  refine Submodule.sum_mem _ fun A _ => Submodule.smul_mem _ _ ?_
  have hA : (Submodule.Quotient.mk (Pi.single A (1 : ℂ))
        : Q.HistoryHilbert)
      = ∑ a ∈ A, Submodule.Quotient.mk (Pi.single ({a} : Finset ι) 1) := by
    have hsum : Submodule.Quotient.mk
          (∑ a ∈ A, Pi.single ({a} : Finset ι) (1 : ℂ))
        = (∑ a ∈ A, Submodule.Quotient.mk (Pi.single ({a} : Finset ι) (1 : ℂ))
          : Q.HistoryHilbert) := by
      rw [← Submodule.mkQ_apply, map_sum]
      simp only [Submodule.mkQ_apply]
    rw [← hsum, Submodule.Quotient.eq]
    exact Q.single_sub_sum_atoms_mem_gnsNull A
  rw [hA]
  exact Submodule.sum_mem _ fun a _ => Submodule.subset_span ⟨a, rfl⟩

end GNS

end QuantumMeasure

/-! ## Witnesses: the coherent switch and its classicalized partner,
as quantum measures on an index of orders -/

section Toys

open QuantumMeasure

/-- Scaling a positive semidefinite complex matrix by a nonnegative
real keeps it positive semidefinite. -/
private theorem posSemidef_realSmul {n : Type*} [Fintype n]
    {M : Matrix n n ℂ} {c : ℝ} (hc : 0 ≤ c) (hM : M.PosSemidef) :
    (((c : ℂ)) • M).PosSemidef := by
  refine Matrix.PosSemidef.of_dotProduct_mulVec_nonneg ?_ fun x => ?_
  · show (((c : ℂ)) • M)ᴴ = ((c : ℂ)) • M
    rw [Matrix.conjTranspose_smul, hM.1.eq, Complex.star_def,
      Complex.conj_ofReal]
  · rw [Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]
    have h0 := hM.dotProduct_mulVec_nonneg x
    have h0re : 0 ≤ (star x ⬝ᵥ M *ᵥ x).re := by
      simpa using (Complex.le_def.mp h0).1
    have h0im : (star x ⬝ᵥ M *ᵥ x).im = 0 := by
      simpa using ((Complex.le_def.mp h0).2).symm
    rw [Complex.le_def]
    constructor
    · simp only [Complex.zero_re, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, sub_zero, h0im, mul_zero]
      exact mul_nonneg hc h0re
    · simp [Complex.mul_im, h0im]

/-- Sums over the two temporal orders, expanded. -/
private theorem sum_switchOrder (f : SwitchOrder → ℂ) :
    ∑ x, f x = f .zThenX + f .xThenZ := by
  have h : (Finset.univ : Finset SwitchOrder)
      = {SwitchOrder.zThenX, SwitchOrder.xThenZ} := by decide
  rw [h, Finset.sum_insert (by decide), Finset.sum_singleton]

/-- The coherent switch as a quantum measure on the order index: the
`QuantumOuterStorey` decoherence functional of the switch family on
`(1,1)`, normalized. Atom matrix `[[1/5, 1/5], [1/5, 2/5]]`. -/
noncomputable def switchMeasure : QuantumMeasure SwitchOrder where
  gram := (((2/5 : ℝ) : ℂ)) • Matrix.of fun α β =>
    decoherenceFunctional switchFamily ![1, 1] α β
  posSemidef := posSemidef_realSmul (by norm_num)
    (presentationGram_posSemidef switchFamily ![1, 1])
  normalized := by
    rw [sum_switchOrder, sum_switchOrder, sum_switchOrder]
    simp only [Matrix.smul_apply, Matrix.of_apply, smul_eq_mul]
    simp only [decoherenceFunctional, switchFamily]
    norm_num [Qx0, Pz0, Matrix.mulVec, Matrix.mul_apply, dotProduct,
      Fin.sum_univ_two, Pi.star_apply, Complex.star_def, map_div₀, map_neg,
      map_one, map_ofNat, Complex.conj_I, Complex.ext_iff, Complex.add_re,
      Complex.add_im, Complex.mul_re, Complex.mul_im, Complex.div_re,
      Complex.div_im, Complex.I_re, Complex.I_im, Complex.normSq_apply,
      Complex.ofReal_re, Complex.ofReal_im]

theorem switchMeasure_gram (α β : SwitchOrder) :
    switchMeasure.gram α β
      = (((2/5 : ℝ) : ℂ)) * decoherenceFunctional switchFamily ![1, 1] α β :=
  rfl

/-- **Grade-2 interference on an index of orders**: the coherent
switch's quantum measure violates additivity by `2/5` — the top event
has measure `1` while the two orders carry `1/5` and `2/5`. Strictly
quantum, exactly where no record family exists
(`QuantumOuterStorey`'s `switch_no_records`). -/
theorem switchMeasure_interference :
    switchMeasure.interference {SwitchOrder.zThenX} {SwitchOrder.xThenZ}
      = 2/5 := by
  have hdisj : Disjoint ({SwitchOrder.zThenX} : Finset SwitchOrder)
      {SwitchOrder.xThenZ} :=
    Finset.disjoint_singleton_left.mpr (by decide)
  rw [switchMeasure.interference_eq hdisj]
  simp only [eventForm, Finset.sum_singleton, switchMeasure_gram]
  simp only [decoherenceFunctional, switchFamily]
  norm_num [Qx0, Pz0, Matrix.mulVec, Matrix.mul_apply, dotProduct,
    Fin.sum_univ_two, Pi.star_apply, Complex.star_def, map_div₀, map_neg,
    map_one, map_ofNat, Complex.conj_I, Complex.ext_iff, Complex.add_re,
    Complex.add_im, Complex.mul_re, Complex.mul_im, Complex.div_re,
    Complex.div_im, Complex.I_re, Complex.I_im, Complex.normSq_apply,
    Complex.ofReal_re, Complex.ofReal_im]

/-- The coherent switch's quantum measure is not diagonal: the order
index genuinely interferes. -/
theorem switchMeasure_not_isDiagonal : ¬ switchMeasure.IsDiagonal := by
  intro h
  have hcontra := h (show SwitchOrder.zThenX ≠ SwitchOrder.xThenZ by decide)
  rw [switchMeasure_gram] at hcontra
  simp only [decoherenceFunctional, switchFamily] at hcontra
  norm_num [Qx0, Pz0, Matrix.mulVec, Matrix.mul_apply, dotProduct,
    Fin.sum_univ_two, Pi.star_apply, Complex.star_def, map_div₀, map_neg,
    map_one, map_ofNat, Complex.conj_I, Complex.ext_iff, Complex.add_re,
    Complex.add_im, Complex.mul_re, Complex.mul_im, Complex.div_re,
    Complex.div_im, Complex.I_re, Complex.I_im, Complex.normSq_apply,
    Complex.ofReal_re, Complex.ofReal_im] at hcontra

/-- The controlled switch (orthogonal pointer riding each order) as a
quantum measure: the pointer classicalizes the index — atom matrix
`diag(1/3, 2/3)`. -/
noncomputable def controlledMeasure : QuantumMeasure SwitchOrder where
  gram := (((2/3 : ℝ) : ℂ)) • Matrix.of fun α β =>
    decoherenceFunctional controlledSwitch switchState α β
  posSemidef := posSemidef_realSmul (by norm_num)
    (presentationGram_posSemidef controlledSwitch switchState)
  normalized := by
    have h01 := controlledSwitch_mediumDecoherent .zThenX .xThenZ (by decide)
    have h10 := controlledSwitch_mediumDecoherent .xThenZ .zThenX (by decide)
    rw [sum_switchOrder, sum_switchOrder, sum_switchOrder]
    simp only [Matrix.smul_apply, Matrix.of_apply, smul_eq_mul, h01, h10,
      mul_zero]
    simp only [decoherenceFunctional, controlledSwitch]
    norm_num [switchState, Qx0, Pz0, Pz1, Matrix.mulVec, Matrix.mul_apply,
      dotProduct, Matrix.kroneckerMap_apply, Fintype.sum_prod_type,
      Fin.sum_univ_two, Pi.star_apply, Complex.star_def, map_div₀, map_neg,
      map_one, map_ofNat, Complex.ext_iff, Complex.ofReal_re,
      Complex.ofReal_im]

theorem controlledMeasure_gram (α β : SwitchOrder) :
    controlledMeasure.gram α β
      = (((2/3 : ℝ) : ℂ))
        * decoherenceFunctional controlledSwitch switchState α β :=
  rfl

/-- Pointer orthogonality classicalizes the measure: the controlled
switch's quantum measure is diagonal (the medium-decoherence witness
of `QuantumOuterStorey`, at measure grade). -/
theorem controlledMeasure_isDiagonal : controlledMeasure.IsDiagonal := by
  intro α β h
  rw [controlledMeasure_gram, controlledSwitch_mediumDecoherent α β h,
    mul_zero]

/-- The classicalized switch IS a classical measure: the outer-storey
design's regime pair, closed at measure grade — same physics, pointer
on, structure equality with the classical embedding. -/
theorem controlledMeasure_eq_classical :
    controlledMeasure
      = classical controlledMeasure.probRow controlledMeasure.probRow_nonneg
          (controlledMeasure.probRow_sum controlledMeasure_isDiagonal) :=
  controlledMeasure.isDiagonal_eq_classical controlledMeasure_isDiagonal

/-- Unit total weight for the recorded two-outcome presentation on the
3-4-5 state. -/
private theorem zMeasure_norm :
    ∑ α, ∑ β,
      decoherenceFunctional ![Pz0, Pz1] ![(3/5 : ℂ), 4/5] α β = 1 := by
  simp only [Fin.sum_univ_two, decoherenceFunctional]
  norm_num [Pz0, Pz1, Matrix.mulVec, Matrix.mul_apply, dotProduct,
    Fin.sum_univ_two, Pi.star_apply, Complex.star_def, map_div₀, map_neg,
    map_one, map_ofNat, Complex.ext_iff, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons]

/-- A recorded presentation: the z-measurement pair on the 3-4-5
state — the class operators are their own record family. -/
noncomputable def zMeasure : QuantumMeasure (Fin 2) :=
  ofPresentation ![Pz0, Pz1] ![(3/5 : ℂ), 4/5] zMeasure_norm

/-- The conservativity theorem, exercised end-to-end: the recorded
presentation's quantum measure is classical (records := the projectors
themselves — Hermitian, orthogonal, trivially correlated). -/
theorem zMeasure_conservative :
    ∃ (p : Fin 2 → ℝ) (hp : ∀ α, 0 ≤ p α) (hs : ∑ α, p α = 1),
      zMeasure = classical p hp hs := by
  refine records_conservativity (R := ![Pz0, Pz1]) zMeasure_norm ?_ ?_ ?_
  · intro α
    fin_cases α
    · exact Pz0_isHermitian
    · exact Pz1_isHermitian
  · intro α β h
    fin_cases α <;> fin_cases β <;>
      first
        | exact absurd rfl h
        | exact Pz0_mul_Pz1
        | exact Pz1_mul_Pz0
  · intro α
    rfl

/-- The recovered probability row is the Born row of the 3-4-5 state:
`(9/25, 16/25)`. -/
theorem zMeasure_probRow : zMeasure.probRow = ![(9/25 : ℝ), 16/25] := by
  funext α
  fin_cases α <;>
  · simp only [probRow, zMeasure, ofPresentation_gram, decoherenceFunctional]
    norm_num [Pz0, Pz1, Matrix.mulVec, Matrix.mul_apply, dotProduct,
      Fin.sum_univ_two, Pi.star_apply, Complex.star_def,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      Complex.add_re, Complex.mul_re, Complex.mul_im]

end Toys

