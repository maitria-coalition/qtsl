noncomputable def V : S → ℝ := fun s =>
  if -2 ≤ s.1 ∧ s.1 ≤ 101 ∧ 0 ≤ s.2 ∧ s.2 ≤ 10 then tbl s
  else 1

noncomputable def step : S → Measure S := fun s =>
  if s.1 ≥ 0 ∧ s.1 ≤ 100 then
    if 1 ≤ s.2 ∧ s.2 ≤ 9 then Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (s.1 - 2, s.2 - 1) (s.1 - 2, s.2 + 1) (s.1 + 1, s.2 - 1) (s.1 + 1, s.2 + 1)
    else if s.2 < 1 then Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (s.1 - 2, s.2) (s.1 - 2, s.2 + 1) (s.1 + 1, s.2) (s.1 + 1, s.2 + 1)
    else Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (s.1 - 2, s.2 - 1) (s.1 - 2, s.2) (s.1 + 1, s.2 - 1) (s.1 + 1, s.2)
  else Measure.dirac s

lemma step_active0 {a b : ℤ} (h0 : a ≥ 0) (h1 : a ≤ 100) (hr : 1 ≤ b ∧ b ≤ 9) :
    step (a, b) = Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (a - 2, b - 1) (a - 2, b + 1) (a + 1, b - 1) (a + 1, b + 1) := by
  simp only [step]
  rw [if_pos (by exact ⟨h0, h1⟩)]
  rw [if_pos (by omega)]

lemma step_active1 {a b : ℤ} (h0 : a ≥ 0) (h1 : a ≤ 100) (hr : b < 1) :
    step (a, b) = Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (a - 2, b) (a - 2, b + 1) (a + 1, b) (a + 1, b + 1) := by
  simp only [step]
  rw [if_pos (by exact ⟨h0, h1⟩)]
  rw [if_neg (by omega)]
  rw [if_pos (by omega)]

lemma step_active2 {a b : ℤ} (h0 : a ≥ 0) (h1 : a ≤ 100) (hr : b > 9) :
    step (a, b) = Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (a - 2, b - 1) (a - 2, b) (a + 1, b - 1) (a + 1, b) := by
  simp only [step]
  rw [if_pos (by exact ⟨h0, h1⟩)]
  rw [if_neg (by omega)]
  rw [if_neg (by omega)]

lemma step_prob : ∀ s, IsProbabilityMeasure (step s) := by
  intro s
  unfold step
  split_ifs
  · exact Sweep.isProbabilityMeasure_mix4 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) _ _ _ _
  · exact Sweep.isProbabilityMeasure_mix4 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) _ _ _ _
  · exact Sweep.isProbabilityMeasure_mix4 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) _ _ _ _
  · infer_instance

instance : IsMarkovKernel (Sweep.ofFun step) := Sweep.isMarkovKernel_ofFun step_prob

