noncomputable def V : S → ℝ := fun s =>
  if -2 ≤ s ∧ s ≤ 101 then tbl s
  else 1

noncomputable def step : S → Measure S := fun s =>
  if s ≥ 0 ∧ s ≤ 100 then
    Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (s - 2) (s - 1) (s) (s + 1)
  else Measure.dirac s

lemma step_active0 {x : ℤ} (h0 : x ≥ 0) (h1 : x ≤ 100) :
    step x = Sweep.mix4 (1 / 4) (1 / 4) (1 / 4) (1 / 4) (x - 2) (x - 1) (x) (x + 1) := by
  simp [step, h0, h1]

lemma step_prob : ∀ s, IsProbabilityMeasure (step s) := by
  intro s
  unfold step
  split_ifs
  · exact Sweep.isProbabilityMeasure_mix4 (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) _ _ _ _
  · infer_instance

instance : IsMarkovKernel (Sweep.ofFun step) := Sweep.isMarkovKernel_ofFun step_prob

lemma V_bounds : ∀ y : S, 0 ≤ V y ∧ V y ≤ 1 := by
  intro y
  by_cases hw : -2 ≤ y ∧ y ≤ 101
  · obtain ⟨h1, h2⟩ := hw
    interval_cases y <;> norm_num [V, tbl]
  · norm_num [V, hw]

lemma V_nonneg : ∀ y : S, 0 ≤ V y := fun y => (V_bounds y).1

lemma V_le_one : ∀ y : S, V y ≤ 1 := fun y => (V_bounds y).2

lemma V_barrier : ∀ y ∈ {x : ℤ | 101 ≤ x}, 1 ≤ V y := by
  intro y hy
  simp only [Set.mem_setOf_eq] at hy
  by_cases h : y ≤ 101
  · have h2 : 101 ≤ y := hy
    interval_cases y <;> norm_num [V, tbl]
  · have hw : ¬(-2 ≤ y ∧ y ≤ 101) := by omega
    simp [V, hw]

lemma V_drift : ∀ x : S, x ∉ {x : ℤ | 101 ≤ x} → ∫ z, V z ∂(step x) ≤ V x := by
  intro x _hx
  by_cases hact : x ≥ 0 ∧ x ≤ 100
  · obtain ⟨h0, h1⟩ := hact
    interval_cases x <;>
