  if 0 ≤ s.1 ∧ s.1 ≤ 51 ∧ 0 ≤ s.2 ∧ s.2 ≤ 11 then tbl s
  else 1

noncomputable def step : S → Measure S := fun s =>
  if s.1 ≤ 50 ∧ s.2 ≤ 10 then
    if s.2 ≥ 1 then Sweep.mix2 (1 / 10) (9 / 10) (s.1 + 1, s.2 + 1) (s.1 + 1, s.2 - 1)
    else Sweep.mix2 (1 / 10) (9 / 10) (s.1 + 1, s.2 + 1) (s.1 + 1, s.2)
  else Measure.dirac s

lemma step_active0 {a b : ℤ} (h0 : a ≤ 50) (h1 : b ≤ 10) (hr : b ≥ 1) :
    step (a, b) = Sweep.mix2 (1 / 10) (9 / 10) (a + 1, b + 1) (a + 1, b - 1) := by
  simp only [step]
  rw [if_pos (by exact ⟨h0, h1⟩)]
  rw [if_pos (by omega)]

lemma step_active1 {a b : ℤ} (h0 : a ≤ 50) (h1 : b ≤ 10) (hr : b < 1) :
    step (a, b) = Sweep.mix2 (1 / 10) (9 / 10) (a + 1, b + 1) (a + 1, b) := by
  simp only [step]
  rw [if_pos (by exact ⟨h0, h1⟩)]
  rw [if_neg (by omega)]

lemma step_prob : ∀ s, IsProbabilityMeasure (step s) := by
  intro s
  unfold step
  split_ifs
  · exact Sweep.isProbabilityMeasure_mix2 (by norm_num) (by norm_num) (by norm_num) _ _
  · exact Sweep.isProbabilityMeasure_mix2 (by norm_num) (by norm_num) (by norm_num) _ _
  · infer_instance

instance : IsMarkovKernel (Sweep.ofFun step) := Sweep.isMarkovKernel_ofFun step_prob

