∕-- The probability of a set of outcomes: the weight it captures. -∕
noncomputable def prob (μ : SubPMF V) (S : Set V) : ℚ :=
  letI := Classical.decPred fun v => v ∈ S
  ∑ v ∈ μ.wt.support, if v ∈ S then μ.wt v else 0
-/
