/- **def** `SuFunctor.Adequacy.FinDTMC.pathLaw` — module `SuFunctor.Adequacy.Dtmc`.
The classical path law of the chain: the finite-dimensional
distribution at horizon `k`, by the product formula of the
literature. 
-/
/- source text (module `SuFunctor.Adequacy.Dtmc`):
∕-- The classical path law of the chain: the finite-dimensional
distribution at horizon `k`, by the product formula of the
literature. -∕
noncomputable def FinDTMC.pathLaw (M : FinDTMC S) (k : ℕ) : SubPMF (Traj S k) where
  wt := Finsupp.onFinset univ (fun ω => chainWt M.init M.step ω)
    (fun _ _ => mem_univ _)
  nonneg ω := chainWt_nonneg M.init_nonneg M.step_nonneg ω
  mass_le_one := by
    refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg
      (Finset.subset_univ _) fun ω _ _ =>
        chainWt_nonneg M.init_nonneg M.step_nonneg ω) ?_
    show (∑ ω : Traj S k, chainWt M.init M.step ω) ≤ 1
    rw [sum_chainWt _ M.step_row_sum k _, M.init_sum]
-/
noncomputable def LeanCone.«SuFunctor.Adequacy.FinDTMC.pathLaw» :
    {S : Type} →
      [inst : Fintype S] →
        [DecidableEq S] →
          SuFunctor.Adequacy.FinDTMC S → (k : ℕ) → SuFunctor.SubPMF (SuFunctor.Adequacy.Traj S k) :=
  SuFunctor.Adequacy.FinDTMC.pathLaw

/- **def** `SuFunctor.Crd.instPseudoDoubleCategoryStruct` — module `SuFunctor.Target`.
note: instance of class `CategoryTheory.PseudoDoubleCategoryStruct`
