/- **def** `CategoryTheory.PseudoDoubleCategoryStruct.Cell.cast` — module `DoubleCat.Basic`.
Transport a cell along equalities of its tight boundaries.

Tight arrows compose strictly but only propositionally so; `Cell.cast` is the
canonical transport of a cell along equalities of its two tight sides.  All
axioms of `CategoryTheory.PseudoDoubleCategory` whose two sides have
propositionally-but-not-syntactically equal tight boundaries are stated up to
this transport. 
-/
noncomputable def LeanCone.«CategoryTheory.PseudoDoubleCategoryStruct.Cell.cast» :
    {C : Type u} →
      [inst : CategoryTheory.Category.{v, u} C] →
        [inst_1 : CategoryTheory.PseudoDoubleCategoryStruct C] →
          {a b c d : C} →
            {m : CategoryTheory.PseudoDoubleCategoryStruct.Loose a b} →
              {n : CategoryTheory.PseudoDoubleCategoryStruct.Loose c d} →
                {f f' : a ⟶ c} →
                  {g g' : b ⟶ d} →
                    f = f' →
                      g = g' →
                        CategoryTheory.PseudoDoubleCategoryStruct.Cell m n f g →
                          CategoryTheory.PseudoDoubleCategoryStruct.Cell m n f' g' :=
  fun {C} [CategoryTheory.Category.{v, u} C] [CategoryTheory.PseudoDoubleCategoryStruct C] {a b c d}
      {m} {n} {f f'} {g g'} hf hg α =>
    hf ▸ hg ▸ α

example : @LeanCone.«CategoryTheory.PseudoDoubleCategoryStruct.Cell.cast».{v, u, u_1, u_2} = @CategoryTheory.PseudoDoubleCategoryStruct.Cell.cast.{v, u, u_1, u_2} := rfl

/- **def** `CategoryTheory.PseudoDoubleCategoryStruct.Cell.IsInvertible` — module `DoubleCat.Functor.Pseudo`.
A globular cell is invertible when it has a two-sided inverse with respect
to tight-wise composition (up to the casts along `𝟙 ≫ 𝟙 = 𝟙`). 
-/
/- source text (module `DoubleCat.Functor.Pseudo`):
∕-- A globular cell is invertible when it has a two-sided inverse with respect
to tight-wise composition (up to the casts along `𝟙 ≫ 𝟙 = 𝟙`). -∕
def PseudoDoubleCategoryStruct.Cell.IsInvertible {a b : C}
    {m n : Loose a b} (α : Cell m n (𝟙 a) (𝟙 b)) : Prop :=
  ∃ β : Cell n m (𝟙 a) (𝟙 b),
    α ≫ᵥ β = (vId m).cast (by simp) (by simp) ∧
    β ≫ᵥ α = (vId n).cast (by simp) (by simp)
-/
noncomputable def LeanCone.«CategoryTheory.PseudoDoubleCategoryStruct.Cell.IsInvertible» :
    {C : Type u} →
      [inst : CategoryTheory.Category.{v, u} C] →
        [inst_1 : CategoryTheory.PseudoDoubleCategoryStruct C] →
          {a b : C} →
            {m n : CategoryTheory.PseudoDoubleCategoryStruct.Loose a b} →
              CategoryTheory.PseudoDoubleCategoryStruct.Cell m n (CategoryTheory.CategoryStruct.id a)
                  (CategoryTheory.CategoryStruct.id b) →
                Prop :=
  CategoryTheory.PseudoDoubleCategoryStruct.Cell.IsInvertible

